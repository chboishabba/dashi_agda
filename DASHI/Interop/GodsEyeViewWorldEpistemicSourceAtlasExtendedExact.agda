      activistPurposeCreatesBlanketObservationAuthority ≡ false
    institutionalSourceCreatesNeutralWorldTruth : Bool
    institutionalSourceCreatesNeutralWorldTruthIsFalse :
      institutionalSourceCreatesNeutralWorldTruth ≡ false
    remoteObservationCreatesLandAuthority : Bool
    remoteObservationCreatesLandAuthorityIsFalse :
      remoteObservationCreatesLandAuthority ≡ false
    unStatementCreatesBindingJudgment : Bool
    unStatementCreatesBindingJudgmentIsFalse :
      unStatementCreatesBindingJudgment ≡ false

