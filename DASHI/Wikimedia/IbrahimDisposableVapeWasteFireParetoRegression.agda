module DASHI.Wikimedia.IbrahimDisposableVapeWasteFireParetoRegression where

import DASHI.Wikimedia.IbrahimDisposableVapeWasteFireParetoExact as Sut

------------------------------------------------------------------------
-- RED contract:
--  * fire-prevention interventions and attribution/data systems are different consumers;
--  * mixed-waste diversion architectures are compared only within the prevention consumer;
--  * B-cycle availability does not imply embedded-vape acceptance;
--  * Pareto ranking uses synthetic local axes and creates neither effect size nor authority;
--  * current front remains bounded to the declared candidate language.
------------------------------------------------------------------------

preventionConsumerIndexed : Set
preventionConsumerIndexed = Sut.FirePreventionConsumerIndexed

attributionConsumerIndexed : Set
attributionConsumerIndexed = Sut.VapeFireAttributionConsumerIndexed

embeddedBatteryGapRetained : Set
embeddedBatteryGapRetained = Sut.EmbeddedBatterySchemeGapRetained

paretoNotAuthority : Set
paretoNotAuthority = Sut.ParetoFrontCreatesAuthority

boundedOnly : Set
boundedOnly = Sut.GlobalOptimalityFromDeclaredLanguage
