------------------------------------------------------------------------
-- Regression 1: the repeated public surface cannot recover its generation path.
------------------------------------------------------------------------

data RepeatedSurfaceCase : Set where
  repeatedFromMemory
  repeatedBySocialCopying
  repeatedByCitationCascade
  repeatedFromSharedScientificInput
  repeatedFromIndependentOrigins : RepeatedSurfaceCase

data RepeatedSurface : Set where sameRepeatedClaimSurface : RepeatedSurface
data GenerationMechanism : Set where
  memoryRetrieval
  socialTransmission
  citationCascade
  sharedScientificGenealogy
  independentEvidenceGeneration : GenerationMechanism

repeatedSurface : RepeatedSurfaceCase → RepeatedSurface
repeatedSurface _ = sameRepeatedClaimSurface

generationMechanism : RepeatedSurfaceCase → GenerationMechanism
generationMechanism repeatedFromMemory = memoryRetrieval
generationMechanism repeatedBySocialCopying = socialTransmission
generationMechanism repeatedByCitationCascade = citationCascade
generationMechanism repeatedFromSharedScientificInput = sharedScientificGenealogy
generationMechanism repeatedFromIndependentOrigins = independentEvidenceGeneration

repetitionMechanismDefect : INF.NonFactorabilityWitness repeatedSurface generationMechanism
repetitionMechanismDefect = INF.nonFactorabilityWitness
  repeatedFromMemory repeatedFromIndependentOrigins refl (λ ())

repeatedSurfaceCannotFactorGenerationMechanism :
  INF.FactorsThrough repeatedSurface generationMechanism → ⊥
repeatedSurfaceCannotFactorGenerationMechanism =
  INF.witnessRulesOutEveryFlatFactorisation repetitionMechanismDefect

------------------------------------------------------------------------
-- Regression 2: information-cascade classification cannot recover truth.
------------------------------------------------------------------------

data CascadeCase : Set where
  sameCascadeTrueClaim sameCascadeFalseClaim : CascadeCase

data CascadeSurface : Set where informationCascadeSurface : CascadeSurface
data ClaimTruth : Set where claimTrue claimFalse : ClaimTruth

cascadeSurface : CascadeCase → CascadeSurface
cascadeSurface _ = informationCascadeSurface

claimTruth : CascadeCase → ClaimTruth
claimTruth sameCascadeTrueClaim = claimTrue
claimTruth sameCascadeFalseClaim = claimFalse

cascadeTruthDefect : INF.NonFactorabilityWitness cascadeSurface claimTruth
cascadeTruthDefect = INF.nonFactorabilityWitness
  sameCascadeTrueClaim sameCascadeFalseClaim refl (λ ())

informationCascadeCannotFactorTruth :
  INF.FactorsThrough cascadeSurface claimTruth → ⊥
informationCascadeCannotFactorTruth =
  INF.witnessRulesOutEveryFlatFactorisation cascadeTruthDefect

------------------------------------------------------------------------
-- Regression 3: a dependency topology cannot by itself recover evidential
-- contribution. Dependence may be redundant, partially informative, or carry
-- distinct conditionally relevant information depending on the consumer.
------------------------------------------------------------------------

data DependencyTopologyCase : Set where
  sameCommonSourceFullyRedundant sameCommonSourcePartlyInformative : DependencyTopologyCase

data DependencyTopology : Set where sameCommonSourceTopology : DependencyTopology
data EvidenceContribution : Set where fullyRedundant partiallyInformative : EvidenceContribution

dependencyTopology : DependencyTopologyCase → DependencyTopology
dependencyTopology _ = sameCommonSourceTopology

evidenceContribution : DependencyTopologyCase → EvidenceContribution
evidenceContribution sameCommonSourceFullyRedundant = fullyRedundant
evidenceContribution sameCommonSourcePartlyInformative = partiallyInformative

dependencyContributionDefect : INF.NonFactorabilityWitness dependencyTopology evidenceContribution
dependencyContributionDefect = INF.nonFactorabilityWitness
  sameCommonSourceFullyRedundant sameCommonSourcePartlyInformative refl (λ ())

dependencyTopologyCannotFactorEvidenceContribution :
  INF.FactorsThrough dependencyTopology evidenceContribution → ⊥
dependencyTopologyCannotFactorEvidenceContribution =
  INF.witnessRulesOutEveryFlatFactorisation dependencyContributionDefect

