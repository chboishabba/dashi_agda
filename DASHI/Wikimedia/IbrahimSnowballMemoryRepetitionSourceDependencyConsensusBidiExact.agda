memoryLearningConstraint : DependencyConsensusReverseConstraint
memoryLearningConstraint = dependency-consensus-reverse-constraint
  "Memory / learning"
  "repeated retrieval, remembered semantic equality, latent state, context history and source of later information remain separate"
  false

scienceConstraint : DependencyConsensusReverseConstraint
scienceConstraint = dependency-consensus-reverse-constraint
  "Replication / reproducibility / scientific consensus"
  "same output, same method, independent team/data, common-source dependence, replication criterion and consensus remain separate"
  false

mediaConstraint : DependencyConsensusReverseConstraint
mediaConstraint = dependency-consensus-reverse-constraint
  "Media / social influence"
  "article/post count, originating report, copying, social transmission, audience exposure and independent corroboration remain separate"
  false

lawConstraint : DependencyConsensusReverseConstraint
lawConstraint = dependency-consensus-reverse-constraint
  "Evidence / testimony"
  "number of witnesses/reports, informational dependence, common interrogation/source, credibility and evidential contribution remain separate"
  false

