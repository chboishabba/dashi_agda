------------------------------------------------------------------------
-- IBRAHIM / MEMORY-REPETITION / SOURCE-DEPENDENCY / CONSENSUS BIDI
--
-- A repeated public surface may be generated by repeated retrieval from one
-- memory/source, social copying, common datasets/code, shared instruments, or
-- genuinely independent observations.  Multiplicity therefore cannot pay
-- evidential independence by itself.  Conversely, dependence does not make a
-- source worthless: it changes the evidential weight and must remain explicit.
------------------------------------------------------------------------

mkQid : String → String → Identity.ExternalIdentityDemand
mkQid label qid = Identity.mkOptionalIdentityDemand
  "Ibrahim memory/repetition/source-dependency/consensus BIDI"
  "verified external identity only"
  label Identity.wikidataQid
  (Identity.verified qid
    "Wikidata identity inspected 2026-09-11; identity does not create provenance independence, replication success, consensus truth or source authority")

memoryQid : Identity.ExternalIdentityDemand
memoryQid = MemoryReplication.memoryQid

reproducibilityQid : Identity.ExternalIdentityDemand
reproducibilityQid = MemoryReplication.reproducibilityQid

scientificConsensusQid : Identity.ExternalIdentityDemand
scientificConsensusQid = MemoryReplication.scientificConsensusQid

consensusQid : Identity.ExternalIdentityDemand
consensusQid = mkQid "consensus" "Q202722"

sourceIndependenceQid : Identity.ExternalIdentityDemand
sourceIndependenceQid = Identity.mkOptionalIdentityDemand
  "Ibrahim memory/repetition/source-dependency/consensus BIDI"
  "external concept identity"
  "evidential/source independence and common-source dependence"
  Identity.wikidataQid
  (Identity.unresolved
    "no exact general QID promoted; statistical independence, source independence, social independence and replication independence remain consumer-distinct")

scientificReplicationQid : Identity.ExternalIdentityDemand
scientificReplicationQid = Identity.mkOptionalIdentityDemand
  "Ibrahim memory/repetition/source-dependency/consensus BIDI"
  "external concept identity"
  "scientific replication / replicability distinct from reproducibility"
  Identity.wikidataQid
  (Identity.unresolved
    "Wikidata reproducibility Q1425625 is explicit and distinct from replicability; no separate exact replication identity promoted in this pass")

