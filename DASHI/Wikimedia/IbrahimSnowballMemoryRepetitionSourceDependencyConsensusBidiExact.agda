------------------------------------------------------------------------
-- Regression 1: count/repetition cannot recover dependency genealogy.
------------------------------------------------------------------------

data RepetitionCase : Set where
  sameCountIndependentOrigins sameCountOneCommonOrigin : RepetitionCase

data RepetitionSurface : Set where sameRepeatedClaimCount : RepetitionSurface
data DependencyGenealogy : Set where independentOrigins commonOriginDependence : DependencyGenealogy

repetitionSurface : RepetitionCase → RepetitionSurface
repetitionSurface _ = sameRepeatedClaimCount

dependencyGenealogy : RepetitionCase → DependencyGenealogy
dependencyGenealogy sameCountIndependentOrigins = independentOrigins
dependencyGenealogy sameCountOneCommonOrigin = commonOriginDependence

repetitionDependencyDefect : INF.NonFactorabilityWitness repetitionSurface dependencyGenealogy
repetitionDependencyDefect = INF.nonFactorabilityWitness
  sameCountIndependentOrigins sameCountOneCommonOrigin refl (λ ())

repetitionCountCannotFactorDependency :
  INF.FactorsThrough repetitionSurface dependencyGenealogy → ⊥
repetitionCountCannotFactorDependency =
  INF.witnessRulesOutEveryFlatFactorisation repetitionDependencyDefect

------------------------------------------------------------------------
-- Regression 2: agreement surface cannot recover independent consensus.
------------------------------------------------------------------------

data AgreementCase : Set where
  sameAgreementIndependentConsensus sameAgreementEchoConsensus : AgreementCase

data AgreementSurface : Set where sameObservedAgreement : AgreementSurface
data ConsensusIndependence : Set where independentlySupportedConsensus echoOrCommonSourceConsensus : ConsensusIndependence

agreementSurface : AgreementCase → AgreementSurface
agreementSurface _ = sameObservedAgreement

consensusIndependence : AgreementCase → ConsensusIndependence
consensusIndependence sameAgreementIndependentConsensus = independentlySupportedConsensus
consensusIndependence sameAgreementEchoConsensus = echoOrCommonSourceConsensus

agreementIndependenceDefect : INF.NonFactorabilityWitness agreementSurface consensusIndependence
agreementIndependenceDefect = INF.nonFactorabilityWitness
  sameAgreementIndependentConsensus sameAgreementEchoConsensus refl (λ ())

agreementCannotFactorIndependentConsensus :
  INF.FactorsThrough agreementSurface consensusIndependence → ⊥
agreementCannotFactorIndependentConsensus =
  INF.witnessRulesOutEveryFlatFactorisation agreementIndependenceDefect

------------------------------------------------------------------------
-- Regression 3: reproduced public output cannot recover latent generation path.
-- This is the direct Learning/Memory Hyperfabric cross-pollination: equal public
-- remembered PNFs can coexist with different underlying states; equal outputs
-- likewise do not establish independent generation.
------------------------------------------------------------------------

data OutputCase : Set where
  sameOutputIndependentGeneration sameOutputSharedGenerationPath : OutputCase

data OutputSurface : Set where samePublicOutput : OutputSurface
data GenerationPath : Set where independentGeneration sharedGenerationPath : GenerationPath

outputSurface : OutputCase → OutputSurface
outputSurface _ = samePublicOutput

generationPath : OutputCase → GenerationPath
generationPath sameOutputIndependentGeneration = independentGeneration
generationPath sameOutputSharedGenerationPath = sharedGenerationPath

outputGenerationDefect : INF.NonFactorabilityWitness outputSurface generationPath
outputGenerationDefect = INF.nonFactorabilityWitness
  sameOutputIndependentGeneration sameOutputSharedGenerationPath refl (λ ())

sameOutputCannotFactorGenerationIndependence :
  INF.FactorsThrough outputSurface generationPath → ⊥
sameOutputCannotFactorGenerationIndependence =
  INF.witnessRulesOutEveryFlatFactorisation outputGenerationDefect

------------------------------------------------------------------------
-- Regression 4: dependency status cannot recover evidential value as zero/nonzero.
-- Dependence requires modelling; it does not justify silently discarding all
-- dependent evidence, just as common context in memory does not erase the event.
------------------------------------------------------------------------

data DependentEvidenceCase : Set where
  sameDependentStatusAddsSomeInformation sameDependentStatusFullyRedundant : DependentEvidenceCase

data DependentSurface : Set where dependentEvidence : DependentSurface
data EvidentialContribution : Set where partialInformation fullyRedundant : EvidentialContribution

dependentSurface : DependentEvidenceCase → DependentSurface
dependentSurface _ = dependentEvidence

evidentialContribution : DependentEvidenceCase → EvidentialContribution
evidentialContribution sameDependentStatusAddsSomeInformation = partialInformation
evidentialContribution sameDependentStatusFullyRedundant = fullyRedundant

dependencyValueDefect : INF.NonFactorabilityWitness dependentSurface evidentialContribution
dependencyValueDefect = INF.nonFactorabilityWitness
  sameDependentStatusAddsSomeInformation sameDependentStatusFullyRedundant refl (λ ())

dependencyLabelCannotFactorEvidentialContribution :
  INF.FactorsThrough dependentSurface evidentialContribution → ⊥
dependencyLabelCannotFactorEvidentialContribution =
  INF.witnessRulesOutEveryFlatFactorisation dependencyValueDefect

