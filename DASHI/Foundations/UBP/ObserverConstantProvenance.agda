module DASHI.Foundations.UBP.ObserverConstantProvenance where

open import Agda.Builtin.Bool using (Bool; false; true)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.String using (String)
open import Data.Rational using (ℚ; _-_; _/_)

import DASHI.Core.GenericReceipt as GenericReceipt
import DASHI.Foundations.UBP.Pi50ConvergentTable as Pi50

data ObserverConstantVersion : Set where
  craig-v5-4-1-source : ObserverConstantVersion
  canonical-pi-cf-50 : ObserverConstantVersion
  exact-pi-target : ObserverConstantVersion

data RationalObserverVersion : Set where
  craig-rational : RationalObserverVersion
  canonical-rational : RationalObserverVersion

observerRational : RationalObserverVersion → ℚ
observerRational craig-rational = Pi50.sourceY50
observerRational canonical-rational = Pi50.canonicalY50

versionOfRational :
  RationalObserverVersion →
  ObserverConstantVersion
versionOfRational craig-rational = craig-v5-4-1-source
versionOfRational canonical-rational = canonical-pi-cf-50

craigObserverNormalForm : ℚ
craigObserverNormalForm =
  10678195081323867029398952980491706367345312803032847723391 /
  40344489343054752407088436891842371820968160890283666757563

canonicalObserverNormalForm : ℚ
canonicalObserverNormalForm =
  85587627775920406939229606214235442123216034256580776169 /
  323368238771197016635670695332535842359492259206719999923

craigObserverExact :
  observerRational craig-rational ≡ craigObserverNormalForm
craigObserverExact = Pi50.sourceY50Normalises

canonicalObserverExact :
  observerRational canonical-rational ≡ canonicalObserverNormalForm
canonicalObserverExact = Pi50.canonicalY50Normalises

observerVersionDelta : ℚ
observerVersionDelta =
  observerRational craig-rational -
  observerRational canonical-rational

observerVersionDeltaNormalForm : ℚ
observerVersionDeltaNormalForm =
  2734787287797861895878337337413165344545354810381555572709194 /
  1449569606998549182495542391376708973611508633517180526971395851214621946728005627560091575061157712043175668851961

observerVersionDeltaExact :
  observerVersionDelta ≡ observerVersionDeltaNormalForm
observerVersionDeltaExact = refl

record VersionedObserverClaim : Set where
  constructor versionedObserverClaim
  field
    claimName : String
    consumedVersion : ObserverConstantVersion
    reproducesAttributedUBP : Bool
    usesCanonicalPiCoefficients : Bool
    claimsExactIrrationalTarget : Bool
    reading : String

craigReproductionClaim : VersionedObserverClaim
craigReproductionClaim =
  versionedObserverClaim
    "UBP v5.4.1 numerical reproduction"
    craig-v5-4-1-source
    true
    false
    false
    "reproduces the exact rational generated by the attributed source table; it does not rename that value a canonical pi convergent or the exact target"

canonicalFiniteApproximationClaim : VersionedObserverClaim
canonicalFiniteApproximationClaim =
  versionedObserverClaim
    "canonical 50-coefficient continued-fraction approximation"
    canonical-pi-cf-50
    false
    true
    false
    "uses OEIS-aligned coefficients and remains a finite rational approximation"

exactObserverTargetClaim : VersionedObserverClaim
exactObserverTargetClaim =
  versionedObserverClaim
    "exact observer target Y = pi/(pi^2+2)"
    exact-pi-target
    false
    false
    true
    "denotes the irrational target through an exact-real interface and is not definitionally identified with either finite rational"

record ObserverProvenanceForkCertificate : Set where
  constructor observerProvenanceForkCertificate
  field
    attributedVersionRetained : Bool
    attributedVersionRetainedIsTrue :
      attributedVersionRetained ≡ true
    canonicalVersionRetained : Bool
    canonicalVersionRetainedIsTrue :
      canonicalVersionRetained ≡ true
    exactTargetSeparated : Bool
    exactTargetSeparatedIsTrue :
      exactTargetSeparated ≡ true
    sourceCanonicalDelta :
      observerVersionDelta ≡ observerVersionDeltaNormalForm
    downstreamClaimsMustSelectVersion : Bool
    downstreamClaimsMustSelectVersionIsTrue :
      downstreamClaimsMustSelectVersion ≡ true
    silentUpstreamReplacementPermitted : Bool
    silentUpstreamReplacementPermittedIsFalse :
      silentUpstreamReplacementPermitted ≡ false

canonicalObserverProvenanceFork :
  ObserverProvenanceForkCertificate
canonicalObserverProvenanceFork =
  observerProvenanceForkCertificate
    true refl
    true refl
    true refl
    observerVersionDeltaExact
    true refl
    false refl

observerConstantProvenanceReceipt : GenericReceipt.GenericReceipt
observerConstantProvenanceReceipt =
  GenericReceipt.mkNonPromotingReceipt
    "versioned UBP observer constant provenance fork"
    "DASHI.Foundations.UBP.ObserverConstantProvenance"
    "canonicalObserverProvenanceFork"
    "the attributed Craig v5.4.1 rational, canonical 50-coefficient rational, exact target identity and exact rational sensitivity delta are first-class and downstream claims must select a version"
    "neither rational approximation is promoted to exact pi/Y, and the historical source value is not silently overwritten"
    "agda -i . DASHI/Foundations/UBP/ObserverConstantProvenance.agda"

observerConstantProvenanceReceiptNonPromoting :
  GenericReceipt.promotesClaim observerConstantProvenanceReceipt ≡ false
observerConstantProvenanceReceiptNonPromoting =
  GenericReceipt.promotesClaimIsFalse observerConstantProvenanceReceipt
