module DASHI.Foundations.Base369Ternary27OperatorOrbitQuotientExact where

------------------------------------------------------------------------
-- STABILISER-QUALIFIED OPERATOR ORBITS / QUOTIENT CODES
--
-- This owner continues the operator-bearing stabiliser layer by recording the
-- reachable fine points generated by the currently admissible operator palette.
-- It uses finite orbit CODES rather than asserting a completed group-action
-- quotient construction.  The code is intentionally base-dependent.
------------------------------------------------------------------------

open import DASHI.Core.Prelude

import DASHI.Foundations.Base369Ternary27HypervoxelFabricGeometryExact as Geometry
import DASHI.Foundations.Base369Ternary27StabiliserOperatorHolonomyExact as Operator
import DASHI.Foundations.Base369Ternary27StratumStabiliserFibreAdmissibilityExact as Sector

------------------------------------------------------------------------
-- 1. Coarse orbit-language codes by exact base.
------------------------------------------------------------------------

data OrbitLanguage : Set where
  identityOnlyOrbit
  swapGeneratedOrbit
  swapRotateGeneratedOrbit
  : OrbitLanguage

orbitLanguageAtBase : Geometry.Ternary27Point -> OrbitLanguage
orbitLanguageAtBase base with Sector.sectorClassAtBase base
... | Sector.fullySymmetricSector = swapRotateGeneratedOrbit
... | Sector.pairSymmetricSector = swapGeneratedOrbit
... | Sector.genericSector = identityOnlyOrbit

positiveCornerOrbitLanguage :
  orbitLanguageAtBase Geometry.positiveCorner ≡ swapRotateGeneratedOrbit
positiveCornerOrbitLanguage = refl

sameSignEdgeOrbitLanguage :
  orbitLanguageAtBase Sector.sameSignEdge ≡ swapGeneratedOrbit
sameSignEdgeOrbitLanguage = refl

oppositeSignEdgeOrbitLanguage :
  orbitLanguageAtBase Sector.oppositeSignEdge ≡ identityOnlyOrbit
oppositeSignEdgeOrbitLanguage = refl

------------------------------------------------------------------------
-- 2. The native edge -> face transition enlarges the operator orbit language.
------------------------------------------------------------------------

transitionChangesOrbitLanguage :
  orbitLanguageAtBase Sector.oppositeSignEdge ≡
  orbitLanguageAtBase Operator.positiveXFace -> ⊥
transitionChangesOrbitLanguage ()

------------------------------------------------------------------------
-- 3. Quotient code keeps the exact base separate from its orbit language.
------------------------------------------------------------------------

record OperatorOrbitQuotientCode : Set where
  constructor operator-orbit-quotient-code
  field
    exactBase : Geometry.Ternary27Point
    orbitLanguage : OrbitLanguage
    orbitLanguageExact : orbitLanguage ≡ orbitLanguageAtBase exactBase

open OperatorOrbitQuotientCode public

encodeOperatorOrbit : Geometry.Ternary27Point -> OperatorOrbitQuotientCode
encodeOperatorOrbit base = operator-orbit-quotient-code base (orbitLanguageAtBase base) refl

------------------------------------------------------------------------
-- 4. Boundary.
------------------------------------------------------------------------

record OperatorOrbitQuotientBoundary : Set where
  constructor operator-orbit-quotient-boundary
  field
    orbitLanguageDependsOnExactBase : Bool
    nativeTransitionMayChangeOrbitLanguage : Bool
    orbitCodeIsFullGroupActionQuotient : Bool
    orbitLanguageDeterminesFineFibrePoint : Bool
    orbitLanguageDeterminesMonsterRepresentation : Bool

canonicalOperatorOrbitQuotientBoundary : OperatorOrbitQuotientBoundary
canonicalOperatorOrbitQuotientBoundary =
  operator-orbit-quotient-boundary true true false false false
