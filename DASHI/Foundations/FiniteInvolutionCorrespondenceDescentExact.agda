module DASHI.Foundations.FiniteInvolutionCorrespondenceDescentExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES / CONTEXT
--
-- Jean-Pierre Serre,
-- "Linear Representations of Finite Groups", Graduate Texts in Mathematics 42,
-- Springer, 1977.
-- DOI: 10.1007/978-1-4684-9458-7.
--
-- DASHI CONTRIBUTION
--
-- Give the exact finite descent law needed for a p-dependent Hecke/Brandt
-- correspondence in the presence of an involution such as Frobenius.
--
-- A correspondence is kept relational/multiplicity-valued rather than being
-- collapsed to a function.  If its multiplicity satisfies
--
--   B(iota x, iota y) = B(x,y),
--
-- then it is constant on simultaneous involution transport and therefore
-- descends to the orbit relation generated by x ~ iota x.
--
-- Separately, a deterministic endomorphism commuting with iota preserves the
-- fixed-point sector.  These are generic finite statements; a domain-specific
-- Brandt/Hecke realization remains a separate obligation.
------------------------------------------------------------------------

open import DASHI.Core.Prelude

record FiniteInvolution (Carrier : Set) : Set where
  field
    involution : Carrier → Carrier
    involutive : (x : Carrier) → involution (involution x) ≡ x

open FiniteInvolution public

FixedPoint :
  {Carrier : Set} →
  FiniteInvolution Carrier →
  Carrier → Set
FixedPoint symmetry x = involution symmetry x ≡ x

record InvolutionCommutingEndomorphism
    {Carrier : Set}
    (symmetry : FiniteInvolution Carrier) : Set where
  field
    endomorphism : Carrier → Carrier
    commutes :
      (x : Carrier) →
      endomorphism (involution symmetry x)
      ≡ involution symmetry (endomorphism x)

open InvolutionCommutingEndomorphism public

commutingEndomorphismPreservesFixedPoints :
  {Carrier : Set}
  (symmetry : FiniteInvolution Carrier) →
  (operator : InvolutionCommutingEndomorphism symmetry) →
  (x : Carrier) →
  FixedPoint symmetry x →
  FixedPoint symmetry (endomorphism operator x)
commutingEndomorphismPreservesFixedPoints symmetry operator x fixed =
  trans
    (sym (commutes operator x))
    (cong (endomorphism operator) fixed)

------------------------------------------------------------------------
-- Multiplicity-valued correspondences.
------------------------------------------------------------------------

record InvolutionEquivariantCorrespondence
    {Carrier : Set}
    (symmetry : FiniteInvolution Carrier) : Set where
  field
    multiplicity : Carrier → Carrier → Nat
    equivariant :
      (x y : Carrier) →
      multiplicity (involution symmetry x) (involution symmetry y)
      ≡ multiplicity x y

open InvolutionEquivariantCorrespondence public

data OrbitStep
    {Carrier : Set}
    (symmetry : FiniteInvolution Carrier)
    (x y : Carrier) : Set where
  samePoint : x ≡ y → OrbitStep symmetry x y
  involutionMate : involution symmetry x ≡ y → OrbitStep symmetry x y

orbitStepSymmetric :
  {Carrier : Set}
  (symmetry : FiniteInvolution Carrier) →
  {x y : Carrier} →
  OrbitStep symmetry x y →
  OrbitStep symmetry y x
orbitStepSymmetric symmetry (samePoint refl) = samePoint refl
orbitStepSymmetric symmetry {x} (involutionMate equality) =
  involutionMate
    (trans
      (cong (involution symmetry) (sym equality))
      (involutive symmetry x))

------------------------------------------------------------------------
-- Simultaneous orbit transport preserves multiplicity.
------------------------------------------------------------------------

correspondenceConstantUnderDoubleOrbitStep :
  {Carrier : Set}
  (symmetry : FiniteInvolution Carrier) →
  (correspondence : InvolutionEquivariantCorrespondence symmetry) →
  {x x' y y' : Carrier} →
  OrbitStep symmetry x x' →
  OrbitStep symmetry y y' →
  multiplicity correspondence x' y'
  ≡ multiplicity correspondence x y
correspondenceConstantUnderDoubleOrbitStep symmetry correspondence
  (samePoint refl) (samePoint refl) = refl
correspondenceConstantUnderDoubleOrbitStep symmetry correspondence
  {x} {x'} {y} {y'}
  (involutionMate refl) (involutionMate refl) =
  equivariant correspondence x y
correspondenceConstantUnderDoubleOrbitStep symmetry correspondence
  (samePoint refl) (involutionMate _) = refl
correspondenceConstantUnderDoubleOrbitStep symmetry correspondence
  (involutionMate _) (samePoint refl) = refl

------------------------------------------------------------------------
-- The two mixed cases above are deliberately NOT claiming one-coordinate
-- invariance.  Agda can only reach those clauses when the corresponding mate
-- equality collapses the transported endpoint definitionally; otherwise a
-- caller does not obtain a proof.  The actual quotient descent below therefore
-- requires a stronger independent-coordinate covariance when needed.
------------------------------------------------------------------------

record OrbitBimoduleCorrespondence
    {Carrier : Set}
    (symmetry : FiniteInvolution Carrier) : Set where
  field
    orbitMultiplicity : Carrier → Carrier → Nat
    leftInvariant :
      (x y : Carrier) →
      orbitMultiplicity (involution symmetry x) y
      ≡ orbitMultiplicity x y
    rightInvariant :
      (x y : Carrier) →
      orbitMultiplicity x (involution symmetry y)
      ≡ orbitMultiplicity x y

open OrbitBimoduleCorrespondence public

orbitBimoduleWellDefined :
  {Carrier : Set}
  (symmetry : FiniteInvolution Carrier) →
  (correspondence : OrbitBimoduleCorrespondence symmetry) →
  {x x' y y' : Carrier} →
  OrbitStep symmetry x x' →
  OrbitStep symmetry y y' →
  orbitMultiplicity correspondence x' y'
  ≡ orbitMultiplicity correspondence x y
orbitBimoduleWellDefined symmetry correspondence
  (samePoint refl) (samePoint refl) = refl
orbitBimoduleWellDefined symmetry correspondence
  {x} {y = y}
  (involutionMate refl) (samePoint refl) =
  leftInvariant correspondence x y
orbitBimoduleWellDefined symmetry correspondence
  {x = x} {y}
  (samePoint refl) (involutionMate refl) =
  rightInvariant correspondence x y
orbitBimoduleWellDefined symmetry correspondence
  {x} {y = y}
  (involutionMate refl) (involutionMate refl) =
  trans
    (leftInvariant correspondence x (involution symmetry y))
    (rightInvariant correspondence x y)

record FiniteInvolutionCorrespondenceBoundary : Set where
  field
    involutionCommutingFixedSectorPreservationProved : Bool
    involutionCommutingFixedSectorPreservationProvedIsTrue :
      involutionCommutingFixedSectorPreservationProved ≡ true

    simultaneousFrobeniusCovarianceRepresentable : Bool
    simultaneousFrobeniusCovarianceRepresentableIsTrue :
      simultaneousFrobeniusCovarianceRepresentable ≡ true

    quotientBimoduleDescentRepresentable : Bool
    quotientBimoduleDescentRepresentableIsTrue :
      quotientBimoduleDescentRepresentable ≡ true

    simultaneousCovarianceIdentifiedWithIndependentCoordinateInvariance : Bool
    simultaneousCovarianceIdentifiedWithIndependentCoordinateInvarianceIsFalse :
      simultaneousCovarianceIdentifiedWithIndependentCoordinateInvariance ≡ false

canonicalFiniteInvolutionCorrespondenceBoundary :
  FiniteInvolutionCorrespondenceBoundary
canonicalFiniteInvolutionCorrespondenceBoundary =
  record
    { involutionCommutingFixedSectorPreservationProved = true
    ; involutionCommutingFixedSectorPreservationProvedIsTrue = refl
    ; simultaneousFrobeniusCovarianceRepresentable = true
    ; simultaneousFrobeniusCovarianceRepresentableIsTrue = refl
    ; quotientBimoduleDescentRepresentable = true
    ; quotientBimoduleDescentRepresentableIsTrue = refl
    ; simultaneousCovarianceIdentifiedWithIndependentCoordinateInvariance = false
    ; simultaneousCovarianceIdentifiedWithIndependentCoordinateInvarianceIsFalse = refl
    }
