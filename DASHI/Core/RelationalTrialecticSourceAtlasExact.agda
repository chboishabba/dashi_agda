murgueitioThreatEmotionRecognition : Source.AttributedSource
murgueitioThreatEmotionRecognition =
  Source.mkDOISource
    "Nicolas Murgueitio; Margaret A. Sheridan; Michelle Shipkova; Amy G. Halberstadt; Patricia T. Garrett-Peters; Cathi B. Propper"
    "Developmental impacts of deprivation and threat on emotion recognition"
    "Neurotoxicology and Teratology 109:107446"
    "2025"
    "10.1016/j.ntt.2025.107446"
    "https://doi.org/10.1016/j.ntt.2025.107446"
    Source.academicArticleSource
    "supports separating global emotion-recognition performance from threat-specific anger bias; it does not establish that threat exposure improves global social cognition"
    Source.publicAttribution

brodbeckIntegrativeComplexity : Source.AttributedSource
brodbeckIntegrativeComplexity =
  Source.mkDOISource
    "Felix C. Brodbeck; Katharina G. Kugler; Josef A. Fischer; Joerg Heinze; Dorothee Fischer"
    "Group-level integrative complexity: Enhancing differentiation and integration in group decision-making"
    "Group Processes & Intergroup Relations 24(1)"
    "2021"
    "10.1177/1368430219892698"
    "https://doi.org/10.1177/1368430219892698"
    Source.academicArticleSource
    "supports the empirical distinction between differentiation and integration of perspectives; DASHI does not identify its richer relational carrier with the psychometric construct"
    Source.publicAttribution

lepperGreeneNisbettOverjustification : Source.AttributedSource
lepperGreeneNisbettOverjustification =
  Source.mkDOISource
    "Mark R. Lepper; David Greene; Richard E. Nisbett"
    "Undermining children's intrinsic interest with extrinsic reward: A test of the overjustification hypothesis"
