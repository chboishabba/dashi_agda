module DASHI.Core.RelationalTrialecticSourceAtlasExact where

------------------------------------------------------------------------
-- RELATIONAL / TRIALECTIC COGNITION SOURCE ATLAS
--
-- ATTRIBUTION RULE
--
-- Every row below has a bounded source role.  A citation records provenance
-- and motivates an empirical/theoretical interface; it does NOT import a
-- theorem, create authority, prove the DASHI construction, or license a
-- stronger causal claim.  Numeric encodings, 3x3 charts, sheaf/descent
-- constructions, non-factorability witnesses and rechartings are DASHI
-- contributions unless a source explicitly owns them.
------------------------------------------------------------------------

open import DASHI.Core.Prelude

import DASHI.Core.AttributedSourceCore as Source

andersenChenRelationalSelf : Source.AttributedSource
andersenChenRelationalSelf =
  Source.mkDOISource
    "Susan M. Andersen; Serena Chen"
    "The relational self: an interpersonal social-cognitive theory"
    "Psychological Review 109(4):619-645"
    "2002"
    "10.1037/0033-295X.109.4.619"
    "https://doi.org/10.1037/0033-295X.109.4.619"
    Source.academicArticleSource
    "supports relationship-indexed self-representation and contextual activation of relational selves; it does not assert a sheaf, stalk, Grothendieck topology, 369 carrier, or trauma-specific causal law"
    Source.publicAttribution

eyalSteffelEpleyPerspectiveGetting : Source.AttributedSource
eyalSteffelEpleyPerspectiveGetting =
  Source.mkDOISource
    "Tal Eyal; Mary Steffel; Nicholas Epley"
    "Perspective mistaking: Accurately understanding the mind of another requires getting perspective, not taking perspective"
    "Journal of Personality and Social Psychology 114(4):547-571"
    "2018"
    "10.1037/pspa0000115"
    "https://doi.org/10.1037/pspa0000115"
    Source.academicArticleSource
    "supports a boundary between perspective-model activity and interpersonal accuracy; DASHI supplies the non-factorability and calibration theorems"
    Source.publicAttribution

proninGilovichRossBias : Source.AttributedSource
proninGilovichRossBias =
  Source.mkDOISource
    "Emily Pronin; Thomas Gilovich; Lee Ross"
    "Objectivity in the eye of the beholder: divergent perceptions of bias in self versus others"
    "Psychological Review 111(3):781-799"
    "2004"
    "10.1037/0033-295X.111.3.781"
    "https://doi.org/10.1037/0033-295X.111.3.781"
    Source.academicArticleSource
    "supports a bounded empirical motivation for self/other asymmetry and naive-realist disagreement; it does not prove that an other is a geometric antipode or logical negation"
    Source.publicAttribution

fonagyLuytenMentalizingDimensions : Source.AttributedSource
fonagyLuytenMentalizingDimensions =
  Source.mkDOISource
    "Peter Fonagy; Patrick Luyten; Elizabeth Allison; Chloe Campbell"
    "The Mentalizing Approach to Psychopathology: State of the Art and Future Directions"
    "Annual Review of Clinical Psychology 16:297-325"
    "2020"
    "10.1146/annurev-clinpsy-071919-015355"
    "https://doi.org/10.1146/annurev-clinpsy-071919-015355"
    Source.academicArticleSource
    "supports treating self- and other-oriented mentalizing as distinguishable dimensions; it does not identify high mental-state attribution with accuracy"
    Source.publicAttribution

mclarenHypermentalizing : Source.AttributedSource
mclarenHypermentalizing =
  Source.mkDOISource
    "Victoria McLaren; Margaret Gallagher; Christopher J. Hopwood; Carla Sharp"
    "Hypermentalizing and Borderline Personality Disorder: A Meta-Analytic Review"
    "American Journal of Psychotherapy 75(1):21-31"
    "2022"
    "10.1176/appi.psychotherapy.20210018"
    "https://doi.org/10.1176/appi.psychotherapy.20210018"
    Source.academicArticleSource
    "supports the calibration firewall that more mental-state attribution is not automatically more accurate modelling; no diagnosis is inferred by DASHI"
    Source.publicAttribution

yangHuangMaltreatmentMentalizing : Source.AttributedSource
yangHuangMaltreatmentMentalizing =
  Source.mkDOISource
    "Yunqing Yang; Yuefeng Huang"
    "Childhood maltreatment and mentalizing capacity: A meta-analysis"
    "Child Abuse & Neglect 149:106623"
    "2024"
    "10.1016/j.chiabu.2023.106623"
    "https://doi.org/10.1016/j.chiabu.2023.106623"
    Source.academicArticleSource
    "supports a population-level boundary against promoting childhood maltreatment to generalized superior mentalizing; association does not determine an individual state or mechanism"
    Source.publicAttribution

schrodtTriangulation : Source.AttributedSource
schrodtTriangulation =
  Source.mkDOISource
    "Paul Schrodt"
    "Interparental conflict and parent-child triangulation: a meta-analytical review of children feeling caught between parents"
    "Human Communication Research 52(2):77-89"
    "2026"
    "10.1093/hcr/hqaf018"
    "https://doi.org/10.1093/hcr/hqaf018"
    Source.academicArticleSource
    "supports a bounded association between interparental conflict and children feeling caught/triangulated; it does not establish enhanced mediation ability"
    Source.publicAttribution

schrodtDistress : Source.AttributedSource
schrodtDistress =
  Source.mkDOISource
    "Paul Schrodt"
    "Parent-child triangulation and children's adjustment: a meta-analysis of children feeling caught and symptoms of distress"
    "Annals of the International Communication Association"
    "2026"
    "10.1093/anncom/wlag024"
    "https://doi.org/10.1093/anncom/wlag024"
    Source.academicArticleSource
    "supports treating feeling-caught burden and distress as retained coordinates rather than assuming mediation skill is a free benefit"
    Source.publicAttribution

kenyBanerjeeParentification : Source.AttributedSource
kenyBanerjeeParentification =
  Source.mkDOISource
    "Shivani Keny; Bidisha Banerjee"
    "Losing childhood and gaining responsibilities: a PRISMA based systematic review on consequences of parentification"
    "Children and Youth Services Review 185:108919"
    "2026"
    "10.1016/j.childyouth.2026.108919"
    "https://doi.org/10.1016/j.childyouth.2026.108919"
    Source.academicArticleSource
    "supports a burden/context boundary for parentification and heterogeneous outcomes; it does not prove a monotone cognitive enhancement"
