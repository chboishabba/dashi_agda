module DASHI.Core.TechnicalDependencyHypergraphExact where

------------------------------------------------------------------------
-- SOURCE-TYPED TECHNICAL DEPENDENCY HYPERGRAPH
--
-- Purpose: distinguish genuine technical/programmatic intersections from
-- weak adjacency generated by common employer, common institutional family,
-- repeated media narrative, or unsourced domain resemblance.
------------------------------------------------------------------------

open import DASHI.Core.Prelude
open import Agda.Builtin.String using (String)

------------------------------------------------------------------------
-- Node and edge types.
------------------------------------------------------------------------

data TechnicalNodeKind : Set where
  personNode
  technologyNode
  programmeNode
  institutionNode
  fundingOrContractNode
  publicationOrPatentNode
  facilityNode
  : TechnicalNodeKind

record TechnicalNode : Set where
  constructor technical-node
  field
    nodeKind : TechnicalNodeKind
    nodeLabel : String

open TechnicalNode public

data TechnicalEdgeKind : Set where
  workedOn
  authoredOrInvented
  ledOrDirected
  programmeUsesTechnology
  programmeHostedAtFacility
  institutionRunsProgramme
  programmeFundedBy
  documentedTechnologyDomainBridge
  sameInstitutionOnly
  sameInstitutionalFamilyOnly
  mediaAssociatedOnly
  reportedRelationshipOnly
  domainSimilarityOnly
  : TechnicalEdgeKind

data EdgeStrength : Set where
  primaryTechnicalReceipt
  primaryRoleReceipt
  officialProgrammeReceipt
  boundedSecondaryReceipt
  mediaNarrativeReceipt
  unresolvedReceipt
  : EdgeStrength

record TechnicalHyperedge : Set where
  constructor technical-hyperedge
  field
    endpoints : List TechnicalNode
    edgeKind : TechnicalEdgeKind
    edgeStrength : EdgeStrength
    provenanceReference : String
    boundedReading : String

open TechnicalHyperedge public

------------------------------------------------------------------------
-- Quotient policy.
--
-- A documentedTechnologyDomainBridge is stronger than mere domain similarity:
-- an authoritative technical source explicitly says the two technical domains
-- share an engineering interface.  It survives the technical quotient but does
-- NOT establish that particular people shared a programme, employer, contract,
-- or historical implementation.
------------------------------------------------------------------------

data QuotientDisposition : Set where
  survivesTechnicalQuotient
  erasedAsInstitutionOnly
  erasedAsMediaOnly
  erasedAsReportedRelationshipOnly
  retainedAsUnresolvedCandidate
  : QuotientDisposition

quotientDisposition : TechnicalHyperedge → QuotientDisposition
quotientDisposition edge with edgeKind edge
... | sameInstitutionOnly = erasedAsInstitutionOnly
... | sameInstitutionalFamilyOnly = erasedAsInstitutionOnly
... | mediaAssociatedOnly = erasedAsMediaOnly
... | reportedRelationshipOnly = erasedAsReportedRelationshipOnly
... | domainSimilarityOnly = retainedAsUnresolvedCandidate
... | workedOn = survivesTechnicalQuotient
... | authoredOrInvented = survivesTechnicalQuotient
... | ledOrDirected = survivesTechnicalQuotient
... | programmeUsesTechnology = survivesTechnicalQuotient
... | programmeHostedAtFacility = survivesTechnicalQuotient
... | institutionRunsProgramme = survivesTechnicalQuotient
... | programmeFundedBy = survivesTechnicalQuotient
... | documentedTechnologyDomainBridge = survivesTechnicalQuotient

record TechnicalDependencyBoundary : Set where
  constructor technical-dependency-boundary
  field
    sameInstitutionEstablishesTechnicalDependency : Bool
    sameInstitutionEstablishesTechnicalDependencyIsFalse :
      sameInstitutionEstablishesTechnicalDependency ≡ false

    sameMediaClusterEstablishesTechnicalDependency : Bool
    sameMediaClusterEstablishesTechnicalDependencyIsFalse :
      sameMediaClusterEstablishesTechnicalDependency ≡ false

    domainSimilarityEstablishesSharedProgramme : Bool
    domainSimilarityEstablishesSharedProgrammeIsFalse :
      domainSimilarityEstablishesSharedProgramme ≡ false

    documentedDomainBridgeSurvivesTechnicalQuotient : Bool
    documentedDomainBridgeSurvivesTechnicalQuotientIsTrue :
      documentedDomainBridgeSurvivesTechnicalQuotient ≡ true

    documentedDomainBridgeImpliesNamedPeopleSharedProgramme : Bool
    documentedDomainBridgeImpliesNamedPeopleSharedProgrammeIsFalse :
      documentedDomainBridgeImpliesNamedPeopleSharedProgramme ≡ false

    primaryPersonWorkReceiptSurvivesQuotient : Bool
    primaryPersonWorkReceiptSurvivesQuotientIsTrue :
      primaryPersonWorkReceiptSurvivesQuotient ≡ true

    programmeTechnologyReceiptSurvivesQuotient : Bool
    programmeTechnologyReceiptSurvivesQuotientIsTrue :
      programmeTechnologyReceiptSurvivesQuotient ≡ true

    sharedTechnicalDomainImpliesSharedAdversary : Bool
    sharedTechnicalDomainImpliesSharedAdversaryIsFalse :
      sharedTechnicalDomainImpliesSharedAdversary ≡ false

canonicalTechnicalDependencyBoundary : TechnicalDependencyBoundary
canonicalTechnicalDependencyBoundary =
  technical-dependency-boundary
    false refl
    false refl
    false refl
    true refl
    false refl
    true refl
    true refl
    false refl

------------------------------------------------------------------------
-- A surviving intersection needs a shared non-erased technical/program node,
-- or a documented engineering-domain bridge with its narrower semantics.
------------------------------------------------------------------------

record SurvivingTechnicalIntersection : Set₁ where
  constructor surviving-technical-intersection
  field
    leftEdge : TechnicalHyperedge
    rightEdge : TechnicalHyperedge
    sharedTechnicalObject : TechnicalNode
    leftSurvives : quotientDisposition leftEdge ≡ survivesTechnicalQuotient
    rightSurvives : quotientDisposition rightEdge ≡ survivesTechnicalQuotient
    intersectionReference : String

open SurvivingTechnicalIntersection public

record CandidateDomainAdjacency : Set₁ where
  constructor candidate-domain-adjacency
  field
    leftObject : TechnicalNode
    rightObject : TechnicalNode
    commonDomain : String
    currentStatus : String
    discriminatorNeeded : String

open CandidateDomainAdjacency public
