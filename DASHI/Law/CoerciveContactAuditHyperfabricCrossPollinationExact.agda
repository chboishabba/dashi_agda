module DASHI.Law.CoerciveContactAuditHyperfabricCrossPollinationExact where

open import DASHI.Core.Prelude
open import Agda.Builtin.String using (String)
import DASHI.Core.IntersectionalNonFactorability as NF
import DASHI.Law.QueenslandWandingReachabilityBidiExact as Wand
import DASHI.Law.LowTraceCoerciveForceNonReconstructionExact as Force

------------------------------------------------------------------------
-- Cross-pollination theorem shape:
--   an intervention may expand the reachable enforcement cone while a later
--   low-observability force event may contract reconstructible history.
-- These are independent axes; neither is inferred from the other.
------------------------------------------------------------------------

record CoerciveContactHypervoxel : Set where
  constructor coerciveContactHypervoxel
  field
    encounter : Wand.EncounterFibre
    force : Force.ForceHypervoxel
    directSearchFirewall : Wand.wandFirewall encounter
    searchReachable : Wand.indirectSearchReachability encounter
    auditReference : String

open CoerciveContactHypervoxel public

record ReachabilityObservabilityAsymmetry
    (h : CoerciveContactHypervoxel) : Set where
  constructor reachabilityObservabilityAsymmetry
  field
    enforcementReachabilityExpanded : Wand.indirectSearchReachability (encounter h)
    forceHistoryNotRecoverableFromCoarseRecord :
      NF.FactorsThrough Force.observe Force.actualForce → ⊥

open ReachabilityObservabilityAsymmetry public

canonicalAsymmetry :
  ReachabilityObservabilityAsymmetry
    (coerciveContactHypervoxel
      Wand.canonicalFirewallBoundary
      Force.contactElectricalLowRecord
      (Wand.noDirectConferral Wand.canonicalFirewallReachability)
      (Wand.searchStillReachable Wand.canonicalFirewallReachability)
      "reachability expansion x low-observability reconstruction boundary")
canonicalAsymmetry =
  reachabilityObservabilityAsymmetry
    refl
    Force.postEncounterRecordCannotReconstructForceHistory

------------------------------------------------------------------------
-- Hyperfabric axes.  The topology is generated by admissible transitions and
-- observer transport; it is not fixed by semantic labels.
------------------------------------------------------------------------

data Axis : Set where
  authorityAxis contactAxis scannerAxis searchAxis forceAxis traceAxis recordingAxis outcomeAxis : Axis

data TransportKind : Set where
  admissibleTransition observerProjection provenanceWeld consumerPromotion : TransportKind

record FabricTransport : Set where
  constructor fabricTransport
  field
    source target : Axis
    kind : TransportKind
    enabled : Bool
    transportReference : String

open FabricTransport public

wandToSearchTransport : FabricTransport
wandToSearchTransport = fabricTransport
  contactAxis searchAxis admissibleTransition true
  "separate downstream search predicate required"

forceToRecordProjection : FabricTransport
forceToRecordProjection = fabricTransport
  forceAxis recordingAxis observerProjection true
  "projection may erase force-history distinctions"

------------------------------------------------------------------------
-- BIDI cutset: each downstream conclusion reopens a typed residual rather than
-- accepting a scalar headline or a doctrinal label as sufficient evidence.
------------------------------------------------------------------------

data Residual : Set where
  authorityResidual transitionResidual denominatorResidual counterfactualResidual
  traceResidual recordingResidual telemetryResidual witnessResidual : Residual

claimResidual : Wand.ConsumerClaim → Residual
claimResidual Wand.lawfulInitialWand = authorityResidual
claimResidual Wand.lawfulDownstreamSearch = transitionResidual
claimResidual Wand.gatewayRate = transitionResidual
claimResidual Wand.selectionDisparity = denominatorResidual
claimResidual Wand.deterrenceEffect = counterfactualResidual
claimResidual Wand.forceHistoryReconstruction = recordingResidual

record ResidualClosureReceipt (claim : Wand.ConsumerClaim) : Set where
  constructor residualClosureReceipt
  field
    residual : Residual
    exactResidual : residual ≡ claimResidual claim
    producer : Wand.ProducerObligation
    exactProducer : producer ≡ Wand.reverseRoute claim
    closureReference : String

open ResidualClosureReceipt public

closedClaimCannotUseWrongProducer :
  (claim : Wand.ConsumerClaim) →
  (receipt : ResidualClosureReceipt claim) →
  producer receipt ≡ Wand.reverseRoute claim
closedClaimCannotUseWrongProducer claim receipt = exactProducer receipt

------------------------------------------------------------------------
-- Important firewalls.
------------------------------------------------------------------------

record CrossPollinationBoundary : Set where
  constructor crossPollinationBoundary
  field
    directFirewallImpliesNoOperationalPath : Bool
    directFirewallImpliesNoOperationalPathIsFalse :
      directFirewallImpliesNoOperationalPath ≡ false

    absentTraceImpliesAbsentForce : Bool
    absentTraceImpliesAbsentForceIsFalse :
      absentTraceImpliesAbsentForce ≡ false

    aggregateCountReconstructsEncounterHistory : Bool
    aggregateCountReconstructsEncounterHistoryIsFalse :
      aggregateCountReconstructsEncounterHistory ≡ false

    marketingLabelFixesFunctionalOntology : Bool
    marketingLabelFixesFunctionalOntologyIsFalse :
      marketingLabelFixesFunctionalOntology ≡ false

canonicalCrossPollinationBoundary : CrossPollinationBoundary
canonicalCrossPollinationBoundary =
  crossPollinationBoundary false refl false refl false refl false refl
