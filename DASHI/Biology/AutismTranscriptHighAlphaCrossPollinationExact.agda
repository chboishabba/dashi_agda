------------------------------------------------------------------------
-- HIGH-ALPHA CROSS-POLLINATION OWNER
--
-- New external evidence is admitted only where it sharpens a promotion edge
-- already exposed by the October-2026 transcript audit.  A source receipt pays
-- only its own population/design/outcome coordinates.
------------------------------------------------------------------------

shankerVlaev2026Source : Source.AttributedSource
shankerVlaev2026Source =
  Source.mkDOISource
    "Ankit Shanker; Ivo Vlaev"
    "Correcting social norm misperceptions to counter online vaccine misinformation during pandemics"
    "Scientific Reports"
    "2026"
    "10.1038/s41598-026-71728-3"
    "https://doi.org/10.1038/s41598-026-71728-3"
    Source.academicArticleSource
    "Randomized online experiment in 731 UK adults. Misinformation reduced vaccination intention and distorted perceived peer support; norm misperception mediated much of the reported intention effect. Adding descriptive norms corrected norm perception more strongly but did not significantly outperform debunking alone on the average intention-change outcome."
    Source.publicAttribution

cornelson2026Source : Source.AttributedSource
cornelson2026Source =
  Source.mkDOISource
    "Kirsten Cornelson; Hao Ming Chen; Caitlin Ford; Jia Hu; Madison Fullerton; Hinna Hasan; Margaret Pateman; Theresa Tang; Janette Wong"
    "Randomized volunteer intervention reduced comments and reaction on anti-COVID-19 vaccine posts on Facebook"
    "Scientific Reports"
    "2026"
    "10.1038/s41598-026-62919-z"
    "https://doi.org/10.1038/s41598-026-62919-z"
    Source.academicArticleSource
    "Randomized volunteer-led social correction changed comments and some reactions on treated Facebook posts, with little evidence of reduced sharing. The study does not directly establish reduced misinformation prevalence, belief change, or exposure."
    Source.publicAttribution

tuckZhuThompson2026Source : Source.AttributedSource
tuckZhuThompson2026Source =
  Source.mkDOISource
    "Alison B. Tuck; Yiqin Zhu; Renee J. Thompson"
    "Depressive Symptoms Are Associated with Linguistic Features of Negative but Not Positive Autobiographical Narratives"
    "Affective Science"
    "2026"
    "10.1007/s42761-026-00395-4"
    "https://doi.org/10.1007/s42761-026-00395-4"
    Source.academicArticleSource
    "Randomized writing-valence study in 457 undergraduates. Greater depressive symptoms were associated with more first-person pronoun use in negative autobiographical narratives, not positive narratives; reported significant language effects were small and context-dependent."
    Source.publicAttribution

fisher2026Source : Source.AttributedSource
fisher2026Source =
  Source.mkDOISource
    "Hadar Fisher; Nigel M Jaffe; Kristina Pidvirny; Anna O Tierney; Mia S Vaidean; Poorvesh Dongre; Christian A Webb"
    "Language-based detection of depression with machine learning: systematic review and meta-analysis"
    "npj Digital Medicine 9:273"
    "2026"
    "10.1038/s41746-026-02448-1"
    "https://doi.org/10.1038/s41746-026-02448-1"
    Source.academicArticleSource
    "Systematic review/meta-analysis of language-only depression models. Pooled accuracy was about 0.80 across 43 studies/40,983 samples, with substantial heterogeneity by text source and other design coordinates; the authors call for standardization and validation before clinical use."
    Source.publicAttribution

wan2024FMTSource : Source.AttributedSource
wan2024FMTSource =
  Source.mkDOISource
    "Lin Wan; Huan Wang; Yan Liang; Xun Zhang; Xinyun Yao; Gang Zhu; Jun Cai; Guoyin Liu; Xinting Liu; Qianqian Niu; Siwen Li; Bo Zhang; Jing Gao; Jing Wang; Xiuyu Shi; Linyan Hu; Xiaoyan Liu; Zhiyong Zou; Guang Yang"
    "Effect of oral faecal microbiota transplantation intervention for children with autism spectrum disorder: A randomised, double-blind, placebo-controlled trial"
    "Clinical and Translational Medicine 14(9):e70006"
    "2024"
    "10.1002/ctm2.70006"
    "https://doi.org/10.1002/ctm2.70006"
    Source.academicArticleSource
    "Randomized double-blind placebo-controlled trial, 103 children (FMT 52; placebo 51). The primary SRS-2 between-group change was not significant; ABC between-group changes were also not significant. A Vineland-3 socialisation-domain secondary signal favoured FMT at week 17. No serious adverse events occurred, and placebo response was substantial."
    Source.publicAttribution

zou2026FMTProtocolSource : Source.AttributedSource
zou2026FMTProtocolSource =
  Source.mkDOISource
    "Yigui Zou; Liang Liu; Hu Chen; Zimu Luo; Zhongsheng Zhu; Ziyuan Li; Baixian Lin; Zeling Zhuang; Wenwen Li; Qinghua Yang; Xiao Yang; Haokui Zhou; Mingjing Luo; Dongling Dai"
    "Study protocol for a randomized controlled trial of fecal microbiota transplantation via different routes in children with moderate-to-severe autism spectrum disorder"
    "Frontiers in Microbiology 17:1829532"
    "2026"
    "10.3389/fmicb.2026.1829532"
    "https://doi.org/10.3389/fmicb.2026.1829532"
    Source.academicArticleSource
    "Protocol for a 75-participant randomized triple-blind double-dummy placebo-controlled route-comparison trial. Protocol status pays design and planned outcomes only, not efficacy."
    Source.publicAttribution

loseth2024Source : Source.AttributedSource
loseth2024Source =
  Source.mkDOISource
    "Guro Løseth; Martin Trøstheim; Siri Leknes"
    "Endogenous mu-opioid modulation of social connection in humans: a systematic review and meta-analysis"
    "Translational Psychiatry 14:379"
    "2024"
    "10.1038/s41398-024-03088-3"
    "https://doi.org/10.1038/s41398-024-03088-3"
    Source.academicArticleSource
    "Preregistered meta-analysis of randomized double-blind placebo-controlled naltrexone studies (17 outcomes; N=455). Mu-opioid antagonism modestly reduced self-reported social connectedness (Hedges g about -0.20), while robust connectedness remained under blockade. This supports modulation, not necessity, truth authority, attachment classification, or an autism mechanism."
    Source.publicAttribution

linares2026Source : Source.AttributedSource
linares2026Source =
  Source.mkDOISource
    "Jon Liñares-de-Marcos; Blanca Palomero-Sierra; Victoria Sánchez-Gómez; Clara J Fernández-Álvarez; Ricardo Canal-Bedia"
    "An integrative approach between neurodiversity perspectives and quality of life models for autistic people across the spectrum of support needs"
    "Frontiers in Psychiatry 16:1756323"
    "2026"
    "10.3389/fpsyt.2025.1756323"
    "https://doi.org/10.3389/fpsyt.2025.1756323"
    Source.academicArticleSource
    "Mini-review integrating neurodiversity and quality-of-life approaches. It explicitly treats identity/self-acceptance and high-quality supports/interventions as compatible rather than mutually exclusive, including across extensive support needs."
    Source.publicAttribution

canonicalHighAlphaSources : List Source.AttributedSource
canonicalHighAlphaSources =
  shankerVlaev2026Source ∷ cornelson2026Source ∷
  tuckZhuThompson2026Source ∷ fisher2026Source ∷
  wan2024FMTSource ∷ zou2026FMTProtocolSource ∷
  loseth2024Source ∷ linares2026Source ∷ []

------------------------------------------------------------------------
-- SOURCE / OUTCOME ADMISSION
--
-- Attribution is not result authority.  These inhabitants witness only that a
-- specific source is admitted to populate one specific outcome family.  They
-- do not import truth, causation, diagnosis, clinical authority, or agreement.
------------------------------------------------------------------------

data HighAlphaOutcomeFamily : Set where
  normMediationOutcome : HighAlphaOutcomeFamily
  platformInterventionOutcome : HighAlphaOutcomeFamily
  pronounAssociationOutcome : HighAlphaOutcomeFamily
  languageModelMetaOutcome : HighAlphaOutcomeFamily
  fmtTrialOutcome : HighAlphaOutcomeFamily
  fmtProtocolDesignOutcome : HighAlphaOutcomeFamily
  muOpioidSocialOutcome : HighAlphaOutcomeFamily
  neurodiversityQoLOutcome : HighAlphaOutcomeFamily

data AdmittedHighAlphaSource :
  HighAlphaOutcomeFamily → Source.AttributedSource → Set where
  shankerVlaevPaysNormMediationOutcome :
    AdmittedHighAlphaSource normMediationOutcome shankerVlaev2026Source
  cornelsonPaysPlatformInterventionOutcome :
    AdmittedHighAlphaSource platformInterventionOutcome cornelson2026Source
  tuckZhuThompsonPaysPronounAssociationOutcome :
    AdmittedHighAlphaSource pronounAssociationOutcome tuckZhuThompson2026Source
  fisherPaysLanguageModelMetaOutcome :
    AdmittedHighAlphaSource languageModelMetaOutcome fisher2026Source
  wan2024PaysFMTTrialOutcome :
    AdmittedHighAlphaSource fmtTrialOutcome wan2024FMTSource
  zou2026PaysFMTProtocolDesign :
    AdmittedHighAlphaSource fmtProtocolDesignOutcome zou2026FMTProtocolSource
  losethPaysMuOpioidSocialOutcome :
    AdmittedHighAlphaSource muOpioidSocialOutcome loseth2024Source
  linaresPaysNeurodiversityQoLOutcome :
    AdmittedHighAlphaSource neurodiversityQoLOutcome linares2026Source

------------------------------------------------------------------------
-- 1. MEDIATED PROPAGATION: exposure -> norm perception -> intention.
------------------------------------------------------------------------

data MediationCoordinate : Set where
  misinformationExposure : MediationCoordinate
  perceivedPeerSupport : MediationCoordinate
  vaccinationIntent : MediationCoordinate

record NormMediationReceipt : Set where
  constructor norm-mediation-receipt
  field
    source : Source.AttributedSource
    sourceAdmission : AdmittedHighAlphaSource normMediationOutcome source
    upstream : MediationCoordinate
    mediator : MediationCoordinate
    downstream : MediationCoordinate
    randomizedDesign : Bool
    randomizedDesignIsTrue : randomizedDesign ≡ true
    averageNormAddedBenefitOverDebunkingPaid : Bool
    averageNormAddedBenefitOverDebunkingPaidIsFalse :
      averageNormAddedBenefitOverDebunkingPaid ≡ false
    reading : String

canonicalNormMediationReceipt : NormMediationReceipt
canonicalNormMediationReceipt =
  norm-mediation-receipt
    shankerVlaev2026Source shankerVlaevPaysNormMediationOutcome
    misinformationExposure perceivedPeerSupport vaccinationIntent
    true refl false refl
    "The 2026 experiment supplies a concrete mediator candidate inside the existing exposure -> belief/norm -> intent chain. Its reported mediation does not make perceived norms the unique mechanism, and the descriptive-norm add-on did not beat debunking alone on average intention change."

