-- Negative at the outgoing voxel, positive at the incoming voxel,
-- zero elsewhere. This exactly matches the physical solver's
-- dx[a]-=J/h ; dx[b]+=J/h sign convention.
sourceIncidenceCoefficient :
  F.Fin 27 → (F.Fin 27 × F.Fin 27) → Q.ℚᵘ
sourceIncidenceCoefficient site (outgoing , incoming)
  with FP._≟_ site outgoing | FP._≟_ site incoming
... | yes _ | _ = Q.-_ Q.1ℚᵘ
... | no _ | yes _ = Q.1ℚᵘ
... | no _ | no _ = Q.0ℚᵘ

sourceNativeIncidence : Operator.Matrix 27 54
sourceNativeIncidence =
  V.tabulate (λ site →
    V.map (sourceIncidenceCoefficient site) sourceNative54Endpoints)

-- Exact 54-case source-native conservation, no arbitrary matrix field.
-- Proofs are computed in the rational equivalence of the literal
-- finite 27x54 incidence; no float or numeric tolerance is involved.
sourceNativeColumnZero :
  (bond : F.Fin 54) →
  Q._≃_
    (Lift.rationalFiniteSum
      (V.map (λ row → V.lookup row bond) sourceNativeIncidence))
    Q.0ℚᵘ
sourceNativeColumnZero F.zero = QP.≃-reflexive refl
