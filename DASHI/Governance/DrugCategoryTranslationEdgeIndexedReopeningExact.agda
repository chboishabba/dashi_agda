module DASHI.Governance.DrugCategoryTranslationEdgeIndexedReopeningExact where

open import DASHI.Core.Prelude

import DASHI.Core.AffectedDependencyClosureExact as Affected
import DASHI.Governance.DrugCategoryMultiChartTranslationGeometryExact as Translation
import DASHI.Governance.DrugCategoryTranslationPathResidueExact as PathResidue

------------------------------------------------------------------------
-- EDGE-INDEXED MULTI-CHART TRANSLATION REOPENING
--
-- The dependency key is an actual translation-edge instance, not merely the
-- generic fact that a consequence belongs to the drug-category domain.
--
--     e occurs in path(c)  ->  c is affected by revision of e.
------------------------------------------------------------------------

data TranslationEdgeInstance : Set where
  stateToClinicalEdge
  clinicalToLivedEdge
  stateToCommercialEdge
  commercialToLivedEdge
  stateToSovereignCommunityEdge
  sovereignCommunityToLivedEdge
  indigenousToCommercialEdge
  : TranslationEdgeInstance

data TranslationConsequence : Set where
  clinicalSafetyConsequence
  livedSubjectConsequence
  commercialPsychedelicConsequence
  sovereignCommunityConsequence
  positivePsychedelicLegibilityConsequence
  : TranslationConsequence

------------------------------------------------------------------------
-- Proof-relevant edge occurrence in the exact consequence history.
------------------------------------------------------------------------

data EdgeOccurs : TranslationEdgeInstance → TranslationConsequence → Set where
  stateClinicalOccursInClinicalSafety :
    EdgeOccurs stateToClinicalEdge clinicalSafetyConsequence

  stateClinicalOccursInLivedSubject :
    EdgeOccurs stateToClinicalEdge livedSubjectConsequence
  clinicalLivedOccursInLivedSubject :
    EdgeOccurs clinicalToLivedEdge livedSubjectConsequence

  stateCommercialOccursInCommercial :
    EdgeOccurs stateToCommercialEdge commercialPsychedelicConsequence
  commercialLivedOccursInCommercial :
    EdgeOccurs commercialToLivedEdge commercialPsychedelicConsequence

  stateSovereignOccursInSovereign :
    EdgeOccurs stateToSovereignCommunityEdge sovereignCommunityConsequence
  sovereignLivedOccursInSovereign :
    EdgeOccurs sovereignCommunityToLivedEdge sovereignCommunityConsequence

  stateClinicalOccursInPositiveSurface :
    EdgeOccurs stateToClinicalEdge positivePsychedelicLegibilityConsequence
  clinicalLivedOccursInPositiveSurface :
    EdgeOccurs clinicalToLivedEdge positivePsychedelicLegibilityConsequence
  stateCommercialOccursInPositiveSurface :
    EdgeOccurs stateToCommercialEdge positivePsychedelicLegibilityConsequence
  commercialLivedOccursInPositiveSurface :
    EdgeOccurs commercialToLivedEdge positivePsychedelicLegibilityConsequence
  stateSovereignOccursInPositiveSurface :
    EdgeOccurs stateToSovereignCommunityEdge positivePsychedelicLegibilityConsequence
  sovereignLivedOccursInPositiveSurface :
    EdgeOccurs sovereignCommunityToLivedEdge positivePsychedelicLegibilityConsequence

  indigenousCommercialOccursInCommercial :
    EdgeOccurs indigenousToCommercialEdge commercialPsychedelicConsequence

------------------------------------------------------------------------
-- Reverse-dependency graph generated by occurrence.
------------------------------------------------------------------------

data TranslationIndexedArtifact : Set where
  edgeArtifact : TranslationEdgeInstance → TranslationIndexedArtifact
  consequenceArtifact : TranslationConsequence → TranslationIndexedArtifact
  consumerArtifact : TranslationConsequence → TranslationIndexedArtifact

data Depends : TranslationIndexedArtifact → TranslationIndexedArtifact → Set where
  occurrenceCreatesDependency :
    ∀ {edge consequence} →
    EdgeOccurs edge consequence →
    Depends (edgeArtifact edge) (consequenceArtifact consequence)
  consequenceFeedsConsumer :
    ∀ {consequence} →
    Depends (consequenceArtifact consequence) (consumerArtifact consequence)

edgeOccurrenceCreatesReopeningObligation :
  ∀ {edge consequence} →
  EdgeOccurs edge consequence →
  Affected.ReopeningObligation
    Depends (edgeArtifact edge) (consequenceArtifact consequence)
edgeOccurrenceCreatesReopeningObligation occurrence =
  Affected.oneEdgeCreatesReopeningObligation
    (occurrenceCreatesDependency occurrence)

edgeOccurrenceReopensConsumer :
  ∀ {edge consequence} →
  EdgeOccurs edge consequence →
  Affected.ReopeningObligation
    Depends (edgeArtifact edge) (consumerArtifact consequence)
edgeOccurrenceReopensConsumer occurrence =
  Affected.obligationsCompose
    (edgeOccurrenceCreatesReopeningObligation occurrence)
    (Affected.oneEdgeCreatesReopeningObligation consequenceFeedsConsumer)

------------------------------------------------------------------------
-- Canonical exact instances.
------------------------------------------------------------------------

stateClinicalRevisionReopensClinicalSafety :
  Affected.ReopeningObligation
    Depends
    (edgeArtifact stateToClinicalEdge)
    (consumerArtifact clinicalSafetyConsequence)
stateClinicalRevisionReopensClinicalSafety =
  edgeOccurrenceReopensConsumer stateClinicalOccursInClinicalSafety

clinicalLivedRevisionReopensLivedSubject :
  Affected.ReopeningObligation
    Depends
    (edgeArtifact clinicalToLivedEdge)
    (consumerArtifact livedSubjectConsequence)
clinicalLivedRevisionReopensLivedSubject =
  edgeOccurrenceReopensConsumer clinicalLivedOccursInLivedSubject

indigenousCommercialRevisionReopensCommercialConsequence :
  Affected.ReopeningObligation
    Depends
    (edgeArtifact indigenousToCommercialEdge)
    (consumerArtifact commercialPsychedelicConsequence)
indigenousCommercialRevisionReopensCommercialConsequence =
  edgeOccurrenceReopensConsumer indigenousCommercialOccursInCommercial

------------------------------------------------------------------------
-- Selectivity: same edge kind/domain is insufficient without occurrence.
------------------------------------------------------------------------

clinicalLivedDoesNotOccurInClinicalSafety :
  EdgeOccurs clinicalToLivedEdge clinicalSafetyConsequence → ⊥
clinicalLivedDoesNotOccurInClinicalSafety ()

indigenousCommercialDoesNotOccurInClinicalSafety :
  EdgeOccurs indigenousToCommercialEdge clinicalSafetyConsequence → ⊥
indigenousCommercialDoesNotOccurInClinicalSafety ()

stateClinicalDoesNotOccurInSovereignCommunity :
  EdgeOccurs stateToClinicalEdge sovereignCommunityConsequence → ⊥
stateClinicalDoesNotOccurInSovereignCommunity ()

------------------------------------------------------------------------
-- Welds to the concrete translation/path owners.
------------------------------------------------------------------------

translationBoundary : Translation.DrugCategoryMultiChartTranslationBoundary
translationBoundary = Translation.canonicalDrugCategoryMultiChartTranslationBoundary

pathResidueBoundary : PathResidue.DrugCategoryTranslationPathResidueBoundary
pathResidueBoundary = PathResidue.canonicalDrugCategoryTranslationPathResidueBoundary

record DrugCategoryTranslationEdgeIndexedBoundary : Set where
  constructor drugCategoryTranslationEdgeIndexedBoundary
  field
    occurrenceCreatesDependency : Bool
    occurrenceCreatesDependencyIsTrue : occurrenceCreatesDependency ≡ true
    occurrenceReopensExactConsumer : Bool
    occurrenceReopensExactConsumerIsTrue : occurrenceReopensExactConsumer ≡ true
    sameDomainWithoutOccurrenceForcesReopening : Bool
    sameDomainWithoutOccurrenceForcesReopeningIsFalse :
      sameDomainWithoutOccurrenceForcesReopening ≡ false
    finalPositiveSurfaceErasesEdgeHistory : Bool
    finalPositiveSurfaceErasesEdgeHistoryIsFalse :
      finalPositiveSurfaceErasesEdgeHistory ≡ false

canonicalDrugCategoryTranslationEdgeIndexedBoundary :
  DrugCategoryTranslationEdgeIndexedBoundary
canonicalDrugCategoryTranslationEdgeIndexedBoundary =
  drugCategoryTranslationEdgeIndexedBoundary
    true refl
    true refl
    false refl
    false refl
