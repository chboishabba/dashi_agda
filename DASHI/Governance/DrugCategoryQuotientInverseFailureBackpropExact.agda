module DASHI.Governance.DrugCategoryQuotientInverseFailureBackpropExact where

open import DASHI.Core.Prelude
open import Agda.Builtin.String using (String)

import DASHI.Core.AffectedDependencyClosureExact as Affected
import DASHI.Governance.DrugCategoryMultiChartTranslationGeometryExact as Translation
import DASHI.Governance.DrugCategoryPartialTranslationPathCategoryExact as Path
import DASHI.Governance.DrugCategoryConsumerIndexedTranslationAdmissionExact as Admission
import DASHI.Governance.DrugCategoryConsumerRelativeQuotientInverseExact as Inverse
import DASHI.Governance.DrugCategoryTranslationSelectiveReopeningExact as Reopen

------------------------------------------------------------------------
-- QUOTIENT-INVERSE FAILURE -> RECONSTRUCTION DEMAND -> SELECTIVE REOPENING
--
-- Non-invertibility is actionable information.  Failure on a declared consumer
-- quotient identifies the missing coordinate family, creates a backward
-- reconstruction demand, and reopens only the certificates depending on it.
------------------------------------------------------------------------

data InverseFailureKind : Set where
  subjectAuthorshipInverseFailure
  historicalContinuityInverseFailure
  sovereignAuthorityInverseFailure
  : InverseFailureKind

failureConsumer : InverseFailureKind → Admission.TranslationConsumer
failureConsumer subjectAuthorshipInverseFailure =
  Admission.livedSubjectAuthorityConsumer
failureConsumer historicalContinuityInverseFailure =
  Admission.historicalContinuityConsumer
failureConsumer sovereignAuthorityInverseFailure =
  Admission.sovereignAuthorityConsumer

failureResidual : InverseFailureKind → Translation.TranslationResidual
failureResidual subjectAuthorshipInverseFailure = Translation.subjectResidual
failureResidual historicalContinuityInverseFailure = Translation.historyResidual
failureResidual sovereignAuthorityInverseFailure = Translation.sovereigntyResidual

failureArtifact : InverseFailureKind → Reopen.TranslationArtifact
failureArtifact subjectAuthorshipInverseFailure = Reopen.subjectResidualArtifact
failureArtifact historicalContinuityInverseFailure = Reopen.historyResidualArtifact
failureArtifact sovereignAuthorityInverseFailure = Reopen.sovereigntyResidualArtifact

record QuotientInverseFailure
    {source target}
    (kind : InverseFailureKind)
    (path : Path.TranslationPath source target) : Set where
  constructor quotientInverseFailure
  field
    inverseImpossible :
      Inverse.ConsumerRelativeQuotientInverse
        (failureConsumer kind) path → ⊥
    failureReference : String
    missingCoordinateReference : String

open QuotientInverseFailure public

subjectInverseFailure :
  QuotientInverseFailure
    subjectAuthorshipInverseFailure
    Path.stateClinicalLivedPath
subjectInverseFailure = quotientInverseFailure
  Inverse.livedSubjectQuotientNotInvertibleOnStateClinicalLived
  "state -> clinical -> lived path is not invertible for the lived-subject authority quotient"
  "originating subject-authorship coordinate was erased on the path"

historyInverseFailure :
  QuotientInverseFailure
    historicalContinuityInverseFailure
    Path.stateClinicalLivedPath
historyInverseFailure = quotientInverseFailure
  Inverse.historicalQuotientNotInvertibleOnStateClinicalLived
  "state -> clinical -> lived path is not invertible for the historical-continuity quotient"
  "historical-path coordinate was erased on the path"

sovereignInverseFailure :
  QuotientInverseFailure
    sovereignAuthorityInverseFailure
    Path.indigenousCommercialPath
sovereignInverseFailure = quotientInverseFailure
  Inverse.sovereignQuotientNotInvertibleOnIndigenousCommercial
  "Indigenous-sovereign -> commercial path is not invertible for sovereign authority"
  "sovereign-authority coordinate is erased in the commercial translation"

------------------------------------------------------------------------
-- BIDI backward demand.
------------------------------------------------------------------------

failureCreatesReconstructionDemand :
  (kind : InverseFailureKind) →
  Reopen.ReconstructionDemand (failureResidual kind)
failureCreatesReconstructionDemand subjectAuthorshipInverseFailure =
  Reopen.recoverOriginatingSubjectPosition
failureCreatesReconstructionDemand historicalContinuityInverseFailure =
  Reopen.recoverHistoricalClassifierPath
failureCreatesReconstructionDemand sovereignAuthorityInverseFailure =
  Reopen.recoverSovereignPermissionAuthority

------------------------------------------------------------------------
-- Exact selective reopening generated by the failure family.
------------------------------------------------------------------------

failureReopensAffectedConsumer :
  (kind : InverseFailureKind) →
  Affected.ReopeningObligation
    Reopen.Depends
    (failureArtifact kind)
    Reopen.downstreamConsumerCertificate
failureReopensAffectedConsumer subjectAuthorshipInverseFailure =
  Reopen.subjectResidualReopensSubjectConsumer
failureReopensAffectedConsumer historicalContinuityInverseFailure =
  Reopen.historyResidualReopensHistoricalConsumer
failureReopensAffectedConsumer sovereignAuthorityInverseFailure =
  Reopen.sovereigntyResidualReopensSovereignConsumer

subjectFailureBackpropagates :
  Reopen.ReconstructionDemand Translation.subjectResidual
subjectFailureBackpropagates =
  failureCreatesReconstructionDemand subjectAuthorshipInverseFailure

historyFailureBackpropagates :
  Reopen.ReconstructionDemand Translation.historyResidual
historyFailureBackpropagates =
  failureCreatesReconstructionDemand historicalContinuityInverseFailure

sovereigntyFailureBackpropagates :
  Reopen.ReconstructionDemand Translation.sovereigntyResidual
sovereigntyFailureBackpropagates =
  failureCreatesReconstructionDemand sovereignAuthorityInverseFailure

------------------------------------------------------------------------
-- Failure is not refutation of the path and not proof that reconstruction is
-- impossible in principle.  It says only that the current path does not carry
-- enough information for that consumer quotient.
------------------------------------------------------------------------

data InverseFailurePromotesPathInvalidity : Set where

data InverseFailurePromotesPermanentUnrecoverability : Set where

data ReconstructionDemandPromotesSuccessfulRecovery : Set where

inverseFailureDoesNotPromotePathInvalidity :
  InverseFailurePromotesPathInvalidity → ⊥
inverseFailureDoesNotPromotePathInvalidity ()

inverseFailureDoesNotPromotePermanentUnrecoverability :
  InverseFailurePromotesPermanentUnrecoverability → ⊥
inverseFailureDoesNotPromotePermanentUnrecoverability ()

reconstructionDemandDoesNotPromoteSuccessfulRecovery :
  ReconstructionDemandPromotesSuccessfulRecovery → ⊥
reconstructionDemandDoesNotPromoteSuccessfulRecovery ()

record QuotientInverseFailureBackpropBoundary : Set where
  constructor quotientInverseFailureBackpropBoundary
  field
    inverseFailureCreatesTypedReconstructionDemand : Bool
    inverseFailureCreatesTypedReconstructionDemandIsTrue :
      inverseFailureCreatesTypedReconstructionDemand ≡ true
    inverseFailureCanSeedSelectiveReopening : Bool
    inverseFailureCanSeedSelectiveReopeningIsTrue :
      inverseFailureCanSeedSelectiveReopening ≡ true
    inverseFailureMeansWholePathInvalid : Bool
    inverseFailureMeansWholePathInvalidIsFalse :
      inverseFailureMeansWholePathInvalid ≡ false
    inverseFailureMeansPermanentlyUnrecoverable : Bool
    inverseFailureMeansPermanentlyUnrecoverableIsFalse :
      inverseFailureMeansPermanentlyUnrecoverable ≡ false

canonicalQuotientInverseFailureBackpropBoundary :
  QuotientInverseFailureBackpropBoundary
canonicalQuotientInverseFailureBackpropBoundary =
  quotientInverseFailureBackpropBoundary
    true refl
    true refl
    false refl
    false refl
