module DASHI.Mathematics.Complexity.Karp21UpperPairGraphEnumerationExact where

------------------------------------------------------------------------
-- E20: identify the ACTUAL signed complete-graph edge list generated by
-- Karp21FiniteCompleteGraphGeneratorExact with the full canonical
-- UpperPair n address enumeration proved duplicate-free and complete by
-- Karp21IndexedUpperPairBijectionExact.
--
-- A source Vec ℤ n determines an edge for each and only each canonical
-- pair address. No cut labels, target witnesses or eigen/PNF scores enter
-- the transform. Signed weight of (i,j) is exactly source[i]*source[j].
-- Existing graph scale owner supplies 4* edge weights separately.
--
-- This remains handwritten Agda source pending pinned typecheck.
-- It does not yet certify packed Word encoding or Turing-machine clock.
------------------------------------------------------------------------

open import Agda.Builtin.Nat using (Nat; zero; suc)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Data.Integer using (ℤ; _*_)
open import Data.List.Base using (List; []; _∷_; _++_; map)
open import Data.Product using (_×_; _,_; proj₁; proj₂)
open import Relation.Binary.PropositionalEquality using (cong; cong₂; trans; sym)

import Data.Fin.Base as Fin
import Data.Vec.Base as Vec
import DASHI.Mathematics.Complexity.Karp21FiniteCompleteGraphGeneratorExact as Gen
import DASHI.Mathematics.Complexity.Karp21FiniteWeightedMaxCutVerifierExact as Cut
import DASHI.Mathematics.Complexity.Karp21IndexedUpperPairBijectionExact as Pair

mapCompose :
  ∀ {A B C : Set} (f : B → C) (g : A → B)
    (xs : List A) →
  map f (map g xs) ≡ map (λ x → f (g x)) xs
mapCompose f g [] = refl
mapCompose f g (x ∷ xs) =
  cong (λ rest → f (g x) ∷ rest)
    (mapCompose f g xs)

mapAppend :
  ∀ {A B : Set} (f : A → B)
    (left right : List A) →
  map f (left ++ right) ≡ map f left ++ map f right
mapAppend f [] right = refl
mapAppend f (x ∷ xs) right =
  cong (λ rest → f x ∷ rest) (mapAppend f xs right)

headWeightedLink :
  ∀ {n} (x : ℤ) (tail : Vec.Vec ℤ n) →
  Fin.Fin n → Gen.HeadLink n
headWeightedLink x tail j =
  Gen.head-link j (x * Vec.lookup tail j)

headLinksAreCanonical :
  ∀ {n} (x : ℤ) (tail : Vec.Vec ℤ n) →
  Gen.headLinks x tail ≡
  map (headWeightedLink x tail) (Pair.allFin n)
headLinksAreCanonical x Vec.[] = refl
headLinksAreCanonical {n = suc n} x (y Vec.∷ xs) =
  cong
    (λ rest → Gen.head-link Fin.zero (x * y) ∷ rest)
    (trans
      (cong (map Gen.promoteHeadLink)
        (headLinksAreCanonical x xs))
      (trans
        (mapCompose Gen.promoteHeadLink
          (headWeightedLink x xs) (Pair.allFin n))
        (sym
          (mapCompose
            (headWeightedLink x (y Vec.∷ xs))
            Fin.suc (Pair.allFin n)))))

-- A genuinely indexed upper pair becomes the uniquely oriented graph
-- edge determined by its source vector. The recursive tail case
-- agrees definitionally with Gen.promoteTailEdge.
edgeAtUpperPair :
  ∀ {n} (values : Vec.Vec ℤ n) →
  Pair.UpperPair n → Cut.SignedUndirectedEdge n
edgeAtUpperPair Vec.[] ()
edgeAtUpperPair (x Vec.∷ xs) (Pair.headTail j) =
  Cut.edge Fin.zero (Fin.suc j) (λ ())
    (x * Vec.lookup xs j)
edgeAtUpperPair (x Vec.∷ xs) (Pair.tailPair p) =
  Gen.promoteTailEdge (edgeAtUpperPair xs p)

headPairsAreCanonical :
  ∀ {n} (x : ℤ) (tail : Vec.Vec ℤ n) →
  Gen.headPairs x tail ≡
  map (λ j → edgeAtUpperPair (x Vec.∷ tail) (Pair.headTail j))
    (Pair.allFin n)
headPairsAreCanonical {n} x tail =
  trans
    (cong (map Gen.emitHeadLink)
      (headLinksAreCanonical x tail))
    (mapCompose Gen.emitHeadLink
      (headWeightedLink x tail) (Pair.allFin n))

-- The source actual complete graph is exactly the enumeration of
-- duplicate-free canonical typed upper-triangle pair addresses.
completeGraphMatchesUpperPairEnumeration :
  ∀ {n} (source : Vec.Vec ℤ n) →
  Gen.completePairEdges source ≡
  map (edgeAtUpperPair source) (Pair.allUpperPairs n)
completeGraphMatchesUpperPairEnumeration Vec.[] = refl
completeGraphMatchesUpperPairEnumeration {n = suc n} (x Vec.∷ xs) =
  trans
    (cong₂ _++_
      (trans
        (headPairsAreCanonical x xs)
        (sym (mapCompose
          (edgeAtUpperPair (x Vec.∷ xs))
          Pair.headTail (Pair.allFin n))))
      (trans
        (cong (map Gen.promoteTailEdge)
          (completeGraphMatchesUpperPairEnumeration xs))
        (sym (mapCompose
          (edgeAtUpperPair (x Vec.∷ xs))
          Pair.tailPair (Pair.allUpperPairs n)))))
    (sym (mapAppend
      (edgeAtUpperPair (x Vec.∷ xs))
      (map Pair.headTail (Pair.allFin n))
      (map Pair.tailPair (Pair.allUpperPairs _))))

-- The global edge-construction theorem is now attached to the actual
-- source-preserving weighted edge list, not merely an abstract
-- combinatorial pair count: each indexed address carries signed
-- source[i] * source[j] at its endpoints.
actualKarpGraphCanonicalUpperPairs :
  ∀ {n} (source : Vec.Vec ℤ n) →
  Gen.completePairEdges source ≡
  map (edgeAtUpperPair source) (Pair.allUpperPairs n)
actualKarpGraphCanonicalUpperPairs =
  completeGraphMatchesUpperPairEnumeration
