module DASHI.Mathematics.NumberTheory.FiniteEulerProductExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES / CONTEXT
--
-- Jean-Pierre Serre,
-- "A Course in Arithmetic", Graduate Texts in Mathematics 7.
-- DOI: 10.1007/978-1-4684-9884-4.
--
-- Toshitsune Miyake,
-- "Modular Forms", Springer Monographs in Mathematics.
-- DOI: 10.1007/3-540-29593-3.
--
-- DASHI CONTRIBUTION
--
-- Prove the finite algebraic Euler-product expansion in a supplied
-- commutative semiring.  For a finite prime list P and a finite exponent list
-- E, the sum of all ordered prime-power monomials generated by the Cartesian
-- expansion equals the product of the corresponding local finite sums:
--
--   sum_{(e_p) in E^P} product_p a(p,e_p)
--     = product_{p in P} sum_{e in E} a(p,e).
--
-- This is the exact finite identity required before analytic convergence,
-- unique factorisation and infinite Euler products enter.  No convergence or
-- arithmetic multiplicativity is inferred from the semiring calculation.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List using (List; []; _∷_)

symmetry : ∀ {A : Set} {x y : A} → x ≡ y → y ≡ x
symmetry refl = refl

transitivity : ∀ {A : Set} {x y z : A} → x ≡ y → y ≡ z → x ≡ z
transitivity refl second = second

congruence : ∀ {A B : Set} (f : A → B) {x y} → x ≡ y → f x ≡ f y
congruence f refl = refl

congruence₂ : ∀ {A B C : Set} (f : A → B → C)
  {x x' : A} {y y' : B} → x ≡ x' → y ≡ y' → f x y ≡ f x' y'
congruence₂ f refl refl = refl

record CommutativeSemiring : Set₁ where
  field
    Carrier : Set
    zero one : Carrier
    add multiply : Carrier → Carrier → Carrier

    addAssociative : ∀ x y z →
      add (add x y) z ≡ add x (add y z)
    addCommutative : ∀ x y → add x y ≡ add y x
    addIdentityLeft : ∀ x → add zero x ≡ x
    addIdentityRight : ∀ x → add x zero ≡ x

    multiplyAssociative : ∀ x y z →
      multiply (multiply x y) z ≡ multiply x (multiply y z)
    multiplyCommutative : ∀ x y → multiply x y ≡ multiply y x
    multiplyIdentityLeft : ∀ x → multiply one x ≡ x
    multiplyIdentityRight : ∀ x → multiply x one ≡ x
    multiplyZeroLeft : ∀ x → multiply zero x ≡ zero
    multiplyZeroRight : ∀ x → multiply x zero ≡ zero

    distributeLeft : ∀ x y z →
      multiply x (add y z)
      ≡ add (multiply x y) (multiply x z)
    distributeRight : ∀ x y z →
      multiply (add x y) z
      ≡ add (multiply x z) (multiply y z)

open CommutativeSemiring public

mapList : ∀ {A B : Set} → (A → B) → List A → List B
mapList f [] = []
mapList f (x ∷ xs) = f x ∷ mapList f xs

append : ∀ {A : Set} → List A → List A → List A
append [] ys = ys
append (x ∷ xs) ys = x ∷ append xs ys

sumList : (semiring : CommutativeSemiring) →
  List (Carrier semiring) → Carrier semiring
sumList semiring [] = zero semiring
sumList semiring (x ∷ xs) =
  add semiring x (sumList semiring xs)

productList : (semiring : CommutativeSemiring) →
  List (Carrier semiring) → Carrier semiring
productList semiring [] = one semiring
productList semiring (x ∷ xs) =
  multiply semiring x (productList semiring xs)

sumAppend : ∀ semiring xs ys →
  sumList semiring (append xs ys)
  ≡ add semiring (sumList semiring xs) (sumList semiring ys)
sumAppend semiring [] ys =
  symmetry (addIdentityLeft semiring (sumList semiring ys))
sumAppend semiring (x ∷ xs) ys =
  transitivity
    (congruence (add semiring x) (sumAppend semiring xs ys))
    (symmetry
      (addAssociative semiring x
        (sumList semiring xs) (sumList semiring ys)))

productAppend : ∀ semiring xs ys →
  productList semiring (append xs ys)
  ≡ multiply semiring (productList semiring xs) (productList semiring ys)
productAppend semiring [] ys =
  symmetry (multiplyIdentityLeft semiring (productList semiring ys))
productAppend semiring (x ∷ xs) ys =
  transitivity
    (congruence (multiply semiring x) (productAppend semiring xs ys))
    (symmetry
      (multiplyAssociative semiring x
        (productList semiring xs) (productList semiring ys)))

scaleLeft : ∀ semiring → Carrier semiring →
  List (Carrier semiring) → List (Carrier semiring)
scaleLeft semiring scalar values =
  mapList (multiply semiring scalar) values

sumScaleLeft : ∀ semiring scalar values →
  sumList semiring (scaleLeft semiring scalar values)
  ≡ multiply semiring scalar (sumList semiring values)
sumScaleLeft semiring scalar [] =
  symmetry (multiplyZeroRight semiring scalar)
sumScaleLeft semiring scalar (value ∷ values) =
  transitivity
    (congruence
      (add semiring (multiply semiring scalar value))
      (sumScaleLeft semiring scalar values))
    (symmetry
      (distributeLeft semiring scalar value
        (sumList semiring values)))

cartesianMultiply : ∀ semiring →
  List (Carrier semiring) → List (Carrier semiring) →
  List (Carrier semiring)
cartesianMultiply semiring [] right = []
cartesianMultiply semiring (left ∷ lefts) right =
  append
    (scaleLeft semiring left right)
    (cartesianMultiply semiring lefts right)

sumCartesianMultiply : ∀ semiring left right →
  sumList semiring (cartesianMultiply semiring left right)
  ≡ multiply semiring
      (sumList semiring left)
      (sumList semiring right)
sumCartesianMultiply semiring [] right =
  symmetry (multiplyZeroLeft semiring (sumList semiring right))
sumCartesianMultiply semiring (left ∷ lefts) right =
  transitivity
    (sumAppend semiring
      (scaleLeft semiring left right)
      (cartesianMultiply semiring lefts right))
    (transitivity
      (congruence₂ (add semiring)
        (sumScaleLeft semiring left right)
        (sumCartesianMultiply semiring lefts right))
      (symmetry
        (distributeRight semiring left
          (sumList semiring lefts)
          (sumList semiring right))))

localTerms :
  ∀ {Prime Exponent : Set}
    (semiring : CommutativeSemiring) →
    (Prime → Exponent → Carrier semiring) →
    List Exponent → Prime → List (Carrier semiring)
localTerms semiring factor exponents prime =
  mapList (factor prime) exponents

finiteEulerExpansion :
  ∀ {Prime Exponent : Set}
    (semiring : CommutativeSemiring) →
    (Prime → Exponent → Carrier semiring) →
    List Exponent → List Prime → List (Carrier semiring)
finiteEulerExpansion semiring factor exponents [] =
  one semiring ∷ []
finiteEulerExpansion semiring factor exponents (prime ∷ primes) =
  cartesianMultiply semiring
    (localTerms semiring factor exponents prime)
    (finiteEulerExpansion semiring factor exponents primes)

finiteEulerProduct :
  ∀ {Prime Exponent : Set}
    (semiring : CommutativeSemiring) →
    (Prime → Exponent → Carrier semiring) →
    List Exponent → List Prime → Carrier semiring
finiteEulerProduct semiring factor exponents [] = one semiring
finiteEulerProduct semiring factor exponents (prime ∷ primes) =
  multiply semiring
    (sumList semiring (localTerms semiring factor exponents prime))
    (finiteEulerProduct semiring factor exponents primes)

finiteEulerProductExpansionTheorem :
  ∀ {Prime Exponent : Set}
    (semiring : CommutativeSemiring)
    (factor : Prime → Exponent → Carrier semiring)
    exponents primes →
  sumList semiring
    (finiteEulerExpansion semiring factor exponents primes)
  ≡ finiteEulerProduct semiring factor exponents primes
finiteEulerProductExpansionTheorem semiring factor exponents [] =
  addIdentityRight semiring (one semiring)
finiteEulerProductExpansionTheorem semiring factor exponents
    (prime ∷ primes) =
  transitivity
    (sumCartesianMultiply semiring
      (localTerms semiring factor exponents prime)
      (finiteEulerExpansion semiring factor exponents primes))
    (congruence
      (multiply semiring
        (sumList semiring (localTerms semiring factor exponents prime)))
      (finiteEulerProductExpansionTheorem
        semiring factor exponents primes))

pointwiseLocalEqualityGivesProductEquality :
  ∀ {Prime Exponent : Set}
    (semiring : CommutativeSemiring)
    (first second : Prime → Exponent → Carrier semiring)
    exponents primes →
  (∀ prime exponent → first prime exponent ≡ second prime exponent) →
  finiteEulerProduct semiring first exponents primes
  ≡ finiteEulerProduct semiring second exponents primes
pointwiseLocalEqualityGivesProductEquality semiring first second
    exponents [] agreement = refl
pointwiseLocalEqualityGivesProductEquality semiring first second
    exponents (prime ∷ primes) agreement =
  congruence₂ (multiply semiring)
    (localSumEquality exponents)
    (pointwiseLocalEqualityGivesProductEquality
      semiring first second exponents primes agreement)
  where
    localSumEquality : ∀ exponentList →
      sumList semiring (localTerms semiring first exponentList prime)
      ≡ sumList semiring (localTerms semiring second exponentList prime)
    localSumEquality [] = refl
    localSumEquality (exponent ∷ exponentList) =
      congruence₂ (add semiring)
        (agreement prime exponent)
        (localSumEquality exponentList)
