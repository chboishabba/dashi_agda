------------------------------------------------------------------------
-- Unnormalised C3 transfer in the 3-ramified ring:
--       T=1+g+g^2;   T^2=3T;   T^6=0.
-- This does NOT reuse the characteristic-zero 1/3 Fourier idempotents.
------------------------------------------------------------------------

record C3Polynomial : Set where
  constructor poly3
  field
    at0 at1 at2 : Eisenstein9

open C3Polynomial public

zeroP oneP transferP : C3Polynomial
zeroP = poly3 zeroR zeroR zeroR
oneP = poly3 oneR zeroR zeroR
transferP = poly3 oneR oneR oneR

mulP : C3Polynomial → C3Polynomial → C3Polynomial
mulP (poly3 a b c) (poly3 d e f) =
  poly3
    (addR (addR (mulR a d) (mulR b f)) (mulR c e))
    (addR (addR (mulR a e) (mulR b d)) (mulR c f))
    (addR (addR (mulR a f) (mulR b e)) (mulR c d))

powP : C3Polynomial → Nat → C3Polynomial
powP p zero = oneP
powP p (suc n) = mulP p (powP p n)

transferSquared :
  mulP transferP transferP
  ≡ poly3 (scalar 3) (scalar 3) (scalar 3)
transferSquared = refl

transferSixZero :
  powP transferP 6 ≡ zeroP
transferSixZero = refl

