------------------------------------------------------------------------
-- lambda^9 is associated to 81 lambda = 81(1-omega).
-- In the (1,omega) basis its ideal is generated by (81,-81) and
-- (0,243).  Thus its quotient admits coordinates
--
--       x = a mod 81,   y = (a+b) mod 243
--
-- for a+b*omega.  This is C81 x C243 ADDITIVELY, not C3^9 as a group.
-- Carry on both cyclic factors is part of the arithmetic semantics.
------------------------------------------------------------------------

record Eisenstein9 : Set where
  constructor coord
  field
    x81  : Nat
    y243 : Nat

open Eisenstein9 public

normalise : Eisenstein9 → Eisenstein9
normalise (coord x y) = coord (x % 81) (y % 243)

fromOmegaBasis : Nat → Nat → Eisenstein9
fromOmegaBasis a b = coord (a % 81) ((a + b) % 243)

zeroR oneR omegaR lambdaR : Eisenstein9
zeroR = coord 0 0
oneR = coord 1 1
omegaR = coord 0 1
lambdaR = coord 1 0

scalar : Nat → Eisenstein9
scalar n = coord (n % 81) (n % 243)

addR : Eisenstein9 → Eisenstein9 → Eisenstein9
addR (coord a b) (coord c d) =
  coord ((a + c) % 81) ((b + d) % 243)

negR : Eisenstein9 → Eisenstein9
negR (coord a b) =
  coord ((81 ∸ (a % 81)) % 81)
        ((243 ∸ (b % 243)) % 243)

------------------------------------------------------------------------
-- Literal multiplication transported from
-- (a+b omega)(c+d omega) = (ac-bd)+(ad+bc-bd)omega.
--
-- For x=a,y=a+b,u=c,v=c+d:
--    x' = xv + yu - yv  (mod 81)
--    y' = 3xv + 3yu - 2yv - 3xu (mod 243).
--
-- Normalised bounds x,u<81 and y,v<243 let us add fixed multiples of
-- the moduli to represent signed intermediate coefficients with Nat ∸.
-- 59049 = 81*729 > 242^2;
-- 177147 = 243*729 > 2*242^2+3*80^2.
------------------------------------------------------------------------

mulR : Eisenstein9 → Eisenstein9 → Eisenstein9
mulR (coord x y) (coord u v)
  with x % 81 | y % 243 | u % 81 | v % 243
... | a | b | c | d =
  coord
    (((a * d + b * c + 59049) ∸ (b * d)) % 81)
    (((3 * a * d + 3 * b * c + 177147)
      ∸ (2 * b * d + 3 * a * c)) % 243)

powR : Eisenstein9 → Nat → Eisenstein9
powR a zero = oneR
powR a (suc n) = mulR a (powR a n)

oneTimesOmega : mulR oneR omegaR ≡ omegaR
oneTimesOmega = refl

omegaCubicIdentity :
  addR (addR (powR omegaR 2) omegaR) oneR ≡ zeroR
omegaCubicIdentity = refl

omegaCubedIsOne : powR omegaR 3 ≡ oneR
omegaCubedIsOne = refl

lambdaSquaredIsMinusThreeOmega :
  powR lambdaR 2 ≡ coord 0 240
lambdaSquaredIsMinusThreeOmega = refl

lambdaEightNonzeroCoordinate :
  powR lambdaR 8 ≡ coord 0 81
lambdaEightNonzeroCoordinate = refl

lambdaNineZero : powR lambdaR 9 ≡ zeroR
lambdaNineZero = refl

scalar99Coordinate : scalar 99 ≡ coord 18 99
scalar99Coordinate = refl

scalar99SquaredCoordinate :
  powR (scalar 99) 2 ≡ coord 0 81
scalar99SquaredCoordinate = refl

scalar99CubedZero :
  powR (scalar 99) 3 ≡ zeroR
scalar99CubedZero = refl

