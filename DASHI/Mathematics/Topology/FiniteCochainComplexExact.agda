module DASHI.Mathematics.Topology.FiniteCochainComplexExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES / CONTEXT
--
-- Samuel Eilenberg and Norman Steenrod,
-- "Foundations of Algebraic Topology", Princeton University Press, 1952.
-- DOI: 10.1515/9781400877492.
--
-- Jozef Dodziuk,
-- "Finite-Difference Approach to the Hodge Theory of Harmonic Forms",
-- American Journal of Mathematics 98 (1976), 79--104.
-- DOI: 10.2307/2373615.
--
-- DASHI CONTRIBUTION
--
-- A proof-bearing three-term cochain core.  It proves that exact one-cochains
-- are closed, cochain maps preserve closed and exact cochains, cochain maps
-- compose, a supplied one-cochain homotopy gives cohomologous images, and
-- direct-product complexes preserve closed/exact witnesses componentwise.
--
-- No quotient type is silently identified with cohomology.  Cohomology is
-- represented first by the exact equivalence relation generated by d0; a
-- quotient construction remains a separate owner.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_; refl)
open import Data.Product using (_×_; _,_)
open import Data.Product.Base using (proj₁; proj₂)
open import Data.Sum.Base using (_⊎_; inj₁; inj₂)
open import Agda.Builtin.Sigma using (Σ)

------------------------------------------------------------------------
-- Equality helpers.
------------------------------------------------------------------------

symmetry : ∀ {A : Set} {x y : A} → x ≡ y → y ≡ x
symmetry refl = refl

transitivity : ∀ {A : Set} {x y z : A} → x ≡ y → y ≡ z → x ≡ z
transitivity refl second = second

congruence : ∀ {A B : Set} (f : A → B) {x y} → x ≡ y → f x ≡ f y
congruence f refl = refl

pairEquality : ∀ {A B : Set} {a a' : A} {b b' : B} →
  a ≡ a' → b ≡ b' → (a , b) ≡ (a' , b')
pairEquality refl refl = refl

record Iff (left right : Set) : Set where
  constructor iff
  field
    forward : left → right
    backward : right → left

open Iff public

------------------------------------------------------------------------
-- Three-term cochain complexes C0 -> C1 -> C2.
------------------------------------------------------------------------

record ThreeTermCochainComplex : Set₁ where
  field
    C0 C1 C2 : Set
    zero2 : C2
    d0 : C0 → C1
    d1 : C1 → C2
    dSquaredZero : ∀ cochain → d1 (d0 cochain) ≡ zero2

open ThreeTermCochainComplex public

Closed1 : (complex : ThreeTermCochainComplex) → C1 complex → Set
Closed1 complex cochain = d1 complex cochain ≡ zero2 complex

Exact1 : (complex : ThreeTermCochainComplex) → C1 complex → Set
Exact1 complex cochain =
  Σ (C0 complex) (λ primitive → d0 complex primitive ≡ cochain)

exactOneCochainIsClosed :
  ∀ complex cochain → Exact1 complex cochain → Closed1 complex cochain
exactOneCochainIsClosed complex cochain (primitive , primitiveEquation) =
  transitivity
    (congruence (d1 complex) (symmetry primitiveEquation))
    (dSquaredZero complex primitive)

------------------------------------------------------------------------
-- Cochain maps and exact functorial laws.
------------------------------------------------------------------------

record CochainMap
    (source target : ThreeTermCochainComplex) : Set₁ where
  field
    map0 : C0 source → C0 target
    map1 : C1 source → C1 target
    map2 : C2 source → C2 target
    map2Zero : map2 (zero2 source) ≡ zero2 target
    commute0 : ∀ x →
      map1 (d0 source x) ≡ d0 target (map0 x)
    commute1 : ∀ x →
      d1 target (map1 x) ≡ map2 (d1 source x)

open CochainMap public

identityCochainMap : ∀ complex → CochainMap complex complex
identityCochainMap complex = record
  { map0 = λ x → x
  ; map1 = λ x → x
  ; map2 = λ x → x
  ; map2Zero = refl
  ; commute0 = λ x → refl
  ; commute1 = λ x → refl
  }

composeCochainMap :
  ∀ {first middle last} →
  CochainMap first middle →
  CochainMap middle last →
  CochainMap first last
composeCochainMap firstMap secondMap = record
  { map0 = λ x → map0 secondMap (map0 firstMap x)
  ; map1 = λ x → map1 secondMap (map1 firstMap x)
  ; map2 = λ x → map2 secondMap (map2 firstMap x)
  ; map2Zero =
      transitivity
        (congruence (map2 secondMap) (map2Zero firstMap))
        (map2Zero secondMap)
  ; commute0 = λ x →
      transitivity
        (congruence (map1 secondMap) (commute0 firstMap x))
        (commute0 secondMap (map0 firstMap x))
  ; commute1 = λ x →
      transitivity
        (commute1 secondMap (map1 firstMap x))
        (congruence (map2 secondMap) (commute1 firstMap x))
  }

cochainMapPreservesClosed :
  ∀ {source target} (mapping : CochainMap source target) cochain →
  Closed1 source cochain → Closed1 target (map1 mapping cochain)
cochainMapPreservesClosed mapping cochain closed =
  transitivity
    (commute1 mapping cochain)
    (transitivity
      (congruence (map2 mapping) closed)
      (map2Zero mapping))

cochainMapPreservesExact :
  ∀ {source target} (mapping : CochainMap source target) cochain →
  Exact1 source cochain → Exact1 target (map1 mapping cochain)
cochainMapPreservesExact mapping cochain (primitive , primitiveEquation) =
  map0 mapping primitive ,
  transitivity
    (symmetry (commute0 mapping primitive))
    (congruence (map1 mapping) primitiveEquation)

------------------------------------------------------------------------
-- A proof-level cohomology relation and cochain homotopies.
------------------------------------------------------------------------

record AdditiveOneCochainComplex : Set₁ where
  field
    underlying : ThreeTermCochainComplex
    zero1 : C1 underlying
    add1 : C1 underlying → C1 underlying → C1 underlying
    add1Associative : ∀ x y z →
      add1 (add1 x y) z ≡ add1 x (add1 y z)
    add1Commutative : ∀ x y → add1 x y ≡ add1 y x
    add1IdentityRight : ∀ x → add1 x zero1 ≡ x

open AdditiveOneCochainComplex public

OneCohomologous :
  (complex : AdditiveOneCochainComplex) →
  C1 (underlying complex) → C1 (underlying complex) → Set
OneCohomologous complex left right =
  Σ (C0 (underlying complex))
    (λ homotopy →
      left ≡ add1 complex right (d0 (underlying complex) homotopy))

record OneCochainHomotopy
    {source : ThreeTermCochainComplex}
    {target : AdditiveOneCochainComplex}
    (first second : CochainMap source (underlying target)) : Set₁ where
  field
    homotopy1 : C1 source → C0 (underlying target)
    homotopyEquation : ∀ cochain →
      map1 first cochain
      ≡ add1 target (map1 second cochain)
          (d0 (underlying target) (homotopy1 cochain))

open OneCochainHomotopy public

homotopicMapsGiveCohomologousImages :
  ∀ {source target}
    {first second : CochainMap source (underlying target)} →
  OneCochainHomotopy first second →
  (cochain : C1 source) →
  OneCohomologous target (map1 first cochain) (map1 second cochain)
homotopicMapsGiveCohomologousImages homotopy cochain =
  homotopy1 homotopy cochain , homotopyEquation homotopy cochain

------------------------------------------------------------------------
-- Direct products of cochain complexes.
------------------------------------------------------------------------

productCochainComplex :
  ThreeTermCochainComplex → ThreeTermCochainComplex →
  ThreeTermCochainComplex
productCochainComplex left right = record
  { C0 = C0 left × C0 right
  ; C1 = C1 left × C1 right
  ; C2 = C2 left × C2 right
  ; zero2 = zero2 left , zero2 right
  ; d0 = λ pair → d0 left (proj₁ pair) , d0 right (proj₂ pair)
  ; d1 = λ pair → d1 left (proj₁ pair) , d1 right (proj₂ pair)
  ; dSquaredZero = λ pair →
      pairEquality
        (dSquaredZero left (proj₁ pair))
        (dSquaredZero right (proj₂ pair))
  }

closedInProductIffComponentwise :
  ∀ left right (cochain : C1 left × C1 right) →
  Iff
    (Closed1 (productCochainComplex left right) cochain)
    (Closed1 left (proj₁ cochain) × Closed1 right (proj₂ cochain))
closedInProductIffComponentwise left right (leftCochain , rightCochain) =
  iff
    (λ equality → split equality)
    (λ componentProofs →
      pairEquality (proj₁ componentProofs) (proj₂ componentProofs))
  where
    split :
      (d1 left leftCochain , d1 right rightCochain)
      ≡ (zero2 left , zero2 right) →
      d1 left leftCochain ≡ zero2 left
      × d1 right rightCochain ≡ zero2 right
    split refl = refl , refl

exactComponentsGiveExactProduct :
  ∀ left right (leftCochain : C1 left) (rightCochain : C1 right) →
  Exact1 left leftCochain → Exact1 right rightCochain →
  Exact1 (productCochainComplex left right) (leftCochain , rightCochain)
exactComponentsGiveExactProduct left right leftCochain rightCochain
    (leftPrimitive , leftEquation)
    (rightPrimitive , rightEquation) =
  (leftPrimitive , rightPrimitive) ,
  pairEquality leftEquation rightEquation
