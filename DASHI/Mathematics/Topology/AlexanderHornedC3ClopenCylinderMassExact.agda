module DASHI.Mathematics.Topology.AlexanderHornedC3ClopenCylinderMassExact where

------------------------------------------------------------------------
-- REUSE ACTUAL EXISTING BINARY CANTOR CLOPEN AND CYLINDER MEASURE OWNERS
--
-- Exact existing owners:
--   Foundations.CantorProjectiveCylinderMeasureExact:
--       dyadic mass, parent = sum children.
--   Foundations.CantorFiniteClopenPremeasureExact:
--       depth-indexed finite Boolean algebra and refinement mass.
--   Foundations.InverseLimitClopenRefinement:
--       compatible threads and clopen-chain INTERFACE.
--   Geometry.SSP369ClopenBallBridge:
--       finite prefix refinement, BUT 'open'/'closed' in that file
--       are status constructors, not proofs in an ambient topology.
--   Topology.AlexanderHornedC3FiniteStageExact:
--       three sector labels, binary left/right prepend.
--   Topology.AlexanderHornedBinaryPadicCylinderExact:
--       chronological binary stream prefix refinement.
--
-- NEW: exact meridian HornAddress -> EXISTING Cantor cylinder
--         and normalized C3-invariant mass
--
-- Each chosen (sector,prefix-length n) cylinder has dyadic mass
-- 1/(3*2^n). For fixed sector it refines to two half-mass
-- children; the sum over all 3 sectors at depth 0 is exactly 1.
-- Rotation changes only the sector and preserves these masses.
--
-- This models the INTRINSIC endpoint Cantor topology only.
-- NOT an ambient R3-ball, Hatcher linking/van Kampen, a
-- wild embedding, or a sigma-additive Borel measure extension.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Bool using (Bool; false; true)
open import Agda.Builtin.List using (List; []; _∷_)
open import Data.Integer.Base using (+_)
open import Data.Rational using (ℚ; 0ℚ; 1ℚ; _+_; _*_; _/_)
import Data.Rational.Tactic.RingSolver as Ring
open import Relation.Binary.PropositionalEquality using (cong; trans)

import DASHI.Mathematics.Topology.AlexanderHornedC3FiniteStageExact as Horn
import DASHI.Mathematics.Topology.AlexanderHornedBinaryPadicCylinderExact as Bin
import DASHI.Foundations.CantorProjectiveCylinderMeasureExact as Cantor
import DASHI.Core.FiniteC3OrbitStabilizerExact as C3

oneThird : ℚ
oneThird = (+ 1) / 3

bitToBool : Horn.Bit → Bool
bitToBool Horn.left = false
bitToBool Horn.right = true

prefixBitsToBools : List Horn.Bit → List Bool
prefixBitsToBools [] = []
prefixBitsToBools (b ∷ bs) = bitToBool b ∷ prefixBitsToBools bs

cylinderOf : Horn.HornAddress → Cantor.Cylinder
cylinderOf (Horn.address sector suffix) =
  Cantor.cylinder (prefixBitsToBools suffix)

leftChildIsExistingCantorLeft :
  ∀ a → cylinderOf (Horn.leftChild a) ≡
    Cantor.leftChild (cylinderOf a)
leftChildIsExistingCantorLeft (Horn.address sector suffix) = refl

rightChildIsExistingCantorRight :
  ∀ a → cylinderOf (Horn.rightChild a) ≡
    Cantor.rightChild (cylinderOf a)
rightChildIsExistingCantorRight (Horn.address sector suffix) = refl

rotationRetainsCylinder : ∀ a →
  cylinderOf (Horn.rotateAddress a) ≡ cylinderOf a
rotationRetainsCylinder (Horn.address sector suffix) = refl

sectorCylinderMass : Horn.HornAddress → ℚ
sectorCylinderMass a = oneThird * Cantor.cylinderMass (cylinderOf a)

rotationPreservesSectorCylinderMass : ∀ a →
  sectorCylinderMass (Horn.rotateAddress a) ≡ sectorCylinderMass a
rotationPreservesSectorCylinderMass (Horn.address sector suffix) = refl

-- This is a genuine same-object reuse of Cantor's dyadic mass theorem.
sectorMassRefinesExactly : ∀ a →
  sectorCylinderMass (Horn.leftChild a)
  + sectorCylinderMass (Horn.rightChild a)
  ≡ sectorCylinderMass a
sectorMassRefinesExactly a =
  trans
    (Ring.solve-∀
      (Cantor.cylinderMass (Cantor.leftChild (cylinderOf a)))
      (Cantor.cylinderMass (Cantor.rightChild (cylinderOf a))))
    (cong (oneThird *_)
      (Cantor.parentMassSplitsExactly (cylinderOf a)))

root : C3.C3 → Horn.HornAddress
root c = Horn.address c []

rootSectorMass : ∀ c → sectorCylinderMass (root c) ≡ oneThird
rootSectorMass C3.c0 = Ring.solve-∀
rootSectorMass C3.c1 = Ring.solve-∀
rootSectorMass C3.c2 = Ring.solve-∀

allThreeRootsHaveUnitMass :
  sectorCylinderMass (root C3.c0)
  + sectorCylinderMass (root C3.c1)
  + sectorCylinderMass (root C3.c2) ≡ 1ℚ
allThreeRootsHaveUnitMass = Ring.solve-∀

------------------------------------------------------------------------
-- True binary clopen MEASURABILITY at the finite stage.
--
-- Literal prefix equality gives a decidable characteristic function.
-- Complement is an equally finite-observable characteristic function.
-- Their inverse images of the discrete Bool values are clopen in
-- the inverse-limit topology GENERATED BY finite projections.
--
-- A proposition about the topology of an ambient embedded R3 ball
-- cannot be inferred by importing this discrete data.
------------------------------------------------------------------------

bitEq : Horn.Bit → Horn.Bit → Bool
bitEq Horn.left Horn.left = true
bitEq Horn.right Horn.right = true
bitEq Horn.left Horn.right = false
bitEq Horn.right Horn.left = false

andBool : Bool → Bool → Bool
andBool true true = true
andBool _ _ = false

notBool : Bool → Bool
notBool true = false
notBool false = true

prefixEq : ∀ {n} →
  Bin.BitPrefix n → Bin.BitPrefix n → Bool
prefixEq Bin.[]ᵇ Bin.[]ᵇ = true
prefixEq (a Bin.∷ᵇ as) (b Bin.∷ᵇ bs) =
  andBool (bitEq a b) (prefixEq as bs)

prefixEqReflexive : ∀ {n} (xs : Bin.BitPrefix n) →
  prefixEq xs xs ≡ true
prefixEqReflexive Bin.[]ᵇ = refl
prefixEqReflexive (Horn.left Bin.∷ᵇ bs)
  rewrite prefixEqReflexive bs = refl
prefixEqReflexive (Horn.right Bin.∷ᵇ bs)
  rewrite prefixEqReflexive bs = refl

prefixCylinderMember : ∀ {n} →
  Bin.BitPrefix n → Bin.BitStream → Bool
prefixCylinderMember prefix stream =
  prefixEq prefix (Bin.projectBits _ stream)

prefixCylinderComplement : ∀ {n} →
  Bin.BitPrefix n → Bin.BitStream → Bool
prefixCylinderComplement prefix stream =
  notBool (prefixCylinderMember prefix stream)

membershipAndComplementExclusive :
  ∀ {n} prefix stream →
  andBool (prefixCylinderMember {n} prefix stream)
    (prefixCylinderComplement prefix stream) ≡ false
membershipAndComplementExclusive prefix stream
  with prefixCylinderMember prefix stream
... | true = refl
... | false = refl

membershipAndComplementExhaustive :
  ∀ {n} prefix stream →
  notBool (andBool
    (notBool (prefixCylinderMember {n} prefix stream))
    (notBool (prefixCylinderComplement prefix stream))) ≡ true
membershipAndComplementExhaustive prefix stream
  with prefixCylinderMember prefix stream
... | true = refl
... | false = refl

-- A cylinder at n+1 is contained in its projected parent at n.
-- This is a REAL refinement proof on actual projected prefixes;
-- not a Boolean 'isClopen=true' status tag.
nestedProjectedCylinder :
  ∀ n prefix stream →
  Bin.projectBits (suc n) stream ≡ prefix →
  Bin.projectBits n stream ≡ Bin.dropNewest n prefix
nestedProjectedCylinder n prefix stream eq =
  trans
    (sym (Bin.binaryProjectionCompatible n stream))
    (cong (Bin.dropNewest n) eq)
  where
    open import Relation.Binary.PropositionalEquality using (sym)
