------------------------------------------------------------------------
-- Actuation-state fibre.
------------------------------------------------------------------------

data RemedyRealisationAxis : Set where
  meritsFinding
  remedySpecification
  directDomesticCompulsion
  domesticImplementationCapacity
  politicalActuation
  communityAuthority
  communityDefinedOutcome
  independentMonitoring
  correctiveRevision
  terminalRealisedRepair
  : RemedyRealisationAxis

data AxisState : Set where
  paid
  presentButConditional
  absentByDefault
  open
  sourceOutcomeRequired
  : AxisState

billyCurrentActuationState : RemedyRealisationAxis → AxisState
billyCurrentActuationState meritsFinding = paid
billyCurrentActuationState remedySpecification = paid
billyCurrentActuationState directDomesticCompulsion = absentByDefault
billyCurrentActuationState domesticImplementationCapacity = paid
billyCurrentActuationState politicalActuation = presentButConditional
billyCurrentActuationState communityAuthority = open
billyCurrentActuationState communityDefinedOutcome = open
billyCurrentActuationState independentMonitoring = presentButConditional
billyCurrentActuationState correctiveRevision = sourceOutcomeRequired
billyCurrentActuationState terminalRealisedRepair = open

record RemedyRealisationBoundary : Set where
  constructor remedy-realisation-boundary
  field
    meritsFindingEqualsImplementation : Bool
    meritsFindingEqualsImplementationIsFalse : meritsFindingEqualsImplementation ≡ false
    implementationCapacityEqualsImplementation : Bool
    implementationCapacityEqualsImplementationIsFalse :
      implementationCapacityEqualsImplementation ≡ false
    implementationEqualsCommunityAdequacy : Bool
    implementationEqualsCommunityAdequacyIsFalse :
      implementationEqualsCommunityAdequacy ≡ false
    monitoringEqualsCorrection : Bool
    monitoringEqualsCorrectionIsFalse : monitoringEqualsCorrection ≡ false
    doctrineRejectedEqualsRelationTransformed : Bool
    doctrineRejectedEqualsRelationTransformedIsFalse :
      doctrineRejectedEqualsRelationTransformed ≡ false
    juridicalHumanityRestoredInOneCoordinateClosesCountryRepair : Bool
    juridicalHumanityRestoredInOneCoordinateClosesCountryRepairIsFalse :
      juridicalHumanityRestoredInOneCoordinateClosesCountryRepair ≡ false

open RemedyRealisationBoundary public

canonicalRemedyRealisationBoundary : RemedyRealisationBoundary
canonicalRemedyRealisationBoundary = remedy-realisation-boundary
  false refl
  false refl
  false refl
  false refl
  false refl
  false refl

