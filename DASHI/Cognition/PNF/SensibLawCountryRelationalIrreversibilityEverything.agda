      permanentHistoricalLossRequiresFrozenCultureModel ≡ false
    countryRelationIsFungibleByEquivalentLandArea : Bool
    countryRelationIsFungibleByEquivalentLandAreaIsFalse :
      countryRelationIsFungibleByEquivalentLandArea ≡ false
    custodialResponsibilityEqualsEconomicPropertyUse : Bool
    custodialResponsibilityEqualsEconomicPropertyUseIsFalse :
      custodialResponsibilityEqualsEconomicPropertyUse ≡ false
    sourceFindingAutomaticallyBecomesUniversalIndigenousOntology : Bool
    sourceFindingAutomaticallyBecomesUniversalIndigenousOntologyIsFalse :
      sourceFindingAutomaticallyBecomesUniversalIndigenousOntology ≡ false

open CountryRelationalRealisedStateBoundary public

