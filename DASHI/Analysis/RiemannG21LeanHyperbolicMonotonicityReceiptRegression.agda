  Receipt.LeanHyperbolicMonotonicityReceiptBoundary.scaledTanhMonotonicitySourceWrittenIsTrue
    Receipt.canonicalLeanHyperbolicMonotonicityReceiptBoundary

regressionLeanCothSourceWritten :
