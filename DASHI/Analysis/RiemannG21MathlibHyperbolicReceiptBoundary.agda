module DASHI.Analysis.RiemannG21MathlibHyperbolicReceiptBoundary where

open import DASHI.Core.Prelude
open import Agda.Builtin.String using (String)

------------------------------------------------------------------------
-- MACHINE-CHECKED EXTERNAL SOURCE INVENTORY
--
-- Mathlib 4, Mathlib.Analysis.SpecialFunctions.Trigonometric.DerivHyp and
-- Mathlib.Analysis.Complex.Trigonometric, current theorem surface inspected
-- 2026-08-27.
--
-- Relevant source theorems:
--
--   Real.self_lt_sinh_iff : x < sinh x <-> 0 < x
--   Real.sinh_pos_iff     : 0 < sinh x <-> 0 < x
--   Real.cosh_pos         : 0 < cosh x
--   Real.tanh_eq_sinh_div_cosh
--   Real.sinh_two_mul
--
-- These facts are enough to make the atomic odd-sector inequality
--
--   sinh x cosh x > x,  x > 0
--
-- a short Lean consequence: apply self_lt_sinh_iff at 2x and rewrite with
-- sinh_two_mul.  They also supply the positivity facts used in the tanh route.
--
-- This DASHI file is a receipt/boundary only.  It does not pretend an Agda
-- theorem has been transported from Lean until an explicit proof-translation
-- or independently checked Agda proof is present.
------------------------------------------------------------------------

record ExternalTheoremReceipt : Set where
  constructor externalTheoremReceipt
  field
    library : String
    moduleName : String
    theoremName : String
    theoremRole : String

open ExternalTheoremReceipt public

selfLtSinhReceipt : ExternalTheoremReceipt
selfLtSinhReceipt =
  externalTheoremReceipt
    "Mathlib 4"
    "Mathlib.Analysis.SpecialFunctions.Trigonometric.DerivHyp"
    "Real.self_lt_sinh_iff"
    "For x>0, supplies x < sinh x; applied at 2x this is the core strict inequality needed for the derivative of x*coth x."

sinhPosReceipt : ExternalTheoremReceipt
sinhPosReceipt =
  externalTheoremReceipt
    "Mathlib 4"
    "Mathlib.Analysis.SpecialFunctions.Trigonometric.DerivHyp"
    "Real.sinh_pos_iff"
    "Supplies strict positivity of sinh on the positive axis."

coshPosReceipt : ExternalTheoremReceipt
coshPosReceipt =
  externalTheoremReceipt
    "Mathlib 4"
    "Mathlib.Analysis.Complex.Trigonometric"
    "Real.cosh_pos"
    "Supplies strict positivity of cosh, hence a positive denominator for tanh=sinh/cosh."

tanhDefinitionReceipt : ExternalTheoremReceipt
tanhDefinitionReceipt =
  externalTheoremReceipt
    "Mathlib 4"
    "Mathlib.Analysis.Complex.Trigonometric"
    "Real.tanh_eq_sinh_div_cosh"
    "Rewrites tanh as sinh/cosh so positive-axis tanh positivity follows from sinh and cosh positivity."

sinhTwoMulReceipt : ExternalTheoremReceipt
sinhTwoMulReceipt =
  externalTheoremReceipt
    "Mathlib 4"
    "Mathlib.Analysis.Complex.Trigonometric"
    "Real.sinh_two_mul"
    "Rewrites sinh(2x) as 2*sinh(x)*cosh(x), converting self_lt_sinh at 2x into sinh(x)cosh(x)>x."

canonicalMathlibHyperbolicReceipts : List ExternalTheoremReceipt
canonicalMathlibHyperbolicReceipts =
  selfLtSinhReceipt
  ∷ sinhPosReceipt
  ∷ coshPosReceipt
  ∷ tanhDefinitionReceipt
  ∷ sinhTwoMulReceipt
  ∷ []

------------------------------------------------------------------------
-- Exact bridge obligations generated by those receipts.
------------------------------------------------------------------------

record MathlibHyperbolicBridgeTarget : Set₁ where
  field
    Real : Set
    Positive : Real → Set
    StrictGreater : Real → Real → Set
    sinh cosh tanh : Real → Real
    multiply : Real → Real → Real

    sinhCoshDominatesIdentity :
      (x : Real) → Positive x →
      StrictGreater (multiply (sinh x) (cosh x)) x

    tanhPositive :
      (x : Real) → Positive x →
      StrictGreater (tanh x) x → Set

    bridgeReading : String

record MathlibHyperbolicReceiptBoundary : Set where
  constructor mathlibHyperbolicReceiptBoundary
  field
    selfLtSinhTheoremLocated : Bool
    selfLtSinhTheoremLocatedIsTrue : selfLtSinhTheoremLocated ≡ true
    sinhPosTheoremLocated : Bool
    sinhPosTheoremLocatedIsTrue : sinhPosTheoremLocated ≡ true
    coshPosTheoremLocated : Bool
    coshPosTheoremLocatedIsTrue : coshPosTheoremLocated ≡ true
    tanhDefinitionTheoremLocated : Bool
    tanhDefinitionTheoremLocatedIsTrue : tanhDefinitionTheoremLocated ≡ true
    sinhTwoMulTheoremLocated : Bool
    sinhTwoMulTheoremLocatedIsTrue : sinhTwoMulTheoremLocated ≡ true
    leanProofTermImportedIntoAgda : Bool
    leanProofTermImportedIntoAgdaIsFalse : leanProofTermImportedIntoAgda ≡ false
    independentAgdaHyperbolicProofDerived : Bool
    independentAgdaHyperbolicProofDerivedIsFalse : independentAgdaHyperbolicProofDerived ≡ false

canonicalMathlibHyperbolicReceiptBoundary : MathlibHyperbolicReceiptBoundary
canonicalMathlibHyperbolicReceiptBoundary =
  mathlibHyperbolicReceiptBoundary
    true refl
    true refl
    true refl
    true refl
    true refl
    false refl
    false refl
