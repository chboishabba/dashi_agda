      (phaseMul (mulIndex i0 x) (atSignal spectrum i0))
      (phaseMul (mulIndex i1 x) (atSignal spectrum i1))
      (phaseMul (mulIndex i2 x) (atSignal spectrum i2))
      (phaseMul (mulIndex i3 x) (atSignal spectrum i3))
      (phaseMul (mulIndex i4 x) (atSignal spectrum i4))
      (phaseMul (mulIndex i5 x) (atSignal spectrum i5))
      (phaseMul (mulIndex i6 x) (atSignal spectrum i6))
      (phaseMul (mulIndex i7 x) (atSignal spectrum i7))
      (phaseMul (mulIndex i8 x) (atSignal spectrum i8))
