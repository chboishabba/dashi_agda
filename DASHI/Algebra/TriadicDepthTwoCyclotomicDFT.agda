-- A phase-invariant rational Hermitian form and Parseval theorem.

dotC9 : C9 → C9 → ℚ
dotC9 (c9 a0 a1 a2 a3 a4 a5) (c9 b0 b1 b2 b3 b4 b5) =
  a0 * b0 + (a1 * b1 + (a2 * b2 + (a3 * b3 + (a4 * b4 + a5 * b5))))

invariantPair : C9 → C9 → ℚ
invariantPair a b =
  sum9Q
    (dotC9 (phaseMul i0 a) (phaseMul i0 b))
    (dotC9 (phaseMul i1 a) (phaseMul i1 b))
    (dotC9 (phaseMul i2 a) (phaseMul i2 b))
    (dotC9 (phaseMul i3 a) (phaseMul i3 b))
    (dotC9 (phaseMul i4 a) (phaseMul i4 b))
    (dotC9 (phaseMul i5 a) (phaseMul i5 b))
    (dotC9 (phaseMul i6 a) (phaseMul i6 b))
    (dotC9 (phaseMul i7 a) (phaseMul i7 b))
    (dotC9 (phaseMul i8 a) (phaseMul i8 b))

signalEnergy : Signal9 → ℚ
signalEnergy f =
  sum9Q
    (invariantPair (atSignal f i0) (atSignal f i0))
    (invariantPair (atSignal f i1) (atSignal f i1))
    (invariantPair (atSignal f i2) (atSignal f i2))
    (invariantPair (atSignal f i3) (atSignal f i3))
    (invariantPair (atSignal f i4) (atSignal f i4))
    (invariantPair (atSignal f i5) (atSignal f i5))
    (invariantPair (atSignal f i6) (atSignal f i6))
    (invariantPair (atSignal f i7) (atSignal f i7))
    (invariantPair (atSignal f i8) (atSignal f i8))

