synthesize9 : Signal9 → Signal9
synthesize9 spectrum = signal9
    (synthesizeAt spectrum i0)
    (synthesizeAt spectrum i1)
    (synthesizeAt spectrum i2)
    (synthesizeAt spectrum i3)
    (synthesizeAt spectrum i4)
