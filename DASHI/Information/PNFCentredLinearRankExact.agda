module DASHI.Information.PNFCentredLinearRankExact where

-- Exact whole-linear-map factorisation of a source-centred n×p matrix
-- through n-1 coordinates. Reuses the already constructed *linear*
-- zero-sum decoder and original source-owned centring receipts.
open import Agda.Builtin.Equality using (_≡_)
open import Agda.Builtin.Nat using (Nat; suc)
open import Data.Fin.Base using (Fin; zero; suc)
open import Relation.Binary.PropositionalEquality using (cong; trans; sym)

import DASHI.Physics.Closure.NSTriadKNExactOrderedScalar as Scalar
import DASHI.Physics.Closure.NSTriadKNPhysicalCutoffInnerProduct as Ring
import DASHI.Information.PNFFiniteCovarianceEconomicsExact as Matrix
import DASHI.Information.PNFCentredCovarianceExact as Centre
import DASHI.Information.PNFSampleMeanExact as Mean
import DASHI.Information.PNFCentredRankDependencyExact as Dependency
import DASHI.Information.PNFCentredRankFactorisationExact as Factor
import DASHI.Information.PNFFiniteSumExchangeExact as Exchange
import DASHI.Information.PNFFiniteBilinearExpansionExact as Bilinear

private
  SOf : Ring.ExactOrderedCommutativeRing → Set
  SOf K = Scalar.Scalar (Ring.orderedScalar K)

-- Whole vector action, in the original observed row order.
centredAction :
  (K : Ring.ExactOrderedCommutativeRing) →
  {k p : Nat} → (M : Mean.ActualFiniteMean K (suc k) p) →
  (Fin p → SOf K) → Fin (suc k) → SOf K
centredAction K M v r =
  Ring.sumFin (Ring.orderedScalar K)
    (λ i → Scalar._*_ (Ring.orderedScalar K)
      (v i) (Matrix.entry
        (Centre.centredMatrix K (Mean.source M)) r i))

-- A k-coordinate linear map; no arbitrary rank receipt or axiom.
tailAction :
  (K : Ring.ExactOrderedCommutativeRing) →
  {k p : Nat} → (M : Mean.ActualFiniteMean K (suc k) p) →
  (Fin p → SOf K) → Fin k → SOf K
tailAction K M v t =
  Ring.sumFin (Ring.orderedScalar K)
    (λ i → Scalar._*_ (Ring.orderedScalar K)
      (v i) (Factor.centeredTail K M i t))

-- The full n-row linear action factors through the n-1 tail action.
-- The nontrivial first-row proof uses finite Fubini and minus-sum
-- centring, not a set-valued statement or unspecified matrix rank.
centredActionFactorsThroughTail :
  (K : Ring.ExactOrderedCommutativeRing) →
  {k p : Nat} → (M : Mean.ActualFiniteMean K (suc k) p) →
  (v : Fin p → SOf K) → (r : Fin (suc k)) →
  Factor.reconstructZeroSum K (tailAction K M v) r
    ≡ centeredAction K M v r
centredActionFactorsThroughTail K {k} {p} M v zero =
  let S = Ring.orderedScalar K
      x = λ t i → Factor.centeredTail K M i t
      tsum = λ i → Ring.sumFin S (λ t → x t i)
      row0 = λ i → Matrix.entry
        (Centre.centredMatrix K (Mean.source M)) zero i
  in
  trans
    (cong (Scalar.neg S)
      (Exchange.finiteSumExchange K
        (λ t i → Scalar._*_ S (v i) (x t i))))
    (trans
      (cong (Scalar.neg S)
        (Ring.sumFinCong S
          (λ i → Ring.sumFinMulLeft K (v i)
            (λ t → x t i))))
      (trans
        (sym (Ring.sumFinNeg K
          (λ i → Scalar._*_ S (v i) (tsum i))))
        (trans
          (Ring.sumFinCong S
            (λ i → Factor.negativeOfProductMovesRight K (v i) (tsum i)))
          (Ring.sumFinCong S
            (λ i → cong (Scalar._*_ S (v i))
              (sym (Dependency.centredFirstRowDeterminedByRemainingRows K M i)))))))
centredActionFactorsThroughTail K M v (suc t) = refl

-- Unlike a generic factorisation of column *sets*, this equality
-- connects the selected entire linear operator to its k-coordinate
-- action. The image therefore lies in a subspace generated by ≤k
-- vectors once the selected field's finite-dimensional rank theorem
-- identifies factorisation dimension with ordinary matrix rank.

-- Both legs of the rank factorisation are linear, not merely functions.
tailActionPreservesAddition :
  (K : Ring.ExactOrderedCommutativeRing) →
  {k p : Nat} → (M : Mean.ActualFiniteMean K (suc k) p) →
  (u v : Fin p → SOf K) → (t : Fin k) →
  tailAction K M (Factor.pointwiseAdd K u v) t ≡
  Factor.pointwiseAdd K (tailAction K M u) (tailAction K M v) t
tailActionPreservesAddition K M u v t =
  let S = Ring.orderedScalar K
      x = λ i → Factor.centeredTail K M i t
  in
  trans
    (Ring.sumFinCong S
      (λ i → Ring.mulDistributesOverAdditionLeft K (u i) (v i) (x i)))
    (Ring.sumFinAdd K
      (λ i → Scalar._*_ S (u i) (x i))
      (λ i → Scalar._*_ S (v i) (x i)))

tailActionPreservesScaling :
  (K : Ring.ExactOrderedCommutativeRing) →
  {k p : Nat} → (M : Mean.ActualFiniteMean K (suc k) p) →
  (c : SOf K) → (v : Fin p → SOf K) → (t : Fin k) →
  tailAction K M (Factor.pointwiseScale K c v) t ≡
  Factor.pointwiseScale K c (tailAction K M v) t
tailActionPreservesScaling K M c v t =
  let S = Ring.orderedScalar K
      x = λ i → Factor.centeredTail K M i t
  in
  trans
    (Ring.sumFinCong S
      (λ i → Ring.mulAssociative K c (v i) (x i)))
    (Ring.sumFinMulLeft K c
      (λ i → Scalar._*_ S (v i) (x i)))
