module DASHI.Physics.ExoticGravity.LiTorrStandardGRComparatorBidiExact where

open import DASHI.Core.Prelude
open import Agda.Builtin.String using (String)

------------------------------------------------------------------------
-- SAME-APPARATUS STANDARD-GR COMPARATOR
--
-- The exotic residual is not measured against zero.  It is measured against
-- the ordinary weak-field gravity generated by the actual stress-energy and
-- mass-current configuration of the apparatus, plus ordinary backgrounds.
------------------------------------------------------------------------

record ApparatusSource : Set₁ where
  constructor apparatus-source
  field
    Geometry MaterialState CurrentDistribution MassCurrentDistribution : Set
    StressEnergyDistribution ProbeWorldline : Set
    sourceDescription : String

open ApparatusSource public

record OrdinaryComparator : Set₁ where
  constructor ordinary-comparator
  field
    apparatus : ApparatusSource
    WeakFieldMetric GravitoelectricField GravitomagneticField : Set
    ElectromagneticBackground MechanicalBackground ThermalBackground : Set
    predictedObservable : String

open OrdinaryComparator public

------------------------------------------------------------------------
-- Residual decomposition.
------------------------------------------------------------------------

record ResidualDecomposition : Set where
  constructor residual-decomposition
  field
    measuredSignal : String
    standardGRSignal : String
    electromagneticSignal : String
    mechanicalSignal : String
    thermalSignal : String
    unexplainedResidual : String

canonicalResidualEquation : ResidualDecomposition
canonicalResidualEquation = residual-decomposition
  "R_measured"
  "R_GR(same apparatus geometry and source currents)"
  "R_EM"
  "R_mechanical"
  "R_thermal"
  "R_exotic = R_measured - R_GR - R_EM - R_mechanical - R_thermal"

------------------------------------------------------------------------
-- Standard GR source bookkeeping.
------------------------------------------------------------------------

record StandardGRSourceBoundary : Set where
  constructor standard-gr-source-boundary
  field
    energyDensityOnlyDeterminesWeakField : Bool
    energyDensityOnlyDeterminesWeakFieldIsFalse :
      energyDensityOnlyDeterminesWeakField ≡ false

    momentumDensityMassCurrentIsIndependentSourceCoordinate : Bool
    momentumDensityMassCurrentIsIndependentSourceCoordinateIsTrue :
      momentumDensityMassCurrentIsIndependentSourceCoordinate ≡ true

    superconductingPhaseCanChangeSourceTermsWithoutNewGravityLaw : Bool
    superconductingPhaseCanChangeSourceTermsWithoutNewGravityLawIsTrue :
      superconductingPhaseCanChangeSourceTermsWithoutNewGravityLaw ≡ true

    phaseCorrelationAloneProvesNewCoupling : Bool
    phaseCorrelationAloneProvesNewCouplingIsFalse :
      phaseCorrelationAloneProvesNewCoupling ≡ false

canonicalStandardGRSourceBoundary : StandardGRSourceBoundary
canonicalStandardGRSourceBoundary =
  standard-gr-source-boundary false refl true refl true refl false refl

------------------------------------------------------------------------
-- BIDI acquisition leaves for a quantitative standard-GR comparator.
------------------------------------------------------------------------

data GRComparatorLeaf : Set where
  apparatusGeometryLeaf : GRComparatorLeaf
  stressEnergyLeaf : GRComparatorLeaf
  massCurrentLeaf : GRComparatorLeaf
  probeGeometryLeaf : GRComparatorLeaf
  weakFieldSolverLeaf : GRComparatorLeaf
  backgroundClosureLeaf : GRComparatorLeaf
  comparatorClosed : GRComparatorLeaf

record GRComparatorState : Set where
  constructor gr-comparator-state
  field
    geometryOwned : Bool
    stressEnergyOwned : Bool
    massCurrentOwned : Bool
    probeGeometryOwned : Bool
    weakFieldPredictionOwned : Bool
    backgroundsOwned : Bool

firstOpenGRComparatorLeaf : GRComparatorState → GRComparatorLeaf
firstOpenGRComparatorLeaf (gr-comparator-state false s m p w b) = apparatusGeometryLeaf
firstOpenGRComparatorLeaf (gr-comparator-state true false m p w b) = stressEnergyLeaf
firstOpenGRComparatorLeaf (gr-comparator-state true true false p w b) = massCurrentLeaf
firstOpenGRComparatorLeaf (gr-comparator-state true true true false w b) = probeGeometryLeaf
firstOpenGRComparatorLeaf (gr-comparator-state true true true true false b) = weakFieldSolverLeaf
firstOpenGRComparatorLeaf (gr-comparator-state true true true true true false) = backgroundClosureLeaf
firstOpenGRComparatorLeaf (gr-comparator-state true true true true true true) = comparatorClosed

------------------------------------------------------------------------
-- A literature mechanism paper does not supply a same-apparatus GR baseline.
------------------------------------------------------------------------

currentGRComparatorFrontier : GRComparatorState
currentGRComparatorFrontier = gr-comparator-state false false false false false false

currentFirstOpenGRComparatorLeaf : GRComparatorLeaf
currentFirstOpenGRComparatorLeaf = firstOpenGRComparatorLeaf currentGRComparatorFrontier
