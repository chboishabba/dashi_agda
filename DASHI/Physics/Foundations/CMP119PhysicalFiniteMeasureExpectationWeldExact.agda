import DASHI.Physics.Foundations.CMP119AntigravityRealHaarExpectationRepresentationExact as Haar
import DASHI.Physics.YangMills.BalabanCMP119FactorizedDensityApproximationExact as Approx
import DASHI.Physics.YangMills.BalabanCMP119FactorizedDensityConvergenceExact as Conv
import DASHI.Physics.YangMills.BalabanCMP119FiniteObservableExpectationConvergenceExact as Expect
import DASHI.Physics.YangMills.BalabanRealSequenceLimitByVanishingErrorExact as Seq
import DASHI.Physics.YangMills.BalabanRealVanishingFiniteAlgebraExact as Vanishing
import DASHI.Physics.YangMills.YangMillsClayPinnedPhysicalCarriersExact as Physical

record PhysicalFiniteMeasureExpectationIdentification
    {SlowField Sequence Component Step : Set}
    {approximation :
      Approx.CMP119FactorizedDensityApproximation
        SlowField Sequence Component Step}
    (states : List SlowField)
    (scale : Nat)
    (observable : SlowField → ℝ)
    (measure : Physical.PhysicalFiniteYMMeasure SlowField ℝ) : Set₁ where
  field
    -- SOURCE-FACING PAYMENT.
    -- This is intentionally the only physical equality introduced here.
    -- It must be justified by the literal selected finite YM/Haar measure;
    -- it is not generated by the factorized-density algebra itself.
    sourceExpectationIsLiteralFiniteYMExpectation :
      Expect.sourceExpectation approximation states scale observable
      ≡ Physical.normalizedExpectation measure observable

open PhysicalFiniteMeasureExpectationIdentification public

compileLiteralFiniteYMExpectationRepresentation :
  ∀ {SlowField Sequence Component Step approximation sequenceLimit}
    {convergence :
      Conv.CMP119FactorizedDensityConvergence
        {SlowField = SlowField}
        {Sequence = Sequence}
        {Component = Component}
        {Step = Step}
        approximation sequenceLimit}
    {vanishing : Vanishing.RealVanishingFiniteAlgebra sequenceLimit}
    {states : List SlowField}
    {scale : Nat}
    {observable : SlowField → ℝ}
    {measure : Physical.PhysicalFiniteYMMeasure SlowField ℝ} →
  PhysicalFiniteMeasureExpectationIdentification
    {approximation = approximation}
    states scale observable measure →
  Haar.RealHaarExpectationRepresentation sequenceLimit
compileLiteralFiniteYMExpectationRepresentation
    {approximation = approximation}
    {convergence = convergence}
    {vanishing = vanishing}
    {states = states}
    {scale = scale}
    {observable = observable}
    {measure = measure}
    identification = record
  { Haar.RealHaarExpectationRepresentation.finiteCMP119Expectation =
      λ refinement →
        Expect.approximateExpectation
          approximation states refinement scale observable
  ; Haar.RealHaarExpectationRepresentation.physicalHaarExpectation =
      Physical.normalizedExpectation measure observable
  ; Haar.RealHaarExpectationRepresentation.representationError =
      λ refinement →
        Expect.expectationErrorBudget
          approximation states refinement scale observable
  ; Haar.RealHaarExpectationRepresentation.finiteApproximatesPhysical =
      λ refinement →
        subst
          (λ physicalValue →
            absℝ
              (physicalValue -ℝ
                Expect.approximateExpectation
                  approximation states refinement scale observable)
            ≤ℝ
            Expect.expectationErrorBudget
              approximation states refinement scale observable)
          (sourceExpectationIsLiteralFiniteYMExpectation identification)
          (Expect.finiteExpectationDifferenceBound
            approximation states refinement scale observable)
  ; Haar.RealHaarExpectationRepresentation.representationErrorVanishes =
      Expect.finiteExpectationBudgetVanishes
        convergence vanishing states scale observable
  }

literalFiniteYMExpectationIsFactorizedLimit :
  ∀ {SlowField Sequence Component Step approximation sequenceLimit}
    {convergence :
      Conv.CMP119FactorizedDensityConvergence
        {SlowField = SlowField}
        {Sequence = Sequence}
        {Component = Component}
        {Step = Step}
        approximation sequenceLimit}
    {vanishing : Vanishing.RealVanishingFiniteAlgebra sequenceLimit}
    {states : List SlowField}
    {scale : Nat}
    {observable : SlowField → ℝ}
    {measure : Physical.PhysicalFiniteYMMeasure SlowField ℝ}
    (identification :
      PhysicalFiniteMeasureExpectationIdentification
        {approximation = approximation}
        states scale observable measure) →
  Seq.limit sequenceLimit
    (λ refinement →
      Expect.approximateExpectation
        approximation states refinement scale observable)
  ≡ Physical.normalizedExpectation measure observable
literalFiniteYMExpectationIsFactorizedLimit
    {sequenceLimit = sequenceLimit}
    identification =
  Haar.physicalHaarExpectationIsFiniteCMP119Limit
    (compileLiteralFiniteYMExpectationRepresentation identification)

