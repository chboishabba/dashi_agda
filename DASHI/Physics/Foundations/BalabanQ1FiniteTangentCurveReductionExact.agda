{-# OPTIONS --safe #-}
module DASHI.Physics.Foundations.BalabanQ1FiniteTangentCurveReductionExact where

------------------------------------------------------------------------
-- Q1 MAX-CUT: THE SOURCE PATH IS GENERATED BY THE EXACT PRESENT-CUT TANGENT.
--
-- The live P1 owner accepts a per-component one-parameter `sourcePath`.
-- But the symmetric present-cut carrier already chose the ten stress slots as
-- the literal finite Tangent carrier, and the R144 metric lane already compiles
-- those SAME finite tangents to canonical metric perturbations.
--
-- Therefore a free per-component path is too much presentation data.  The
-- minimal source object is one tangent->curve realization on the present-cut
-- Background carrier.  Every component path is obtained by feeding it the
-- already-existing exact finite tangent for that symmetric slot.
--
-- This file compiles that smaller datum into
-- `PresentCutSignedSourcePathDerivative`; all B4/P1/spatial-C3 consequences are
-- downstream compiler output.
------------------------------------------------------------------------

open import Agda.Builtin.Bool using (Bool; false; true)
open import Agda.Builtin.Equality using (_≡_)
open import Agda.Builtin.Nat using (Nat)
open import DASHI.Foundations.RealAnalysisAxioms using (ℝ; 0ℝ)

import DASHI.Physics.Foundations.KernelGeometryEmergenceObligations as K
import DASHI.Physics.Foundations.CMP119SymmetricPresentCutCarrierCompilerExact as Present10
import DASHI.Physics.Foundations.CMP119SymmetricFiniteTangentBasisCompilerExact as MetricTangent
import DASHI.Physics.Foundations.CMP119CosmologyP1PresentCutPathDerivativeExact as P1
import DASHI.Physics.Foundations.CMP119CosmologyP1InvariantPathDerivativeCovarianceExact as Path
import DASHI.Physics.Foundations.CMP119CosmologyP1SourcePotentialCovarianceExact as Potential
import DASHI.Physics.Foundations.CMP119CosmologyE1SignedSymmetricTangentExact as Signed
import DASHI.Physics.Foundations.CMP119CosmologyE1SignedReadoutCovarianceExact as Readout
import DASHI.Physics.Foundations.CMP119CosmologyE1HypercubicSignedAxisActionExact as Axis

import DASHI.Physics.YangMills.Balaban1989BetaDrivenCompleteDensityFlowExact as BetaDensity
import DASHI.Physics.YangMills.BalabanClayPresentCutPhysicalCompilerRound122Exact as Present
import DASHI.Physics.YangMills.BalabanCMP109116LiteralDifferentiatedCarrierRound103Exact as Carrier
import DASHI.Physics.YangMills.BalabanCMP109116SourceContinuationRound103Exact as Source
import DASHI.Physics.YangMills.BalabanCMP109116FiniteEffectiveActionHessianRound103Exact as Finite
import DASHI.Physics.YangMills.BalabanBC2CompactGroupSameDensityRound119Exact as BC2
import DASHI.Physics.YangMills.BalabanBC2FiniteLocalizedFirstVariationRound143Exact as R143
import DASHI.Physics.YangMills.BalabanClayT4HypercubicGeneratedActionExact as Hyper

module _
    {History Cell : Set} {cutoff : Nat}
    {trajectory split}
    {inputs : BetaDensity.BetaDrivenCompleteDensityInputs
      {trajectory = trajectory} {split = split}}
    {source localization bc1Canonical}
    (presentData :
      Present10.SymmetricFunctionalRegularEPresentCutInputs History Cell cutoff
        {trajectory = trajectory} {split = split} {inputs = inputs}
        source localization bc1Canonical)
    (laws :
      R143.PresentCutBC2FirstVariationLinearity
        (Present10.asPresentCutPhysicalSourceInputs presentData))
  where

  present = Present10.asPresentCutPhysicalSourceInputs presentData
  carrier = Present.bc1Carrier present

  Background : Set
  Background = Source.Background (Carrier.source carrier)

  Tangent : Set
  Tangent = Finite.Tangent (Carrier.finiteAction carrier)

  exactFiniteTangent : K.SymmetricTensorComponent4 → Tangent
  exactFiniteTangent =
    Present10.symmetricSlotAsPresentCutFiniteTangent presentData

  record PresentCutFiniteTangentCurveRealization : Set₁ where
    field
      potentialGeometry :
        Potential.LiteralSourcePotentialEuclideanGeometry
          carrier Hyper.HypercubicGenerator

      derivativeLaws : Path.SignedPathDerivativeLaws

      -- One curve constructor for the actual finite tangent carrier.
      curveFromFiniteTangent :
        Background → Tangent → ℝ → Background

      -- A source curve is genuinely based at the selected background.
      curveAtZero :
        ∀ background tangent →
        curveFromFiniteTangent background tangent 0ℝ
        ≡ background

      -- Naturality is charged once, on the exact symmetric tangent basis.
      -- Reflection signs are represented by t -> -t via `applyBasisSign`.
      curveCovariantOnSymmetricBasis :
        ∀ generator background component t →
        let transformed =
              Signed.actSignedComponent
                (Axis.hypercubicSignedAxisAction generator) component
        in
        curveFromFiniteTangent
          (Potential.actBackground potentialGeometry generator background)
          (exactFiniteTangent (Signed.component transformed))
          t
        ≡
        Potential.actBackground potentialGeometry generator
          (curveFromFiniteTangent
            background
            (exactFiniteTangent component)
            (Readout.applyBasisSign (Signed.sign transformed) t))

      -- Ordinary derivative semantics for the SAME finite tangent used by BC2.
      bc2FirstVariationIsCurveDerivative :
        ∀ background component →
        BC2.firstVariation (Present.bc2 present)
          (Carrier.effectivePotential carrier)
          background
          (exactFiniteTangent component)
        ≡
        Path.derivativeAtZero derivativeLaws
          (λ t →
            Carrier.effectivePotential carrier
              (curveFromFiniteTangent
                background (exactFiniteTangent component) t))

  open PresentCutFiniteTangentCurveRealization public

  sourcePath :
    PresentCutFiniteTangentCurveRealization →
    Background → K.SymmetricTensorComponent4 → ℝ → Background
  sourcePath data background component =
    curveFromFiniteTangent data background (exactFiniteTangent component)

  sourcePathAtZero :
    (data : PresentCutFiniteTangentCurveRealization) →
    ∀ background component →
    sourcePath data background component 0ℝ
    ≡ background
  sourcePathAtZero data background component =
    curveAtZero data background (exactFiniteTangent component)

  asPresentCutSignedSourcePathDerivative :
    PresentCutFiniteTangentCurveRealization →
    P1.PresentCutSignedSourcePathDerivative presentData laws
  asPresentCutSignedSourcePathDerivative data = record
    { P1.PresentCutSignedSourcePathDerivative.potentialGeometry =
        potentialGeometry data
    ; P1.PresentCutSignedSourcePathDerivative.derivativeLaws =
        derivativeLaws data
    ; P1.PresentCutSignedSourcePathDerivative.sourcePath =
        sourcePath data
    ; P1.PresentCutSignedSourcePathDerivative.sourcePathCovariant =
        curveCovariantOnSymmetricBasis data
    ; P1.PresentCutSignedSourcePathDerivative.bc2FirstVariationIsPathDerivative =
        bc2FirstVariationIsCurveDerivative data
    }

------------------------------------------------------------------------
-- Frontier accounting.
------------------------------------------------------------------------

-- The path is no longer selected separately for ten tensor components.
freePerComponentSourcePathIsPrimitive : Bool
freePerComponentSourcePathIsPrimitive = false

-- The component supplied to the curve constructor is exactly the present-cut
-- finite Tangent carrier fixed by construction in `Present10`.
q1CurveUsesExactPresentCutFiniteTangent : Bool
q1CurveUsesExactPresentCutFiniteTangent =
  Present10.r144CompatibleTenSlotCarrierBuiltByConstruction

-- R144 already maps the same finite tangent into the canonical metric domain.
-- Requiring a second component->metric perturbation construction would duplicate
-- `CMP119SymmetricFiniteTangentBasisCompilerExact`.
independentMetricTangentConstructionRequired : Bool
independentMetricTangentConstructionRequired =
  MetricTangent.directSymmetricSlotToCMP119MetricPerturbationIsPrimitive

-- What genuinely remains is source semantics for ONE tangent->curve map:
-- construct it on the literal Background carrier, prove B4 naturality on the
-- selected ten tangents, and identify BC2.firstVariation with its ordinary
-- derivative.  Everything else in Q1/P1/C3 is compiler output.
remainingQ1LeafIsTangentCurveSourceSemantics : Bool
remainingQ1LeafIsTangentCurveSourceSemantics = true

-- CMP109 Eq.(5.1)'s B -> U_j(exp iB) is a gauge-background path for the vacuum
-- polarization Hessian.  It is not silently identified with this metric/stress
-- tangent curve merely because both are one-parameter variations.
cmp109GaugeBPathIsNotMetricStressCurveByNotation : Bool
cmp109GaugeBPathIsNotMetricStressCurveByNotation = true
