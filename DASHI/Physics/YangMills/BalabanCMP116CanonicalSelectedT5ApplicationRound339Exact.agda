    sourceEnvelopeCalibrationStillRequired : Bool
    sourceEnvelopeCalibrationStillRequiredIsTrue :
      sourceEnvelopeCalibrationStillRequired ≡ true

    twoCoordinatesCompileDirectlyToR320 : Bool
    twoCoordinatesCompileDirectlyToR320IsTrue :
      twoCoordinatesCompileDirectlyToR320 ≡ true

    freshYMDecayEstimateIntroduced : Bool
    freshYMDecayEstimateIntroducedIsFalse :
      freshYMDecayEstimateIntroduced ≡ false

canonicalRound339Boundary : Round339Boundary
canonicalRound339Boundary =
  round339-boundary
    false refl
    false refl
    true refl
    true refl
    true refl
    false refl

