module DASHI.Physics.YangMills.YangMillsLocalChargeQuadraticFormCoreExact where

------------------------------------------------------------------------
-- ROUND87: LOCAL CHARGE AS AN EVENTUALLY CONSTANT QUADRATIC FORM ON A CORE
--
-- PRIMARY / CALIBRATION SOURCES
--
-- Manfred Requardt,
-- "Symmetry Conservation and Integrals over Local Charge Densities in Quantum
-- Field Theory", Communications in Mathematical Physics 50 (1976), 259--263.
-- DOI: 10.1007/BF01609406.
--
-- Giovanni Morchio and Franco Strocchi,
-- "Spontaneous Symmetry Breaking and Energy Gap Generated by Variables at
-- Infinity", Communications in Mathematical Physics 99 (1985), 153--175.
-- DOI: 10.1007/BF01212279.
--
-- Giovanni Morchio and Franco Strocchi,
-- "Charge density and electric charge in quantum electrodynamics",
-- Journal of Mathematical Physics 44 (2003), 5569--5587.
-- DOI: 10.1063/1.1623928. arXiv: hep-th/0301111.
--
-- SOURCE BOUNDARY
--
-- The 1985 paper is by Morchio AND Strocchi and its title is "...Variables at
-- Infinity", not a single-author "...Vector Charges" paper.  Its long-range
-- symmetry-breaking setting is calibration only; it is not promoted to a
-- nonperturbative Yang--Mills stress theorem.
--
-- Morchio--Strocchi 2003 emphasizes an important operator-domain distinction:
-- local charge integrals can be meaningful first as quadratic forms on a
-- restricted/local domain, while stronger operator convergence may require
-- additional smearing/domain analysis.
--
-- MATHEMATICAL ROLE
--
-- The Round86 operator-action compiler already shows eventual constancy on a
-- local core removes the need for a global norm/strong cutoff limit.  This file
-- proves the parallel statement at the weaker quadratic-form level.  If the
-- cutoff form is unchanged once the cutoff contains the joint localization of
-- the bra/ket vectors, define the limiting form at that joint support radius;
-- every larger cutoff is exactly the same form value.
--
-- This lets the optional stress programme prove Ward/current identities first
-- on the natural local quadratic-form domain and postpone closability /
-- self-adjoint operator completion until it is genuinely needed.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_)
open import Agda.Builtin.Nat using (Nat; _≤_)
import Data.Nat.Properties as ℕP

open import DASHI.Physics.YangMills.CompactLieProofLevel

record LocalChargeQuadraticFormCore (Core Scalar : Set) : Set₁ where
  field
    jointSupportRadius : Core → Core → Nat
    cutoffChargeForm : Nat → Core → Core → Scalar

    formStableBeyondJointSupport :
      ∀ bra ket leftCutoff rightCutoff →
      jointSupportRadius bra ket ≤ leftCutoff →
      jointSupportRadius bra ket ≤ rightCutoff →
      cutoffChargeForm leftCutoff bra ket
      ≡ cutoffChargeForm rightCutoff bra ket

open LocalChargeQuadraticFormCore public

localCoreChargeForm :
  ∀ {Core Scalar} →
  LocalChargeQuadraticFormCore Core Scalar →
  Core → Core → Scalar
localCoreChargeForm dataSet bra ket =
  cutoffChargeForm dataSet (jointSupportRadius dataSet bra ket) bra ket

cutoffFormEqualsLocalCoreFormBeyondSupport :
  ∀ {Core Scalar}
    (dataSet : LocalChargeQuadraticFormCore Core Scalar)
    bra ket cutoff →
  jointSupportRadius dataSet bra ket ≤ cutoff →
  cutoffChargeForm dataSet cutoff bra ket
  ≡ localCoreChargeForm dataSet bra ket
cutoffFormEqualsLocalCoreFormBeyondSupport dataSet bra ket cutoff supportBelow =
  formStableBeyondJointSupport dataSet
    bra ket cutoff (jointSupportRadius dataSet bra ket)
    supportBelow ℕP.≤-refl

allLargeCutoffFormsAgree :
  ∀ {Core Scalar}
    (dataSet : LocalChargeQuadraticFormCore Core Scalar)
    bra ket leftCutoff rightCutoff →
  jointSupportRadius dataSet bra ket ≤ leftCutoff →
  jointSupportRadius dataSet bra ket ≤ rightCutoff →
  cutoffChargeForm dataSet leftCutoff bra ket
  ≡ cutoffChargeForm dataSet rightCutoff bra ket
allLargeCutoffFormsAgree dataSet = formStableBeyondJointSupport dataSet

record LocalCoreQuadraticFormCutoffRemoval
    {Core Scalar : Set}
    (dataSet : LocalChargeQuadraticFormCore Core Scalar) : Set₁ where
  field
    limitingForm : Core → Core → Scalar
    limitingFormIsSupportCutoff : ∀ bra ket →
      limitingForm bra ket
      ≡ cutoffChargeForm dataSet (jointSupportRadius dataSet bra ket) bra ket
    everyLargeCutoffIsLimitingForm : ∀ bra ket cutoff →
      jointSupportRadius dataSet bra ket ≤ cutoff →
      cutoffChargeForm dataSet cutoff bra ket ≡ limitingForm bra ket

open LocalCoreQuadraticFormCutoffRemoval public

localCoreQuadraticFormCutoffRemoval :
  ∀ {Core Scalar}
    (dataSet : LocalChargeQuadraticFormCore Core Scalar) →
  LocalCoreQuadraticFormCutoffRemoval dataSet
localCoreQuadraticFormCutoffRemoval dataSet = record
  { limitingForm = localCoreChargeForm dataSet
  ; limitingFormIsSupportCutoff = λ bra ket →
      ℕP.refl
  ; everyLargeCutoffIsLimitingForm =
      cutoffFormEqualsLocalCoreFormBeyondSupport dataSet
  }

localChargeQuadraticFormCutoffRemovalLevel : ProofLevel
localChargeQuadraticFormCutoffRemovalLevel = machineChecked

-- Physical input still required for the optional stress route: identify the
-- actual renormalized stress-current cutoff quadratic form on the reconstructed
-- local domain and prove the locality/Ward stabilization premise.
physicalStressChargeQuadraticFormStabilizationLevel : ProofLevel
physicalStressChargeQuadraticFormStabilizationLevel = conditional
