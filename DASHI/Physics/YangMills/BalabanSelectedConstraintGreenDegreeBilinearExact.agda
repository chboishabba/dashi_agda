module DASHI.Physics.YangMills.BalabanSelectedConstraintGreenDegreeBilinearExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES
--
-- Tadeusz Bałaban,
-- "Propagators for Lattice Gauge Theories in a Background Field",
-- Communications in Mathematical Physics 99 (1985), 389--434.
-- DOI: 10.1007/BF01240355.
--
-- Tadeusz Bałaban,
-- "The Variational Problem and Background Fields in Renormalization Group
-- Method for Lattice Gauge Theories", Communications in Mathematical Physics
-- 102 (1985), 277--309. DOI: 10.1007/BF01229381.
--
-- Roger Penrose, "A Generalized Inverse for Matrices", Proceedings of the
-- Cambridge Philosophical Society 51 (1955), 406--413.
-- DOI: 10.1017/S0305004100030401.
--
-- DASHI CONTRIBUTION
--
-- Collapse each of the sixteen Möbius-degree Green blocks BEFORE enclosure.
-- Bilinearity of the finite KKT pseudoinverse pairing gives exactly
--
--   sum_{S in d} sum_{T in e} <s_S , K+ delta_T>
--     = < sum_{S in d} s_S , K+ (sum_{T in e} delta_T) >.
--
-- Combined with the Round58 cardinality-layer formulas, the whole 4x4 Green
-- table is therefore generated by four degree-summed source vectors and four
-- degree-summed defect vectors.  The physical numerical problem is no longer
-- 225 atom pair estimates, nor even sixteen unrelated scalar Green blocks: it
-- is one common pseudoinverse acting on four explicit source/defect vectors.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_)
open import Data.Rational.Base using (ℚ)
open import Relation.Binary.PropositionalEquality using (trans)

open import DASHI.Physics.YangMills.CompactLieProofLevel
import DASHI.Physics.YangMills.BalabanPhysicalBlockFibreSumsExact as Sums
import DASHI.Physics.YangMills.BalabanFiniteSumFubiniExact as Fubini
import DASHI.Physics.YangMills.BalabanFiniteRectangularRationalExact as Rect
import DASHI.Physics.YangMills.BalabanP33FiniteKKTPseudoinverseProjectorExact as Pseudo
import DASHI.Physics.YangMills.BalabanSelectedRawExtractorConstraintDefectAtomsExact as Atoms
import DASHI.Physics.YangMills.BalabanSelectedConstraintAtomGreenExpansionExact as Green
import DASHI.Physics.YangMills.BalabanP33CorrelatedMobiusDegreeJointExact as Degree

sourceDegreeVector :
  ∀ {Multiplier pseudoData firstVariationCovector rawExtractor} →
  Atoms.SelectedConstraintAtomData
    {Multiplier} pseudoData firstVariationCovector rawExtractor →
  Degree.MobiusDegree → Multiplier → ℚ
sourceDegreeVector atoms degree =
  Green.sumVector (Degree.degreeSubsets degree) (Atoms.sourceAtom atoms)

defectDegreeVector :
  ∀ {Multiplier pseudoData firstVariationCovector rawExtractor} →
  Atoms.SelectedConstraintAtomData
    {Multiplier} pseudoData firstVariationCovector rawExtractor →
  Degree.MobiusDegree → Multiplier → ℚ
defectDegreeVector atoms degree =
  Green.sumVector (Degree.degreeSubsets degree) (Atoms.defectAtom atoms)

greenDegreeBlockFromAtoms :
  ∀ {Multiplier pseudoData firstVariationCovector rawExtractor} →
  Atoms.SelectedConstraintAtomData
    {Multiplier} pseudoData firstVariationCovector rawExtractor →
  Degree.MobiusDegree → Degree.MobiusDegree → ℚ
greenDegreeBlockFromAtoms atoms leftDegree rightDegree =
  Sums.sumRational (Degree.degreeSubsets leftDegree)
    (λ left →
      Sums.sumRational (Degree.degreeSubsets rightDegree)
        (Green.greenAtomPairContraction atoms left))

greenDegreePairing :
  ∀ {Multiplier}
    {pseudoData : Pseudo.FiniteKKTPseudoinverseData Multiplier}
    {firstVariationCovector rawExtractor}
    (atoms : Atoms.SelectedConstraintAtomData
      pseudoData firstVariationCovector rawExtractor) →
  Degree.MobiusDegree → Degree.MobiusDegree → ℚ
greenDegreePairing {pseudoData = pseudoData} atoms leftDegree rightDegree =
  Rect.finiteDot
    (Pseudo.multiplierCarrier pseudoData)
    (sourceDegreeVector atoms leftDegree)
    (Pseudo.pseudoApply pseudoData (defectDegreeVector atoms rightDegree))

greenDegreePairingExact :
  ∀ {Multiplier}
    {pseudoData : Pseudo.FiniteKKTPseudoinverseData Multiplier}
    {firstVariationCovector rawExtractor}
    (atoms : Atoms.SelectedConstraintAtomData
      pseudoData firstVariationCovector rawExtractor)
    leftDegree rightDegree →
  greenDegreePairing atoms leftDegree rightDegree
  ≡ greenDegreeBlockFromAtoms atoms leftDegree rightDegree
greenDegreePairingExact
    {pseudoData = pseudoData} atoms leftDegree rightDegree =
  let
    carrier = Pseudo.multiplierCarrier pseudoData
    lefts = Degree.degreeSubsets leftDegree
    rights = Degree.degreeSubsets rightDegree

    pseudoDefectSum : ∀ row →
      Pseudo.pseudoApply pseudoData (defectDegreeVector atoms rightDegree) row
      ≡ Green.sumVector rights
          (λ right → Pseudo.pseudoApply pseudoData (Atoms.defectAtom atoms right)) row
    pseudoDefectSum =
      Green.applyRectangularSumVector
        carrier
        (Pseudo.gramPseudoinverse pseudoData)
        rights
        (Atoms.defectAtom atoms)

    rightExpanded :
      Rect.finiteDot carrier
        (sourceDegreeVector atoms leftDegree)
        (Pseudo.pseudoApply pseudoData (defectDegreeVector atoms rightDegree))
      ≡ Sums.sumRational rights
          (λ right →
            Rect.finiteDot carrier
              (sourceDegreeVector atoms leftDegree)
              (Pseudo.pseudoApply pseudoData (Atoms.defectAtom atoms right)))
    rightExpanded =
      trans
        (Green.finiteDotRightPointwiseCong carrier pseudoDefectSum)
        (Green.finiteDotSumRight carrier
          (sourceDegreeVector atoms leftDegree)
          rights
          (λ right → Pseudo.pseudoApply pseudoData (Atoms.defectAtom atoms right)))

    bothExpanded :
      Sums.sumRational rights
          (λ right →
            Rect.finiteDot carrier
              (sourceDegreeVector atoms leftDegree)
              (Pseudo.pseudoApply pseudoData (Atoms.defectAtom atoms right)))
      ≡ Sums.sumRational rights
          (λ right →
            Sums.sumRational lefts
              (λ left → Green.greenAtomPairContraction atoms left right))
    bothExpanded =
      Sums.sumRationalCong rights _ _
        (λ right →
          Green.finiteDotSumLeft
            carrier lefts (Atoms.sourceAtom atoms)
            (Pseudo.pseudoApply pseudoData (Atoms.defectAtom atoms right)))
  in
  trans rightExpanded
    (trans bothExpanded
      (Fubini.sumSwap rights lefts
        (λ right left → Green.greenAtomPairContraction atoms left right)))

greenDegreeBilinearCollapseLevel : ProofLevel
greenDegreeBilinearCollapseLevel = machineChecked

-- Numerical/locality frontier after this collapse: bound four source degree
-- vectors, four defect degree vectors, and the action of the SAME physical KKT
-- pseudoinverse on those vectors over the selected region.  The sixteen scalar
-- Green blocks are then derived bilinearly rather than independently certified.
selectedRegionDegreeVectorGreenBoundsLevel : ProofLevel
selectedRegionDegreeVectorGreenBoundsLevel = conditional
