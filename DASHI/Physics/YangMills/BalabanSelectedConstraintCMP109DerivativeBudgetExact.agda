module DASHI.Physics.YangMills.BalabanSelectedConstraintCMP109DerivativeBudgetExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES
--
-- Tadeusz Bałaban,
-- "Averaging Operations for Lattice Gauge Theories",
-- Communications in Mathematical Physics 98 (1985), 17--51.
-- DOI: 10.1007/BF01211042.
--
-- Tadeusz Bałaban,
-- "Renormalization Group Approach to Lattice Gauge Field Theories. I.
-- Generation of Effective Actions in a Small Field Approximation and a
-- Coupling Constant Renormalization in Four Dimensions",
-- Communications in Mathematical Physics 109 (1987), 249--301.
-- DOI: 10.1007/BF01215223.
--
-- Tadeusz Bałaban,
-- "Spaces of Regular Gauge Field Configurations on a Lattice and Gauge
-- Fixing Conditions", Communications in Mathematical Physics 99 (1985),
-- 75--102. DOI: 10.1007/BF01466594.
--
-- DASHI CONTRIBUTION
--
-- Assemble the two nonlinear derivative sectors into the exact reduced
-- Gate-I threshold.  The block-average part is generated by two CMP109
-- derivative primitives at radius rho=1/8192; the gauge part is the literal
-- physical two-background derivative already proved in this tranche.
--
-- The CMP109 reference-entry bridge gives
--
--     ||DQ_U-DQ_A||^2 <= 9/4096 ||h||^2
--                        <= 3711/262144 ||h||^2.
--
-- The physical gauge calculation gives
--
--     ||DF_U-DF_A||^2 <= 1/262144 ||h||^2.
--
-- Exact tagged-row splitting and Pythagorean contraction of the reduced
-- projection therefore yield
--
--     ||P( DQ_U-DQ_A , DF_U-DF_A ) h||^2
--       <= 29/2048 ||h||^2.
--
-- The theorem uses the same physical perturbation in both sectors.  The only
-- remaining nonlinear same-object seam is to prove that the CMP109 primitive
-- attached to a selected background is literally the derivative of the
-- selected nonlinear block-average map at that background.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_; refl)
open import Data.Rational.Base as ℚ using (ℚ; _*_; _≤_)
open import Relation.Binary.PropositionalEquality using (subst; sym; trans)

open import DASHI.Physics.YangMills.CompactLieProofLevel
import DASHI.Physics.YangMills.BalabanPhysicalBlockFibreSumsExact as Sums
import DASHI.Physics.YangMills.BalabanP33CMP109DerivativeDifferencePrimitiveExact as Primitive
import DASHI.Physics.YangMills.BalabanP33PhysicalRationalWilsonPlaquetteJetExact as Physical
import DASHI.Physics.YangMills.BalabanP33PhysicalSU2FiniteCoordinatesExact as Coordinates
import DASHI.Physics.YangMills.BalabanP33PhysicalBackgroundGaugeParameterizedYoungExact as Relaxed
import DASHI.Physics.YangMills.BalabanCMP109SelectedBlockAverageIFTBridgeExact as CMP109
import DASHI.Physics.YangMills.BalabanSelectedBlockAverageReferenceEntryBudgetExact as AverageBudget
import DASHI.Physics.YangMills.BalabanFiniteRectangularSchurSquaredExact as RectSchur
import DASHI.Physics.YangMills.BalabanSelectedConstraintDerivativeSectorBudgetExact as Sector
import DASHI.Physics.YangMills.BalabanSelectedGaugeDerivativeTwoBackgroundVariationExact as GaugeVariation
import DASHI.Physics.YangMills.BalabanSelectedCombinedProjectionNormExact as ProjectionNorm
import DASHI.Physics.YangMills.BalabanSelectedCombinedProjectionOrthogonalityExact as Projection

averageVariationFromPrimitives :
  ∀ {LeftOperator RightOperator} →
  Primitive.CMP109DerivativeDifferencePrimitive LeftOperator CMP109.Cell →
  Primitive.CMP109DerivativeDifferencePrimitive RightOperator CMP109.Cell →
  Coordinates.PhysicalSU2BondField4 → Sector.AverageVariation
averageVariationFromPrimitives left right field row =
  let
    vector = Coordinates.encodePhysicalSU2 field
    matrix = AverageBudget.twoBackgroundMatrix
      (CMP109.primitiveReferenceDifferenceMatrix left)
      (CMP109.primitiveReferenceDifferenceMatrix right)
  in
  RectSchur.rectApply AverageBudget.columns matrix vector row

averageVariationNormIsRectangularNorm :
  ∀ {LeftOperator RightOperator}
    (left : Primitive.CMP109DerivativeDifferencePrimitive LeftOperator CMP109.Cell)
    (right : Primitive.CMP109DerivativeDifferencePrimitive RightOperator CMP109.Cell)
    field →
  Sector.averageVariationNormSq (averageVariationFromPrimitives left right field)
  ≡ RectSchur.rectVectorNormSq AverageBudget.rows
      (RectSchur.rectApply AverageBudget.columns
        (AverageBudget.twoBackgroundMatrix
          (CMP109.primitiveReferenceDifferenceMatrix left)
          (CMP109.primitiveReferenceDifferenceMatrix right))
        (Coordinates.encodePhysicalSU2 field))
averageVariationNormIsRectangularNorm left right field =
  Sums.sumRationalCong AverageBudget.rows _ _ (λ row → refl)

encodedFieldRectangularNormExact : ∀ field →
  RectSchur.rectVectorNormSq AverageBudget.columns
    (Coordinates.encodePhysicalSU2 field)
  ≡ Coordinates.physicalSU2BondNormSq field
encodedFieldRectangularNormExact field =
  trans
    (Sums.sumRationalCong AverageBudget.columns _ _ (λ coordinate → refl))
    (Coordinates.encodePhysicalSU2NormSqExact field)

cmp109AverageVariationFitsSectorBudget :
  ∀ {LeftOperator RightOperator}
    (left : Primitive.CMP109DerivativeDifferencePrimitive LeftOperator CMP109.Cell)
    (right : Primitive.CMP109DerivativeDifferencePrimitive RightOperator CMP109.Cell)
    field →
  Primitive.radius left ≡ AverageBudget.rho →
  Primitive.radius right ≡ AverageBudget.rho →
  Sector.averageVariationNormSq
      (averageVariationFromPrimitives left right field)
  ≤ GaugeVariation.blockAverageDerivativeRemainingSquaredBudget
      * Coordinates.physicalSU2BondNormSq field
cmp109AverageVariationFitsSectorBudget
    left right field leftRadius rightRadius =
  let
    primitiveBound = CMP109.cmp109TwoBackgroundPrimitivesFitSelectedIFTBudget
      left right (Coordinates.encodePhysicalSU2 field) leftRadius rightRadius
  in
  subst
    (λ lower → lower
      ≤ GaugeVariation.blockAverageDerivativeRemainingSquaredBudget
          * Coordinates.physicalSU2BondNormSq field)
    (sym (averageVariationNormIsRectangularNorm left right field))
    (subst
      (λ upper →
        RectSchur.rectVectorNormSq AverageBudget.rows
          (RectSchur.rectApply AverageBudget.columns
            (AverageBudget.twoBackgroundMatrix
              (CMP109.primitiveReferenceDifferenceMatrix left)
              (CMP109.primitiveReferenceDifferenceMatrix right))
            (Coordinates.encodePhysicalSU2 field))
        ≤ GaugeVariation.blockAverageDerivativeRemainingSquaredBudget * upper)
      (encodedFieldRectangularNormExact field)
      primitiveBound)

selectedConstraintCMP109DerivativeVariationTwentyNineOver2048 :
  ∀ {LeftOperator RightOperator}
    (leftPrimitive : Primitive.CMP109DerivativeDifferencePrimitive
      LeftOperator CMP109.Cell)
    (rightPrimitive : Primitive.CMP109DerivativeDifferencePrimitive
      RightOperator CMP109.Cell)
    (leftBackground rightBackground : Physical.RationalSU2Background4)
    field →
  Primitive.radius leftPrimitive ≡ AverageBudget.rho →
  Primitive.radius rightPrimitive ≡ AverageBudget.rho →
  Relaxed.RelaxedInverseLinkRadius leftBackground →
  Relaxed.RelaxedInverseLinkRadius rightBackground →
  ProjectionNorm.rawMultiplierNormSq
    (Projection.selectedReducedProjection
      (Sector.combineDerivativeSectors
        (averageVariationFromPrimitives leftPrimitive rightPrimitive field)
        (Sector.literalGaugeTwoBackgroundVariation
          leftBackground rightBackground field)))
  ≤ GaugeVariation.fullDerivativeVariationSquaredBudget
      * Coordinates.physicalSU2BondNormSq field
selectedConstraintCMP109DerivativeVariationTwentyNineOver2048
    leftPrimitive rightPrimitive leftBackground rightBackground field
    leftRadiusExact rightRadiusExact leftBackgroundRadius rightBackgroundRadius =
  Sector.selectedReducedCombinedDerivativeVariationUpper
    leftBackground rightBackground field
    (averageVariationFromPrimitives leftPrimitive rightPrimitive field)
    leftBackgroundRadius rightBackgroundRadius
    (cmp109AverageVariationFitsSectorBudget
      leftPrimitive rightPrimitive field leftRadiusExact rightRadiusExact)

selectedCMP109AverageVariationSectorLevel : ProofLevel
selectedCMP109AverageVariationSectorLevel = machineChecked

selectedCMP109CombinedDerivativeVariationLevel : ProofLevel
selectedCMP109CombinedDerivativeVariationLevel = machineChecked

selectedCMP109PrimitiveBackgroundSameObjectLevel : ProofLevel
selectedCMP109PrimitiveBackgroundSameObjectLevel = conditional
