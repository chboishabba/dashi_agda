module DASHI.Physics.YangMills.BalabanClayGate4CMP109ShortestContourEnumerationExact where

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List using (List; []; _∷_)
open import Agda.Builtin.Nat using (Nat; zero; suc)
open import Relation.Binary.PropositionalEquality using (cong; trans)

open import DASHI.Physics.YangMills.CompactLieProofLevel

------------------------------------------------------------------------
-- Executable equation-(0.11) shortest-contour enumeration.
--
-- Tadeusz Bałaban,
-- "Renormalization Group Approach to Lattice Gauge Field Theories. I.
-- Generation of Effective Actions in a Small Field Approximation and a
-- Coupling Constant Renormalization in Four Dimensions",
-- Communications in Mathematical Physics 109 (1987), 249--301.
-- DOI: 10.1007/BF01215223.
--
-- Immediately before equation (0.4), Bałaban defines G(y,x) by taking the
-- coordinate directions with nonzero displacement and concatenating their
-- straight segments in every permutation.  This module implements that finite
-- enumeration for four signed coordinate segments.  Every emitted order is
-- generated by insertion from the active segment list, and commuting coordinate
-- actions prove that all emitted contours have the same endpoint.  For four
-- active directions the executable family has exactly 4! = 24 members.
--
-- Instantiation with the repository's periodic signed-bond path carrier remains
-- a separate geometric bridge; the finite permutation algorithm itself is no
-- longer an analytic input.
------------------------------------------------------------------------

data _∈_ {A : Set} (value : A) : List A → Set where
  here : ∀ {values} → value ∈ (value ∷ values)
  there : ∀ {other values} → value ∈ values → value ∈ (other ∷ values)

_++_ : ∀ {A : Set} → List A → List A → List A
[] ++ right = right
(left ∷ lefts) ++ right = left ∷ (lefts ++ right)

mapList : ∀ {A B : Set} → (A → B) → List A → List B
mapList function [] = []
mapList function (value ∷ values) =
  function value ∷ mapList function values

concatMap : ∀ {A B : Set} → (A → List B) → List A → List B
concatMap function [] = []
concatMap function (value ∷ values) =
  function value ++ concatMap function values

data Either (left right : Set) : Set where
  leftWitness : left → Either left right
  rightWitness : right → Either left right

appendMembershipCases :
  ∀ {A : Set} {value : A} left right →
  value ∈ (left ++ right) →
  Either (value ∈ left) (value ∈ right)
appendMembershipCases [] right membership = rightWitness membership
appendMembershipCases (head ∷ tail) right here = leftWitness here
appendMembershipCases (head ∷ tail) right (there membership)
  with appendMembershipCases tail right membership
... | leftWitness inTail = leftWitness (there inTail)
... | rightWitness inRight = rightWitness inRight

record MapPreimage
    {A B : Set}
    (function : A → B)
    (values : List A)
    (target : B) : Set where
  constructor mapWitness
  field
    source : A
    sourceMembership : source ∈ values
    imageExact : function source ≡ target

open MapPreimage public

mapMembershipPreimage :
  ∀ {A B : Set}
    (function : A → B) values target →
  target ∈ mapList function values →
  MapPreimage function values target
mapMembershipPreimage function [] target ()
mapMembershipPreimage function (value ∷ values) .(function value) here =
  mapWitness value here refl
mapMembershipPreimage function (value ∷ values) target (there membership)
  with mapMembershipPreimage function values target membership
... | mapWitness source sourceIn image =
  mapWitness source (there sourceIn) image

record ConcatMapPreimage
    {A B : Set}
    (function : A → List B)
    (values : List A)
    (target : B) : Set where
  constructor concatWitness
  field
    source : A
    sourceMembership : source ∈ values
    targetMembership : target ∈ function source

open ConcatMapPreimage public

concatMapMembershipPreimage :
  ∀ {A B : Set}
    (function : A → List B) values target →
  target ∈ concatMap function values →
  ConcatMapPreimage function values target
concatMapMembershipPreimage function [] target ()
concatMapMembershipPreimage function (value ∷ values) target membership
  with appendMembershipCases (function value)
    (concatMap function values) membership
... | leftWitness inHead = concatWitness value here inHead
... | rightWitness inTail
  with concatMapMembershipPreimage function values target inTail
...   | concatWitness source sourceIn targetIn =
      concatWitness source (there sourceIn) targetIn

------------------------------------------------------------------------
-- Insertion-generated permutations.
------------------------------------------------------------------------

data Insertion {A : Set} (value : A) : List A → List A → Set where
  insertHere : ∀ {values} →
    Insertion value values (value ∷ values)
  insertThere : ∀ {other values inserted} →
    Insertion value values inserted →
    Insertion value (other ∷ values) (other ∷ inserted)

insertEverywhere : ∀ {A : Set} → A → List A → List (List A)
insertEverywhere value [] = (value ∷ []) ∷ []
insertEverywhere value (head ∷ tail) =
  (value ∷ head ∷ tail) ∷
  mapList (λ inserted → head ∷ inserted)
    (insertEverywhere value tail)

insertEverywhereSound :
  ∀ {A : Set}
    (value : A) values inserted →
  inserted ∈ insertEverywhere value values →
  Insertion value values inserted
insertEverywhereSound value [] .(value ∷ []) here = insertHere
insertEverywhereSound value [] inserted (there ())
insertEverywhereSound value (head ∷ tail)
    .(value ∷ head ∷ tail) here = insertHere
insertEverywhereSound value (head ∷ tail) inserted (there membership)
  with mapMembershipPreimage
    (λ selected → head ∷ selected)
    (insertEverywhere value tail)
    inserted membership
... | mapWitness selected selectedIn refl =
  insertThere (insertEverywhereSound value tail selected selectedIn)

permutations : ∀ {A : Set} → List A → List (List A)
permutations [] = [] ∷ []
permutations (value ∷ values) =
  concatMap (insertEverywhere value) (permutations values)

data GeneratedPermutation {A : Set} : List A → List A → Set where
  permutationNil : GeneratedPermutation [] []
  permutationInsert : ∀ {value source permuted inserted} →
    GeneratedPermutation source permuted →
    Insertion value permuted inserted →
    GeneratedPermutation (value ∷ source) inserted

permutationsSound :
  ∀ {A : Set} (source target : List A) →
  target ∈ permutations source →
  GeneratedPermutation source target
permutationsSound [] .[] here = permutationNil
permutationsSound [] target (there ())
permutationsSound (value ∷ values) target membership
  with concatMapMembershipPreimage
    (insertEverywhere value)
    (permutations values)
    target membership
... | concatWitness permuted permutedIn targetIn =
  permutationInsert
    (permutationsSound values permuted permutedIn)
    (insertEverywhereSound value permuted target targetIn)

------------------------------------------------------------------------
-- Endpoint invariance under commuting coordinate segments.
------------------------------------------------------------------------

record CommutingSegmentAction
    (Point Segment : Set) : Set₁ where
  field
    step : Point → Segment → Point
    distinctSegmentsCommute : ∀ point left right →
      step (step point left) right
      ≡ step (step point right) left

open CommutingSegmentAction public

follow :
  ∀ {Point Segment} →
  CommutingSegmentAction Point Segment →
  Point → List Segment → Point
follow action point [] = point
follow action point (segment ∷ segments) =
  follow action (step action point segment) segments

insertionPreservesEndpoint :
  ∀ {Point Segment}
    {value : Segment} {source inserted : List Segment}
    (action : CommutingSegmentAction Point Segment) →
  Insertion value source inserted →
  ∀ point →
  follow action point inserted
  ≡ follow action (step action point value) source
insertionPreservesEndpoint action insertHere point = refl
insertionPreservesEndpoint {value = value}
    action (insertThere {other = other} insertion) point =
  trans
    (insertionPreservesEndpoint action insertion
      (step action point other))
    (cong
      (λ start → follow action start _)
      (distinctSegmentsCommute action point other value))

generatedPermutationPreservesEndpoint :
  ∀ {Point Segment}
    {source permuted : List Segment}
    (action : CommutingSegmentAction Point Segment) →
  GeneratedPermutation source permuted →
  ∀ point →
  follow action point permuted ≡ follow action point source
generatedPermutationPreservesEndpoint action permutationNil point = refl
generatedPermutationPreservesEndpoint action
    (permutationInsert {value = value} permutation insertion) point =
  trans
    (insertionPreservesEndpoint action insertion point)
    (generatedPermutationPreservesEndpoint action permutation
      (step action point value))

------------------------------------------------------------------------
-- Four-dimensional signed coordinate data.
------------------------------------------------------------------------

data Axis4 : Set where
  axis0 axis1 axis2 axis3 : Axis4

data Direction : Set where
  positive negative : Direction

record SignedCount : Set where
  constructor signedCount
  field
    direction : Direction
    count : Nat

open SignedCount public

record AxisSegment : Set where
  constructor axisSegment
  field
    axis : Axis4
    segmentCount : SignedCount

open AxisSegment public

record Displacement4 : Set where
  constructor displacement4
  field
    coordinate0 coordinate1 coordinate2 coordinate3 : SignedCount

open Displacement4 public

activeSegment : Axis4 → SignedCount → List AxisSegment
activeSegment axis (signedCount direction zero) = []
activeSegment axis (signedCount direction (suc count)) =
  axisSegment axis (signedCount direction (suc count)) ∷ []

activeSegments : Displacement4 → List AxisSegment
activeSegments displacement =
  activeSegment axis0 (coordinate0 displacement) ++
  (activeSegment axis1 (coordinate1 displacement) ++
  (activeSegment axis2 (coordinate2 displacement) ++
   activeSegment axis3 (coordinate3 displacement)))

cmp109ShortestContourOrders :
  Displacement4 → List (List AxisSegment)
cmp109ShortestContourOrders displacement =
  permutations (activeSegments displacement)

cmp109ContourOrderSound :
  ∀ displacement order →
  order ∈ cmp109ShortestContourOrders displacement →
  GeneratedPermutation (activeSegments displacement) order
cmp109ContourOrderSound displacement order membership =
  permutationsSound (activeSegments displacement) order membership

cmp109EnumeratedContourEndpointExact :
  ∀ {Point}
    (action : CommutingSegmentAction Point AxisSegment)
    displacement order →
  order ∈ cmp109ShortestContourOrders displacement →
  ∀ point →
  follow action point order
  ≡ follow action point (activeSegments displacement)
cmp109EnumeratedContourEndpointExact action displacement order membership =
  generatedPermutationPreservesEndpoint action
    (cmp109ContourOrderSound displacement order membership)

allFourPositiveUnitSegments : List AxisSegment
allFourPositiveUnitSegments =
  axisSegment axis0 (signedCount positive (suc zero)) ∷
  axisSegment axis1 (signedCount positive (suc zero)) ∷
  axisSegment axis2 (signedCount positive (suc zero)) ∷
  axisSegment axis3 (signedCount positive (suc zero)) ∷ []

listLength : ∀ {A : Set} → List A → Nat
listLength [] = zero
listLength (_ ∷ values) = suc (listLength values)

fourActiveContourFamilyHas24Members :
  listLength (permutations allFourPositiveUnitSegments)
  ≡ 24
fourActiveContourFamilyHas24Members = refl

cmp109ShortestContourEnumerationLevel : ProofLevel
cmp109ShortestContourEnumerationLevel = machineChecked

cmp109ContourPermutationSoundnessLevel : ProofLevel
cmp109ContourPermutationSoundnessLevel = machineChecked

cmp109ContourEndpointIndependenceLevel : ProofLevel
cmp109ContourEndpointIndependenceLevel = machineChecked

cmp109FourActiveDirectionCount24Level : ProofLevel
cmp109FourActiveDirectionCount24Level = computed

physicalPeriodicSegmentActionInputsLevel : ProofLevel
physicalPeriodicSegmentActionInputsLevel = conditional

physicalCMP109BlockDisplacementIdentificationInputsLevel : ProofLevel
physicalCMP109BlockDisplacementIdentificationInputsLevel = conditional
