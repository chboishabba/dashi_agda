module DASHI.Physics.YangMills.BalabanSelectedVariationSignConventionExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES
--
-- Tadeusz Bałaban,
-- "The Variational Problem and Background Fields in Renormalization Group
-- Method for Lattice Gauge Theories",
-- Communications in Mathematical Physics 102 (1985), 277--309.
-- DOI: 10.1007/BF01229381.
--
-- Franco Brezzi,
-- "On the Existence, Uniqueness and Approximation of Saddle-Point Problems
-- Arising from Lagrangian Multipliers",
-- RAIRO Analyse Numérique 8 (1974), 129--151.
-- No DOI was assigned to the cited article.
--
-- DASHI CONTRIBUTION
--
-- Fix one public sign convention for the selected plaquette variation.
-- The exact projector identity is
--
--   dS(Pw) = dS(w) - dS((I-P)w),
--
-- while the raw extractor has
--
--   dS(w) = Singleton + RawLocalization.
--
-- Therefore the projected spillover is
--
--   RawLocalization - dS((I-P)w).
--
-- Round 39 proves dS((I-P)w)=<lambda,Lw>, with a positive pairing sign.
-- Stationarity consequently gives the canonical equality
--
--   Singleton = - RawLocalization + <lambda,Lw>.
--
-- In particular, the quantity that must be bounded above is
-- RawLocalization-<lambda,Lw>; the displayed alternative
-- -RawLocalization-<lambda,Lw> is not definitionally generated by the
-- selected-variation decomposition.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_)
open import Data.Rational.Base as ℚ using
  (ℚ; 0ℚ; _+_; _-_; _*_; -_; _≤_)
import Data.Rational.Properties as ℚP
import Data.Rational.Tactic.RingSolver as ℚRing
open import Relation.Binary.PropositionalEquality using
  (cong; subst; sym; trans)

open import DASHI.Physics.YangMills.CompactLieProofLevel
import DASHI.Physics.YangMills.BalabanP33FiniteKKTAdmissibleProjectorExact as KKT
import DASHI.Physics.YangMills.BalabanP33PlaquetteBoundaryProjectorExact as Boundary
import DASHI.Physics.YangMills.BalabanSelectedVariationKKTMultiplierExact as Stationary
import DASHI.Physics.YangMills.BalabanSelectedRawExtractorConstraintDefectExact as RawDefect

rawVariationDecomposition :
  ∀ {Multiplier}
    (dataSet : Stationary.SelectedKKTStationaryData Multiplier)
    vector →
  Stationary.firstVariation dataSet vector
  ≡ Stationary.firstVariation dataSet
      (KKT.selectedAdmissibleProject
        (Stationary.projectorData dataSet) vector)
    + Stationary.firstVariation dataSet
      (KKT.selectedConstraintRepair
        (Stationary.projectorData dataSet) vector)
rawVariationDecomposition =
  Stationary.firstVariationRawSplitsProjectedRepair

projectedVariationDecomposition :
  ∀ {Multiplier}
    (dataSet : Stationary.SelectedKKTStationaryData Multiplier)
    vector →
  Stationary.firstVariation dataSet
      (KKT.selectedAdmissibleProject
        (Stationary.projectorData dataSet) vector)
  ≡ Stationary.firstVariation dataSet vector
    - Stationary.firstVariation dataSet
      (KKT.selectedConstraintRepair
        (Stationary.projectorData dataSet) vector)
projectedVariationDecomposition =
  Stationary.projectedFirstVariationIsRawMinusRepair

projectorDefectSignExact :
  ∀ {Multiplier}
    (dataSet : Stationary.SelectedKKTStationaryData Multiplier)
    bondField plaquette →
  Stationary.firstVariation dataSet
    (KKT.selectedConstraintRepair
      (Stationary.projectorData dataSet)
      (Boundary.rawPlaquetteSingletonExtractor bondField plaquette))
  ≡ KKT.multiplierDot
      (Stationary.projectorData dataSet)
      (Stationary.kktMultiplier dataSet)
      (RawDefect.rawExtractorConstraintDefect
        (Stationary.projectorData dataSet) bondField plaquette)
projectorDefectSignExact =
  RawDefect.rawExtractorProjectorDefectPairingExact

canonicalProjectedSpillover : ℚ → ℚ → ℚ
canonicalProjectedSpillover rawLocalization multiplierPairing =
  rawLocalization - multiplierPairing

singletonResidualSignExact :
  ∀ singleton rawLocalization multiplierPairing →
  singleton
    + canonicalProjectedSpillover rawLocalization multiplierPairing
    ≡ 0ℚ →
  singleton ≡ - rawLocalization + multiplierPairing
singletonResidualSignExact
    singleton rawLocalization multiplierPairing stationarity =
  trans
    (sym
      (ℚRing.solve-∀
        singleton rawLocalization multiplierPairing))
    (trans
      (cong
        (λ selected → selected
          - rawLocalization + multiplierPairing)
        stationarity)
      (ℚRing.solve-∀ rawLocalization multiplierPairing))

canonicalResidualIsRawMinusPairing :
  ∀ rawLocalization multiplierPairing →
  canonicalProjectedSpillover rawLocalization multiplierPairing
  ≡ rawLocalization - multiplierPairing
canonicalResidualIsRawMinusPairing rawLocalization multiplierPairing =
  ℚRing.solve []

singletonBudgetTargetExact :
  ∀ singleton rawLocalization multiplierPairing coefficient charge →
  singleton
    + canonicalProjectedSpillover rawLocalization multiplierPairing
    ≡ 0ℚ →
  canonicalProjectedSpillover rawLocalization multiplierPairing
    ≤ coefficient * charge →
  - (coefficient * charge) ≤ singleton
singletonBudgetTargetExact
    singleton rawLocalization multiplierPairing coefficient charge
    stationarity residualUpper =
  let
    singletonExact :
      singleton
      ≡ - canonicalProjectedSpillover
          rawLocalization multiplierPairing
    singletonExact =
      trans
        (singletonResidualSignExact
          singleton rawLocalization multiplierPairing stationarity)
        (ℚRing.solve-∀ rawLocalization multiplierPairing)

    reflected :
      - (coefficient * charge)
      ≤ - canonicalProjectedSpillover
          rawLocalization multiplierPairing
    reflected = ℚP.neg-antimono-≤ residualUpper
  in
  subst
    (λ upper → - (coefficient * charge) ≤ upper)
    (sym singletonExact)
    reflected

wrongDoubleNegativeWouldForcePairCancellation :
  ∀ rawLocalization multiplierPairing →
  (- rawLocalization + multiplierPairing)
    ≡ (- rawLocalization - multiplierPairing) →
  multiplierPairing + multiplierPairing ≡ 0ℚ
wrongDoubleNegativeWouldForcePairCancellation
    rawLocalization multiplierPairing equality =
  trans
    (sym
      (ℚRing.solve-∀ rawLocalization multiplierPairing))
    (trans
      (cong
        (λ selected → selected
          + rawLocalization + multiplierPairing)
        equality)
      (ℚRing.solve-∀ rawLocalization multiplierPairing))

selectedVariationSignConventionLevel : ProofLevel
selectedVariationSignConventionLevel = machineChecked

selectedVariationPhysicalResidualBoundProducerLevel : ProofLevel
selectedVariationPhysicalResidualBoundProducerLevel = conditional
