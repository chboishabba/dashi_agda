{-
  DASHI reconstruction of the finite-dimensional unitary trace inequality.
  The proof below is synthetically generated by DASHI from the standard
  finite-matrix argument; no external theorem is claimed.

  For a concrete complex matrix U over the repository's ordered-real
  boundary, unitarity U†U = I gives every column norm equal to one.
  The diagonal entry is one term of that column norm, hence its real
  part has absolute value at most one.  The finite diagonal sum and any
  normalizer satisfying the explicit finite bound are then discharged by
  finite-sum algebra.
-}
module DASHI.Physics.YangMills.YMClaySUNConcreteUnitaryTraceRangeExact where

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Nat using (Nat; zero; suc)
open import Data.Sum using (_⊎_; inj₁; inj₂)
open import Data.Fin.Base as Fin using (Fin)
open import Relation.Binary.PropositionalEquality using (cong; sym; trans; subst)

open import DASHI.Foundations.RealAnalysisAxioms using
  (ℝ; 0ℝ; 1ℝ; _+ℝ_; _-ℝ_; _*ℝ_; -ℝ_; absℝ; _≤ℝ_; _<ℝ_;
   zeroLtOne; strictToNonnegative; ≤ℝ-refl; ≤ℝ-trans; ≤ℝ-total;
   addNonnegative; +-mono-≤; negEqSubZero; negℝ-involutive;
   negℝ-order; negℝ-mulˡ; negℝ-mul-neg; subEqAddNeg; subSelf;
   absZero; absAddSubadditive; absMul; absNonnegative;
   absOfNonnegative; absOfNonpositive; mulNonnegative;
   mulMonotoneNonnegative; mulOneʳ; +-identityˡ; +-identityʳ; +-comm;
   oneNonnegative)

module C where
  record ComplexPair : Set where
    constructor complex
    field
      re im : ℝ
  open ComplexPair public

  zeroC : ComplexPair
  zeroC = complex 0ℝ 0ℝ

  _+C_ : ComplexPair → ComplexPair → ComplexPair
  _+C_ (complex a b) (complex c d) = complex (a +ℝ c) (b +ℝ d)

  _*C_ : ComplexPair → ComplexPair → ComplexPair
  _*C_ (complex a b) (complex c d) =
    complex ((a *ℝ c) -ℝ (b *ℝ d)) ((a *ℝ d) +ℝ (b *ℝ c))

  conjugateC : ComplexPair → ComplexPair
  conjugateC (complex a b) = complex a (-ℝ b)

  normSqC : ComplexPair → ℝ
  normSqC (complex a b) = (a *ℝ a) +ℝ (b *ℝ b)

private
  addLeftMono : ∀ {a b : ℝ} (c : ℝ) → a ≤ℝ b → c +ℝ a ≤ℝ c +ℝ b
  addLeftMono c h = +-mono-≤ ≤ℝ-refl h

  addRightMono : ∀ {a b : ℝ} (c : ℝ) → a ≤ℝ b → a +ℝ c ≤ℝ b +ℝ c
  addRightMono c h = +-mono-≤ h ≤ℝ-refl

  leAddNonnegative : ∀ {a b : ℝ} → 0ℝ ≤ℝ b → a ≤ℝ a +ℝ b
  leAddNonnegative {a} {b} hb =
    subst (λ t → t ≤ℝ a +ℝ b) (+-identityʳ a) (addLeftMono a hb)

  negZero : (-ℝ 0ℝ) ≡ 0ℝ
  negZero = trans (negEqSubZero 0ℝ) (subSelf 0ℝ)

  squareNonnegative : ∀ (a : ℝ) → 0ℝ ≤ℝ a *ℝ a
  squareNonnegative a with ≤ℝ-total 0ℝ a
  ... | inj₁ h0 = mulNonnegative h0 h0
  ... | inj₂ ha =
    let hneg = subst (λ t → t ≤ℝ (-ℝ a)) negZero (negℝ-order ha)
    in subst (λ t → 0ℝ ≤ℝ t) (negℝ-mul-neg a a) (mulNonnegative hneg hneg)

  absLeOneOfSquareLeOne : ∀ {a : ℝ} → absℝ a *ℝ absℝ a ≤ℝ 1ℝ → absℝ a ≤ℝ 1ℝ
  absLeOneOfSquareLeOne {a} hsqAbs with ≤ℝ-total (absℝ a) 1ℝ
  ... | inj₁ hle = hle
  ... | inj₂ hge =
    let h0abs = absNonnegative a
        h0one = strictToNonnegative zeroLtOne
        hmul = mulMonotoneNonnegative h0abs ≤ℝ-refl h0one hge
        hleSquare =
          subst (λ t → t ≤ℝ absℝ a *ℝ absℝ a) (mulOneʳ (absℝ a)) hmul
    in ≤ℝ-trans hleSquare hsqAbs

sumFin : ∀ {n : Nat} → (Fin n → ℝ) → ℝ
sumFin {zero} f = 0ℝ
sumFin {suc n} f = f Fin.zero +ℝ sumFin (λ k → f (Fin.suc k))

sumFinNonnegative :
  ∀ {n : Nat} (f : Fin n → ℝ) →
  (∀ i → 0ℝ ≤ℝ f i) →
  0ℝ ≤ℝ sumFin f
sumFinNonnegative {zero} f hf = ≤ℝ-refl
sumFinNonnegative {suc n} f hf =
  addNonnegative (hf Fin.zero)
    (sumFinNonnegative (λ k → f (Fin.suc k)) (λ k → hf (Fin.suc k)))

sumFinMono :
  ∀ {n : Nat} {f g : Fin n → ℝ} →
  (∀ i → f i ≤ℝ g i) →
  sumFin f ≤ℝ sumFin g
sumFinMono {zero} {f} {g} h = ≤ℝ-refl
sumFinMono {suc n} {f} {g} h =
  +-mono-≤ (h Fin.zero)
    (sumFinMono {f = λ k → f (Fin.suc k)} {g = λ k → g (Fin.suc k)}
      (λ k → h (Fin.suc k)))

sumFinCongr :
  ∀ {n : Nat} {f g : Fin n → ℝ} →
  (∀ i → f i ≡ g i) →
  sumFin f ≡ sumFin g
sumFinCongr {zero} {f} {g} h = refl
sumFinCongr {suc n} {f} {g} h =
  cong₂ℝ (h Fin.zero)
    (sumFinCongr {f = λ k → f (Fin.suc k)} {g = λ k → g (Fin.suc k)}
      (λ k → h (Fin.suc k)))
  where
    cong₂ℝ : ∀ {a b c d : ℝ} → a ≡ b → c ≡ d → a +ℝ c ≡ b +ℝ d
    cong₂ℝ refl refl = refl

sumFinAbsBound :
  ∀ {n : Nat} (f : Fin n → ℝ) →
  absℝ (sumFin f) ≤ℝ sumFin (λ i → absℝ (f i))
sumFinAbsBound {zero} f =
  subst (λ t → t ≤ℝ 0ℝ) (sym absZero) ≤ℝ-refl
sumFinAbsBound {suc n} f =
  ≤ℝ-trans (absAddSubadditive (f Fin.zero) (sumFin (λ k → f (Fin.suc k))))
    (addLeftMono (absℝ (f Fin.zero)) (sumFinAbsBound (λ k → f (Fin.suc k))))

termLeSum :
  ∀ {n : Nat} (f : Fin n → ℝ) (i : Fin n) →
  (∀ k → 0ℝ ≤ℝ f k) →
  f i ≤ℝ sumFin f
termLeSum {zero} f ()
termLeSum {suc n} f Fin.zero hf =
  leAddNonnegative
    (sumFinNonnegative (λ k → f (Fin.suc k)) (λ k → hf (Fin.suc k)))
termLeSum {suc n} f (Fin.suc i) hf =
  let tailLe =
        subst
          (λ t → sumFin (λ k → f (Fin.suc k)) ≤ℝ t)
          (sym (+-comm (f Fin.zero) (sumFin (λ k → f (Fin.suc k)))))
          (leAddNonnegative {a = sumFin (λ k → f (Fin.suc k))}
            {b = f Fin.zero} (hf Fin.zero))
  in ≤ℝ-trans
       (termLeSum (λ k → f (Fin.suc k)) i (λ k → hf (Fin.suc k)))
       tailLe

ConcreteMatrix : Nat → Set
ConcreteMatrix n = Fin n → Fin n → C.ComplexPair

delta : ∀ {n : Nat} → Fin n → Fin n → ℝ
delta {zero} () ()
delta {suc n} Fin.zero Fin.zero = 1ℝ
delta {suc n} Fin.zero (Fin.suc _) = 0ℝ
delta {suc n} (Fin.suc _) Fin.zero = 0ℝ
delta {suc n} (Fin.suc i) (Fin.suc j) = delta i j

deltaDiagonal : ∀ {n : Nat} (i : Fin n) → delta i i ≡ 1ℝ
deltaDiagonal {zero} ()
deltaDiagonal {suc n} Fin.zero = refl
deltaDiagonal {suc n} (Fin.suc i) = deltaDiagonal i

complexSum : ∀ {n : Nat} → (Fin n → C.ComplexPair) → C.ComplexPair
complexSum {zero} f = C.zeroC
complexSum {suc n} f =
  C._+C_ (f Fin.zero) (complexSum (λ k → f (Fin.suc k)))

concreteDagger : ∀ {n : Nat} → ConcreteMatrix n → ConcreteMatrix n
concreteDagger U i j = C.conjugateC (U j i)

concreteMultiply :
  ∀ {n : Nat} → ConcreteMatrix n → ConcreteMatrix n → ConcreteMatrix n
concreteMultiply A B i j =
  complexSum (λ k → C._*C_ (A i k) (B k j))

concreteIdentityMatrix : ∀ {n : Nat} → ConcreteMatrix n
concreteIdentityMatrix i j = C.complex (delta i j) 0ℝ

complexSumRe :
  ∀ {n : Nat} (f : Fin n → C.ComplexPair) →
  C.re (complexSum f) ≡ sumFin (λ i → C.re (f i))
complexSumRe {zero} f = refl
complexSumRe {suc n} f =
  cong (λ t → C.re (f Fin.zero) +ℝ t)
    (complexSumRe (λ k → f (Fin.suc k)))

reConjugateMulSelf :
  ∀ (z : C.ComplexPair) →
  C.re (C._*C_ (C.conjugateC z) z) ≡ C.normSqC z
reConjugateMulSelf (C.complex a b) =
  trans (subEqAddNeg (a *ℝ a) ((-ℝ b) *ℝ b))
    (cong (λ t → (a *ℝ a) +ℝ t)
      (trans
        (cong (λ t → -ℝ t) (negℝ-mulˡ b b))
        (negℝ-involutive (b *ℝ b))))

columnNormSum :
  ∀ {n : Nat} (U : ConcreteMatrix n) (i : Fin n) →
  C.re (concreteMultiply (concreteDagger U) U i i)
    ≡ sumFin (λ k → C.normSqC (U k i))
columnNormSum {n} U i =
  trans (complexSumRe (λ k → C._*C_ (concreteDagger U i k) (U k i)))
    (sumFinCongr (λ k → reConjugateMulSelf (U k i)))

columnNormEqOne :
  ∀ {n : Nat} (U : ConcreteMatrix n) →
  concreteMultiply (concreteDagger U) U ≡ concreteIdentityMatrix →
  ∀ i → sumFin (λ k → C.normSqC (U k i)) ≡ 1ℝ
columnNormEqOne U unitary i =
  trans (sym (columnNormSum U i))
    (trans (cong (λ M → C.re (M i i)) unitary) (deltaDiagonal i))

normSqNonnegative : ∀ (z : C.ComplexPair) → 0ℝ ≤ℝ C.normSqC z
normSqNonnegative (C.complex a b) =
  addNonnegative (squareNonnegative a) (squareNonnegative b)

diagonalNormSqLeOne :
  ∀ {n : Nat} (U : ConcreteMatrix n) →
  concreteMultiply (concreteDagger U) U ≡ concreteIdentityMatrix →
  ∀ i → C.normSqC (U i i) ≤ℝ 1ℝ
diagonalNormSqLeOne U unitary i =
  subst (λ t → C.normSqC (U i i) ≤ℝ t)
    (columnNormEqOne U unitary i)
    (termLeSum (λ k → C.normSqC (U k i)) i
      (λ k → normSqNonnegative (U k i)))

reAbsSquareLeNormSq :
  ∀ (z : C.ComplexPair) →
  absℝ (C.re z) *ℝ absℝ (C.re z) ≤ℝ C.normSqC z
reAbsSquareLeNormSq (C.complex a b) with ≤ℝ-total 0ℝ a
... | inj₁ h0 =
  let hle = leAddNonnegative (squareNonnegative b)
  in subst (λ t → t *ℝ t ≤ℝ (a *ℝ a) +ℝ (b *ℝ b))
       (sym (absOfNonnegative h0)) hle
... | inj₂ ha =
  let hle = leAddNonnegative (squareNonnegative b)
      hle' =
        subst (λ t → t ≤ℝ (a *ℝ a) +ℝ (b *ℝ b)) (sym (negℝ-mul-neg a a)) hle
  in subst (λ t → t *ℝ t ≤ℝ (a *ℝ a) +ℝ (b *ℝ b))
       (sym (absOfNonpositive ha)) hle'

concreteDiagonalRealPartRange :
  ∀ {n : Nat} (U : ConcreteMatrix n) →
  concreteMultiply (concreteDagger U) U ≡ concreteIdentityMatrix →
  ∀ i → absℝ (C.re (U i i)) ≤ℝ 1ℝ
concreteDiagonalRealPartRange U unitary i =
  absLeOneOfSquareLeOne
    (≤ℝ-trans (reAbsSquareLeNormSq (U i i)) (diagonalNormSqLeOne U unitary i))

natToReal : Nat → ℝ
natToReal zero = 0ℝ
natToReal (suc n) = natToReal n +ℝ 1ℝ

natToRealNonnegative : ∀ n → 0ℝ ≤ℝ natToReal n
natToRealNonnegative zero = ≤ℝ-refl
natToRealNonnegative (suc n) =
  addNonnegative (natToRealNonnegative n) oneNonnegative

sumFinOnes : ∀ (n : Nat) → sumFin (λ (_ : Fin n) → 1ℝ) ≡ natToReal n
sumFinOnes zero = refl
sumFinOnes (suc n) =
  trans (cong (λ t → 1ℝ +ℝ t) (sumFinOnes n)) (+-comm 1ℝ (natToReal n))

concreteDiagonalSumAbsBound :
  ∀ {n : Nat} (U : ConcreteMatrix n) →
  concreteMultiply (concreteDagger U) U ≡ concreteIdentityMatrix →
  absℝ (sumFin (λ i → C.re (U i i))) ≤ℝ natToReal n
concreteDiagonalSumAbsBound {n} U unitary =
  ≤ℝ-trans h1
    (≤ℝ-trans h2
      (subst (λ t → sumFin (λ (_ : Fin n) → 1ℝ) ≤ℝ t)
        (sumFinOnes n) ≤ℝ-refl))
  where
    h1 : absℝ (sumFin (λ i → C.re (U i i)))
       ≤ℝ sumFin (λ i → absℝ (C.re (U i i)))
    h1 = sumFinAbsBound (λ i → C.re (U i i))
    h2 : sumFin (λ i → absℝ (C.re (U i i)))
       ≤ℝ sumFin (λ (_ : Fin n) → 1ℝ)
    h2 = sumFinMono (λ i → concreteDiagonalRealPartRange U unitary i)

concreteNormalizedRealTraceRange :
  ∀ {n : Nat} (U : ConcreteMatrix n) →
  concreteMultiply (concreteDagger U) U ≡ concreteIdentityMatrix →
  (normalizer : ℝ) →
  absℝ normalizer *ℝ natToReal n ≤ℝ 1ℝ →
  absℝ (normalizer *ℝ sumFin (λ i → C.re (U i i))) ≤ℝ 1ℝ
concreteNormalizedRealTraceRange {n} U unitary normalizer normalizerBound =
  subst (λ t → t ≤ℝ 1ℝ)
    (sym (absMul normalizer (sumFin (λ i → C.re (U i i)))))
    (≤ℝ-trans hmul normalizerBound)
  where
    hsum = concreteDiagonalSumAbsBound U unitary
    hmul : absℝ normalizer *ℝ absℝ (sumFin (λ i → C.re (U i i)))
          ≤ℝ absℝ normalizer *ℝ natToReal n
    hmul =
      mulMonotoneNonnegative (absNonnegative normalizer) ≤ℝ-refl
        (absNonnegative (sumFin (λ i → C.re (U i i)))) hsum
