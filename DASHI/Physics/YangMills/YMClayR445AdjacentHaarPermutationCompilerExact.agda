module DASHI.Physics.YangMills.YMClayR445AdjacentHaarPermutationCompilerExact where

------------------------------------------------------------------------
-- R445 P0.D finite permutation compiler, not an invariance postulate.
--
-- The existing source Haar.LinkPermutation is generated by identity,
-- composition, head-fixed permutations and a head transposition.
-- The code below compiles an arbitrary *typed schedule* of legal
-- adjacent transpositions to that EXACT original Haar source.
-- Its action equality is proved by induction, without new axioms.
--
-- For the original canonical 1024-bond -> 128 pair + 896 residual
-- permutation, a deterministic insertion schedule has 41,792
-- adjacent transpositions. Do NOT hardcode them in a gigantic
-- Agda proof term: first establish a compact, typed and checked
-- source schedule/recursive permutation witness. This module
-- isolates the reusable compiler and proof.
--
-- It does NOT by itself inhabit the original selected
-- 1024-bond OriginalR445PermutationAndNativeBlockWeld, prove Haar
-- transport through the canonical codec, or establish physical RG.
------------------------------------------------------------------------

open import Agda.Builtin.Nat using (Nat; zero; suc)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List using (List; []; _∷_)
open import Data.Fin.Base using (Fin) renaming (zero to fzero; suc to fsuc)
open import Data.Vec.Base using (Vec)

import DASHI.Physics.YangMills.YMClayFiniteProductHaarPermutationExact as Haar

-- A legal adjacent position in a vector with n+2 entries. No
-- out-of-range index can be represented by this constructor.
originalAdjacentSwap :
  ∀ {n} → Fin (suc n) →
  Haar.LinkPermutation (suc (suc n))
originalAdjacentSwap fzero = Haar.swapHead
originalAdjacentSwap {suc n} (fsuc position) =
  Haar.fixHead (originalAdjacentSwap {n} position)

-- Chronological order: first position in the list is applied first.
originalAdjacentSchedule :
  ∀ {n} → List (Fin (suc n)) →
  Haar.LinkPermutation (suc (suc n))
originalAdjacentSchedule [] = Haar.identity
originalAdjacentSchedule (position ∷ rest) =
  Haar.compose
    (originalAdjacentSchedule rest)
    (originalAdjacentSwap position)

originalExecuteAdjacentSchedule :
  ∀ {Link : Set} {n : Nat} →
  List (Fin (suc n)) →
  Vec Link (suc (suc n)) →
  Vec Link (suc (suc n))
originalExecuteAdjacentSchedule [] vector = vector
originalExecuteAdjacentSchedule (position ∷ rest) vector =
  originalExecuteAdjacentSchedule rest
    (Haar.permuteLinks (originalAdjacentSwap position) vector)

-- A proof for *every* length, value carrier and typed schedule.
-- This is the interface needed to turn a finite bond-coordinate
-- sorting/renaming certificate into the original Haar API.
originalAdjacentScheduleCompilationCorrect :
  ∀ {Link : Set} {n : Nat}
    (schedule : List (Fin (suc n)))
    (vector : Vec Link (suc (suc n))) →
  Haar.permuteLinks (originalAdjacentSchedule schedule) vector
  ≡ originalExecuteAdjacentSchedule schedule vector
originalAdjacentScheduleCompilationCorrect [] vector = refl
originalAdjacentScheduleCompilationCorrect
    (position ∷ rest) vector =
  originalAdjacentScheduleCompilationCorrect rest
    (Haar.permuteLinks (originalAdjacentSwap position) vector)

-- Exact R445 source cardinalities; the actual schedule and its
-- canonical bond-list equality remain explicitly unpaid.
OriginalR445AdjacentPosition : Set
OriginalR445AdjacentPosition = Fin 1023

originalR445CompileSchedule :
  List OriginalR445AdjacentPosition →
  Haar.LinkPermutation 1024
originalR445CompileSchedule = originalAdjacentSchedule

originalR445ScheduledActionCorrect :
  ∀ {Link : Set}
    (schedule : List OriginalR445AdjacentPosition)
    (vector : Vec Link 1024) →
  Haar.permuteLinks (originalR445CompileSchedule schedule) vector
  ≡ originalExecuteAdjacentSchedule schedule vector
originalR445ScheduledActionCorrect =
  originalAdjacentScheduleCompilationCorrect
