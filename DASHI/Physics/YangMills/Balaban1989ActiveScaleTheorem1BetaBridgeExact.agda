module DASHI.Physics.YangMills.Balaban1989ActiveScaleTheorem1BetaBridgeExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES
--
-- Tadeusz Bałaban,
-- "Convergent Renormalization Expansions for Lattice Gauge Theories",
-- Communications in Mathematical Physics 119 (1988), 243--285.
-- DOI: 10.1007/BF01217741.
--
-- Tadeusz Bałaban,
-- "Large Field Renormalization. II. Localization, Exponentiation, and Bounds
-- for the R Operation", Communications in Mathematical Physics 122 (1989),
-- 355--392. DOI: 10.1007/BF01238433.
--
-- DASHI CONTRIBUTION
--
-- CMP122 Theorem 1 is a statement about the sequence of effective densities
-- generated by a FINITE ultraviolet trajectory: if every effective coupling
-- occurring in that trajectory lies in (0,gamma], then every corresponding
-- density has the Sect.-2 form and bounds of CMP119.  A previous repository
-- carrier encoded this as a hypothesis over every natural number, which is
-- stronger than the cutoff problem and does not compose with the already
-- correct ActiveScale terminal-history theorem.
--
-- This file gives the source-shaped active-scale carrier and proves that the
-- finite-mode beta history supplies its entire coupling hypothesis.  No new RG
-- estimate is assumed: positivity is the literal rational positivity already
-- stored by the finite history, and smallness is the theorem propagated from
-- the single terminal inverse-coupling threshold.
------------------------------------------------------------------------

open import Agda.Builtin.Nat using (Nat)
open import Data.Rational.Base as ℚ using (ℚ; Positive; _≤_)

open import DASHI.Physics.YangMills.CompactLieProofLevel
import DASHI.Physics.YangMills.BalabanYM4SourceNormalizedCouplingRecurrenceExact as Flow
import DASHI.Physics.YangMills.BalabanYM4FiniteModeBetaToSourceTrajectoryExact as FiniteBeta
import DASHI.Physics.YangMills.Balaban1989FiniteModeInverseSquareTerminalHistoryExact as History

record ActiveEffectiveDensityFlow
    (trajectory : Flow.SourceNormalizedCouplingTrajectory)
    (Mode Atom Density : Set)
    (betaData : FiniteBeta.FiniteModeBetaTrajectoryData trajectory Mode Atom)
    (history : History.FiniteModeInverseSquareTerminalHistoryData
      trajectory Mode Atom betaData) : Set₁ where
  field
    densityAt : Nat → Density

    InSection2DensityClass : Nat → Density → Set
    Section2ConditionsAndBounds : Nat → Density → Set

open ActiveEffectiveDensityFlow public

activeCouplingPositive :
  ∀ {trajectory Mode Atom Density betaData history}
    (flow : ActiveEffectiveDensityFlow
      trajectory Mode Atom Density betaData history)
    scale → History.ActiveScale history scale →
  Positive (History.couplingAt history scale)
activeCouplingPositive {history = history} flow scale active =
  History.couplingPositive history scale

activeCouplingSmall :
  ∀ {trajectory Mode Atom Density betaData history}
    (flow : ActiveEffectiveDensityFlow
      trajectory Mode Atom Density betaData history)
    scale → History.ActiveScale history scale →
  History.couplingAt history scale ≤ History.gamma history
activeCouplingSmall {history = history} flow scale active =
  History.finiteModeSmallCouplingAtActiveScale history scale active

record ActiveTheorem1CouplingHypothesis
    {trajectory : Flow.SourceNormalizedCouplingTrajectory}
    {Mode Atom Density : Set}
    {betaData : FiniteBeta.FiniteModeBetaTrajectoryData trajectory Mode Atom}
    {history : History.FiniteModeInverseSquareTerminalHistoryData
      trajectory Mode Atom betaData}
    (flow : ActiveEffectiveDensityFlow
      trajectory Mode Atom Density betaData history) : Set₁ where
  field
    positiveOnEveryActiveScale : ∀ scale →
      History.ActiveScale history scale →
      Positive (History.couplingAt history scale)

    atMostGammaOnEveryActiveScale : ∀ scale →
      History.ActiveScale history scale →
      History.couplingAt history scale ≤ History.gamma history

open ActiveTheorem1CouplingHypothesis public

finiteModeHistorySuppliesTheorem1CouplingHypothesis :
  ∀ {trajectory Mode Atom Density betaData history}
    (flow : ActiveEffectiveDensityFlow
      trajectory Mode Atom Density betaData history) →
  ActiveTheorem1CouplingHypothesis flow
finiteModeHistorySuppliesTheorem1CouplingHypothesis
    {history = history} flow = record
  { positiveOnEveryActiveScale = λ scale active →
      activeCouplingPositive flow scale active
  ; atMostGammaOnEveryActiveScale = λ scale active →
      activeCouplingSmall flow scale active
  }

------------------------------------------------------------------------
-- Exact source-theorem boundary.  The theorem itself is a published imported
-- authority, not a DASHI invention.  Notice that its result is restricted to
-- the same ActiveScale predicate as its hypothesis; there is no fictitious
-- density assertion beyond the terminal cutoff.
------------------------------------------------------------------------

record ActiveBalaban1989Theorem1Witness
    {trajectory : Flow.SourceNormalizedCouplingTrajectory}
    {Mode Atom Density : Set}
    {betaData : FiniteBeta.FiniteModeBetaTrajectoryData trajectory Mode Atom}
    {history : History.FiniteModeInverseSquareTerminalHistoryData
      trajectory Mode Atom betaData}
    (flow : ActiveEffectiveDensityFlow
      trajectory Mode Atom Density betaData history) : Set₁ where
  field
    effectiveDensitiesPreserveSection2Form : ∀ scale →
      History.ActiveScale history scale →
      InSection2DensityClass flow scale (densityAt flow scale)

    effectiveDensitiesSatisfySection2Bounds : ∀ scale →
      History.ActiveScale history scale →
      Section2ConditionsAndBounds flow scale (densityAt flow scale)

open ActiveBalaban1989Theorem1Witness public

record ActiveSection2Invariant
    {trajectory : Flow.SourceNormalizedCouplingTrajectory}
    {Mode Atom Density : Set}
    {betaData : FiniteBeta.FiniteModeBetaTrajectoryData trajectory Mode Atom}
    {history : History.FiniteModeInverseSquareTerminalHistoryData
      trajectory Mode Atom betaData}
    (flow : ActiveEffectiveDensityFlow
      trajectory Mode Atom Density betaData history)
    (source : ActiveBalaban1989Theorem1Witness flow)
    (scale : Nat)
    (active : History.ActiveScale history scale) : Set where
  field
    section2Form :
      InSection2DensityClass flow scale (densityAt flow scale)
    section2Bounds :
      Section2ConditionsAndBounds flow scale (densityAt flow scale)

open ActiveSection2Invariant public

activeSection2Invariant :
  ∀ {trajectory Mode Atom Density betaData history}
    {flow : ActiveEffectiveDensityFlow
      trajectory Mode Atom Density betaData history}
    (source : ActiveBalaban1989Theorem1Witness flow)
    scale (active : History.ActiveScale history scale) →
  ActiveSection2Invariant flow source scale active
activeSection2Invariant source scale active = record
  { section2Form = effectiveDensitiesPreserveSection2Form source scale active
  ; section2Bounds = effectiveDensitiesSatisfySection2Bounds source scale active
  }

activeScaleCMP122CouplingHypothesisFromFiniteBetaLevel : ProofLevel
activeScaleCMP122CouplingHypothesisFromFiniteBetaLevel = machineChecked

activeScaleCMP122Section2AssemblyLevel : ProofLevel
activeScaleCMP122Section2AssemblyLevel = machineChecked

activeScaleCMP122Theorem1SourceLevel : ProofLevel
activeScaleCMP122Theorem1SourceLevel = standardImported
