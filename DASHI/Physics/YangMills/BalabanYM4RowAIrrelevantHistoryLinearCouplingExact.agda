{-# OPTIONS --safe #-}
module DASHI.Physics.YangMills.BalabanYM4RowAIrrelevantHistoryLinearCouplingExact where

------------------------------------------------------------------------
-- ROW A: O(gamma) INITIAL IRRELEVANT RESPONSE -> O(gamma) HISTORY SENSITIVITY
--
-- The previous compiler gives the cutoff-uniform history sensitivity constant
--
--   H_hist = 2 L_beta S_init,
--
-- where L_beta is the Lipschitz projection from the irrelevant coordinate to
-- beta and S_init controls the initial irrelevant displacement generated by the
-- shooting input.
--
-- Therefore if source analysis proves only the natural small-coupling response
--
--   S_init <= S0 * gamma,
--
-- then automatically
--
--   H_hist <= (2 L_beta S0) * gamma.
--
-- This is exactly the O(gamma) history hypothesis consumed by the augmented
-- canonical Row-A gate.  No additional summation or contraction argument remains.
------------------------------------------------------------------------

open import Data.Rational.Base as ℚ using
  (ℚ; 0ℚ; _*_; _≤_; NonNegative)
import Data.Rational.Properties as ℚP
import Data.Rational.Tactic.RingSolver as ℚRing
open import Relation.Binary.PropositionalEquality using (subst)

open import DASHI.Physics.YangMills.CompactLieProofLevel
import DASHI.Physics.YangMills.BalabanIrrelevantRGMemoryContractionExact as Memory
import DASHI.Physics.YangMills.BalabanYM4RowAIrrelevantHistoryInputSensitivityExact as Input
import DASHI.Physics.YangMills.BalabanTraceKoteckyPreissGeometricExact as Geo
import DASHI.Physics.YangMills.BalabanP33RationalQuaternionNormSquaredExact as Norm

record InitialResponseLinearInCoupling
    {memory : Memory.ContractiveIrrelevantMemory}
    {projection : Memory.LipschitzIrrelevantBetaProjection memory}
    (response : Input.IrrelevantHistoryInputResponse projection) : Set where
  field
    couplingCap responseSlope : ℚ
    couplingCapNonnegative : 0ℚ ≤ couplingCap
    responseSlopeNonnegative : 0ℚ ≤ responseSlope
    responseConstantBelowSlopeTimesCoupling :
      Input.responseConstant response ≤ responseSlope * couplingCap

open InitialResponseLinearInCoupling public

historySlope :
  ∀ {memory}
    {projection : Memory.LipschitzIrrelevantBetaProjection memory}
    {response : Input.IrrelevantHistoryInputResponse projection} →
  InitialResponseLinearInCoupling response → ℚ
historySlope {projection = projection} dataSet =
  Geo.twoℚ * Memory.lipschitzConstant projection * responseSlope dataSet

historySlopeNonnegative :
  ∀ {memory}
    {projection : Memory.LipschitzIrrelevantBetaProjection memory}
    {response : Input.IrrelevantHistoryInputResponse projection}
    (dataSet : InitialResponseLinearInCoupling response) →
  0ℚ ≤ historySlope dataSet
historySlopeNonnegative {projection = projection} dataSet =
  let
    twoNN : 0ℚ ≤ Geo.twoℚ
    twoNN = ℚP.+-mono-≤ Geo.oneNonnegativeProof Geo.oneNonnegativeProof

    firstNN : 0ℚ ≤ Geo.twoℚ * Memory.lipschitzConstant projection
    firstNN =
      let
        instance
          twoNonnegative : NonNegative Geo.twoℚ
          twoNonnegative = ℚ.nonNegative twoNN
          lNonnegative : NonNegative (Memory.lipschitzConstant projection)
          lNonnegative = ℚ.nonNegative (Memory.lipschitzNonnegative projection)
      in
      ℚP.nonNegative⁻¹
        (Geo.twoℚ * Memory.lipschitzConstant projection)
  in
  let
    instance
      firstNonnegative : NonNegative
        (Geo.twoℚ * Memory.lipschitzConstant projection)
      firstNonnegative = ℚ.nonNegative firstNN
      slopeNonnegative : NonNegative (responseSlope dataSet)
      slopeNonnegative = ℚ.nonNegative (responseSlopeNonnegative dataSet)
  in
  ℚP.nonNegative⁻¹
    ((Geo.twoℚ * Memory.lipschitzConstant projection) * responseSlope dataSet)

historySensitivityLinearInCoupling :
  ∀ {memory}
    {projection : Memory.LipschitzIrrelevantBetaProjection memory}
    {response : Input.IrrelevantHistoryInputResponse projection}
    (dataSet : InitialResponseLinearInCoupling response) →
  Input.historySensitivityConstant response
  ≤ historySlope dataSet * couplingCap dataSet
historySensitivityLinearInCoupling {projection = projection} {response = response} dataSet =
  let
    L = Memory.lipschitzConstant projection
    S = Input.responseConstant response
    S0 = responseSlope dataSet
    g = couplingCap dataSet

    twoNN : 0ℚ ≤ Geo.twoℚ
    twoNN = ℚP.+-mono-≤ Geo.oneNonnegativeProof Geo.oneNonnegativeProof

    twoLNN : 0ℚ ≤ Geo.twoℚ * L
    twoLNN =
      let
        instance
          twoNonnegative : NonNegative Geo.twoℚ
          twoNonnegative = ℚ.nonNegative twoNN
          lNonnegative : NonNegative L
          lNonnegative = ℚ.nonNegative (Memory.lipschitzNonnegative projection)
      in
      ℚP.nonNegative⁻¹ (Geo.twoℚ * L)

    scaled = Norm.scaleNonnegative
      (Geo.twoℚ * L) twoLNN
      (responseConstantBelowSlopeTimesCoupling dataSet)
  in
  subst
    (λ upper → Input.historySensitivityConstant response ≤ upper)
    (ℚRing.solve-∀ Geo.twoℚ L S0 g)
    scaled

rowAInitialResponseToHistoryLinearCouplingLevel : ProofLevel
rowAInitialResponseToHistoryLinearCouplingLevel = machineChecked

-- The remaining physical statement is narrower still: on the literal generated
-- RG trajectory, the INITIAL irrelevant/polymer displacement created by a change
-- in the shooting input must be O(gamma).  The entire later history tail and its
-- cutoff-uniform sum are theorem-generated from that one source estimate.
literalInitialIrrelevantResponseLinearInCouplingLevel : ProofLevel
literalInitialIrrelevantResponseLinearInCouplingLevel = conditional
