module DASHI.Physics.YangMills.BalabanSelectedCanonicalConstraintAtomsFromSubsetExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES
--
-- Tadeusz Bałaban, "The Variational Problem and Background Fields in
-- Renormalization Group Method for Lattice Gauge Theories", Communications in
-- Mathematical Physics 102 (1985), 277--309.
-- DOI: 10.1007/BF01229381.
--
-- Roger Penrose, "A Generalized Inverse for Matrices", Proceedings of the
-- Cambridge Philosophical Society 51 (1955), 406--413.
-- DOI: 10.1017/S0305004100030401.
--
-- Gian-Carlo Rota, "On the Foundations of Combinatorial Theory I. Theory of
-- Möbius Functions", Z. Wahrscheinlichkeitstheorie verw. Gebiete 2 (1964),
-- 340--368. DOI: 10.1007/BF00531932.
--
-- DASHI CONTRIBUTION
-- Remove the remaining arbitrary `constraintAtoms` choice from the correlated
-- residual authority on the literal single-plaquette route.  Source and defect
-- atoms are now canonically generated by:
--
--   same 16 subset projectors -> actual KKT constraint -> Möbius transform.
--
-- Owner maps may classify the resulting atoms but cannot replace their values.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_)
open import Data.Rational.Base as ℚ using (ℚ)

open import DASHI.Physics.YangMills.CompactLieProofLevel
import DASHI.Physics.YangMills.BalabanPhysicalBlockFibreSumsExact as Sums
import DASHI.Physics.YangMills.BalabanWilsonBooleanFourCubeExact as Cube
import DASHI.Physics.YangMills.BalabanP33FiniteKKTAdmissibleProjectorExact as KKT
import DASHI.Physics.YangMills.BalabanP33FiniteKKTPseudoinverseProjectorExact as Pseudo
import DASHI.Physics.YangMills.BalabanP33PlaquetteBoundaryProjectorExact as Boundary
import DASHI.Physics.YangMills.BalabanP33PhysicalSU2FiniteCoordinatesExact as Physical
import DASHI.Physics.YangMills.BalabanP33PhysicalRationalWilsonPlaquetteJetExact as Plaquette
import DASHI.Physics.YangMills.BalabanSelectedSourceSubsetConstraintPartialExact as SubsetSource
import DASHI.Physics.YangMills.BalabanSelectedRawExtractorConstraintDefectAtomsExact as Atoms
import DASHI.Physics.YangMills.BalabanSelectedCorrelatedResidualOwnershipExact as Ownership
import DASHI.Physics.YangMills.BalabanSelectedCorrelatedResidualAuthorityExact as Authority

record CanonicalSubsetCorrelatedAuthorityInputs
    {Multiplier : Set}
    (pseudoData : Pseudo.FiniteKKTPseudoinverseData Multiplier)
    (firstVariationCovector : KKT.StateVector)
    (bondField : Physical.PhysicalSU2BondField4)
    (plaquette : Plaquette.Plaquette4) : Set₁ where
  field
    sourceSupported :
      SubsetSource.PlaquetteSupportedSource plaquette firstVariationCovector

    rawLocalization : ℚ
    rawLocalizationAtom : Cube.Subset4 → ℚ
    rawLocalizationReconstruct :
      Sums.sumRational Cube.nonemptySubsets4 rawLocalizationAtom
      ≡ rawLocalization

    rawOwnerOf : Cube.Subset4 → Ownership.CorrelatedResidualOwner
    greenOwnerOf :
      Cube.Subset4 → Cube.Subset4 → Ownership.MultiplierGreenAtomOwner

open CanonicalSubsetCorrelatedAuthorityInputs public

sourceDefectProducer :
  ∀ {Multiplier pseudoData firstVariationCovector bondField plaquette} →
  CanonicalSubsetCorrelatedAuthorityInputs
    {Multiplier} pseudoData firstVariationCovector bondField plaquette →
  SubsetSource.LiteralSourceDefectSubsetProducer
    pseudoData firstVariationCovector bondField plaquette
sourceDefectProducer inputs = record
  { SubsetSource.LiteralSourceDefectSubsetProducer.sourceSupported =
      sourceSupported inputs }

canonicalConstraintAtoms :
  ∀ {Multiplier pseudoData firstVariationCovector bondField plaquette} →
  CanonicalSubsetCorrelatedAuthorityInputs
    {Multiplier} pseudoData firstVariationCovector bondField plaquette →
  Atoms.SelectedConstraintAtomData
    pseudoData firstVariationCovector
    (Boundary.rawPlaquetteSingletonExtractor bondField plaquette)
canonicalConstraintAtoms inputs =
  SubsetSource.literalSourceDefectMobiusAtoms (sourceDefectProducer inputs)

canonicalCorrelatedResidualAuthority :
  ∀ {Multiplier pseudoData firstVariationCovector bondField plaquette} →
  CanonicalSubsetCorrelatedAuthorityInputs
    {Multiplier} pseudoData firstVariationCovector bondField plaquette →
  Authority.CorrelatedResidualAuthority
    pseudoData firstVariationCovector
    (Boundary.rawPlaquetteSingletonExtractor bondField plaquette)
canonicalCorrelatedResidualAuthority inputs = record
  { Authority.CorrelatedResidualAuthority.rawLocalization =
      rawLocalization inputs
  ; Authority.CorrelatedResidualAuthority.rawLocalizationAtom =
      rawLocalizationAtom inputs
  ; Authority.CorrelatedResidualAuthority.rawLocalizationReconstruct =
      rawLocalizationReconstruct inputs
  ; Authority.CorrelatedResidualAuthority.constraintAtoms =
      canonicalConstraintAtoms inputs
  ; Authority.CorrelatedResidualAuthority.rawOwnerOf = rawOwnerOf inputs
  ; Authority.CorrelatedResidualAuthority.greenOwnerOf = greenOwnerOf inputs
  }

canonicalConstraintAtomsFromSubsetLevel : ProofLevel
canonicalConstraintAtomsFromSubsetLevel = machineChecked

canonicalCorrelatedAuthorityNoIndependentConstraintAtomsLevel : ProofLevel
canonicalCorrelatedAuthorityNoIndependentConstraintAtomsLevel = machineChecked

-- Remaining G2 producer on this path:
--   * physical plaquette support of the first-variation covector;
--   * raw-localization partial evaluations / grouped enclosure;
--   * quantitative Green/locality bounds.
-- There is no longer an independent 15-source + 15-defect atom authority.
