{-# OPTIONS --safe #-}
module DASHI.Physics.YangMills.BalabanRowAShootingFixedPointTerminalExactRound102 where

------------------------------------------------------------------------
-- ROUND102 A TUNING: SHOOTING FIXED POINT -> EXACT TERMINAL COORDINATE
--
-- For cutoff K let T_K(u)=u_R+B_K(u), where B_K is the cumulative beta prefix
-- of the trajectory generated by u.  At a fixed point u*=T_K(u*), the exact
-- CMP109 recurrence telescopes to
--
--      u_K = u* - B_K(u*) = u_R.
--
-- Thus q<1 is needed to construct the fixed point, but the terminal observation
-- window is then exact coordinate algebra rather than another estimate.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_)
open import Agda.Builtin.Nat using (Nat; zero)
open import Relation.Binary.PropositionalEquality using (cong; trans)

open import DASHI.Foundations.RealAnalysisAxioms using (ℝ; _+ℝ_; _-ℝ_)
open import DASHI.Physics.YangMills.CompactLieProofLevel
import DASHI.Physics.YangMills.BalabanEffectiveCouplingTrajectory as Trajectory
import DASHI.Physics.YangMills.BalabanInverseSquareCouplingBudget as Budget
import DASHI.Physics.YangMills.BalabanCutoffBetaLaw as BetaLaw

record LiteralFiniteCutoffShootingFixedPoint (K : Nat) : Set₁ where
  field
    dynamics : BetaLaw.BalabanCutoffCouplingDynamics K

    renormalisedInverseSquare : ℝ
    bareInverseSquare : ℝ

    initialCoordinateExact :
      Trajectory.inverseSquaredCoupling (BetaLaw.step dynamics) zero
      ≡ bareInverseSquare

    shootingFixedPointEquation :
      bareInverseSquare
      ≡ renormalisedInverseSquare
          +ℝ Budget.betaPrefixSum (BetaLaw.step dynamics) K

    arithmetic : Budget.InverseSquareBudgetArithmetic

    -- Elementary ordered-field identity kept explicit because the common real
    -- authority surface intentionally exposes only a minimal API.
    addThenSubtractRight : ∀ a b → (a +ℝ b) -ℝ b ≡ a

open LiteralFiniteCutoffShootingFixedPoint public

terminalInverseSquareExact :
  ∀ {K} (dataSet : LiteralFiniteCutoffShootingFixedPoint K) →
  Trajectory.inverseSquaredCoupling (BetaLaw.step (dynamics dataSet)) K
  ≡ renormalisedInverseSquare dataSet
terminalInverseSquareExact {K} dataSet =
  let
    step = BetaLaw.step (dynamics dataSet)
    prefix = Budget.betaPrefixSum step K
    tel = Budget.inverseSquareTelescoping (arithmetic dataSet) step K
    replaceInitial = cong (λ u → u -ℝ prefix) (initialCoordinateExact dataSet)
    replaceFixed = cong (λ u → u -ℝ prefix) (shootingFixedPointEquation dataSet)
    cancel = addThenSubtractRight dataSet (renormalisedInverseSquare dataSet) prefix
  in
  trans tel (trans replaceInitial (trans replaceFixed cancel))

record RenormalisedCoordinateDecoder
    {K : Nat}
    (fixed : LiteralFiniteCutoffShootingFixedPoint K) : Set₁ where
  field
    targetCoupling : ℝ
    terminalCoordinateDeterminesCoupling :
      Trajectory.inverseSquaredCoupling
          (BetaLaw.step (dynamics fixed)) K
        ≡ renormalisedInverseSquare fixed →
      Trajectory.coupling (BetaLaw.step (dynamics fixed)) K
        ≡ targetCoupling

open RenormalisedCoordinateDecoder public

terminalCouplingIsTarget :
  ∀ {K}
    (fixed : LiteralFiniteCutoffShootingFixedPoint K)
    (decoder : RenormalisedCoordinateDecoder fixed) →
  Trajectory.coupling (BetaLaw.step (dynamics fixed)) K
  ≡ targetCoupling decoder
terminalCouplingIsTarget fixed decoder =
  terminalCoordinateDeterminesCoupling decoder
    (terminalInverseSquareExact fixed)

shootingFixedPointTerminalCoordinateLevel : ProofLevel
shootingFixedPointTerminalCoordinateLevel = machineChecked

shootingFixedPointTerminalCouplingLevel : ProofLevel
shootingFixedPointTerminalCouplingLevel = machineChecked

-- Physical tuning seam after the BIDI cancellation: prove the literal source
-- shooting map is a closed self-map of the admissible tube and use the already-
-- owned q<1 estimate.  Banach then constructs the fixed point.  The terminal
-- renormalised coupling is not an additional analytic inequality after that.
literalCMP109ShootingSelfMapAndFixedPointLevel : ProofLevel
literalCMP109ShootingSelfMapAndFixedPointLevel = conditional

banachContractionFixedPointLevel : ProofLevel
banachContractionFixedPointLevel = standardImported
