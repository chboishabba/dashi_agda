open import Agda.Builtin.Equality using (_≡_; refl; cong; sym; trans)
open import Agda.Builtin.Nat using (Nat)
open import Data.Nat.Base using (_≤_)

open import DASHI.Physics.YangMills.CompactLieProofLevel
import DASHI.Physics.YangMills.YangMillsStressChargeLocalCoreCutoffStabilizationExact as Core

record LocalCutoffCommutatorShell
    (Observable Target : Set) : Set₁ where
  field
    supportRadius : Observable → Nat

    zero : Target
    _⊕_ : Target → Target → Target
    rightIdentity : ∀ value → value ⊕ zero ≡ value

    cutoffCommutator : Nat → Observable → Target
    outerShellCommutator : Nat → Nat → Observable → Target

    -- The larger cutoff differs from the smaller one only by its outer shell.
    cutoffSplitsIntoInnerPlusOuter :
      ∀ observable inner outer →
      inner ≤ outer →
      cutoffCommutator outer observable
        ≡ cutoffCommutator inner observable
          ⊕ outerShellCommutator inner outer observable

    -- Physical locality/current theorem: once the inner cutoff contains the
    -- observable support, the extra outer shell has zero commutator with it.
    outerShellVanishesBeyondSupport :
      ∀ observable inner outer →
      supportRadius observable ≤ inner →
      inner ≤ outer →
      outerShellCommutator inner outer observable ≡ zero

open LocalCutoffCommutatorShell public

cutoffCommutatorStableBeyondSupport :
  ∀ {Observable Target}
    (dataSet : LocalCutoffCommutatorShell Observable Target)
    observable inner outer →
  supportRadius dataSet observable ≤ inner →
  inner ≤ outer →
  cutoffCommutator dataSet outer observable
    ≡ cutoffCommutator dataSet inner observable
cutoffCommutatorStableBeyondSupport dataSet observable inner outer supportInside nested =
  trans
    (cutoffSplitsIntoInnerPlusOuter dataSet observable inner outer nested)
    (trans
      (cong
        (λ shell →
          LocalCutoffCommutatorShell._⊕_ dataSet
            (cutoffCommutator dataSet inner observable) shell)
        (outerShellVanishesBeyondSupport dataSet observable inner outer supportInside nested))
      (rightIdentity dataSet (cutoffCommutator dataSet inner observable)))

record VacuumNeutralLocalChargeCore
    {Observable Target : Set}
    (shellData : LocalCutoffCommutatorShell Observable Target)
    (LocalVector : Set) : Set₁ where
  field
    localState : Observable → LocalVector
    cutoffChargeAction : Nat → LocalVector → Target

    -- Q_R(A Omega) = [Q_R,A] Omega after the vacuum/normalization contribution
    -- is removed.  The actual YM construction must prove this on the SAME OS
    -- local core; it is not imported from Requardt.
    localStateChargeIsCommutator :
      ∀ cutoff observable →
      cutoffChargeAction cutoff (localState observable)
        ≡ cutoffCommutator shellData cutoff observable

open VacuumNeutralLocalChargeCore public

localStateChargeStableBeyondSupport :
  ∀ {Observable Target LocalVector}
    {shellData : LocalCutoffCommutatorShell Observable Target}
    (coreData : VacuumNeutralLocalChargeCore shellData LocalVector)
    observable inner outer →
  supportRadius shellData observable ≤ inner →
  inner ≤ outer →
  cutoffChargeAction coreData outer (localState coreData observable)
    ≡ cutoffChargeAction coreData inner (localState coreData observable)
localStateChargeStableBeyondSupport {shellData = shellData} coreData observable inner outer supportInside nested =
  trans
    (localStateChargeIsCommutator coreData outer observable)
    (trans
      (cutoffCommutatorStableBeyondSupport shellData observable inner outer supportInside nested)
      (sym (localStateChargeIsCommutator coreData inner observable)))

-- Package the observable-labelled local-state core directly into the Round85
-- eventual-constancy API.  The `LocalVector` parameter here is intentionally the
-- local-observable LABEL, while the actual vector is `localState observable`.
-- This avoids quotienting potentially non-unique A Omega presentations until a
-- later domain/core theorem actually proves representation independence.
observableLabelledLocalCoreCutoffCharge :
  ∀ {Observable Target LocalVector}
    (shellData : LocalCutoffCommutatorShell Observable Target) →
    (coreData : VacuumNeutralLocalChargeCore shellData LocalVector) →
  Core.LocalCoreCutoffCharge Observable Target
observableLabelledLocalCoreCutoffCharge shellData coreData = record
  { Core.LocalCoreCutoffCharge.supportRadius = supportRadius shellData
  ; Core.LocalCoreCutoffCharge.cutoffChargeAction =
      λ cutoff observable →
        cutoffChargeAction coreData cutoff (localState coreData observable)
  ; Core.LocalCoreCutoffCharge.actionStableBeyondSupport =
      λ observable leftCutoff rightCutoff supportLeft supportRight →
        trans
          (sym
            (localStateChargeStableBeyondSupport coreData observable
              (supportRadius shellData observable) leftCutoff
              Data.Nat.Base.≤-refl supportLeft))
          (localStateChargeStableBeyondSupport coreData observable
            (supportRadius shellData observable) rightCutoff
            Data.Nat.Base.≤-refl supportRight)
  }

