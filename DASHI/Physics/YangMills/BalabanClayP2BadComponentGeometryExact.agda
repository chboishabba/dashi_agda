module DASHI.Physics.YangMills.BalabanClayP2BadComponentGeometryExact where

open import Agda.Builtin.Equality using (_≡_; refl)

open import DASHI.Physics.YangMills.CompactLieProofLevel
open import DASHI.Physics.YangMills.BalabanPeriodicTorus4Carrier using (Dec)

------------------------------------------------------------------------
-- Proof-relevant bad-block connected components.
--
-- A component is generated by literal finite paths whose vertices are all bad.
-- This avoids assuming a component allocator.  Equality of components is stated
-- extensionally (mutual membership), which is the invariant notion needed by the
-- polymer expansion and does not require function extensionality or proof
-- irrelevance.
------------------------------------------------------------------------

record BadBlockGeometry
    (Configuration Gauge Block : Set) : Set₁ where
  field
    transform : Gauge → Configuration → Configuration
    Adjacent : Block → Block → Set
    adjacentSymmetric : ∀ {left right} →
      Adjacent left right → Adjacent right left

    BadBlock : Configuration → Block → Set
    badBlockDecidable : ∀ configuration block →
      Dec (BadBlock configuration block)

    badGaugeForward : ∀ gauge configuration block →
      BadBlock configuration block →
      BadBlock (transform gauge configuration) block
    badGaugeBackward : ∀ gauge configuration block →
      BadBlock (transform gauge configuration) block →
      BadBlock configuration block

open BadBlockGeometry public

data BadPath
    {Configuration Gauge Block : Set}
    (dataSet : BadBlockGeometry Configuration Gauge Block)
    (configuration : Configuration)
    : Block → Block → Set where
  root : ∀ {block} →
    BadBlock dataSet configuration block →
    BadPath dataSet configuration block block
  step : ∀ {start current next} →
    BadPath dataSet configuration start current →
    Adjacent dataSet current next →
    BadBlock dataSet configuration next →
    BadPath dataSet configuration start next

pathStartBad :
  ∀ {Configuration Gauge Block}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration start finish} →
  BadPath dataSet configuration start finish →
  BadBlock dataSet configuration start
pathStartBad (root bad) = bad
pathStartBad (step path adjacent bad) = pathStartBad path

pathEndBad :
  ∀ {Configuration Gauge Block}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration start finish} →
  BadPath dataSet configuration start finish →
  BadBlock dataSet configuration finish
pathEndBad (root bad) = bad
pathEndBad (step path adjacent bad) = bad

appendBadPath :
  ∀ {Configuration Gauge Block}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration start middle finish} →
  BadPath dataSet configuration start middle →
  BadPath dataSet configuration middle finish →
  BadPath dataSet configuration start finish
appendBadPath left (root bad) = left
appendBadPath left (step right adjacent bad) =
  step (appendBadPath left right) adjacent bad

reverseBadPath :
  ∀ {Configuration Gauge Block}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration start finish} →
  BadPath dataSet configuration start finish →
  BadPath dataSet configuration finish start
reverseBadPath {dataSet = dataSet} (root bad) = root bad
reverseBadPath {dataSet = dataSet} (step path adjacent bad) =
  appendBadPath
    (step (root bad) (adjacentSymmetric dataSet adjacent) (pathEndBad path))
    (reverseBadPath path)

mapBadPathGaugeForward :
  ∀ {Configuration Gauge Block}
    (dataSet : BadBlockGeometry Configuration Gauge Block)
    gauge {configuration start finish} →
  BadPath dataSet configuration start finish →
  BadPath dataSet (transform dataSet gauge configuration) start finish
mapBadPathGaugeForward dataSet gauge (root bad) =
  root (badGaugeForward dataSet gauge _ _ bad)
mapBadPathGaugeForward dataSet gauge (step path adjacent bad) =
  step
    (mapBadPathGaugeForward dataSet gauge path)
    adjacent
    (badGaugeForward dataSet gauge _ _ bad)

mapBadPathGaugeBackward :
  ∀ {Configuration Gauge Block}
    (dataSet : BadBlockGeometry Configuration Gauge Block)
    gauge {configuration start finish} →
  BadPath dataSet (transform dataSet gauge configuration) start finish →
  BadPath dataSet configuration start finish
mapBadPathGaugeBackward dataSet gauge (root bad) =
  root (badGaugeBackward dataSet gauge _ _ bad)
mapBadPathGaugeBackward dataSet gauge (step path adjacent bad) =
  step
    (mapBadPathGaugeBackward dataSet gauge path)
    adjacent
    (badGaugeBackward dataSet gauge _ _ bad)

record BadComponent
    {Configuration Gauge Block : Set}
    (dataSet : BadBlockGeometry Configuration Gauge Block)
    (configuration : Configuration) : Set where
  constructor component
  field
    seed : Block
    seedIsBad : BadBlock dataSet configuration seed

open BadComponent public

Contains :
  ∀ {Configuration Gauge Block}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration} →
  BadComponent dataSet configuration → Block → Set
Contains {dataSet = dataSet} {configuration = configuration} polymer block =
  BadPath dataSet configuration (seed polymer) block

badComponentOf :
  ∀ {Configuration Gauge Block}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration block} →
  BadBlock dataSet configuration block →
  BadComponent dataSet configuration
badComponentOf {dataSet = dataSet} {configuration = configuration} {block = block} bad = component block bad

everyBadBlockAssigned :
  ∀ {Configuration Gauge Block}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration block}
    (bad : BadBlock dataSet configuration block) →
  Contains {dataSet = dataSet} {configuration = configuration} (badComponentOf bad) block
everyBadBlockAssigned {dataSet = dataSet} {configuration = configuration} bad = root bad

PairwiseConnected :
  ∀ {Configuration Gauge Block}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration} →
  BadComponent dataSet configuration → Set
PairwiseConnected {dataSet = dataSet} {configuration = configuration} polymer =
  ∀ {left right} →
  Contains polymer left → Contains polymer right →
  BadPath dataSet configuration left right

componentConnected :
  ∀ {Configuration Gauge Block}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration}
    (polymer : BadComponent dataSet configuration) →
  PairwiseConnected polymer
componentConnected polymer leftMember rightMember =
  appendBadPath (reverseBadPath leftMember) rightMember

record SameComponent
    {Configuration Gauge Block : Set}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration : Configuration}
    (left right : BadComponent dataSet configuration) : Set where
  field
    forward : ∀ block → Contains left block → Contains right block
    backward : ∀ block → Contains right block → Contains left block

open SameComponent public

sameComponentUnique :
  ∀ {Configuration Gauge Block}
    {dataSet : BadBlockGeometry Configuration Gauge Block}
    {configuration}
    (left right : BadComponent dataSet configuration) →
  Contains left (seed right) →
  SameComponent left right
sameComponentUnique left right leftToRightSeed = record
  { forward = λ block leftToBlock →
      appendBadPath (reverseBadPath leftToRightSeed) leftToBlock
  ; backward = λ block rightToBlock →
      appendBadPath leftToRightSeed rightToBlock
  }

transformComponent :
  ∀ {Configuration Gauge Block}
    (dataSet : BadBlockGeometry Configuration Gauge Block)
    gauge {configuration} →
  BadComponent dataSet configuration →
  BadComponent dataSet (transform dataSet gauge configuration)
transformComponent dataSet gauge polymer =
  component (seed polymer)
    (badGaugeForward dataSet gauge _ _ (seedIsBad polymer))

componentGaugeInvariantForward :
  ∀ {Configuration Gauge Block}
    (dataSet : BadBlockGeometry Configuration Gauge Block)
    gauge {configuration}
    (polymer : BadComponent dataSet configuration) block →
  Contains polymer block →
  Contains (transformComponent dataSet gauge polymer) block
componentGaugeInvariantForward dataSet gauge polymer block =
  mapBadPathGaugeForward dataSet gauge

componentGaugeInvariantBackward :
  ∀ {Configuration Gauge Block}
    (dataSet : BadBlockGeometry Configuration Gauge Block)
    gauge {configuration}
    (polymer : BadComponent dataSet configuration) block →
  Contains (transformComponent dataSet gauge polymer) block →
  Contains polymer block
componentGaugeInvariantBackward dataSet gauge polymer block =
  mapBadPathGaugeBackward dataSet gauge

badBlockGaugeInvariantForward :
  ∀ {Configuration Gauge Block}
    (dataSet : BadBlockGeometry Configuration Gauge Block)
    gauge configuration block →
  BadBlock dataSet configuration block →
  BadBlock dataSet (transform dataSet gauge configuration) block
badBlockGaugeInvariantForward = badGaugeForward

badBlockGaugeInvariantBackward :
  ∀ {Configuration Gauge Block}
    (dataSet : BadBlockGeometry Configuration Gauge Block)
    gauge configuration block →
  BadBlock dataSet (transform dataSet gauge configuration) block →
  BadBlock dataSet configuration block
badBlockGaugeInvariantBackward = badGaugeBackward

badBlockMeasurable :
  ∀ {Configuration Gauge Block}
    (dataSet : BadBlockGeometry Configuration Gauge Block)
    configuration block →
  Dec (BadBlock dataSet configuration block)
badBlockMeasurable = badBlockDecidable

p2BadPathAlgebraLevel : ProofLevel
p2BadPathAlgebraLevel = machineChecked

p2BadComponentAssignmentConnectivityLevel : ProofLevel
p2BadComponentAssignmentConnectivityLevel = machineChecked

p2BadComponentGaugeInvarianceLevel : ProofLevel
p2BadComponentGaugeInvarianceLevel = machineChecked

p2BadComponentExtensionalUniquenessLevel : ProofLevel
p2BadComponentExtensionalUniquenessLevel = machineChecked

-- A literal Wilson bad predicate and the finite block adjacency now suffice to
-- instantiate this construction; the activity/rooted-shell estimate is separate.
p2LiteralWilsonBadPredicateInstantiationLevel : ProofLevel
p2LiteralWilsonBadPredicateInstantiationLevel = conditional
