{-# OPTIONS --safe #-}
module DASHI.Physics.YangMills.YMClayRationalS3DegreeSevenOrbitMomentsExact where

------------------------------------------------------------------------
-- SMALL FULLY RATIONAL positive S3 degree-seven orbit certificate.
-- Three hyperoctahedral signed/permutation orbit representatives:
-- (1,0,0,0), (1/2,1/2,1/2,1/2), (-1/3,2/3,2/3,0)
-- with positive TOTAL orbit masses 167/960, 1/15, 243/320.
--
-- Exact orbit invariants of squared coordinates:
-- e2 = sum_{i<j} qi² qj², e3 = sum_{i<j<k} qi² qj² qk².
-- Every signed-permutation-invariant polynomial of coordinate
-- degree <=7 on S3 is generated by 1, e2, e3 because e1=sum qi²=1.
-- Thus these three finite rational equalities, together with
-- signed-permutation symmetry, imply exact all-monomial degree-seven
-- cubature. The combinatorial group-orbit-to-all-polynomials
-- implication has an independent exact checker but is not yet Agda
-- kernel-checked. No pi, sqrt, or Haar oracle.
--
-- Attribution: Pizzetti/Folland; original DASHI rational SU2;
-- Wilson/Balaban, Bishop/Bridges.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_; refl)
open import Data.Integer.Base using (+_)
open import Data.Rational using (ℚ; 1ℚ; _+_; _*_; _/_)
import Data.Rational.Tactic.RingSolver as ℚRing

axisMass halfMass thirdMass : ℚ
axisMass = + 167 / 960
halfMass = + 1 / 15
thirdMass = + 243 / 320

degreeSevenTotalMassExactlyOne :
  (axisMass + halfMass) + thirdMass ≡ 1ℚ
degreeSevenTotalMassExactlyOne = refl

-- e2 at axis, half and third orbit representatives is respectively
-- 0, 3/8, 8/27. The source-based orbit-average moment is 1/4.
degreeSevenSecondInvariant :
  (halfMass * (+ 3 / 8)) +
  (thirdMass * (+ 8 / 27)) ≡ (+ 1 / 4)
degreeSevenSecondInvariant = refl

-- e3 at axis, half and third orbit representatives is respectively
-- 0, 1/16, 16/729. The source-based orbit-average moment is 1/48.
degreeSevenThirdInvariant :
  (halfMass * (+ 1 / 16)) +
  (thirdMass * (+ 16 / 729)) ≡ (+ 1 / 48)
degreeSevenThirdInvariant = refl
