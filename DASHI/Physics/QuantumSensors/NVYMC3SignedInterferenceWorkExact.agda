module DASHI.Physics.QuantumSensors.NVYMC3SignedInterferenceWorkExact where

-- Concrete rational real-amplitude optical signed cross-work producer,
-- consuming the exact NS ABCD finite signed pair-difference theorem and
-- preserving the 369/YM C3 cyclic channel symmetry in a finite fixture.
-- Rate labels are supplied by a physical model, not by Navier–Stokes.

open import Agda.Builtin.Equality using (_≡_)
open import Agda.Builtin.List using (List; []; _∷_)
open import Data.Product using (_×_; _,_; proj₁; proj₂)
open import Data.Rational.Base using (ℚ; 0ℚ; _+_; _*_)
open import Data.Rational.Tactic.RingSolver using (solve)
import DASHI.Physics.Closure.NSTriadKNFixedOutputCoherentCovariancePairDifferenceExact as NS
import DASHI.Physics.QuantumSensors.NVYM369C3OpticalFourierExact as Optical

-- Signed interference work generated by the *actual* channel amplitudes.
-- For rational-real amplitude paths the cross term between i and j
-- in |Σ a_i|² is 2 a_i a_j.
twiceCross : ℚ → ℚ → ℚ
twiceCross a b = (a + a) * b

record ThreeOpticalWorks : Set where
  constructor works
  field
    amplitudes : Optical.ThreePhotonChannels
    rateFirst rateSecond rateThird : ℚ
open ThreeOpticalWorks public

interferenceFirst : ThreeOpticalWorks → ℚ
interferenceFirst x =
  twiceCross (Optical.first (amplitudes x))
             (Optical.second (amplitudes x))

interferenceSecond : ThreeOpticalWorks → ℚ
interferenceSecond x =
  twiceCross (Optical.second (amplitudes x))
             (Optical.third (amplitudes x))

interferenceThird : ThreeOpticalWorks → ℚ
interferenceThird x =
  twiceCross (Optical.third (amplitudes x))
             (Optical.first (amplitudes x))

opticalTerms : ThreeOpticalWorks → List (ℚ × ℚ)
opticalTerms x =
  (rateFirst x , interferenceFirst x) ∷
  (rateSecond x , interferenceSecond x) ∷
  (rateThird x , interferenceThird x) ∷ []

-- The actual signed pair-work identity from NS is applied on the
-- amplitude-derived optical work entries. It does not create a
-- positivity claim for those signed work terms.

signedCenteringFromNS :
  (x : ThreeOpticalWorks) →
  NS.natAsRational (length (opticalTerms x)) *
    (0ℚ - NS.weightedWorkSum proj₁ proj₂ (opticalTerms x))
    + NS.rateSum proj₁ (opticalTerms x) *
      NS.workSum proj₂ (opticalTerms x)
  ≡ 0ℚ - NS.pairDifferenceWorkSum proj₁ proj₂ (opticalTerms x)
signedCenteringFromNS x =
  NS.divisionFreePairDifferenceCentering proj₁ proj₂ (opticalTerms x)
