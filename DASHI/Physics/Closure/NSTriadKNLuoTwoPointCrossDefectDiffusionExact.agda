module DASHI.Physics.Closure.NSTriadKNLuoTwoPointCrossDefectDiffusionExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES / CONTEXT
--
-- Author: Runlong Yu.
-- Title: "Filtered Vortex Stretching and Subgrid Defects for the
-- Three-Dimensional Navier-Stokes Equations".
-- DOI: 10.48550/arXiv.2606.27560.
-- Status: arXiv preprint, submitted 25 June 2026.
--
-- Authors: Alexey Cheskidov; Roman Shvydkoy.
-- Title: "A Unified Approach to Regularity Problems for the 3D Navier-Stokes
-- and Euler Equations: The Use of Kolmogorov's Dissipation Range".
-- DOI: 10.1007/s00021-014-0167-4.
--
-- DASHI CONTRIBUTION
--
-- This module computes the exact diffusion product rule for the polynomial
-- two-point defect
--
--   C = a cross b,             A = |C|^2.
--
-- In one spatial direction, with first jets a_1,b_1 and second jets a_2,b_2,
--
--   C_1 = a_1 cross b + a cross b_1,
--   C_2 = a_2 cross b + 2 a_1 cross b_1 + a cross b_2.
--
-- Therefore
--
--   d_2 |C|^2
--     = 2 |C_1|^2 + 2 C dot C_2,
--
-- and the part generated by applying the Laplacian separately to the two
-- vorticity factors is exactly
--
--   2 C dot (a_2 cross b + a cross b_2)
--     = d_2 |C|^2
--       - 2 |C_1|^2
--       - 4 C dot (a_1 cross b_1).
--
-- The final mixed-gradient term is sign-indefinite; explicit rational jets
-- realize both +4 and -4.  Consequently a physical-space product-gradient
-- argument alone does not supply the desired c 2^(2q) defect damping.  The
-- correct coercive route must use the two input frequencies before their
-- high-high product can collapse to a low output frequency.
------------------------------------------------------------------------

open import Agda.Builtin.List using (List; []; _∷_)
open import Data.Rational.Base using
  (ℚ; 0ℚ; 1ℚ; _+_; _*_; -_; _-_)
open import Data.Rational.Tactic.RingSolver using (solve)
open import Relation.Binary.PropositionalEquality using (_≡_; cong; trans)

import DASHI.Physics.Closure.NSTriadKNLuoDirectionalDefectGramExact as Gram
import DASHI.Physics.Closure.NSTriadKNLuoCrossProductDefectEvolutionAlgebraExact as Cross

record SpatialDerivativeJet : Set where
  constructor spatialDerivativeJet
  field
    leftFirst rightFirst : Gram.Vec3
    leftSecond rightSecond : Gram.Vec3

open SpatialDerivativeJet public

crossValue : Gram.Vec3 → Gram.Vec3 → Gram.Vec3
crossValue = Gram.cross

firstCrossDerivative :
  Gram.Vec3 → Gram.Vec3 → SpatialDerivativeJet → Gram.Vec3
firstCrossDerivative left right jet =
  Cross.crossFirstVariation
    left right (leftFirst jet) (rightFirst jet)

mixedCrossGradient : SpatialDerivativeJet → Gram.Vec3
mixedCrossGradient jet =
  Gram.cross (leftFirst jet) (rightFirst jet)

secondCrossDerivative :
  Gram.Vec3 → Gram.Vec3 → SpatialDerivativeJet → Gram.Vec3
secondCrossDerivative left right jet =
  Cross.vecAdd
    (Gram.cross (leftSecond jet) right)
    (Cross.vecAdd
      (Cross.scaleVec 2 (mixedCrossGradient jet))
      (Gram.cross left (rightSecond jet)))

inputLaplacianDefectRate :
  Gram.Vec3 → Gram.Vec3 → SpatialDerivativeJet → ℚ
inputLaplacianDefectRate left right jet =
  2 * Gram.dot
    (crossValue left right)
    (Cross.vecAdd
      (Gram.cross (leftSecond jet) right)
      (Gram.cross left (rightSecond jet)))

crossGradientDissipation :
  Gram.Vec3 → Gram.Vec3 → SpatialDerivativeJet → ℚ
crossGradientDissipation left right jet =
  2 * Gram.normSquared (firstCrossDerivative left right jet)

mixedGradientRemainder :
  Gram.Vec3 → Gram.Vec3 → SpatialDerivativeJet → ℚ
mixedGradientRemainder left right jet =
  4 * Gram.dot (crossValue left right) (mixedCrossGradient jet)

defectSecondSpatialDerivative :
  Gram.Vec3 → Gram.Vec3 → SpatialDerivativeJet → ℚ
defectSecondSpatialDerivative left right jet =
  2 * Gram.normSquared (firstCrossDerivative left right jet)
  + 2 * Gram.dot
      (crossValue left right)
      (secondCrossDerivative left right jet)

twoPointDiffusionProductRule :
  ∀ left right jet →
  inputLaplacianDefectRate left right jet
  + crossGradientDissipation left right jet
  + mixedGradientRemainder left right jet
  ≡ defectSecondSpatialDerivative left right jet
twoPointDiffusionProductRule left right jet =
  solve
    ( Gram.x left ∷ Gram.y left ∷ Gram.z left
    ∷ Gram.x right ∷ Gram.y right ∷ Gram.z right
    ∷ Gram.x (leftFirst jet) ∷ Gram.y (leftFirst jet)
    ∷ Gram.z (leftFirst jet)
    ∷ Gram.x (rightFirst jet) ∷ Gram.y (rightFirst jet)
    ∷ Gram.z (rightFirst jet)
    ∷ Gram.x (leftSecond jet) ∷ Gram.y (leftSecond jet)
    ∷ Gram.z (leftSecond jet)
    ∷ Gram.x (rightSecond jet) ∷ Gram.y (rightSecond jet)
    ∷ Gram.z (rightSecond jet)
    ∷ [])

sumInputLaplacianRate :
  Gram.Vec3 → Gram.Vec3 → List SpatialDerivativeJet → ℚ
sumInputLaplacianRate left right [] = 0ℚ
sumInputLaplacianRate left right (jet ∷ jets) =
  inputLaplacianDefectRate left right jet
  + sumInputLaplacianRate left right jets

sumCrossGradientDissipation :
  Gram.Vec3 → Gram.Vec3 → List SpatialDerivativeJet → ℚ
sumCrossGradientDissipation left right [] = 0ℚ
sumCrossGradientDissipation left right (jet ∷ jets) =
  crossGradientDissipation left right jet
  + sumCrossGradientDissipation left right jets

sumMixedGradientRemainder :
  Gram.Vec3 → Gram.Vec3 → List SpatialDerivativeJet → ℚ
sumMixedGradientRemainder left right [] = 0ℚ
sumMixedGradientRemainder left right (jet ∷ jets) =
  mixedGradientRemainder left right jet
  + sumMixedGradientRemainder left right jets

sumDefectSecondDerivative :
  Gram.Vec3 → Gram.Vec3 → List SpatialDerivativeJet → ℚ
sumDefectSecondDerivative left right [] = 0ℚ
sumDefectSecondDerivative left right (jet ∷ jets) =
  defectSecondSpatialDerivative left right jet
  + sumDefectSecondDerivative left right jets

finiteTwoPointDiffusionProductRule :
  ∀ left right jets →
  sumInputLaplacianRate left right jets
  + sumCrossGradientDissipation left right jets
  + sumMixedGradientRemainder left right jets
  ≡ sumDefectSecondDerivative left right jets
finiteTwoPointDiffusionProductRule left right [] = solve []
finiteTwoPointDiffusionProductRule left right (jet ∷ jets)
  rewrite twoPointDiffusionProductRule left right jet
        | finiteTwoPointDiffusionProductRule left right jets =
  solve
    ( defectSecondSpatialDerivative left right jet
    ∷ sumDefectSecondDerivative left right jets
    ∷ inputLaplacianDefectRate left right jet
    ∷ sumInputLaplacianRate left right jets
    ∷ crossGradientDissipation left right jet
    ∷ sumCrossGradientDissipation left right jets
    ∷ mixedGradientRemainder left right jet
    ∷ sumMixedGradientRemainder left right jets
    ∷ [])

record PeriodicIntegratedDefectJet : Set where
  constructor periodicIntegratedDefectJet
  field
    left right : Gram.Vec3
    spatialJets : List SpatialDerivativeJet
    integratedTotalSecondDerivativeVanishes :
      sumDefectSecondDerivative left right spatialJets ≡ 0ℚ

open PeriodicIntegratedDefectJet public

periodicIntegratedDiffusionIdentity :
  ∀ dataSet →
  sumInputLaplacianRate
    (left dataSet) (right dataSet) (spatialJets dataSet)
  ≡
  - sumCrossGradientDissipation
      (left dataSet) (right dataSet) (spatialJets dataSet)
  - sumMixedGradientRemainder
      (left dataSet) (right dataSet) (spatialJets dataSet)
periodicIntegratedDiffusionIdentity dataSet =
  let
    input =
      sumInputLaplacianRate
        (left dataSet) (right dataSet) (spatialJets dataSet)
    gradient =
      sumCrossGradientDissipation
        (left dataSet) (right dataSet) (spatialJets dataSet)
    mixed =
      sumMixedGradientRemainder
        (left dataSet) (right dataSet) (spatialJets dataSet)

    productRule =
      finiteTwoPointDiffusionProductRule
        (left dataSet) (right dataSet) (spatialJets dataSet)

    closed : input + gradient + mixed ≡ 0ℚ
    closed =
      trans productRule
        (integratedTotalSecondDerivativeVanishes dataSet)

    leftExpanded : input ≡ (input + gradient + mixed) - gradient - mixed
    leftExpanded = solve (input ∷ gradient ∷ mixed ∷ [])

    shifted :
      (input + gradient + mixed) - gradient - mixed
      ≡ 0ℚ - gradient - mixed
    shifted =
      cong (λ value → value - gradient - mixed) closed

    rightClosed : 0ℚ - gradient - mixed ≡ - gradient - mixed
    rightClosed = solve (gradient ∷ mixed ∷ [])
  in
  trans leftExpanded (trans shifted rightClosed)

e1 e2 e3 zeroVec : Gram.Vec3
e1 = Gram.vec3 1ℚ 0ℚ 0ℚ
e2 = Gram.vec3 0ℚ 1ℚ 0ℚ
e3 = Gram.vec3 0ℚ 0ℚ 1ℚ
zeroVec = Gram.vec3 0ℚ 0ℚ 0ℚ

positiveMixedJet : SpatialDerivativeJet
positiveMixedJet = spatialDerivativeJet e1 e2 zeroVec zeroVec

negativeMixedJet : SpatialDerivativeJet
negativeMixedJet = spatialDerivativeJet e2 e1 zeroVec zeroVec

positiveMixedRemainderWitness :
  mixedGradientRemainder e1 e2 positiveMixedJet ≡ 4
positiveMixedRemainderWitness = solve []

negativeMixedRemainderWitness :
  mixedGradientRemainder e1 e2 negativeMixedJet ≡ - 4
negativeMixedRemainderWitness = solve []

record TwoPointDiffusionAuthorityBoundary : Set where
  constructor twoPointDiffusionAuthorityBoundary
  field
    exactSecondDerivativeProductRuleProved : Set
    finiteSpatialSummationProved : Set
    periodicIntegratedIdentityProved : Set
    mixedGradientSignIndefiniteProved : Set
    pairFrequencyShellDampingProved : Set
    physicalAnnularDefectDampingProved : Set

canonicalTwoPointDiffusionAuthorityBoundary :
  TwoPointDiffusionAuthorityBoundary
canonicalTwoPointDiffusionAuthorityBoundary =
  twoPointDiffusionAuthorityBoundary ⊤ ⊤ ⊤ ⊤ ⊥ ⊥
  where
  open import Data.Unit using (⊤)
  open import Data.Empty using (⊥)
