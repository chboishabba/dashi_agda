module DASHI.Physics.Closure.NSTriadKNLuoIncrementKernelFourierMultiplierExact where

------------------------------------------------------------------------
-- PROVENANCE
--
-- Authors: Peter Constantin; Weinan E; Edriss S. Titi.
-- Title: "Onsager's Conjecture on the Energy Conservation for Solutions
-- of Euler's Equation".
-- Communications in Mathematical Physics 165 (1994), 207--209.
-- DOI: 10.1007/BF02099744.
--
-- Author: Xiaoyutao Luo.
-- Title: "A Beale--Kato--Majda Criterion with Optimal Frequency and
-- Temporal Localization".
-- Journal of Mathematical Fluid Mechanics 21 (2019), article 1.
-- DOI: 10.1007/s00021-019-0411-z.
-- arXiv DOI: 10.48550/arXiv.1803.05569.
--
-- PURPOSE
-- Isolate the exact Fourier multiplier generated by the weighted increment
-- product
--
--   integral phi_p(y) (e^{-ik.y}-1)(e^{-il.y}-1) dy.
--
-- With the repository's Fourier-sign convention this coefficient is
--
--   hatPhi_p(k+l) - hatPhi_p(k) - hatPhi_p(l) + hatPhi_p(0).
--
-- The theorem below closes its rational algebra, symmetry, zero-mode
-- cancellation and coefficient multiplication. The remaining analytic leaf
-- is the Fourier/integration theorem identifying the literal spatial integral
-- with this multiplier on the official periodic carrier.
------------------------------------------------------------------------

open import Agda.Primitive using (Level; lsuc)
open import Agda.Builtin.Bool using (Bool; true)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List using ([]; _∷_)
open import Data.Rational.Base using (ℚ; 0ℚ; 1ℚ; _+_; _*_; _-_)
open import Data.Rational.Tactic.RingSolver using (solve)

incrementKernelMultiplier : ℚ → ℚ → ℚ → ℚ → ℚ
incrementKernelMultiplier transformSum transformLeft transformRight transformZero =
  transformSum - transformLeft - transformRight + transformZero

normalizedIncrementKernelMultiplier : ℚ → ℚ → ℚ → ℚ
normalizedIncrementKernelMultiplier transformSum transformLeft transformRight =
  transformSum - transformLeft - transformRight + 1ℚ

normalizedMultiplierMeaning :
  ∀ transformSum transformLeft transformRight transformZero →
  transformZero ≡ 1ℚ →
  incrementKernelMultiplier
    transformSum transformLeft transformRight transformZero
  ≡ normalizedIncrementKernelMultiplier
      transformSum transformLeft transformRight
normalizedMultiplierMeaning
  transformSum transformLeft transformRight transformZero transformZeroIsOne
  rewrite transformZeroIsOne = refl

incrementKernelMultiplierSymmetric :
  ∀ transformSum transformLeft transformRight transformZero →
  incrementKernelMultiplier
    transformSum transformLeft transformRight transformZero
  ≡ incrementKernelMultiplier
      transformSum transformRight transformLeft transformZero
incrementKernelMultiplierSymmetric
  transformSum transformLeft transformRight transformZero =
  solve (transformSum ∷ transformLeft ∷ transformRight ∷ transformZero ∷ [])

leftZeroModeCancellation :
  ∀ transformRight transformZero →
  incrementKernelMultiplier
    transformRight transformZero transformRight transformZero
  ≡ 0ℚ
leftZeroModeCancellation transformRight transformZero =
  solve (transformRight ∷ transformZero ∷ [])

rightZeroModeCancellation :
  ∀ transformLeft transformZero →
  incrementKernelMultiplier
    transformLeft transformLeft transformZero transformZero
  ≡ 0ℚ
rightZeroModeCancellation transformLeft transformZero =
  solve (transformLeft ∷ transformZero ∷ [])

bothZeroModeCancellation :
  ∀ transformZero →
  incrementKernelMultiplier
    transformZero transformZero transformZero transformZero
  ≡ 0ℚ
bothZeroModeCancellation transformZero =
  solve (transformZero ∷ [])

incrementPairContribution :
  ℚ → ℚ → ℚ → ℚ → ℚ → ℚ
incrementPairContribution
  transformSum transformLeft transformRight transformZero tensorCoefficient =
  incrementKernelMultiplier
    transformSum transformLeft transformRight transformZero
  * tensorCoefficient

leftZeroPairContributionVanishes :
  ∀ transformRight transformZero tensorCoefficient →
  incrementPairContribution
    transformRight transformZero transformRight transformZero tensorCoefficient
  ≡ 0ℚ
leftZeroPairContributionVanishes transformRight transformZero tensorCoefficient =
  solve (transformRight ∷ transformZero ∷ tensorCoefficient ∷ [])

rightZeroPairContributionVanishes :
  ∀ transformLeft transformZero tensorCoefficient →
  incrementPairContribution
    transformLeft transformLeft transformZero transformZero tensorCoefficient
  ≡ 0ℚ
rightZeroPairContributionVanishes transformLeft transformZero tensorCoefficient =
  solve (transformLeft ∷ transformZero ∷ tensorCoefficient ∷ [])

record PeriodicIncrementMultiplierData
    {modeLevel : Level}
    (Mode : Set modeLevel) : Set (lsuc modeLevel) where
  field
    zeroMode : Mode
    addMode : Mode → Mode → Mode
    kernelTransform : Mode → ℚ

    addZeroLeft : ∀ mode → addMode zeroMode mode ≡ mode
    addZeroRight : ∀ mode → addMode mode zeroMode ≡ mode
    addCommutative : ∀ left right → addMode left right ≡ addMode right left

open PeriodicIncrementMultiplierData public

pairMultiplier :
  ∀ {modeLevel} {Mode : Set modeLevel} →
  PeriodicIncrementMultiplierData Mode →
  Mode → Mode → ℚ
pairMultiplier data left right =
  incrementKernelMultiplier
    (kernelTransform data (addMode data left right))
    (kernelTransform data left)
    (kernelTransform data right)
    (kernelTransform data (zeroMode data))

pairMultiplierSymmetric :
  ∀ {modeLevel} {Mode : Set modeLevel}
    (data : PeriodicIncrementMultiplierData Mode)
    left right →
  pairMultiplier data left right ≡ pairMultiplier data right left
pairMultiplierSymmetric data left right
  rewrite addCommutative data left right =
  incrementKernelMultiplierSymmetric
    (kernelTransform data (addMode data right left))
    (kernelTransform data left)
    (kernelTransform data right)
    (kernelTransform data (zeroMode data))

pairMultiplierLeftZero :
  ∀ {modeLevel} {Mode : Set modeLevel}
    (data : PeriodicIncrementMultiplierData Mode)
    mode →
  pairMultiplier data (zeroMode data) mode ≡ 0ℚ
pairMultiplierLeftZero data mode
  rewrite addZeroLeft data mode =
  leftZeroModeCancellation
    (kernelTransform data mode)
    (kernelTransform data (zeroMode data))

pairMultiplierRightZero :
  ∀ {modeLevel} {Mode : Set modeLevel}
    (data : PeriodicIncrementMultiplierData Mode)
    mode →
  pairMultiplier data mode (zeroMode data) ≡ 0ℚ
pairMultiplierRightZero data mode
  rewrite addZeroRight data mode =
  rightZeroModeCancellation
    (kernelTransform data mode)
    (kernelTransform data (zeroMode data))

incrementKernelFourierMultiplierAlgebraClosed : Bool
incrementKernelFourierMultiplierAlgebraClosed = true

incrementKernelZeroModeCancellationClosed : Bool
incrementKernelZeroModeCancellationClosed = true

incrementKernelFourierMultiplierAlgebraClosedIsTrue :
  incrementKernelFourierMultiplierAlgebraClosed ≡ true
incrementKernelFourierMultiplierAlgebraClosedIsTrue = refl

incrementKernelZeroModeCancellationClosedIsTrue :
  incrementKernelZeroModeCancellationClosed ≡ true
incrementKernelZeroModeCancellationClosedIsTrue = refl
