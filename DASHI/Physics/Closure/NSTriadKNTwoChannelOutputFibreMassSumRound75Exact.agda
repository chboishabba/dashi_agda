module DASHI.Physics.Closure.NSTriadKNTwoChannelOutputFibreMassSumRound75Exact where

------------------------------------------------------------------------
-- PRIMARY SOURCES / CONTEXT
--
-- Authors: Augustin-Louis Cauchy; Hermann Amandus Schwarz.
-- Classical finite-dimensional Cauchy--Schwarz inequality; DOI not applicable.
--
-- Author: Jean-Michel Bony.
-- Title: "Calcul symbolique et propagation des singularites pour les
-- equations aux derivees partielles non lineaires".
-- DOI: 10.24033/asens.1404.
--
-- ROUND75 / OUTPUT-FIBRE Q/W SUM IDENTITIES
--
-- Round75 constructed the static rational two-channel overlay directly from
-- the literal Galerkin coefficient.  This file proves that its abstract Round72
-- quantities are EXACTLY the expected physical sums:
--
--   Q = sum_tau |-i(u_p dot q)|^2,
--   W = sum_tau |<u_k,P_k u_q>|^2.
--
-- It then sums the per-triad physical norm bounds on the same classified
-- output-fibre list.  Hence the remaining frame theorem is reduced to bounding
-- explicit finite majorants generated by repeated velocity/mode masses; there
-- is no remaining factor-selection or overlay-identification ambiguity.
------------------------------------------------------------------------

open import Agda.Builtin.Bool using (Bool; true; false)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List using (List; []; _∷_)
open import Data.Rational.Base using (ℚ; 0ℚ; _+_; _*_; _≤_)
import Data.Rational.Properties as ℚP
open import Data.Rational.Tactic.RingSolver using (solve)
open import Relation.Binary.PropositionalEquality using (cong; trans)

import DASHI.Physics.Closure.NSIntegerFourierLattice as Z3
import DASHI.Physics.Closure.NSTriadKNComplex3ExactCarrier as C3
import DASHI.Physics.Closure.NSTriadKNComplex3GalerkinEquationAudit as Audit
import DASHI.Physics.Closure.NSTriadKNOrderedEuclideanL2Carrier as L2
import DASHI.Physics.Closure.NSTriadKNRationalOrderedFiniteL2 as RationalL2
import DASHI.Physics.Closure.NSTriadKNPhysicalTriadEnumeration as Physical
import DASHI.Physics.Closure.NSTriadKNLuoPhysicalFiveClassSupportRound25Exact as Support
import DASHI.Physics.Closure.NSTriadKNGlobalBilinearShellPairingRound29Exact as Shell
import DASHI.Physics.Closure.NSTriadKNStaticPairingEmitsStructuredTriadicAtomsRound72Exact as Fine
import DASHI.Physics.Closure.NSTriadKNFactorizedEffectiveComplexityCauchyRound72Exact as Effective
import DASHI.Physics.Closure.NSTriadKNOrderedInteractionRealImaginaryTwoChannelRound74Exact as Channels
import DASHI.Physics.Closure.NSTriadKNOrderedInteractionTwoChannelMassIdentityRound74Exact as Mass
import DASHI.Physics.Closure.NSTriadKNTwoChannelStructuredCauchyOverlayRound74Exact as Overlay
import DASHI.Physics.Closure.NSTriadKNRationalComplex3LerayPythagoras as Leray
import DASHI.Physics.Closure.NSTriadKNCanonicalTwoChannelPhysicalMassBoundsRound75Exact as Bounds
import DASHI.Physics.Closure.NSTriadKNStaticRationalTwoChannelOverlayRound75Exact as Static

F : C3.RealField _
F = RationalL2.rationalRealField

canonicalQSum :
  ∀ {E : C3.IntegerEmbedding F}
    {I : C3.ModeInverseSquare F E} →
  Audit.FiniteComplex3GalerkinSystem F E I →
  List Support.ClassifiedPhysicalTriad → ℚ
canonicalQSum system [] = 0ℚ
canonicalQSum system (classified ∷ rest) =
  let channels = Static.channelsForClassified system classified in
  Mass.leftChannelSquaredMass channels + canonicalQSum system rest

canonicalWSum :
  ∀ {E : C3.IntegerEmbedding F}
    {I : C3.ModeInverseSquare F E} →
  Audit.FiniteComplex3GalerkinSystem F E I →
  List Support.ClassifiedPhysicalTriad → ℚ
canonicalWSum system [] = 0ℚ
canonicalWSum system (classified ∷ rest) =
  let channels = Static.channelsForClassified system classified in
  Mass.rightChannelSquaredMass channels + canonicalWSum system rest

qEnergyMajorant :
  ∀ {E : C3.IntegerEmbedding F}
    {I : C3.ModeInverseSquare F E} →
  Audit.FiniteComplex3GalerkinSystem F E I →
  List Support.ClassifiedPhysicalTriad → ℚ
qEnergyMajorant system [] = 0ℚ
qEnergyMajorant system (classified ∷ rest) =
  let incidence = Support.incidence classified in
  L2.complex3NormSquared (Audit.velocityAt system (Physical.p incidence))
  * L2.complex3NormSquared
      (C3.modeVector (Audit.integerEmbedding system) (Physical.q incidence))
  + qEnergyMajorant system rest

wEnergyMajorant :
  ∀ {E : C3.IntegerEmbedding F}
    {I : C3.ModeInverseSquare F E} →
  Audit.FiniteComplex3GalerkinSystem F E I →
  List Support.ClassifiedPhysicalTriad → ℚ
wEnergyMajorant system [] = 0ℚ
wEnergyMajorant system (classified ∷ rest) =
  let incidence = Support.incidence classified in
  L2.complex3NormSquared (Static.outputVelocityTest system incidence)
  * L2.complex3NormSquared (Audit.velocityAt system (Physical.q incidence))
  + wEnergyMajorant system rest

factorChargeFromClassifiedExact :
  ∀ {E : C3.IntegerEmbedding F}
    {I : C3.ModeInverseSquare F E}
    (system : Audit.FiniteComplex3GalerkinSystem F E I)
    (pairing : Shell.StaticPhysicalShellPairing)
    (hh : Fine.HHOwnerSelection)
    (classified : List Support.ClassifiedPhysicalTriad)
    (valuesExact : ∀ selected →
      Shell.triadValue pairing (Support.incidence selected)
      ≡ Static.literalRationalTriadValue system (Support.incidence selected)) →
  Effective.concentrationCharge
    (Overlay.twoChannelFactors
      (Static.twoChannelOverlayFromClassified
        system pairing hh classified valuesExact))
  ≡ canonicalQSum system classified
factorChargeFromClassifiedExact system pairing hh [] valuesExact = refl
factorChargeFromClassifiedExact system pairing hh
    (classified ∷ rest) valuesExact =
  let
    channels = Static.channelsForClassified system classified
    tailExact = λ selected → valuesExact selected
  in
  trans
    (cong
      (λ tail →
        L2.square (Channels.left0 channels)
        + (L2.square (Channels.left1 channels) + tail))
      (factorChargeFromClassifiedExact
        system pairing hh rest tailExact))
    (solve
      ( Channels.left0 channels
      ∷ Channels.left1 channels
      ∷ canonicalQSum system rest
      ∷ []))

factorComplexityFromClassifiedExact :
  ∀ {E : C3.IntegerEmbedding F}
    {I : C3.ModeInverseSquare F E}
    (system : Audit.FiniteComplex3GalerkinSystem F E I)
    (pairing : Shell.StaticPhysicalShellPairing)
    (hh : Fine.HHOwnerSelection)
    (classified : List Support.ClassifiedPhysicalTriad)
    (valuesExact : ∀ selected →
      Shell.triadValue pairing (Support.incidence selected)
      ≡ Static.literalRationalTriadValue system (Support.incidence selected)) →
  Effective.effectiveComplexity
    (Overlay.twoChannelFactors
      (Static.twoChannelOverlayFromClassified
        system pairing hh classified valuesExact))
  ≡ canonicalWSum system classified
factorComplexityFromClassifiedExact system pairing hh [] valuesExact = refl
factorComplexityFromClassifiedExact system pairing hh
    (classified ∷ rest) valuesExact =
  let
    channels = Static.channelsForClassified system classified
    tailExact = λ selected → valuesExact selected
  in
  trans
    (cong
      (λ tail →
        L2.square (Channels.right0 channels)
        + (L2.square (Channels.right1 channels) + tail))
      (factorComplexityFromClassifiedExact
        system pairing hh rest tailExact))
    (solve
      ( Channels.right0 channels
      ∷ Channels.right1 channels
      ∷ canonicalWSum system rest
      ∷ []))

canonicalQSumBelowEnergyMajorant :
  ∀ {E : C3.IntegerEmbedding F}
    {I : C3.ModeInverseSquare F E}
    (system : Audit.FiniteComplex3GalerkinSystem F E I)
    (classified : List Support.ClassifiedPhysicalTriad) →
  canonicalQSum system classified ≤ qEnergyMajorant system classified
canonicalQSumBelowEnergyMajorant system [] = ℚP.≤-refl
canonicalQSumBelowEnergyMajorant system (classified ∷ rest) =
  ℚP.+-mono-≤
    (Bounds.orderedInteractionCanonicalQBound
      system (Support.incidence classified))
    (canonicalQSumBelowEnergyMajorant system rest)

canonicalWSumBelowEnergyMajorant :
  ∀ {E : C3.IntegerEmbedding F}
    {I : C3.ModeInverseSquare F E}
    (O : Leray.RationalInverseNormOrder E I)
    (system : Audit.FiniteComplex3GalerkinSystem F E I)
    (classified : List Support.ClassifiedPhysicalTriad) →
  (∀ selected → Z3.NonZeroMode (Physical.k (Support.incidence selected))) →
  canonicalWSum system classified ≤ wEnergyMajorant system classified
canonicalWSumBelowEnergyMajorant O system [] nonzero = ℚP.≤-refl
canonicalWSumBelowEnergyMajorant O system (classified ∷ rest) nonzero =
  ℚP.+-mono-≤
    (Bounds.orderedInteractionCanonicalWBound
      O system (Support.incidence classified) (nonzero classified)
      (Static.outputVelocityTest system (Support.incidence classified)))
    (canonicalWSumBelowEnergyMajorant
      O system rest (λ selected → nonzero selected))

round75OverlayChargeEqualsCanonicalQSum : Bool
round75OverlayChargeEqualsCanonicalQSum = true

round75OverlayComplexityEqualsCanonicalWSum : Bool
round75OverlayComplexityEqualsCanonicalWSum = true

round75CanonicalQWSumsHaveExplicitPhysicalEnergyMajorants : Bool
round75CanonicalQWSumsHaveExplicitPhysicalEnergyMajorants = true

round75FrameProblemReducedToMajorantMultiplicityGeometry : Bool
round75FrameProblemReducedToMajorantMultiplicityGeometry = true

round75FrameProblemReducedToMajorantMultiplicityGeometryIsTrue :
  round75FrameProblemReducedToMajorantMultiplicityGeometry ≡ true
round75FrameProblemReducedToMajorantMultiplicityGeometryIsTrue = refl
