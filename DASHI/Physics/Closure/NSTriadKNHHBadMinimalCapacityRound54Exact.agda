module DASHI.Physics.Closure.NSTriadKNHHBadMinimalCapacityRound54Exact where

------------------------------------------------------------------------
-- PRIMARY SOURCES / CONTEXT
--
-- Authors: Peter Constantin; Charles Fefferman.
-- Title: "Direction of Vorticity and the Problem of Global Regularity for
-- the Navier-Stokes Equations".
-- DOI: 10.1512/iumj.1993.42.42034.
--
-- Author: Xiaoyutao Luo.
-- Title: "A Beale--Kato--Majda Criterion with Optimal Frequency and Temporal
-- Localization".
-- DOI: 10.1007/s00021-019-0411-z.
-- arXiv DOI: 10.48550/arXiv.1803.05569.
--
-- DASHI CONTRIBUTION
--
-- Round 53 permits arbitrary bounded shell capacities.  Round 54 removes the
-- remaining existential ambiguity by constructing the CANONICAL LEAST capacity
-- generated by the literal normalized Duhamel recurrence:
--
--   M_0     = C_0,
--   M_(q+1) = alpha_q M_q + beta_q.
--
-- No alpha_q <= 1 hypothesis is used.  This M is a valid raw capacity and it is
-- pointwise <= every other raw capacity.  Consequently:
--
--   a bounded HH-bad supersolution exists
--       iff
--   this canonical minimal capacity is uniformly bounded.
--
-- This is a genuine falsification sharpening: the physical PDE lane no longer
-- has to search over capacities.  It has one explicit sequence to estimate.
------------------------------------------------------------------------

open import Agda.Builtin.Bool using (Bool; true)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Nat using (Nat; zero; suc)
open import Data.Rational.Base using
  (ℚ; 0ℚ; _+_; _*_; _≤_; nonNegative)
import Data.Rational.Properties as ℚP

import DASHI.Physics.Closure.NSTriadKNHHBadRawVariableCapacityRound53Exact as Raw
import DASHI.Physics.Closure.NSTriadKNHHBadRawCapacityToOwnerRound53Exact as ToOwner
import DASHI.Physics.Closure.NSTriadKNHHBadShellBarrierRound52Exact as Barrier

nonnegativeProduct :
  ∀ {left right : ℚ} →
  0ℚ ≤ left → 0ℚ ≤ right → 0ℚ ≤ left * right
nonnegativeProduct {left} {right} leftNN rightNN =
  let
    instance
      leftNNI = nonNegative leftNN
      rightNNI = nonNegative rightNN
      productNNI = ℚP.nonNeg*nonNeg⇒nonNeg left right
  in
  ℚP.nonNegative⁻¹ (left * right)

addNonnegative :
  ∀ {left right : ℚ} →
  0ℚ ≤ left → 0ℚ ≤ right → 0ℚ ≤ left + right
addNonnegative leftNN rightNN =
  ℚP.+-mono-≤ leftNN rightNN

minimalCapacity :
  Raw.PhysicalGeneralVariableDefectDuhamel → Nat → ℚ
minimalCapacity physical zero = Raw.normalizedDefect physical zero
minimalCapacity physical (suc q) =
  Raw.alpha physical q * minimalCapacity physical q
  + Raw.forcing physical q

minimalCapacityNonnegative :
  (physical : Raw.PhysicalGeneralVariableDefectDuhamel) →
  ∀ q → 0ℚ ≤ minimalCapacity physical q
minimalCapacityNonnegative physical zero =
  Barrier.profileNonnegative (Raw.asGeneralBarrierRecurrence physical) zero
minimalCapacityNonnegative physical (suc q) =
  addNonnegative
    (nonnegativeProduct
      (Raw.alphaNonnegative physical q)
      (minimalCapacityNonnegative physical q))
    (Raw.forcingNonnegative physical q)

minimalCapacityData :
  (physical : Raw.PhysicalGeneralVariableDefectDuhamel) →
  Raw.RawVariableCapacity physical
minimalCapacityData physical = record
  { capacity = minimalCapacity physical
  ; capacityNonnegative = minimalCapacityNonnegative physical
  ; baseBelowCapacity = ℚP.≤-refl
  ; capacityInvariant = λ q → ℚP.≤-refl
  }

physicalHHBadProfileBelowMinimalCapacity :
  (physical : Raw.PhysicalGeneralVariableDefectDuhamel) →
  ∀ q →
  Raw.normalizedDefect physical q ≤ minimalCapacity physical q
physicalHHBadProfileBelowMinimalCapacity physical =
  Raw.physicalHHBadRawVariableCapacityInvariant
    (minimalCapacityData physical)

minimalCapacityBelowEveryRawCapacity :
  ∀ {physical} →
  (other : Raw.RawVariableCapacity physical) →
  ∀ q →
  minimalCapacity physical q ≤ Raw.capacity other q
minimalCapacityBelowEveryRawCapacity {physical} other zero =
  Raw.baseBelowCapacity other
minimalCapacityBelowEveryRawCapacity {physical} other (suc q) =
  let
    inherited :
      Raw.alpha physical q * minimalCapacity physical q
      ≤ Raw.alpha physical q * Raw.capacity other q
    inherited =
      let instance alphaNNI = nonNegative (Raw.alphaNonnegative physical q)
      in ℚP.*-monoˡ-≤-nonNeg
        (Raw.alpha physical q)
        (minimalCapacityBelowEveryRawCapacity other q)

    addForcing :
      Raw.alpha physical q * minimalCapacity physical q
        + Raw.forcing physical q
      ≤ Raw.alpha physical q * Raw.capacity other q
        + Raw.forcing physical q
    addForcing = ℚP.+-mono-≤ inherited ℚP.≤-refl
  in
  ℚP.≤-trans addForcing (Raw.capacityInvariant other q)

record UniformMinimalCapacity
    (physical : Raw.PhysicalGeneralVariableDefectDuhamel) : Set where
  field
    ceiling : ℚ
    ceilingNonnegative : 0ℚ ≤ ceiling
    minimalBelowCeiling : ∀ q → minimalCapacity physical q ≤ ceiling

open UniformMinimalCapacity public

uniformMinimalToUniformRawCapacity :
  ∀ {physical} →
  UniformMinimalCapacity physical →
  ToOwner.UniformRawVariableCapacity physical
uniformMinimalToUniformRawCapacity uniform = record
  { capacityData = minimalCapacityData _
  ; ceiling = ceiling uniform
  ; ceilingNonnegative = ceilingNonnegative uniform
  ; capacityBelowCeiling = minimalBelowCeiling uniform
  }

uniformRawCapacityToUniformMinimal :
  ∀ {physical} →
  ToOwner.UniformRawVariableCapacity physical →
  UniformMinimalCapacity physical
uniformRawCapacityToUniformMinimal {physical} uniform = record
  { ceiling = ToOwner.ceiling uniform
  ; ceilingNonnegative = ToOwner.ceilingNonnegative uniform
  ; minimalBelowCeiling = λ q →
      ℚP.≤-trans
        (minimalCapacityBelowEveryRawCapacity
          (ToOwner.capacityData uniform) q)
        (ToOwner.capacityBelowCeiling uniform q)
  }

boundedCapacityExistenceReducedToCanonicalMinimalSequence : Bool
boundedCapacityExistenceReducedToCanonicalMinimalSequence = true

minimalCapacityAllowsTransientAmplification : Bool
minimalCapacityAllowsTransientAmplification = true

boundedCapacityExistenceReducedToCanonicalMinimalSequenceIsTrue :
  boundedCapacityExistenceReducedToCanonicalMinimalSequence ≡ true
boundedCapacityExistenceReducedToCanonicalMinimalSequenceIsTrue = refl

minimalCapacityAllowsTransientAmplificationIsTrue :
  minimalCapacityAllowsTransientAmplification ≡ true
minimalCapacityAllowsTransientAmplificationIsTrue = refl
