module DASHI.Physics.Closure.NSTriadKNLuoPerModeFiniteAssemblyAdapterExact where

------------------------------------------------------------------------
-- PROVENANCE
--
-- Author: Xiaoyutao Luo.
-- Title: "A Beale--Kato--Majda Criterion with Optimal Frequency and Temporal
-- Localization".
-- Journal of Mathematical Fluid Mechanics 21 (2019), article 1.
-- DOI: 10.1007/s00021-019-0411-z.
-- arXiv DOI: 10.48550/arXiv.1803.05569.
--
-- PURPOSE
-- Build the equation-(4.2) evolution object from the exact finite J1/J2,
-- J11/J12 and lower/upper-range assembly.  The caller supplies the physical
-- shell energy/dissipation inequality against the total interaction fold; all
-- source decomposition equalities are then generated by the finite theorem.
------------------------------------------------------------------------

open import Agda.Builtin.Bool using (Bool; true)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Nat using (Nat)
open import Agda.Builtin.Unit using (⊤; tt)
open import Data.Rational.Base using (ℚ; _+_; _*_; _≤_)
open import Relation.Binary.PropositionalEquality using (subst)

import DASHI.Physics.Closure.NSTriadKNLuoEquation42FiniteRangeAssemblyExact as Assembly
import DASHI.Physics.Closure.NSTriadKNLuoPerModeCommutatorEvolutionExact as Evolution

record LuoPerModeFinitePhysicalInputs : Set₁ where
  field
    finiteRangeData : Assembly.Equation42FiniteRangeData

    shellL2Squared : Nat → ℚ
    shellDissipation : Nat → ℚ
    timeDerivativeShellL2Squared : Nat → ℚ

    equation42AgainstTotalFold :
      (shell : Nat) →
      timeDerivativeShellL2Squared shell + shellDissipation shell
      ≤ Assembly.totalInteractionSum finiteRangeData shell

open LuoPerModeFinitePhysicalInputs public

perModeEvolutionFromFiniteAssembly :
  LuoPerModeFinitePhysicalInputs →
  Evolution.LuoPerModeCommutatorEvolution ⊤ ℚ
perModeEvolutionFromFiniteAssembly inputs = record
  { shellL2Squared = λ shell state → shellL2Squared inputs shell
  ; shellDissipation = λ shell state → shellDissipation inputs shell
  ; timeDerivativeShellL2Squared = λ shell state →
      timeDerivativeShellL2Squared inputs shell
  ; lowToNearInteraction = λ shell state →
      Assembly.J1 (finiteRangeData inputs) shell
  ; highTailInteraction = λ shell state →
      Assembly.J2 (finiteRangeData inputs) shell
  ; J1 = λ shell state → Assembly.J1 (finiteRangeData inputs) shell
  ; J2 = λ shell state → Assembly.J2 (finiteRangeData inputs) shell
  ; J11 = λ shell state → Assembly.J11 (finiteRangeData inputs) shell
  ; J12 = λ shell state → Assembly.J12 (finiteRangeData inputs) shell
  ; lowerHalfRange = λ shell state →
      Assembly.lowerHalfJ11 (finiteRangeData inputs) shell
  ; upperHalfRange = λ shell state →
      Assembly.upperHalfJ11 (finiteRangeData inputs) shell
  ; add = _+_
  ; multiply = _*_
  ; lessOrEqual = _≤_
  ; perModeEvolutionInequality = λ shell state →
      subst
        (λ upper →
          timeDerivativeShellL2Squared inputs shell
            + shellDissipation inputs shell
          ≤ upper)
        (Assembly.J1J2Meaning (finiteRangeData inputs) shell)
        (equation42AgainstTotalFold inputs shell)
  ; equation42RightHandSideMeaning = λ shell state → refl
  ; J1DyadicSplit = λ shell state →
      Assembly.J11J12Meaning (finiteRangeData inputs) shell
  ; lowShellSumRangeSplit = λ shell state →
      Assembly.J11RangeMeaning (finiteRangeData inputs) shell
  ; lowToNearHasLuoDyadicMeaning =
      Assembly.J1DecisionHasSourceMeaning (finiteRangeData inputs)
  ; lowToNearHasLuoDyadicMeaningWitness =
      Assembly.j1DecisionHasSourceMeaning (finiteRangeData inputs)
  ; highTailHasLuoDyadicMeaning =
      Assembly.J11DecisionHasSourceMeaning (finiteRangeData inputs)
  ; highTailHasLuoDyadicMeaningWitness =
      Assembly.j11DecisionHasSourceMeaning (finiteRangeData inputs)
  }

perModeFiniteAssemblyAdapterConstructed : Bool
perModeFiniteAssemblyAdapterConstructed = true

perModeFiniteAssemblyAdapterConstructedIsTrue :
  perModeFiniteAssemblyAdapterConstructed ≡ true
perModeFiniteAssemblyAdapterConstructedIsTrue = refl
