module DASHI.Physics.QuantumVacuum.CasimirInversePowerDerivativeBidiExact where

open import DASHI.Core.Prelude
open import Agda.Builtin.String using (String)

import DASHI.Analysis.InversePowerDerivativeCompilerExact as IDC
import DASHI.Physics.QuantumVacuum.CasimirParallelPlateKernel as Casimir
import DASHI.Physics.QuantumVacuum.PhysicalQuantities as Q
import DASHI.Physics.QuantumVacuum.CasimirCoefficient720To240CompilerExact as Coeff

------------------------------------------------------------------------
-- CASIMIR INVERSE-POWER DERIVATIVE, BIDI
--
-- The energy coefficient 720 is supplied by the spectral evaluation.  This
-- module isolates the remaining same-object calculus payment needed to turn
-- the inverse-cube energy observable into the inverse-fourth pressure law.
------------------------------------------------------------------------

record CasimirDerivativeApplication
    (kernel : Casimir.CasimirScalarModel) : Set₁ where
  field
    derivativeStructure : IDC.DerivativeStructure

    scalarCarrierAgrees :
      IDC.Scalar derivativeStructure ≡ Casimir.Scalar kernel

    separationCarrierAgrees :
      IDC.Variable derivativeStructure ≡ Q.Length

    inversePowerFamily : IDC.InversePowerFamily derivativeStructure

    EnergyFunction : IDC.Function derivativeStructure
    PressureFunction : IDC.Function derivativeStructure

    energyFunctionIsInverseCube :
      EnergyFunction ≡ IDC.power3Member inversePowerFamily

    pressureFunctionIsInverseFourth :
      PressureFunction ≡ IDC.power4Member inversePowerFamily

    sameRenormalisedObservableFamily : Set
    applicationReading : String

open CasimirDerivativeApplication public

record CasimirDerivativeClosure
    (kernel : Casimir.CasimirScalarModel)
    (A : CasimirDerivativeApplication kernel) : Set₁ where
  field
    inverseCubeReceipt :
      IDC.InverseCubeDerivativeReceipt
        (derivativeStructure A)
        (inversePowerFamily A)

    energyPerAreaSameObject : Set
    pressureSameObject : Set
    signConventionMatchesKernel : Set

    closureReading : String

open CasimirDerivativeClosure public

------------------------------------------------------------------------
-- The 720 -> 240 numerical step is already owned independently.
------------------------------------------------------------------------

coefficientArithmeticOwned : 3 * 240 ≡ 720
coefficientArithmeticOwned = Coeff.threeTimes240Is720

------------------------------------------------------------------------
-- Reverse obligations exposed to a real-analysis implementation.
------------------------------------------------------------------------

record CasimirDerivativeOpenObligations
    (kernel : Casimir.CasimirScalarModel)
    (A : CasimirDerivativeApplication kernel) : Set₁ where
  field
    realOrEquivalentCalculusCarrier : Set
    derivativeOfInverseCube : Set
    constantCoefficientRule : Set
    chainRuleForLengthValue : Set
    sameObservableTransport : Set
    pressureSignConvention : Set

open CasimirDerivativeOpenObligations public

------------------------------------------------------------------------
-- Firewall: matching closed forms are not enough.  The pressure formula must
-- be generated by differentiating the same renormalised energy observable.
------------------------------------------------------------------------

data ClosedFormMatchClosesSameObjectDerivativePermission : Set where

closedFormMatchCannotAutoCloseDerivative :
  ClosedFormMatchClosesSameObjectDerivativePermission → ⊥
closedFormMatchCannotAutoCloseDerivative ()
