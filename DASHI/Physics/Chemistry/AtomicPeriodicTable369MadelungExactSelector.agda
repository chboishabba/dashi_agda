------------------------------------------------------------------------
-- Exact structural Madelung/Aufbau selector.
--
-- Orbitals are ordered lexicographically by
--
--   (n + l, n)
--
-- equivalently: increasing n+l, and for equal n+l increasing n.
-- Instead of depending on a sorting library, we generate the diagonals
-- directly.  For each k >= 1 the consecutive diagonals 2k-1 and 2k contain
-- the same angular labels
--
--   l = k-1, k-2, ..., 0,
--
-- hence the same subshell-capacity list
--
--   4(k-1)+2, 4(k-2)+2, ..., 2.
--
-- Concatenating those doubled diagonal layers generates the capacity sequence
-- OEIS A167268.  This is a mathematical Aufbau/Madelung selector object.  It
-- does not assert that the historical n+alpha*l proxy derived this order, nor
-- that empirical interacting-atom ground states obey it without exceptions.
------------------------------------------------------------------------

infixr 5 _++L_

_++L_ : {A : Set} -> List A -> List A -> List A
[] ++L ys = ys
(x ∷ xs) ++L ys = x ∷ (xs ++L ys)

record OrbitalBlock : Set where
  constructor orbitalBlock
  field
    principal : Nat
    angular : Nat

open OrbitalBlock public

------------------------------------------------------------------------
-- Build one n+l diagonal from its first principal index and largest l.
------------------------------------------------------------------------

diagonalBlocksFrom : Nat -> Nat -> List OrbitalBlock
diagonalBlocksFrom n zero = orbitalBlock n zero ∷ []
diagonalBlocksFrom n (suc l) =
  orbitalBlock n (suc l) ∷ diagonalBlocksFrom (suc n) l

oddDiagonalBlocks : Nat -> List OrbitalBlock
oddDiagonalBlocks zero = []
oddDiagonalBlocks (suc k) = diagonalBlocksFrom (suc k) k

evenDiagonalBlocks : Nat -> List OrbitalBlock
evenDiagonalBlocks zero = []
evenDiagonalBlocks (suc k) = diagonalBlocksFrom (suc (suc k)) k

madelungLayerBlocks : Nat -> List OrbitalBlock
madelungLayerBlocks k = oddDiagonalBlocks k ++L evenDiagonalBlocks k

madelungBlockPrefix : Nat -> List OrbitalBlock
madelungBlockPrefix zero = []
madelungBlockPrefix (suc k) =
  madelungBlockPrefix k ++L madelungLayerBlocks (suc k)

------------------------------------------------------------------------
-- Capacity image of the selector.
------------------------------------------------------------------------

blockCapacity : OrbitalBlock -> Nat
blockCapacity b = G.subshellCapacity (angular b)

mapCapacity : List OrbitalBlock -> List Nat
mapCapacity [] = []
mapCapacity (b ∷ bs) = blockCapacity b ∷ mapCapacity bs

madelungCapacityPrefix : Nat -> List Nat
madelungCapacityPrefix k = mapCapacity (madelungBlockPrefix k)

------------------------------------------------------------------------
-- Exact A167268 prefixes generated by the selector.
------------------------------------------------------------------------

firstLayerBlocks :
  madelungBlockPrefix 1
  ≡ orbitalBlock 1 0 ∷ orbitalBlock 2 0 ∷ []
firstLayerBlocks = refl

secondLayerBlocks :
  madelungBlockPrefix 2
  ≡ orbitalBlock 1 0 ∷ orbitalBlock 2 0
  ∷ orbitalBlock 2 1 ∷ orbitalBlock 3 0
  ∷ orbitalBlock 3 1 ∷ orbitalBlock 4 0 ∷ []
secondLayerBlocks = refl

firstLayerCapacities :
  madelungCapacityPrefix 1 ≡ 2 ∷ 2 ∷ []
firstLayerCapacities = refl

secondLayerCapacities :
  madelungCapacityPrefix 2 ≡ 2 ∷ 2 ∷ 6 ∷ 2 ∷ 6 ∷ 2 ∷ []
secondLayerCapacities = refl

thirdLayerCapacities :
  madelungCapacityPrefix 3
  ≡ 2 ∷ 2 ∷ 6 ∷ 2 ∷ 6 ∷ 2
  ∷ 10 ∷ 6 ∷ 2 ∷ 10 ∷ 6 ∷ 2 ∷ []
thirdLayerCapacities = refl

fourthLayerCapacities :
  madelungCapacityPrefix 4
  ≡ 2 ∷ 2 ∷ 6 ∷ 2 ∷ 6 ∷ 2
  ∷ 10 ∷ 6 ∷ 2 ∷ 10 ∷ 6 ∷ 2
  ∷ 14 ∷ 10 ∷ 6 ∷ 2 ∷ 14 ∷ 10 ∷ 6 ∷ 2 ∷ []
fourthLayerCapacities = refl

------------------------------------------------------------------------
-- Same early coordinates used by the archived proxy are contained in the exact
-- selector, but the later ordering no longer depends on a fixed alpha.
------------------------------------------------------------------------

firstFourSAndThreeDContext :
  madelungBlockPrefix 3
  ≡ orbitalBlock 1 0 ∷ orbitalBlock 2 0
  ∷ orbitalBlock 2 1 ∷ orbitalBlock 3 0
  ∷ orbitalBlock 3 1 ∷ orbitalBlock 4 0
  ∷ orbitalBlock 3 2 ∷ orbitalBlock 4 1
  ∷ orbitalBlock 5 0 ∷ orbitalBlock 4 2
  ∷ orbitalBlock 5 1 ∷ orbitalBlock 6 0 ∷ []
firstFourSAndThreeDContext = refl

