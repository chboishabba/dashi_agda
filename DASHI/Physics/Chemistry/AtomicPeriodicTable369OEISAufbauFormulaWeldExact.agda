------------------------------------------------------------------------
-- Exact arithmetic weld from the already-proved shell-capacity law to the
-- OEIS Aufbau period-length coordinate A093907, and hence by partial summation
-- to the full-shell / noble-element coordinate A018227.
--
-- OEIS A093907 gives
--   a(n) = 2 * floor((n + 2) / 2)^2, n >= 1,
-- i.e. the shell-capacity values with shell indices
--   1,2,2,3,3,4,4,... .
--
-- Rather than introduce division, we define that index sequence by its exact
-- two-step recurrence.  The resulting period-length object is therefore a
-- repo-native mathematical construction, not merely a copied finite table.
--
-- This pays the integer-sequence/formula weld only.  It does not prove that
-- the DASHI MDL selector physically realizes the Aufbau/Madelung filling order,
-- nor does it prove empirical element stability, spectra, or nuclear existence.
------------------------------------------------------------------------

periodShellIndex : Nat -> Nat
periodShellIndex zero = zero
periodShellIndex (suc zero) = 1
periodShellIndex (suc (suc zero)) = 2
periodShellIndex (suc (suc (suc n))) =
  suc (periodShellIndex (suc n))

aufbauPeriodLength : Nat -> Nat
aufbauPeriodLength n = G.shellCapacity (periodShellIndex n)

------------------------------------------------------------------------
-- A093907 exact prefix regressions generated by the formula object.
------------------------------------------------------------------------

period1 : aufbauPeriodLength 1 ≡ 2
period1 = refl

period2 : aufbauPeriodLength 2 ≡ 8
period2 = refl

period3 : aufbauPeriodLength 3 ≡ 8
period3 = refl

period4 : aufbauPeriodLength 4 ≡ 18
period4 = refl

period5 : aufbauPeriodLength 5 ≡ 18
period5 = refl

period6 : aufbauPeriodLength 6 ≡ 32
period6 = refl

period7 : aufbauPeriodLength 7 ≡ 32
period7 = refl

firstSevenPeriodLengths :
  aufbauPeriodLength 1 ≡ 2
  × aufbauPeriodLength 2 ≡ 8
  × aufbauPeriodLength 3 ≡ 8
  × aufbauPeriodLength 4 ≡ 18
  × aufbauPeriodLength 5 ≡ 18
  × aufbauPeriodLength 6 ≡ 32
  × aufbauPeriodLength 7 ≡ 32
firstSevenPeriodLengths =
  period1 ,
  (period2 ,
  (period3 ,
  (period4 ,
  (period5 ,
  (period6 , period7)))))

------------------------------------------------------------------------
-- A018227 as the partial sums of the period-length sequence.
------------------------------------------------------------------------

aufbauClosure : Nat -> Nat
aufbauClosure zero = zero
aufbauClosure (suc n) =
  aufbauClosure n + aufbauPeriodLength (suc n)

closure1 : aufbauClosure 1 ≡ 2
closure1 = refl

closure2 : aufbauClosure 2 ≡ 10
closure2 = refl

closure3 : aufbauClosure 3 ≡ 18
closure3 = refl

closure4 : aufbauClosure 4 ≡ 36
closure4 = refl

closure5 : aufbauClosure 5 ≡ 54
closure5 = refl

closure6 : aufbauClosure 6 ≡ 86
closure6 = refl

closure7 : aufbauClosure 7 ≡ 118
closure7 = refl

firstSevenClosures :
  aufbauClosure 1 ≡ 2
  × aufbauClosure 2 ≡ 10
  × aufbauClosure 3 ≡ 18
  × aufbauClosure 4 ≡ 36
  × aufbauClosure 5 ≡ 54
  × aufbauClosure 6 ≡ 86
  × aufbauClosure 7 ≡ 118
firstSevenClosures =
  closure1 ,
  (closure2 ,
  (closure3 ,
  (closure4 ,
  (closure5 ,
  (closure6 , closure7)))))

------------------------------------------------------------------------
-- The historical 2,10,18 regression is now embedded in the exact closure
-- construction, rather than merely recorded beside the OEIS sequence.
------------------------------------------------------------------------

historicalClosuresEmbed :
  G.historicalClosureZ G.heliumLikeClosure ≡ aufbauClosure 1
  × G.historicalClosureZ G.neonLikeClosure ≡ aufbauClosure 2
  × G.historicalClosureZ G.argonLikeClosure ≡ aufbauClosure 3
historicalClosuresEmbed = refl , (refl , refl)

