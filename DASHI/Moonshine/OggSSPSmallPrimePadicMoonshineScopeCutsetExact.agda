chenMarksTyler : Source.AttributedSource
chenMarksTyler =
  Source.mkNoDOISource
    "Ryan C. Chen, Samuel Marks, and Matthew Tyler"
    "p-adic Properties of Hauptmoduln with Applications to Moonshine"
    "SIGMA 15 (2019), arXiv:1809.02913"
    "2019"
    "https://arxiv.org/abs/1809.02913"
    Source.academicArticleSource
    "proves broad p-adic annihilation/congruence results for monstrous Hauptmoduln and relates them to Monster power maps and selected centralizer moonshine modules; does not state the 2B/3B local-centralizer defect valuation used by DASHI"
    Source.publicAttribution

carnahanUrano : Source.AttributedSource
carnahanUrano =
  Source.mkNoDOISource
    "Scott Carnahan and Satoru Urano"
    "Monstrous Moonshine for integral group rings"
    "arXiv:2111.09404"
    "2021"
    "https://arxiv.org/abs/2111.09404"
    Source.academicArticleSource
    "formulates an integral-group-ring Hauptmodul conjecture and proves the new conjecture in the paper for cyclic subgroups generated by class 4A; this is route-level precedent, not a proof for 2B/3B"
    Source.publicAttribution

padicMoonshineScopeAtlas : Source.AttributedSourceAtlas
padicMoonshineScopeAtlas =
  Source.mkSourceAtlas
    "small-prime p-adic/integral moonshine scope atlas"
    "DASHI.Moonshine.OggSSPSmallPrimePadicMoonshineScopeCutsetExact"
    (chenMarksTyler ∷ carnahanUrano ∷ [])
    "external sources own p-adic Hauptmodul and integral moonshine frameworks; class-specific 2B/3B valuation recognition remains an open DASHI theorem"

