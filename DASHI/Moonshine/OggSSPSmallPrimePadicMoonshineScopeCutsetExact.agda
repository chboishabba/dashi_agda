module DASHI.Moonshine.OggSSPSmallPrimePadicMoonshineScopeCutsetExact where

------------------------------------------------------------------------
-- SMALL-PRIME p-ADIC / INTEGRAL MOONSHINE SCOPE CUTSET
--
-- SOTA EXTERNAL INPUT
--
-- Chen--Marks--Tyler:
--   many monstrous Hauptmoduln satisfy congruences modulo powers of
--   p in {2,3,5,7,11}; the paper relates p-adic annihilation to Monster power
--   maps and gives p-adic moonshine examples for certain centralizers of
--   commuting pA-type pairs.
--
-- Carnahan--Urano:
--   formulate a substantially broader integral-group-ring moonshine
--   conjecture, but in that paper prove the new conjecture for cyclic
--   subgroups generated by class 4A.
--
-- CONSEQUENCE
--
-- These papers strongly source the ROUTE
--
--   integral/graded Monster representation
--     -> p-adic Hauptmodul / q-expansion information,
--
-- but do not supply a theorem for the particular 2B/3B local-centralizer
-- valuation defects 10 and 2 required here.
------------------------------------------------------------------------

open import DASHI.Core.Prelude
open import Agda.Builtin.Bool using (Bool; true; false)

import DASHI.Core.AttributedSourceCore as Source
