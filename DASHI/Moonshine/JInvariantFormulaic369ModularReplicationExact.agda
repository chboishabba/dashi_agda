module DASHI.Moonshine.JInvariantFormulaic369ModularReplicationExact where

------------------------------------------------------------------------
-- FORMULAIC MODULAR REPLICATION OF THE 369 J RENDERER
--
-- If an analytic modular action preserves the same Klein-j value, then every
-- downstream phase / colour / 3-6-9-27 observer is preserved automatically.
-- The recursive rainbow pattern is therefore generated by modular transport of
-- one analytic phase field, not by copying pixels.
------------------------------------------------------------------------

open import DASHI.Core.Prelude

import DASHI.Moonshine.JInvariantFormulaic369RendererExact as Render
import DASHI.Moonshine.JInvariantOrderThreeSeamModularWordExact as Word
import DASHI.Moonshine.JInvariantKleinConstructionGluingBidiExact as Klein

------------------------------------------------------------------------
-- 1. Generic same-object modular action over the renderer point carrier.
------------------------------------------------------------------------

record J369ModularAction (R : Render.JPhaseRenderingAlgebra) : Set₁ where
  constructor j369-modular-action
  field
    Matrix : Set
    act : Matrix → Klein.Point (Render.klein R) → Klein.Point (Render.klein R)
    jInvariant :
      (M : Matrix) →
      (z : Klein.Point (Render.klein R)) →
      Render.jValue R (act M z) ≡ Render.jValue R z

open J369ModularAction public

phaseInvariant :
  (R : Render.JPhaseRenderingAlgebra) →
  (A : J369ModularAction R) →
  (M : Matrix A) →
  (z : Klein.Point (Render.klein R)) →
  Render.jPhase R (act A M z) ≡ Render.jPhase R z
phaseInvariant R A M z rewrite jInvariant A M z = refl

colourInvariant :
  (R : Render.JPhaseRenderingAlgebra) →
  (A : J369ModularAction R) →
  (M : Matrix A) →
  (z : Klein.Point (Render.klein R)) →
  Render.jColour R (act A M z) ≡ Render.jColour R z
colourInvariant R A M z rewrite jInvariant A M z = refl

observer3Invariant :
  (R : Render.JPhaseRenderingAlgebra) →
  (A : J369ModularAction R) →
  (M : Matrix A) →
  (z : Klein.Point (Render.klein R)) →
  Render.observer3 (Render.renderAt R (act A M z)) ≡
  Render.observer3 (Render.renderAt R z)
observer3Invariant R A M z rewrite jInvariant A M z = refl

observer6Invariant :
  (R : Render.JPhaseRenderingAlgebra) →
  (A : J369ModularAction R) →
  (M : Matrix A) →
  (z : Klein.Point (Render.klein R)) →
  Render.observer6 (Render.renderAt R (act A M z)) ≡
  Render.observer6 (Render.renderAt R z)
observer6Invariant R A M z rewrite jInvariant A M z = refl

observer9Invariant :
  (R : Render.JPhaseRenderingAlgebra) →
  (A : J369ModularAction R) →
  (M : Matrix A) →
  (z : Klein.Point (Render.klein R)) →
  Render.observer9 (Render.renderAt R (act A M z)) ≡
  Render.observer9 (Render.renderAt R z)
observer9Invariant R A M z rewrite jInvariant A M z = refl

observer27Invariant :
  (R : Render.JPhaseRenderingAlgebra) →
  (A : J369ModularAction R) →
  (M : Matrix A) →
  (z : Klein.Point (Render.klein R)) →
  Render.observer27 (Render.renderAt R (act A M z)) ≡
  Render.observer27 (Render.renderAt R z)
observer27Invariant R A M z rewrite jInvariant A M z = refl

------------------------------------------------------------------------
-- 2. Same seam word as the balanced-FRACTRAN owner.
--
-- This bridge consumes an analytic interpretation of the already-proved Nat
-- word gamma_k = L^k T.  The symbolic word is not redefined here.
------------------------------------------------------------------------

record SeamWordAnalyticAction (R : Render.JPhaseRenderingAlgebra) : Set₁ where
  constructor seam-word-analytic-action
  field
    actWord :
      Word.NatMatrix2 →
      Klein.Point (Render.klein R) →
      Klein.Point (Render.klein R)

    wordJInvariant :
      (M : Word.NatMatrix2) →
      (z : Klein.Point (Render.klein R)) →
      Render.jValue R (actWord M z) ≡ Render.jValue R z

open SeamWordAnalyticAction public

gammaPoint :
  (R : Render.JPhaseRenderingAlgebra) →
  SeamWordAnalyticAction R →
  Nat →
  Klein.Point (Render.klein R) →
  Klein.Point (Render.klein R)
gammaPoint R A k z = actWord A (Word.gammaWord k) z

gammaColourRepeats :
  (R : Render.JPhaseRenderingAlgebra) →
  (A : SeamWordAnalyticAction R) →
  (k : Nat) →
  (z : Klein.Point (Render.klein R)) →
  Render.jColour R (gammaPoint R A k z) ≡ Render.jColour R z
gammaColourRepeats R A k z rewrite wordJInvariant A (Word.gammaWord k) z = refl

gammaPhaseRepeats :
  (R : Render.JPhaseRenderingAlgebra) →
  (A : SeamWordAnalyticAction R) →
  (k : Nat) →
  (z : Klein.Point (Render.klein R)) →
  Render.jPhase R (gammaPoint R A k z) ≡ Render.jPhase R z
gammaPhaseRepeats R A k z rewrite wordJInvariant A (Word.gammaWord k) z = refl

------------------------------------------------------------------------
-- 3. Formulaic reproduction frontier.
------------------------------------------------------------------------

data FormulaicReplicationResidual : Set where
  missingConcreteComplexKleinJAlgebra : FormulaicReplicationResidual
  missingConcreteAnalyticLAction : FormulaicReplicationResidual
  missingConcreteAnalyticTAction : FormulaicReplicationResidual
  missingRasterGridInstantiation : FormulaicReplicationResidual
  missingGeneratedRasterComparisonReceipt : FormulaicReplicationResidual

record FormulaicReplicationFrontier : Set where
  constructor formulaic-replication-frontier
  field
    modularValueInvariancePropagatesToPhase : Bool
    modularValueInvariancePropagatesToColour : Bool
    modularValueInvariancePropagatesTo369Observers : Bool
    signedFRACTRANSeamWordReused : Bool
    recursiveFansNeedPixelCopying : Bool
    concreteAnalyticInstantiationPaid : Bool
    rasterReproductionPaid : Bool
    firstResidual : FormulaicReplicationResidual

canonicalFormulaicReplicationFrontier : FormulaicReplicationFrontier
canonicalFormulaicReplicationFrontier =
  formulaic-replication-frontier
    true true true true false false false
    missingConcreteComplexKleinJAlgebra
