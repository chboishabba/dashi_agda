record P11FiveStatePermutationBoundary : Set where
  field
    ell2GeneratedByThreeInvolutions : Bool
    ell2GeneratedByThreeInvolutionsIsTrue : ell2GeneratedByThreeInvolutions ≡ true

    ell3GeneratedByFourCyclicPermutations : Bool
    ell3GeneratedByFourCyclicPermutationsIsTrue :
      ell3GeneratedByFourCyclicPermutations ≡ true

    ell5GeneratedByInverseClosedSixPermutations : Bool
    ell5GeneratedByInverseClosedSixPermutationsIsTrue :
      ell5GeneratedByInverseClosedSixPermutations ≡ true

    allPrimeActionsInverseClosed : Bool
    allPrimeActionsInverseClosedIsTrue : allPrimeActionsInverseClosed ≡ true

    samePositiveAdjacencyAsFiveStateLift : Bool
    samePositiveAdjacencyAsFiveStateLiftIsTrue :
      samePositiveAdjacencyAsFiveStateLift ≡ true

    arithmeticDoubleCosetGroupIdentified : Bool
    arithmeticDoubleCosetGroupIdentifiedIsFalse :
      arithmeticDoubleCosetGroupIdentified ≡ false

canonicalP11FiveStatePermutationBoundary : P11FiveStatePermutationBoundary
canonicalP11FiveStatePermutationBoundary =
  record
    { ell2GeneratedByThreeInvolutions = true
    ; ell2GeneratedByThreeInvolutionsIsTrue = refl
    ; ell3GeneratedByFourCyclicPermutations = true
    ; ell3GeneratedByFourCyclicPermutationsIsTrue = refl
    ; ell5GeneratedByInverseClosedSixPermutations = true
    ; ell5GeneratedByInverseClosedSixPermutationsIsTrue = refl
    ; allPrimeActionsInverseClosed = true
    ; allPrimeActionsInverseClosedIsTrue = refl
    ; samePositiveAdjacencyAsFiveStateLift = true
    ; samePositiveAdjacencyAsFiveStateLiftIsTrue = refl
    ; arithmeticDoubleCosetGroupIdentified = false
    ; arithmeticDoubleCosetGroupIdentifiedIsFalse = refl
    }
