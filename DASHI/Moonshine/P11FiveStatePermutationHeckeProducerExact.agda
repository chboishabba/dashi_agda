r2SchreierMatchesPositiveEntry Fine.b1 Fine.a0 = refl
r2SchreierMatchesPositiveEntry Fine.b1 Fine.a1 = refl
r2SchreierMatchesPositiveEntry Fine.b1 Fine.b0 = refl
r2SchreierMatchesPositiveEntry Fine.b1 Fine.b1 = refl
r2SchreierMatchesPositiveEntry Fine.b1 Fine.b2 = refl
r2SchreierMatchesPositiveEntry Fine.b2 Fine.a0 = refl
r2SchreierMatchesPositiveEntry Fine.b2 Fine.a1 = refl
r2SchreierMatchesPositiveEntry Fine.b2 Fine.b0 = refl
r2SchreierMatchesPositiveEntry Fine.b2 Fine.b1 = refl
r2SchreierMatchesPositiveEntry Fine.b2 Fine.b2 = refl

