r2SchreierMatchesPositiveEntry Fine.a1 Fine.a1 = refl
r2SchreierMatchesPositiveEntry Fine.a1 Fine.b0 = refl
r2SchreierMatchesPositiveEntry Fine.a1 Fine.b1 = refl
r2SchreierMatchesPositiveEntry Fine.a1 Fine.b2 = refl
r2SchreierMatchesPositiveEntry Fine.b0 Fine.a0 = refl
r2SchreierMatchesPositiveEntry Fine.b0 Fine.a1 = refl
