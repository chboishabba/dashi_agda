module DASHI.Moonshine.P11FiveStatePermutationHeckeProducerExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES / CONTEXT
--
-- Jean-Pierre Serre,
-- "Trees", Springer Monographs in Mathematics.
-- DOI: 10.1007/978-3-642-61856-7.
--
-- Alexander Lubotzky,
-- "Discrete Groups, Expanding Graphs and Invariant Measures",
-- Progress in Mathematics 125, Birkhauser, 1994.
-- DOI: 10.1007/978-3-0346-0332-4.
--
-- DASHI CONTRIBUTION
--
-- Upgrade the five-state positive p=11 model from a hand-enumerated multigraph
-- to an actual inverse-closed permutation action.
--
-- On the common five-vertex carrier A0,A1,B0,B1,B2:
--
-- * ell=2 is generated by three involutions;
-- * ell=3 is generated by the four nonidentity powers of one 5-cycle;
-- * ell=5 is generated by those four cyclic shifts plus a permutation g and
--   its inverse.
--
-- Consequently every prime adjacency is a sum of genuine bijections.  This is
-- the first representation-side object in the lane whose positivity/locality
-- is generated before linearization rather than imposed on a matrix.
--
-- The action is an INTERNAL finite candidate.  No claim is made that its
-- generated permutation group is a quaternionic unit group, that the carrier
-- is Gamma\G/U, or that it is the ternary-pants S3 action from PR #558.
------------------------------------------------------------------------

open import DASHI.Core.Prelude
open import Data.Fin using (Fin; zero; suc)

import DASHI.Moonshine.PositiveFiniteNeighbourSystemExact as Positive
import DASHI.Moonshine.PositiveSchreierNeighbourSystemExact as Schreier
import DASHI.Moonshine.P11FiveStatePositiveHeckeLiftExact as Fine

------------------------------------------------------------------------
-- ell=2: three involutions.
------------------------------------------------------------------------

r2PermutationAction : Fin 3 → Fine.P11Fine5 → Fine.P11Fine5
r2PermutationAction zero Fine.a0 = Fine.b0
r2PermutationAction zero Fine.a1 = Fine.b1
r2PermutationAction zero Fine.b0 = Fine.a0
r2PermutationAction zero Fine.b1 = Fine.a1
r2PermutationAction zero Fine.b2 = Fine.b2
r2PermutationAction (suc zero) Fine.a0 = Fine.b1
r2PermutationAction (suc zero) Fine.a1 = Fine.b2
r2PermutationAction (suc zero) Fine.b0 = Fine.b0
r2PermutationAction (suc zero) Fine.b1 = Fine.a0
r2PermutationAction (suc zero) Fine.b2 = Fine.a1
r2PermutationAction (suc (suc zero)) Fine.a0 = Fine.b2
r2PermutationAction (suc (suc zero)) Fine.a1 = Fine.b0
r2PermutationAction (suc (suc zero)) Fine.b0 = Fine.a1
r2PermutationAction (suc (suc zero)) Fine.b1 = Fine.b1
r2PermutationAction (suc (suc zero)) Fine.b2 = Fine.a0

r2Involutive :
  (edge : Fin 3) → (vertex : Fine.P11Fine5) →
  r2PermutationAction edge (r2PermutationAction edge vertex) ≡ vertex
r2Involutive zero Fine.a0 = refl
r2Involutive zero Fine.a1 = refl
r2Involutive zero Fine.b0 = refl
r2Involutive zero Fine.b1 = refl
r2Involutive zero Fine.b2 = refl
r2Involutive (suc zero) Fine.a0 = refl
r2Involutive (suc zero) Fine.a1 = refl
r2Involutive (suc zero) Fine.b0 = refl
r2Involutive (suc zero) Fine.b1 = refl
r2Involutive (suc zero) Fine.b2 = refl
r2Involutive (suc (suc zero)) Fine.a0 = refl
r2Involutive (suc (suc zero)) Fine.a1 = refl
r2Involutive (suc (suc zero)) Fine.b0 = refl
r2Involutive (suc (suc zero)) Fine.b1 = refl
r2Involutive (suc (suc zero)) Fine.b2 = refl

r2SchreierProducer : Schreier.FiniteSchreierProducer Fine.P11Fine5 (Fin 3)
r2SchreierProducer =
  record
    { Schreier.generatorCount = 3
    ; Schreier.generatorAt = λ edge → edge
    ; Schreier.act = r2PermutationAction
    }

r2InverseClosed :
  Schreier.InverseClosedSchreierProducer Fine.P11Fine5 (Fin 3) r2SchreierProducer
r2InverseClosed =
  record
    { Schreier.inverseIndex = λ edge → edge
    ; Schreier.inverseIndexInvolutive = λ edge → refl
    ; Schreier.actionInverse = r2Involutive
    }

R2Schreier : Positive.PositiveFiniteNeighbourSystem Fine.P11Fine5
R2Schreier = Schreier.schreierNeighbourSystem r2SchreierProducer

------------------------------------------------------------------------
-- ell=3: four nonidentity powers of the 5-cycle
-- A0 -> A1 -> B0 -> B1 -> B2 -> A0.
------------------------------------------------------------------------

shift1 : Fine.P11Fine5 → Fine.P11Fine5
shift1 Fine.a0 = Fine.a1
shift1 Fine.a1 = Fine.b0
shift1 Fine.b0 = Fine.b1
shift1 Fine.b1 = Fine.b2
shift1 Fine.b2 = Fine.a0

shift2 : Fine.P11Fine5 → Fine.P11Fine5
shift2 Fine.a0 = Fine.b0
shift2 Fine.a1 = Fine.b1
shift2 Fine.b0 = Fine.b2
shift2 Fine.b1 = Fine.a0
shift2 Fine.b2 = Fine.a1

shift3 : Fine.P11Fine5 → Fine.P11Fine5
shift3 Fine.a0 = Fine.b1
shift3 Fine.a1 = Fine.b2
shift3 Fine.b0 = Fine.a0
shift3 Fine.b1 = Fine.a1
shift3 Fine.b2 = Fine.b0

shift4 : Fine.P11Fine5 → Fine.P11Fine5
shift4 Fine.a0 = Fine.b2
shift4 Fine.a1 = Fine.a0
shift4 Fine.b0 = Fine.a1
shift4 Fine.b1 = Fine.b0
shift4 Fine.b2 = Fine.b1

r3PermutationAction : Fin 4 → Fine.P11Fine5 → Fine.P11Fine5
r3PermutationAction zero = shift1
r3PermutationAction (suc zero) = shift2
r3PermutationAction (suc (suc zero)) = shift3
r3PermutationAction (suc (suc (suc zero))) = shift4

r3InverseIndex : Fin 4 → Fin 4
r3InverseIndex zero = suc (suc (suc zero))
r3InverseIndex (suc zero) = suc (suc zero)
r3InverseIndex (suc (suc zero)) = suc zero
r3InverseIndex (suc (suc (suc zero))) = zero

r3InverseIndexInvolutive : (edge : Fin 4) →
  r3InverseIndex (r3InverseIndex edge) ≡ edge
r3InverseIndexInvolutive zero = refl
r3InverseIndexInvolutive (suc zero) = refl
r3InverseIndexInvolutive (suc (suc zero)) = refl
r3InverseIndexInvolutive (suc (suc (suc zero))) = refl

r3ActionInverse :
  (edge : Fin 4) → (vertex : Fine.P11Fine5) →
  r3PermutationAction (r3InverseIndex edge)
    (r3PermutationAction edge vertex) ≡ vertex
r3ActionInverse zero Fine.a0 = refl
r3ActionInverse zero Fine.a1 = refl
r3ActionInverse zero Fine.b0 = refl
r3ActionInverse zero Fine.b1 = refl
r3ActionInverse zero Fine.b2 = refl
r3ActionInverse (suc zero) Fine.a0 = refl
r3ActionInverse (suc zero) Fine.a1 = refl
r3ActionInverse (suc zero) Fine.b0 = refl
r3ActionInverse (suc zero) Fine.b1 = refl
r3ActionInverse (suc zero) Fine.b2 = refl
r3ActionInverse (suc (suc zero)) Fine.a0 = refl
r3ActionInverse (suc (suc zero)) Fine.a1 = refl
r3ActionInverse (suc (suc zero)) Fine.b0 = refl
r3ActionInverse (suc (suc zero)) Fine.b1 = refl
r3ActionInverse (suc (suc zero)) Fine.b2 = refl
r3ActionInverse (suc (suc (suc zero))) Fine.a0 = refl
r3ActionInverse (suc (suc (suc zero))) Fine.a1 = refl
r3ActionInverse (suc (suc (suc zero))) Fine.b0 = refl
r3ActionInverse (suc (suc (suc zero))) Fine.b1 = refl
r3ActionInverse (suc (suc (suc zero))) Fine.b2 = refl

r3SchreierProducer : Schreier.FiniteSchreierProducer Fine.P11Fine5 (Fin 4)
r3SchreierProducer =
  record
    { Schreier.generatorCount = 4
    ; Schreier.generatorAt = λ edge → edge
    ; Schreier.act = r3PermutationAction
    }

r3InverseClosed :
  Schreier.InverseClosedSchreierProducer Fine.P11Fine5 (Fin 4) r3SchreierProducer
r3InverseClosed =
  record
    { Schreier.inverseIndex = r3InverseIndex
    ; Schreier.inverseIndexInvolutive = r3InverseIndexInvolutive
    ; Schreier.actionInverse = r3ActionInverse
    }

R3Schreier : Positive.PositiveFiniteNeighbourSystem Fine.P11Fine5
R3Schreier = Schreier.schreierNeighbourSystem r3SchreierProducer

------------------------------------------------------------------------
-- ell=5: R3's four cyclic shifts plus g and g^-1.
------------------------------------------------------------------------

g : Fine.P11Fine5 → Fine.P11Fine5
g Fine.a0 = Fine.a1
g Fine.a1 = Fine.a0
g Fine.b0 = Fine.b1
g Fine.b1 = Fine.b2
g Fine.b2 = Fine.b0

gInverse : Fine.P11Fine5 → Fine.P11Fine5
gInverse Fine.a0 = Fine.a1
gInverse Fine.a1 = Fine.a0
gInverse Fine.b0 = Fine.b2
gInverse Fine.b1 = Fine.b0
gInverse Fine.b2 = Fine.b1

gInverseLeft : (vertex : Fine.P11Fine5) → gInverse (g vertex) ≡ vertex
gInverseLeft Fine.a0 = refl
gInverseLeft Fine.a1 = refl
gInverseLeft Fine.b0 = refl
gInverseLeft Fine.b1 = refl
gInverseLeft Fine.b2 = refl

gLeftInverse : (vertex : Fine.P11Fine5) → g (gInverse vertex) ≡ vertex
gLeftInverse Fine.a0 = refl
gLeftInverse Fine.a1 = refl
gLeftInverse Fine.b0 = refl
gLeftInverse Fine.b1 = refl
gLeftInverse Fine.b2 = refl

r5PermutationAction : Fin 6 → Fine.P11Fine5 → Fine.P11Fine5
r5PermutationAction zero = g
r5PermutationAction (suc zero) = gInverse
r5PermutationAction (suc (suc zero)) = shift1
r5PermutationAction (suc (suc (suc zero))) = shift2
r5PermutationAction (suc (suc (suc (suc zero)))) = shift3
r5PermutationAction (suc (suc (suc (suc (suc zero))))) = shift4

r5InverseIndex : Fin 6 → Fin 6
r5InverseIndex zero = suc zero
r5InverseIndex (suc zero) = zero
r5InverseIndex (suc (suc zero)) = suc (suc (suc (suc (suc zero))))
r5InverseIndex (suc (suc (suc zero))) = suc (suc (suc (suc zero)))
r5InverseIndex (suc (suc (suc (suc zero)))) = suc (suc (suc zero))
r5InverseIndex (suc (suc (suc (suc (suc zero))))) = suc (suc zero)

r5InverseIndexInvolutive : (edge : Fin 6) →
  r5InverseIndex (r5InverseIndex edge) ≡ edge
r5InverseIndexInvolutive zero = refl
r5InverseIndexInvolutive (suc zero) = refl
r5InverseIndexInvolutive (suc (suc zero)) = refl
r5InverseIndexInvolutive (suc (suc (suc zero))) = refl
r5InverseIndexInvolutive (suc (suc (suc (suc zero)))) = refl
r5InverseIndexInvolutive (suc (suc (suc (suc (suc zero))))) = refl

r5ActionInverse :
  (edge : Fin 6) → (vertex : Fine.P11Fine5) →
  r5PermutationAction (r5InverseIndex edge)
    (r5PermutationAction edge vertex) ≡ vertex
r5ActionInverse zero = gInverseLeft
r5ActionInverse (suc zero) = gLeftInverse
r5ActionInverse (suc (suc zero)) = r3ActionInverse zero
r5ActionInverse (suc (suc (suc zero))) = r3ActionInverse (suc zero)
r5ActionInverse (suc (suc (suc (suc zero)))) =
  r3ActionInverse (suc (suc zero))
r5ActionInverse (suc (suc (suc (suc (suc zero))))) =
  r3ActionInverse (suc (suc (suc zero)))

r5SchreierProducer : Schreier.FiniteSchreierProducer Fine.P11Fine5 (Fin 6)
r5SchreierProducer =
  record
    { Schreier.generatorCount = 6
    ; Schreier.generatorAt = λ edge → edge
    ; Schreier.act = r5PermutationAction
    }

r5InverseClosed :
  Schreier.InverseClosedSchreierProducer Fine.P11Fine5 (Fin 6) r5SchreierProducer
r5InverseClosed =
  record
    { Schreier.inverseIndex = r5InverseIndex
    ; Schreier.inverseIndexInvolutive = r5InverseIndexInvolutive
    ; Schreier.actionInverse = r5ActionInverse
    }

R5Schreier : Positive.PositiveFiniteNeighbourSystem Fine.P11Fine5
R5Schreier = Schreier.schreierNeighbourSystem r5SchreierProducer

------------------------------------------------------------------------
-- Indicator matrix entries recover the same prime adjacency matrices as the
-- previous positive fine model.  This establishes the permutation decomposition
-- without requiring edge labels to agree.
------------------------------------------------------------------------

indicator : Fine.P11Fine5 → Fine.P11Fine5 → Nat
indicator Fine.a0 Fine.a0 = 1
indicator Fine.a0 _ = 0
indicator Fine.a1 Fine.a1 = 1
indicator Fine.a1 _ = 0
indicator Fine.b0 Fine.b0 = 1
indicator Fine.b0 _ = 0
indicator Fine.b1 Fine.b1 = 1
indicator Fine.b1 _ = 0
indicator Fine.b2 Fine.b2 = 1
indicator Fine.b2 _ = 0

sameAdjacencyEntry :
  (left right : Positive.PositiveFiniteNeighbourSystem Fine.P11Fine5) →
  Fine.P11Fine5 → Fine.P11Fine5 → Set
sameAdjacencyEntry left right source target =
  Positive.positiveOperator left (indicator target) source
  ≡ Positive.positiveOperator right (indicator target) source

