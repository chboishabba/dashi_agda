constant : Nat → BishopComplex
constant n = C.complex (R._⋆ (+ n / 1)) R.0ℝ

evalC : BishopComplex → List BishopComplex → BishopComplex
evalC q [] = A.zeroC
evalC q (a ∷ as) = a +C (q *C evalC q as)

evalR : R.ℝ → List BishopComplex → BishopComplex
evalR n [] = A.zeroC
evalR n (a ∷ as) = a +C scaleC n (evalR n as)

scaleBothCong : ∀ {n m : R.ℝ} {a b} → R._≃_ n m → a ≈C b →
  scaleC n a ≈C scaleC m b
scaleBothCong {a = C.complex _ _} {b = C.complex _ _} h (a , b) =
  P.*-cong h a , P.*-cong h b

evalRCong : ∀ {n m : R.ℝ} → R._≃_ n m → (as : List BishopComplex) →
  evalR n as ≈C evalR m as
evalRCong h [] = C.≈C-refl _
evalRCong h (a ∷ as) = A.addCCongruent (C.≈C-refl a)
  (scaleBothCong h (evalRCong h as))

