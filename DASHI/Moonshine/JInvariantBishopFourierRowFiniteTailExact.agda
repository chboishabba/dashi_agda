-- Generic exact finite telescope. The recurrence is supplied by the
-- two literal all-real polynomial proofs above, not an analytic axiom.
term : Nat → BishopComplex → Nat → BishopComplex
term k q n = scaleC (R.pow (N.natReal (suc n)) k) (powC q (suc n))

partial : Nat → BishopComplex → Nat → BishopComplex
partial k q = Partial.finiteComplexPartial (term k q)

pullDifference : ∀ z q a b →
  ((z *C a) -C ((q *C z) *C b)) ≈C (z *C (a -C (q *C b)))
pullDifference (C.complex x y) (C.complex u v) (C.complex a b) (C.complex c d) =
  (let open P.ℝ-Solver in solve 8
    (λ x y u v a b c d →
      (x ⊗ a ⊖ y ⊗ b) ⊖
      ((u ⊗ x ⊖ v ⊗ y) ⊗ c ⊖ (u ⊗ y ⊕ v ⊗ x) ⊗ d)
      ⊜ x ⊗ (a ⊖ (u ⊗ c ⊖ v ⊗ d)) ⊖
        y ⊗ (b ⊖ (u ⊗ d ⊕ v ⊗ c))) P.≃-refl x y u v a b c d)
  ,
  (let open P.ℝ-Solver in solve 8
    (λ x y u v a b c d →
      (x ⊗ b ⊕ y ⊗ a) ⊖
      ((u ⊗ x ⊖ v ⊗ y) ⊗ d ⊕ (u ⊗ y ⊕ v ⊗ x) ⊗ c)
      ⊜ x ⊗ (b ⊖ (u ⊗ d ⊕ v ⊗ c)) ⊕
        y ⊗ (a ⊖ (u ⊗ c ⊖ v ⊗ d))) P.≃-refl x y u v a b c d)

moveScale : ∀ s z d → (z *C scaleC s d) ≈C (d *C scaleC s z)
moveScale s (C.complex x y) (C.complex u v) =
  (let open P.ℝ-Solver in solve 5
    (λ s x y u v →
      x ⊗ (s ⊗ u) ⊖ y ⊗ (s ⊗ v) ⊜ u ⊗ (s ⊗ x) ⊖ v ⊗ (s ⊗ y))
      P.≃-refl s x y u v)
  ,
  (let open P.ℝ-Solver in solve 5
    (λ s x y u v →
      x ⊗ (s ⊗ v) ⊕ y ⊗ (s ⊗ u) ⊜ u ⊗ (s ⊗ y) ⊕ v ⊗ (s ⊗ x))
      P.≃-refl s x y u v)

differenceSelf : ∀ z → (z -C z) ≈C A.zeroC
differenceSelf (C.complex x y) = P.+-inverseʳ x , P.+-inverseʳ y

telescope : ∀ a b c → ((a -C b) +C (b -C c)) ≈C (a -C c)
telescope (C.complex a b) (C.complex c d) (C.complex e f) =
  (let open P.ℝ-Solver in solve 3
    (λ a c e → (a ⊖ c) ⊕ (c ⊖ e) ⊜ a ⊖ e) P.≃-refl a c e)
  ,
  (let open P.ℝ-Solver in solve 3
    (λ b d f → (b ⊖ d) ⊕ (d ⊖ f) ⊜ b ⊖ f) P.≃-refl b d f)

module Finite (q : BishopComplex) (k : Nat) (coeffs : List BishopComplex)
  (recurrence : ∀ n →
    (evalR n coeffs -C (q *C evalR (R._+_ n R.1ℝ) coeffs)) ≈C
    scaleC (R.pow n k) (powC (gapMinus q) (suc k))) where

  den = powC (gapMinus q) (suc k)

  tail : Nat → BishopComplex
  tail n = powC q (suc n) *C evalR (N.natReal (suc n)) coeffs

  nextRead : ∀ n → evalR (N.natReal (suc (suc n))) coeffs ≈C
    evalR (R._+_ (N.natReal (suc n)) R.1ℝ) coeffs
  nextRead n = evalRCong (N.natRealSuccessor (suc n)) coeffs

  tailStep : ∀ n → (tail n -C tail (suc n)) ≈C (den *C term k q n)
  tailStep n =
    let z = powC q (suc n)
        a = evalR (N.natReal (suc n)) coeffs
        b = evalR (R._+_ (N.natReal (suc n)) R.1ℝ) coeffs
    in complexTrans
      (A.subCCongruent (C.≈C-refl _)
        (A.mulCCongruent (C.≈C-refl _) (nextRead n)))
      (complexTrans (pullDifference z q a b)
        (complexTrans (A.mulCCongruent (C.≈C-refl z) (recurrence (N.natReal (suc n))))
          (moveScale (R.pow (N.natReal (suc n)) k) z den)))

  finiteRead : ∀ n → (den *C partial k q n) ≈C (tail zero -C tail n)
  finiteRead zero = complexTrans (L.complexMultiplyRightZero den)
    (complexSym (differenceSelf (tail zero)))
  finiteRead (suc n) =
    complexTrans (L.complexMultiplyDistributesLeft den (partial k q n) (term k q n))
      (complexTrans (A.addCCongruent (finiteRead n) (complexSym (tailStep n)))
        (telescope (tail zero) (tail n) (tail (suc n))))

module Weight4 (q : BishopComplex) = Finite q 3 (coeff3 q) (λ n → recurrence3 n q)
module Weight6 (q : BishopComplex) = Finite q 5 (coeff5 q) (λ n → recurrence5 n q)
