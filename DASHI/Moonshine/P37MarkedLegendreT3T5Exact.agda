baseT5 P37.q7 (suc (suc (suc (suc zero)))) = P37.lambda37 P37.q6 P37.root0
baseT5 P37.q7 (suc (suc (suc (suc (suc zero))))) = P37.lambda37 P37.q8 P37.root0
