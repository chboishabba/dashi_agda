baseT5 P37.q3 (suc (suc zero)) = P37.lambda37 P37.q5 P37.root0
baseT5 P37.q3 (suc (suc (suc zero))) = P37.lambda37 P37.q6 P37.root1
baseT5 P37.q3 (suc (suc (suc (suc zero)))) = P37.lambda37 P37.q7 P37.root1
baseT5 P37.q3 (suc (suc (suc (suc (suc zero))))) = P37.lambda37 P37.q7 P37.root1
baseT5 P37.q4 zero = P37.lambda37 P37.q0 P37.root1
baseT5 P37.q4 (suc zero) = P37.lambda37 P37.q0 P37.root1
