baseT5 P37.q4 (suc (suc (suc (suc (suc zero))))) = P37.lambda37 P37.q6 P37.root0
baseT5 P37.q5 zero = P37.lambda37 P37.q0 P37.root0
baseT5 P37.q5 (suc zero) = P37.lambda37 P37.q1 P37.root0
baseT5 P37.q5 (suc (suc zero)) = P37.lambda37 P37.q2 P37.root0
baseT5 P37.q5 (suc (suc (suc zero))) = P37.lambda37 P37.q2 P37.root0
baseT5 P37.q5 (suc (suc (suc (suc zero)))) = P37.lambda37 P37.q3 P37.root0
baseT5 P37.q5 (suc (suc (suc (suc (suc zero))))) = P37.lambda37 P37.q8 P37.root0
