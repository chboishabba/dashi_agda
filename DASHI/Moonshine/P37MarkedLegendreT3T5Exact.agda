baseT5 P37.q8 (suc (suc (suc (suc (suc zero))))) = P37.lambda37 P37.q7 P37.root0

markedT5Neighbour :
  P37.P37SupersingularLambda → Fin 6 → P37.P37SupersingularLambda
markedT5Neighbour (P37.lambda37 q P37.root0) edge = baseT5 q edge
markedT5Neighbour (P37.lambda37 q P37.root1) edge =
  P37.p37MarkedFrobenius (baseT5 q edge)

MarkedT5 : Positive.PositiveFiniteNeighbourSystem P37.P37SupersingularLambda
MarkedT5 = record
  { Positive.arity = 6
  ; Positive.neighbour = markedT5Neighbour
  }

markedT5FrobeniusEquivariant :
  (source : P37.P37SupersingularLambda) → (edge : Fin 6) →
  markedT5Neighbour (P37.p37MarkedFrobenius source) edge
  ≡ P37.p37MarkedFrobenius (markedT5Neighbour source edge)
markedT5FrobeniusEquivariant (P37.lambda37 q P37.root0) edge = refl
markedT5FrobeniusEquivariant (P37.lambda37 q P37.root1) edge =
  sym (P37.p37MarkedFrobeniusInvolution (baseT5 q edge))

------------------------------------------------------------------------
-- Multiplicity is visible in the finite geometry, not erased to a set relation.
------------------------------------------------------------------------

t3DoubleRootWitness :
  markedT3Neighbour (P37.lambda37 P37.q1 P37.root0) zero
  ≡ markedT3Neighbour (P37.lambda37 P37.q1 P37.root0) (suc zero)
t3DoubleRootWitness = refl

t5DoubleRootWitness :
  markedT5Neighbour (P37.lambda37 P37.q0 P37.root0) (suc zero)
  ≡ markedT5Neighbour
      (P37.lambda37 P37.q0 P37.root0)
      (suc (suc zero))
t5DoubleRootWitness = refl

------------------------------------------------------------------------
-- Exact coarse projection by actual edge counting.
------------------------------------------------------------------------

isCoarse0 : P37.P37SupersingularLambda → Nat
isCoarse0 x with coarseClass x
... | Controls.p37c0 = 1
... | Controls.p37c1 = 0
... | Controls.p37c2 = 0

isCoarse1 : P37.P37SupersingularLambda → Nat
isCoarse1 x with coarseClass x
... | Controls.p37c0 = 0
... | Controls.p37c1 = 1
... | Controls.p37c2 = 0

isCoarse2 : P37.P37SupersingularLambda → Nat
isCoarse2 x with coarseClass x
... | Controls.p37c0 = 0
... | Controls.p37c1 = 0
... | Controls.p37c2 = 1

record CoarseRow : Set where
  constructor coarseRow
  field
    to0 to1 to2 : Nat

open CoarseRow public

markedT3CoarseRow : P37.P37SupersingularLambda → CoarseRow
markedT3CoarseRow x = coarseRow
  (Positive.positiveOperator MarkedT3 isCoarse0 x)
  (Positive.positiveOperator MarkedT3 isCoarse1 x)
  (Positive.positiveOperator MarkedT3 isCoarse2 x)

markedT5CoarseRow : P37.P37SupersingularLambda → CoarseRow
markedT5CoarseRow x = coarseRow
  (Positive.positiveOperator MarkedT5 isCoarse0 x)
  (Positive.positiveOperator MarkedT5 isCoarse1 x)
  (Positive.positiveOperator MarkedT5 isCoarse2 x)

expectedT3Row : Controls.P37BrandtClass → CoarseRow
expectedT3Row Controls.p37c0 = coarseRow 2 1 1
expectedT3Row Controls.p37c1 = coarseRow 1 0 3
expectedT3Row Controls.p37c2 = coarseRow 1 3 0

expectedT5Row : Controls.P37BrandtClass → CoarseRow
expectedT5Row Controls.p37c0 = coarseRow 2 2 2
expectedT5Row Controls.p37c1 = coarseRow 2 1 3
expectedT5Row Controls.p37c2 = coarseRow 2 3 1

markedT3ProjectsToCoarse :
  (x : P37.P37SupersingularLambda) →
  markedT3CoarseRow x ≡ expectedT3Row (coarseClass x)
markedT3ProjectsToCoarse (P37.lambda37 P37.q0 P37.root0) = refl
