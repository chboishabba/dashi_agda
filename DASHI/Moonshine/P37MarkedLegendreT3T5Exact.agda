      legendreT3MultiplicityGeometryConstructed ≡ true

    legendreT5MultiplicityGeometryConstructed : Bool
    legendreT5MultiplicityGeometryConstructedIsTrue :
      legendreT5MultiplicityGeometryConstructed ≡ true

    frobeniusEquivarianceStructural : Bool
