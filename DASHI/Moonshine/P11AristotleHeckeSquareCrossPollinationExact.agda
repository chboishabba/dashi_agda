module DASHI.Moonshine.P11AristotleHeckeSquareCrossPollinationExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES / CONTEXT
--
-- Reinier Bröker, Kristin Lauter and Andrew V. Sutherland,
-- "Modular polynomials via isogeny volcanoes",
-- Mathematics of Computation 81 (2012), 1201--1231.
-- DOI: 10.1090/S0025-5718-2011-02508-1.
--
-- Toshitsune Miyake,
-- "Modular Forms", Springer Monographs in Mathematics, Springer, 2006.
-- DOI: 10.1007/3-540-29593-3.
--
-- Aristotle (Harmonic), editor of the user-supplied Lean source used by
-- DASHI.Moonshine.AristotleHeckeRecurrenceCoreExact.
--
-- DASHI CONTRIBUTION
--
-- Cross-pollinate the first source-faithful classical arithmetic
-- correspondence with Aristotle's prime-power Hecke recurrence.
--
-- At p=11 and ell=2 the already-constructed modular-polynomial operator is
--
--       A = [[0,3],[2,1]],
--
-- with eigenvalues 3 and -2.  For weight k=2 the normalized Hecke recurrence
-- has scale ell^(k-1)=2, so an eigenvalue lambda at T_2 forces
--
--       a(4) = lambda^2 - 2.
--
-- Hence the two modes force T_4 eigenvalues 7 and 2.  On the actual two-state
-- arithmetic carrier we define the operator forced by the same relation,
--
--       T4_forced := T2^2 - 2 I,
--
-- and calculate its matrix exactly as
--
--       [[4,3],[2,5]].
--
-- Its eigenvalues on the already-constructed p=11 modes are exactly 7 and 2,
-- matching the independently formalized Aristotle recurrence kernel.
--
-- IMPORTANT BOUNDARY:
-- this constructs the T_4 operator FORCED BY the weight-2 Hecke relation from
-- the existing T_2 correspondence.  It does not independently construct the
-- ell=4 modular-polynomial/isogeny correspondence.  Equality with that future
-- geometric producer remains a concrete comparison theorem.
------------------------------------------------------------------------

open import DASHI.Core.Prelude
open import Data.Integer using (ℤ; +_; -[1+_])
  renaming (_+_ to _+ℤ_; _*_ to _*ℤ_; _-_ to _-ℤ_)

import DASHI.Moonshine.AristotleHeckeRecurrenceCoreExact as Aristotle
import DASHI.Moonshine.P11ClassicalTwoIsogenyCorrespondenceExact as P11
import DASHI.Moonshine.P11ClassicalTwoIsogenySpectralExact as Spectral

------------------------------------------------------------------------
-- Canonical sequence generated by the Aristotle recurrence itself.
------------------------------------------------------------------------

generatedPrimePowerLane :
  (A : Aristotle.RecurrenceCoefficientAlgebra) →
  Aristotle.Carrier A →
  Aristotle.Carrier A →
  Nat → Aristotle.Carrier A
generatedPrimePowerLane A scale eigen 0 = Aristotle.one A
generatedPrimePowerLane A scale eigen 1 = eigen
generatedPrimePowerLane A scale eigen (suc (suc n)) =
  Aristotle.sub A
    (Aristotle.mul A eigen (generatedPrimePowerLane A scale eigen (suc n)))
    (Aristotle.mul A scale (generatedPrimePowerLane A scale eigen n))

generatedPrimePowerSystem :
  (A : Aristotle.RecurrenceCoefficientAlgebra) →
  (scale eigen : Aristotle.Carrier A) →
  Aristotle.PrimePowerHeckeSystem A scale
    (generatedPrimePowerLane A scale eigen)
generatedPrimePowerSystem A scale eigen =
  record
    { normalised = refl
    ; primePowerRecurrence = λ n → refl
    }

integerRecurrenceAlgebra : Aristotle.RecurrenceCoefficientAlgebra
integerRecurrenceAlgebra =
  record
    { Carrier = ℤ
    ; one = + 1
    ; mul = _*ℤ_
    ; sub = _-ℤ_
    }

weightTwoScaleAtEll2 : ℤ
weightTwoScaleAtEll2 = + 2

constantModeLane : Nat → ℤ
constantModeLane =
  generatedPrimePowerLane integerRecurrenceAlgebra
    weightTwoScaleAtEll2 (+ 3)

nonconstantModeLane : Nat → ℤ
nonconstantModeLane =
  generatedPrimePowerLane integerRecurrenceAlgebra
    weightTwoScaleAtEll2 (-[1+ 1 ])

constantModeLaneSystem :
  Aristotle.PrimePowerHeckeSystem integerRecurrenceAlgebra
    weightTwoScaleAtEll2 constantModeLane
constantModeLaneSystem =
  generatedPrimePowerSystem integerRecurrenceAlgebra
    weightTwoScaleAtEll2 (+ 3)

nonconstantModeLaneSystem :
  Aristotle.PrimePowerHeckeSystem integerRecurrenceAlgebra
    weightTwoScaleAtEll2 nonconstantModeLane
nonconstantModeLaneSystem =
  generatedPrimePowerSystem integerRecurrenceAlgebra
    weightTwoScaleAtEll2 (-[1+ 1 ])

------------------------------------------------------------------------
-- Aristotle recurrence forces the two square eigenvalues.
------------------------------------------------------------------------

constantPrimeSquareForcedIsSeven : constantModeLane 2 ≡ + 7
constantPrimeSquareForcedIsSeven = refl

nonconstantPrimeSquareForcedIsTwo : nonconstantModeLane 2 ≡ + 2
nonconstantPrimeSquareForcedIsTwo = refl

constantPrimeSquareIsAristotleFormula :
  constantModeLane 2
  ≡ Aristotle.sub integerRecurrenceAlgebra
      (Aristotle.mul integerRecurrenceAlgebra
        (constantModeLane 1) (constantModeLane 1))
      (Aristotle.mul integerRecurrenceAlgebra
        weightTwoScaleAtEll2 (constantModeLane 0))
constantPrimeSquareIsAristotleFormula =
  Aristotle.primeSquareFormula integerRecurrenceAlgebra
    weightTwoScaleAtEll2 constantModeLane constantModeLaneSystem

nonconstantPrimeSquareIsAristotleFormula :
  nonconstantModeLane 2
  ≡ Aristotle.sub integerRecurrenceAlgebra
      (Aristotle.mul integerRecurrenceAlgebra
        (nonconstantModeLane 1) (nonconstantModeLane 1))
      (Aristotle.mul integerRecurrenceAlgebra
        weightTwoScaleAtEll2 (nonconstantModeLane 0))
nonconstantPrimeSquareIsAristotleFormula =
  Aristotle.primeSquareFormula integerRecurrenceAlgebra
    weightTwoScaleAtEll2 nonconstantModeLane nonconstantModeLaneSystem

------------------------------------------------------------------------
-- T4 forced directly from the actual p=11 T2 matrix.
------------------------------------------------------------------------

t2SquaredAction : P11.IntPair → P11.IntPair
t2SquaredAction vector = P11.matrixAction (P11.matrixAction vector)

subtractPair : P11.IntPair → P11.IntPair → P11.IntPair
subtractPair u v =
  P11.intPair
    (P11.left u -ℤ P11.left v)
    (P11.right u -ℤ P11.right v)

addPair : P11.IntPair → P11.IntPair → P11.IntPair
addPair u v =
  P11.intPair
    (P11.left u +ℤ P11.left v)
    (P11.right u +ℤ P11.right v)

forcedT4Action : P11.IntPair → P11.IntPair
forcedT4Action vector =
  subtractPair (t2SquaredAction vector) (P11.scalePair (+ 2) vector)

------------------------------------------------------------------------
-- Matrix of T4_forced on the coordinate basis: [[4,3],[2,5]].
------------------------------------------------------------------------

forcedT4OnJ0Basis :
  forcedT4Action Spectral.basisJ0
  ≡ P11.intPair (+ 4) (+ 2)
forcedT4OnJ0Basis = refl

forcedT4OnJ1Basis :
  forcedT4Action Spectral.basisJ1
  ≡ P11.intPair (+ 3) (+ 5)
forcedT4OnJ1Basis = refl

-- The Hecke-square equation is checked on both coordinate basis vectors.
-- This avoids claiming a general linearity theorem that has not been packaged
-- for IntPair in the repository.

weightTwoHeckeSquareOnJ0Basis :
  t2SquaredAction Spectral.basisJ0
  ≡ addPair
      (forcedT4Action Spectral.basisJ0)
      (P11.scalePair (+ 2) Spectral.basisJ0)
weightTwoHeckeSquareOnJ0Basis = refl

weightTwoHeckeSquareOnJ1Basis :
  t2SquaredAction Spectral.basisJ1
  ≡ addPair
      (forcedT4Action Spectral.basisJ1)
      (P11.scalePair (+ 2) Spectral.basisJ1)
weightTwoHeckeSquareOnJ1Basis = refl

------------------------------------------------------------------------
-- Spectral agreement: correspondence square and Aristotle recurrence produce
-- exactly the same values 7 and 2.
------------------------------------------------------------------------

forcedT4ConstantEigenmode :
  forcedT4Action P11.constantEigenvector
  ≡ P11.scalePair (+ 7) P11.constantEigenvector
forcedT4ConstantEigenmode = refl

forcedT4NonconstantEigenmode :
  forcedT4Action P11.nonconstantEigenvector
  ≡ P11.scalePair (+ 2) P11.nonconstantEigenvector
forcedT4NonconstantEigenmode = refl

constantCorrespondenceSquareMatchesAristotle :
  forcedT4Action P11.constantEigenvector
  ≡ P11.scalePair (constantModeLane 2) P11.constantEigenvector
constantCorrespondenceSquareMatchesAristotle = refl

nonconstantCorrespondenceSquareMatchesAristotle :
  forcedT4Action P11.nonconstantEigenvector
  ≡ P11.scalePair (nonconstantModeLane 2) P11.nonconstantEigenvector
nonconstantCorrespondenceSquareMatchesAristotle = refl

------------------------------------------------------------------------
-- Authority boundary.
------------------------------------------------------------------------

record P11AristotleHeckeSquareBoundary : Set where
  field
    actualP11T2CorrespondenceConsumed : Bool
    actualP11T2CorrespondenceConsumedIsTrue :
      actualP11T2CorrespondenceConsumed ≡ true

    weightTwoT4ForcedOperatorConstructed : Bool
    weightTwoT4ForcedOperatorConstructedIsTrue :
      weightTwoT4ForcedOperatorConstructed ≡ true

    forcedT4MatrixComputed : Bool
    forcedT4MatrixComputedIsTrue : forcedT4MatrixComputed ≡ true

    arithmeticModesMatchAristotlePrimeSquareRecurrence : Bool
    arithmeticModesMatchAristotlePrimeSquareRecurrenceIsTrue :
      arithmeticModesMatchAristotlePrimeSquareRecurrence ≡ true

    independentEll4GeometricCorrespondenceConstructedHere : Bool
    independentEll4GeometricCorrespondenceConstructedHereIsFalse :
      independentEll4GeometricCorrespondenceConstructedHere ≡ false

canonicalP11AristotleHeckeSquareBoundary : P11AristotleHeckeSquareBoundary
canonicalP11AristotleHeckeSquareBoundary =
  record
    { actualP11T2CorrespondenceConsumed = true
    ; actualP11T2CorrespondenceConsumedIsTrue = refl
    ; weightTwoT4ForcedOperatorConstructed = true
    ; weightTwoT4ForcedOperatorConstructedIsTrue = refl
    ; forcedT4MatrixComputed = true
    ; forcedT4MatrixComputedIsTrue = refl
    ; arithmeticModesMatchAristotlePrimeSquareRecurrence = true
    ; arithmeticModesMatchAristotlePrimeSquareRecurrenceIsTrue = refl
    ; independentEll4GeometricCorrespondenceConstructedHere = false
    ; independentEll4GeometricCorrespondenceConstructedHereIsFalse = refl
    }
