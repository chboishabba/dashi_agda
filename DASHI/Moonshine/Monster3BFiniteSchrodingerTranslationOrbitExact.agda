module DASHI.Moonshine.Monster3BFiniteSchrodingerTranslationOrbitExact where

------------------------------------------------------------------------
-- FULL DELTA ORBIT FROM THE SIX UNIT TRANSLATION GENERATORS
--
-- No full-translation closure is added to the invariant-subspace interface.
-- For one coordinate, trit shift 0/+1/-1 is implemented by I/T/T^2.
-- The six coordinate words are then composed.  This is exactly the finite
-- F3^6 translation group generated by the six existing translation actions.
------------------------------------------------------------------------

open import Agda.Builtin.Bool using (Bool; true; false)
open import Agda.Builtin.Equality using (_≡_; refl)
open import DASHI.Algebra.Trit using (Trit; neg; zer; pos)

import DASHI.Moonshine.C3CyclotomicAmplitudeAlgebraExact as C3
import DASHI.Moonshine.Monster3BFiniteHeisenbergGeneratorsExact as H
import DASHI.Moonshine.Monster3BFiniteSchrodingerFunctionModuleExact as V
import DASHI.Moonshine.Monster3BFiniteSchrodingerDeltaExtractionExact as Delta

------------------------------------------------------------------------
-- 1. Generator words for one trit shift.
------------------------------------------------------------------------

translateWord : Trit → H.Axis6 → V.SchrodingerFunction → V.SchrodingerFunction
translateWord zer axis f = f
translateWord pos axis f = V.translationAction axis f
translateWord neg axis f = V.translationAction axis (V.translationAction axis f)

translateWordPreservesInvariantSubspace :
  ∀ {Member}
    (inv : V.HeisenbergInvariantSubspace Member) →
    (shift : Trit) (axis : H.Axis6) (f : V.SchrodingerFunction) →
    Member f → Member (translateWord shift axis f)
translateWordPreservesInvariantSubspace inv zer axis f member = member
translateWordPreservesInvariantSubspace inv pos axis f member =
  V.closedUnderTranslation inv axis f member
translateWordPreservesInvariantSubspace inv neg axis f member =
  V.closedUnderTranslation inv axis (V.translationAction axis f)
    (V.closedUnderTranslation inv axis f member)

------------------------------------------------------------------------
-- 2. Six-coordinate generated translation action.
------------------------------------------------------------------------

generatedTranslation : H.X6 → V.SchrodingerFunction → V.SchrodingerFunction
generatedTranslation (H.x6 s0 s1 s2 s3 s4 s5) f =
  translateWord s5 H.axis5
    (translateWord s4 H.axis4
      (translateWord s3 H.axis3
        (translateWord s2 H.axis2
          (translateWord s1 H.axis1
            (translateWord s0 H.axis0 f)))))

generatedTranslationPreservesInvariantSubspace :
  ∀ {Member}
    (inv : V.HeisenbergInvariantSubspace Member) →
    (shift : H.X6) (f : V.SchrodingerFunction) →
    Member f → Member (generatedTranslation shift f)
generatedTranslationPreservesInvariantSubspace inv
    (H.x6 s0 s1 s2 s3 s4 s5) f member =
  translateWordPreservesInvariantSubspace inv s5 H.axis5 _
    (translateWordPreservesInvariantSubspace inv s4 H.axis4 _
      (translateWordPreservesInvariantSubspace inv s3 H.axis3 _
        (translateWordPreservesInvariantSubspace inv s2 H.axis2 _
          (translateWordPreservesInvariantSubspace inv s1 H.axis1 _
            (translateWordPreservesInvariantSubspace inv s0 H.axis0 f member)))))

------------------------------------------------------------------------
-- 3. Point transport corresponding to the generated pullback action.
--
-- A positive generator shifts delta support forward by +1; applying it twice
-- shifts support by -1.  The point map below records the same six words.
------------------------------------------------------------------------

shiftTrit : Trit → Trit → Trit
shiftTrit zer value = value
shiftTrit pos value = H.increment value
shiftTrit neg value = H.increment (H.increment value)

shiftPoint : H.X6 → H.X6 → H.X6
shiftPoint (H.x6 s0 s1 s2 s3 s4 s5) (H.x6 x0 x1 x2 x3 x4 x5) =
  H.x6
    (shiftTrit s0 x0)
    (shiftTrit s1 x1)
    (shiftTrit s2 x2)
    (shiftTrit s3 x3)
    (shiftTrit s4 x4)
    (shiftTrit s5 x5)

------------------------------------------------------------------------
-- 4. Every target has an explicit shift from any source.
------------------------------------------------------------------------

subtractTrit : Trit → Trit → Trit
subtractTrit target source = H._+3_ target (H.negate3 source)

shiftTritSubtractRestores :
  (target source : Trit) → shiftTrit (subtractTrit target source) source ≡ target
shiftTritSubtractRestores neg neg = refl
shiftTritSubtractRestores neg zer = refl
shiftTritSubtractRestores neg pos = refl
shiftTritSubtractRestores zer neg = refl
shiftTritSubtractRestores zer zer = refl
shiftTritSubtractRestores zer pos = refl
shiftTritSubtractRestores pos neg = refl
shiftTritSubtractRestores pos zer = refl
shiftTritSubtractRestores pos pos = refl

shiftFromTo : H.X6 → H.X6 → H.X6
shiftFromTo source target =
  H.x6
    (subtractTrit (H.x0 target) (H.x0 source))
    (subtractTrit (H.x1 target) (H.x1 source))
    (subtractTrit (H.x2 target) (H.x2 source))
    (subtractTrit (H.x3 target) (H.x3 source))
    (subtractTrit (H.x4 target) (H.x4 source))
    (subtractTrit (H.x5 target) (H.x5 source))

shiftFromToRestores :
  (source target : H.X6) → shiftPoint (shiftFromTo source target) source ≡ target
shiftFromToRestores
  (H.x6 s0 s1 s2 s3 s4 s5)
  (H.x6 t0 t1 t2 t3 t4 t5)
  rewrite shiftTritSubtractRestores t0 s0
        | shiftTritSubtractRestores t1 s1
        | shiftTritSubtractRestores t2 s2
        | shiftTritSubtractRestores t3 s3
        | shiftTritSubtractRestores t4 s4
        | shiftTritSubtractRestores t5 s5 = refl

------------------------------------------------------------------------
-- 5. Delta orbit receipt.
--
-- The pointwise transport equality is kept as an explicit input to this thin
-- receipt.  It is a finite generator-word calculation, not a new representation
-- assumption.  Keeping it visible prevents transitivity from being confused
-- with arbitrary permutation closure.
------------------------------------------------------------------------

record GeneratedDeltaTransportReceipt
    (source target : H.X6) : Set where
  constructor generated-delta-transport-receipt
  field
    shift : H.X6
    shiftCarriesSourceToTarget : shiftPoint shift source ≡ target
    generatedActionCarriesDeltaPointwise :
      V.PointwiseEqual
        (generatedTranslation shift (Delta.comparisonDelta source))
        (Delta.comparisonDelta target)
open GeneratedDeltaTransportReceipt public

transportedDeltaMember :
  ∀ {Member}
    (inv : V.HeisenbergInvariantSubspace Member) →
    (source target : H.X6) →
    Member (Delta.comparisonDelta source) →
    GeneratedDeltaTransportReceipt source target →
    Member (Delta.comparisonDelta target)
transportedDeltaMember inv source target sourceMember receipt =
  V.closedUnderPointwiseEquality inv
    (generatedTranslation (shift receipt) (Delta.comparisonDelta source))
    (Delta.comparisonDelta target)
    (generatedTranslationPreservesInvariantSubspace inv
      (shift receipt) (Delta.comparisonDelta source) sourceMember)
    (generatedActionCarriesDeltaPointwise receipt)

canonicalShiftCarriesSourceToTarget :
  (source target : H.X6) →
  shiftPoint (shiftFromTo source target) source ≡ target
canonicalShiftCarriesSourceToTarget = shiftFromToRestores

record TranslationOrbitBoundary : Set where
  constructor translation-orbit-boundary
  field
    fullTranslationGeneratedFromSixUnitActions : Bool
    everyTargetHasExplicitShift : Bool
    arbitraryFullTranslationClosureAssumed : Bool
    deltaPointwiseTransportCalculationClosedHere : Bool
    deltaOrbitMembershipClosedHere : Bool
open TranslationOrbitBoundary public

canonicalTranslationOrbitBoundary : TranslationOrbitBoundary
canonicalTranslationOrbitBoundary =
  translation-orbit-boundary true true false false false
