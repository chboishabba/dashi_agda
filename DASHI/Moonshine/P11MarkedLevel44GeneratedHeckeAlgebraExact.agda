module DASHI.Moonshine.P11MarkedLevel44GeneratedHeckeAlgebraExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES / CONTEXT
--
-- Fred Diamond and Jerry Shurman,
-- "A First Course in Modular Forms", GTM 228, Springer, 2005.
-- DOI: 10.1007/978-0-387-27226-9.
--
-- Jean-Pierre Serre,
-- "Linear Representations of Finite Groups", Springer, 1977.
-- DOI: 10.1007/978-1-4684-9458-7.
--
-- DASHI CONTRIBUTION
--
-- P11MarkedLevel44PermutationIntertwinerExact proves on the WHOLE marked
-- three-copy oldspace that
--
--   T3 = -1,   T5 = +1,   T7 = -2
--
-- after transport to the common Old3 coordinate module.  The generic
-- auxiliary-level theorem added later closes compositional Hecke WORDS on a
-- product carrier but deliberately does not claim additive Hecke algebra.
--
-- Here the p=11 marked oldspace DOES have the required Z-module structure, so
-- we close that remaining finite algebraic loophole honestly.  We build the
-- free Z-linear/compositional expression algebra generated by I,T3,T5,T7 and
-- prove every expression acts on the entire oldspace as ONE scalar.
--
-- Consequently every such additive/compositional Hecke expression commutes
-- with deck S3 and is blind to the old-copy / deck-standard coordinate.
-- This is stronger than checking more primes and stronger than checking only
-- words.  It still does NOT manufacture the missing analytic
-- Eichler/Jacquet--Langlands same-object identification.
------------------------------------------------------------------------

open import DASHI.Core.Prelude
open import Agda.Builtin.List using ([]; _∷_)
import Data.Integer.Tactic.RingSolver as ℤRing
open import Data.Integer using (ℤ; +_; -[1+_])
  renaming (_+_ to _+ℤ_; _*_ to _*ℤ_)
open import Relation.Binary.PropositionalEquality using (cong; sym; trans)

import DASHI.Moonshine.P11MarkedLevel44PermutationIntertwinerExact as Old
import DASHI.Moonshine.P11MarkedX2S3HeckeDecompositionExact as S3
import DASHI.Moonshine.P11MarkedX2T7HeckeCollisionExact as T7

------------------------------------------------------------------------
-- Free expression algebra generated by the three source-native Hecke maps.
------------------------------------------------------------------------

data HeckeExpr : Set where
  identity : HeckeExpr
  t3 t5 t7 : HeckeExpr
  _plus_ : HeckeExpr → HeckeExpr → HeckeExpr
  _after_ : HeckeExpr → HeckeExpr → HeckeExpr
  scale : ℤ → HeckeExpr → HeckeExpr

infixl 6 _plus_
infixr 7 _after_

markedEval : HeckeExpr → S3.Int5 → S3.Int5
markedEval identity x = x
markedEval t3 x = S3.markedT3Action x
markedEval t5 x = S3.markedT5Action x
markedEval t7 x = T7.markedT7Action x
markedEval (left plus right) x =
  S3.add5 (markedEval left x) (markedEval right x)
markedEval (left after right) x =
  markedEval left (markedEval right x)
markedEval (scale k expr) x = S3.scale5 k (markedEval expr x)

scalarEval : HeckeExpr → ℤ
scalarEval identity = + 1
scalarEval t3 = -[1+ 0 ]
scalarEval t5 = + 1
scalarEval t7 = -[1+ 1 ]
scalarEval (left plus right) = scalarEval left +ℤ scalarEval right
scalarEval (left after right) = scalarEval left *ℤ scalarEval right
scalarEval (scale k expr) = k *ℤ scalarEval expr

------------------------------------------------------------------------
-- Small Old3 module laws needed by the structural induction.
------------------------------------------------------------------------

old3Ext :
  (u v : Old.Old3) →
  Old.x1 u ≡ Old.x1 v →
  Old.x2 u ≡ Old.x2 v →
  Old.x4 u ≡ Old.x4 v →
  u ≡ v
old3Ext (Old.old3 a b c) (Old.old3 d e f) refl refl refl = refl

scaleAddScalar :
  (a b : ℤ) (v : Old.Old3) →
  Old.addOld3 (Old.scaleOld3 a v) (Old.scaleOld3 b v)
  ≡ Old.scaleOld3 (a +ℤ b) v
scaleAddScalar a b (Old.old3 x y z) =
  old3Ext _ _
    (ℤRing.solve (a ∷ b ∷ x ∷ []))
    (ℤRing.solve (a ∷ b ∷ y ∷ []))
    (ℤRing.solve (a ∷ b ∷ z ∷ []))

scaleComposeScalar :
  (a b : ℤ) (v : Old.Old3) →
  Old.scaleOld3 a (Old.scaleOld3 b v)
  ≡ Old.scaleOld3 (a *ℤ b) v
scaleComposeScalar a b (Old.old3 x y z) =
  old3Ext _ _
    (ℤRing.solve (a ∷ b ∷ x ∷ []))
    (ℤRing.solve (a ∷ b ∷ y ∷ []))
    (ℤRing.solve (a ∷ b ∷ z ∷ []))

scaleOutsideScalar :
  (k a : ℤ) (v : Old.Old3) →
  Old.scaleOld3 k (Old.scaleOld3 a v)
  ≡ Old.scaleOld3 (k *ℤ a) v
scaleOutsideScalar = scaleComposeScalar

------------------------------------------------------------------------
-- Main theorem: the whole generated algebra is scalar on the oldspace.
------------------------------------------------------------------------

generatedHeckeExpressionActsScalarly :
  (expr : HeckeExpr) →
  (v : Old.Old3) →
  markedEval expr (Old.realizeOld3 v)
  ≡ Old.realizeOld3 (Old.scaleOld3 (scalarEval expr) v)
generatedHeckeExpressionActsScalarly identity v =
  sym (Old.realizeScalar (+ 1) v)
generatedHeckeExpressionActsScalarly t3 v = Old.realizeT3 v
generatedHeckeExpressionActsScalarly t5 v = Old.realizeT5 v
generatedHeckeExpressionActsScalarly t7 v = Old.realizeT7 v
generatedHeckeExpressionActsScalarly (left plus right) v =
  trans
    (cong₂ S3.add5
      (generatedHeckeExpressionActsScalarly left v)
      (generatedHeckeExpressionActsScalarly right v))
    (trans
      (sym
        (Old.realizeAdditive
          (Old.scaleOld3 (scalarEval left) v)
          (Old.scaleOld3 (scalarEval right) v)))
      (cong Old.realizeOld3
        (scaleAddScalar (scalarEval left) (scalarEval right) v)))
generatedHeckeExpressionActsScalarly (left after right) v =
  trans
    (cong (markedEval left)
      (generatedHeckeExpressionActsScalarly right v))
    (trans
      (generatedHeckeExpressionActsScalarly left
        (Old.scaleOld3 (scalarEval right) v))
      (cong Old.realizeOld3
        (scaleComposeScalar
          (scalarEval left) (scalarEval right) v)))
generatedHeckeExpressionActsScalarly (scale k expr) v =
  trans
    (cong (S3.scale5 k)
      (generatedHeckeExpressionActsScalarly expr v))
    (trans
      (sym
        (Old.realizeScalar k
          (Old.scaleOld3 (scalarEval expr) v)))
      (cong Old.realizeOld3
        (scaleOutsideScalar k (scalarEval expr) v)))

------------------------------------------------------------------------
-- Deck commutation follows because deck permutations commute with scalar
-- multiplication on Old3, and both routes are transported by the same Phi.
------------------------------------------------------------------------

oldRScale :
  (k : ℤ) (v : Old.Old3) →
  Old.oldR (Old.scaleOld3 k v) ≡ Old.scaleOld3 k (Old.oldR v)
oldRScale k (Old.old3 a b c) = refl

oldSScale :
  (k : ℤ) (v : Old.Old3) →
  Old.oldS (Old.scaleOld3 k v) ≡ Old.scaleOld3 k (Old.oldS v)
oldSScale k (Old.old3 a b c) = refl

markedExpressionCommutesWithDeckR :
  (expr : HeckeExpr) →
  (v : Old.Old3) →
  markedEval expr (Perm.deckR5 (Old.realizeOld3 v))
  ≡ Perm.deckR5 (markedEval expr (Old.realizeOld3 v))
markedExpressionCommutesWithDeckR expr v =
  trans
    (cong (markedEval expr) (sym (Old.realizeDeckR v)))
    (trans
      (generatedHeckeExpressionActsScalarly expr (Old.oldR v))
      (trans
        (cong Old.realizeOld3
          (sym (oldRScale (scalarEval expr) v)))
        (trans
          (Old.realizeDeckR (Old.scaleOld3 (scalarEval expr) v))
          (cong Perm.deckR5
            (sym (generatedHeckeExpressionActsScalarly expr v))))))

markedExpressionCommutesWithDeckS :
  (expr : HeckeExpr) →
  (v : Old.Old3) →
  markedEval expr (Perm.deckS5 (Old.realizeOld3 v))
  ≡ Perm.deckS5 (markedEval expr (Old.realizeOld3 v))
markedExpressionCommutesWithDeckS expr v =
  trans
    (cong (markedEval expr) (sym (Old.realizeDeckS v)))
    (trans
      (generatedHeckeExpressionActsScalarly expr (Old.oldS v))
      (trans
        (cong Old.realizeOld3
          (sym (oldSScale (scalarEval expr) v)))
        (trans
          (Old.realizeDeckS (Old.scaleOld3 (scalarEval expr) v))
          (cong Perm.deckS5
            (sym (generatedHeckeExpressionActsScalarly expr v))))))

------------------------------------------------------------------------
-- Boundary.
------------------------------------------------------------------------

record GeneratedHeckeAlgebraBoundary : Set where
  field
    additiveCompositionalClosureConstructed : Bool
    wholeMarkedOldspaceScalarActionProved : Bool
    generatedAlgebraCommutesWithDeckS3 : Bool
    moreT3T5T7AlgebraProbesCanRecoverCopyLabel : Bool
    analyticMarkedSameObjectIdentificationConstructedHere : Bool

canonicalGeneratedHeckeAlgebraBoundary : GeneratedHeckeAlgebraBoundary
canonicalGeneratedHeckeAlgebraBoundary = record
  { additiveCompositionalClosureConstructed = true
  ; wholeMarkedOldspaceScalarActionProved = true
  ; generatedAlgebraCommutesWithDeckS3 = true
  ; moreT3T5T7AlgebraProbesCanRecoverCopyLabel = false
  ; analyticMarkedSameObjectIdentificationConstructedHere = false
  }
