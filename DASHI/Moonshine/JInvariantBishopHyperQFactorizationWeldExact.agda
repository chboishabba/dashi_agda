δ : Series → Series
δ = U.D 1

dCong : ∀ {a b} → a ≈s b → δ a ≈s δ b
dCong h n = P.*-congˡ (h n)

scaleCong : (a : ℚᵘ) → ∀ {f g} → f ≈s g → scale (a ⋆) f ≈s scale (a ⋆) g
scaleCong a h n = P.*-congˡ (h n)

dAdd : (a b : Series) → δ (a ⊕s b) ≈s (δ a ⊕s δ b)
dAdd a b n = P.*-distribˡ-+ (R.pow (NR.natReal n) 1) (a n) (b n)

dSub : (a b : Series) → δ (a ⊖s b) ≈s (δ a ⊖s δ b)
dSub = T.dSub

dMul : (a b : Series) → δ (a ⊗s b) ≈s ((δ a ⊗s b) ⊕s (a ⊗s δ b))
dMul = U.eulerLeibniz

dScale : (a : ℚᵘ) (f : Series) → δ (scale (a ⋆) f) ≈s scale (a ⋆) (δ f)
dScale a f n = let open P.ℝ-Solver in
  solve 3 (λ d a f → d ⊗ (a ⊗ f) ⊜ a ⊗ (d ⊗ f)) P.≃-refl
    (R.pow (NR.natReal n) 1) (a ⋆) (f n)

dRepeat2 : (f : Series) → δ (δ f) ≈s U.D 2 f
dRepeat2 f n = let open P.ℝ-Solver in
  solve 2 (λ n f → (Κ (+ 1 / 1) ⊗ n) ⊗ ((Κ (+ 1 / 1) ⊗ n) ⊗ f) ⊜
    ((Κ (+ 1 / 1) ⊗ n) ⊗ n) ⊗ f) P.≃-refl (NR.natReal n) (f n)

dRepeat3 : (f : Series) → δ (δ (δ f)) ≈s U.D 3 f
dRepeat3 f = transS (dCong (dRepeat2 f)) (λ n → let open P.ℝ-Solver in
  solve 2 (λ n f → (Κ (+ 1 / 1) ⊗ n) ⊗ (((Κ (+ 1 / 1) ⊗ n) ⊗ n) ⊗ f) ⊜
    (((Κ (+ 1 / 1) ⊗ n) ⊗ n) ⊗ n) ⊗ f) P.≃-refl (NR.natReal n) (f n))

