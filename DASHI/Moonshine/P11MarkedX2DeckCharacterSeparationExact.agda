module DASHI.Moonshine.P11MarkedX2DeckCharacterSeparationExact where

------------------------------------------------------------------------
-- PRIMARY SOURCES / CONTEXT
--
-- Jean-Pierre Serre,
-- "Linear Representations of Finite Groups", Graduate Texts in Mathematics 42,
-- Springer, 1977.
-- DOI: 10.1007/978-1-4684-9458-7.
-- Restriction of S3 irreducibles to A3 ~= C3 and character decomposition.
--
-- Nicholas M. Katz and Barry Mazur,
-- "Arithmetic Moduli of Elliptic Curves", Annals of Mathematics Studies 108,
-- Princeton University Press, 1985.
-- DOI: 10.1515/9781400881710.
-- Full-level-2 deck action / moduli context.
--
-- John D. Dixon and Brian Mortimer,
-- "Permutation Groups", Graduate Texts in Mathematics 163, Springer, 1996.
-- DOI: 10.1007/978-1-4612-0731-3.
-- S3 = C3 semidirect C2 and the reflection relation s r s = r^-1.
--
-- CROSS-POLLINATION
--
-- PR #572 constructs the exact C3 character rows on the repository's existing
-- Phase3 carrier.  That exact file is reused here; no new zeta/character
-- datatype is introduced.
--
-- DASHI CONTRIBUTION
--
-- P11MarkedX2S3HeckeDecompositionExact proves that the coarse Brandt-newform
-- line and the two-dimensional deck-standard sector collide under the corrected
-- arithmetic observation
--
--   (T3,T5,F) = (-1,1,+1).
--
-- Here we show that the ACTUAL deck C3 generated by the full-level-2 frame
-- rotation separates them:
--
--   Brandt line | C3 = chi_0,
--   standard    | C3 = chi_1 + chi_2.
--
-- The reflection generator then distinguishes the S3 sign line from the
-- trivial lines.  Thus adding deck character data is a strictly informative
-- observation refinement; it is not another Hecke eigenvalue in disguise.
------------------------------------------------------------------------

open import DASHI.Core.Prelude
open import Data.Integer using (ℤ; +_; -[1+_])

import DASHI.Cognition.PhaseEnrichedTrit as Phase
import DASHI.Foundations.Phase3RootCharacterWeldExact as Root
import DASHI.Moonshine.P11FullLevel2DeckHeckeEquivarianceExact as Deck
import DASHI.Moonshine.P11MarkedX2S3HeckeDecompositionExact as Dec

------------------------------------------------------------------------
-- Linearized deck generators on the exact Int5 coordinate carrier.
-- This is the push-forward of
--
--   r : b0 -> b1 -> b2 -> b0,  a0,a1 fixed
--   s : a0 <-> a1, b1 <-> b2, b0 fixed.
------------------------------------------------------------------------

deckRLinear : Dec.Int5 → Dec.Int5
deckRLinear v = Dec.int5
  (Dec.a0c v) (Dec.a1c v)
  (Dec.b2c v) (Dec.b0c v) (Dec.b1c v)

deckSLinear : Dec.Int5 → Dec.Int5
deckSLinear v = Dec.int5
  (Dec.a1c v) (Dec.a0c v)
  (Dec.b0c v) (Dec.b2c v) (Dec.b1c v)

deckRLinearCubed : (v : Dec.Int5) →
  deckRLinear (deckRLinear (deckRLinear v)) ≡ v
deckRLinearCubed (Dec.int5 a0 a1 b0 b1 b2) = refl

deckSLinearSquared : (v : Dec.Int5) → deckSLinear (deckSLinear v) ≡ v
deckSLinearSquared (Dec.int5 a0 a1 b0 b1 b2) = refl

deckSRSLinear : (v : Dec.Int5) →
  deckSLinear (deckRLinear (deckSLinear v)) ≡ deckRLinear (deckRLinear v)
deckSRSLinear (Dec.int5 a0 a1 b0 b1 b2) = refl

------------------------------------------------------------------------
-- Explicit restriction behaviour on the already-proved simultaneous sectors.
------------------------------------------------------------------------

brandtDeckRFixed : deckRLinear Dec.brandtNewformVector ≡ Dec.brandtNewformVector
brandtDeckRFixed = refl

brandtDeckSFixed : deckSLinear Dec.brandtNewformVector ≡ Dec.brandtNewformVector
brandtDeckSFixed = refl

constantDeckRFixed : deckRLinear Dec.constantVector ≡ Dec.constantVector
constantDeckRFixed = refl

constantDeckSFixed : deckSLinear Dec.constantVector ≡ Dec.constantVector
constantDeckSFixed = refl

signDeckRFixed : deckRLinear Dec.signVector ≡ Dec.signVector
signDeckRFixed = refl

signDeckSNegated :
  deckSLinear Dec.signVector ≡ Dec.scale5 (-[1+ 0 ]) Dec.signVector
signDeckSNegated = refl

standardOrbit1 : Dec.Int5
standardOrbit1 = deckRLinear Dec.standardVector1

standardOrbit2 : Dec.Int5
standardOrbit2 = deckRLinear standardOrbit1

standardOrbit1Exact :
  standardOrbit1 ≡ Dec.int5 (+ 0) (+ 0) (+ 0) (+ 1) (-[1+ 0 ])
standardOrbit1Exact = refl

standardOrbit2Exact :
  standardOrbit2 ≡ Dec.int5 (+ 0) (+ 0) (-[1+ 0 ]) (+ 0) (+ 1)
standardOrbit2Exact = refl

standardRotationCloses : deckRLinear standardOrbit2 ≡ Dec.standardVector1
standardRotationCloses = refl

standardVectorNotDeckRFixed :
  deckRLinear Dec.standardVector1 ≡ Dec.standardVector1 → ⊥
standardVectorNotDeckRFixed ()

------------------------------------------------------------------------
-- Exact Phase3 character observer reused from PR #572.
--
-- A one-dimensional trivial C3 sector reads chi_0.  The real/rational standard
-- plane becomes the conjugate nontrivial pair chi_1 + chi_2 after adjoining the
-- cubic character coordinate.  We keep multiplicities and root labels separate:
-- no complex scalar carrier is manufactured here.
------------------------------------------------------------------------

record C3CharacterMultiplicity : Set where
  constructor c3Multiplicity
  field
    chi0Multiplicity chi1Multiplicity chi2Multiplicity : Nat

open C3CharacterMultiplicity public

brandtC3Multiplicity : C3CharacterMultiplicity
brandtC3Multiplicity = c3Multiplicity 1 0 0

constantC3Multiplicity : C3CharacterMultiplicity
constantC3Multiplicity = c3Multiplicity 1 0 0

signC3Multiplicity : C3CharacterMultiplicity
signC3Multiplicity = c3Multiplicity 1 0 0

standardC3Multiplicity : C3CharacterMultiplicity
standardC3Multiplicity = c3Multiplicity 0 1 1

brandtRestrictionIsTrivial : brandtC3Multiplicity ≡ c3Multiplicity 1 0 0
brandtRestrictionIsTrivial = refl

standardRestrictionIsConjugatePair : standardC3Multiplicity ≡ c3Multiplicity 0 1 1
standardRestrictionIsConjugatePair = refl

brandtAndStandardC3TypesDiffer : brandtC3Multiplicity ≡ standardC3Multiplicity → ⊥
brandtAndStandardC3TypesDiffer ()

-- The actual root labels at the generator r.
brandtCharacterAtR : Phase.Phase3
brandtCharacterAtR = Root.character Phase.phase0 Phase.phase1

standardCharacter1AtR : Phase.Phase3
standardCharacter1AtR = Root.character Phase.phase1 Phase.phase1

standardCharacter2AtR : Phase.Phase3
standardCharacter2AtR = Root.character Phase.phase2 Phase.phase1

brandtCharacterAtRIsOne : brandtCharacterAtR ≡ Phase.phase0
brandtCharacterAtRIsOne = refl

standardCharacter1AtRIsZeta : standardCharacter1AtR ≡ Phase.phase1
standardCharacter1AtRIsZeta = refl

standardCharacter2AtRIsZetaSquared : standardCharacter2AtR ≡ Phase.phase2
standardCharacter2AtRIsZetaSquared = refl

------------------------------------------------------------------------
-- Observation refinement: the old arithmetic fingerprint collides, while the
-- deck-character-extended fingerprint separates the sectors.
------------------------------------------------------------------------

data DeckC3Type : Set where
  trivialC3 conjugateNontrivialPair : DeckC3Type

record ExtendedMarkedFingerprint : Set where
  constructor extendedFingerprint
  field
    arithmeticFingerprint : Dec.JointEigenFingerprint
    deckC3Type : DeckC3Type

brandtExtendedFingerprint : ExtendedMarkedFingerprint
brandtExtendedFingerprint =
  extendedFingerprint Dec.brandtNewformFingerprint trivialC3

standardExtendedFingerprint : ExtendedMarkedFingerprint
standardExtendedFingerprint =
  extendedFingerprint Dec.standardFingerprint conjugateNontrivialPair

arithmeticPartStillCollides :
  ExtendedMarkedFingerprint.arithmeticFingerprint brandtExtendedFingerprint
  ≡ ExtendedMarkedFingerprint.arithmeticFingerprint standardExtendedFingerprint
arithmeticPartStillCollides = Dec.brandtAndStandardFingerprintsCoincide

extendedFingerprintsSeparate :
  brandtExtendedFingerprint ≡ standardExtendedFingerprint → ⊥
extendedFingerprintsSeparate ()

------------------------------------------------------------------------
-- Full S3 observer: C3 type distinguishes standard from one-dimensional lines;
-- reflection parity distinguishes sign from trivial one-dimensional lines.
------------------------------------------------------------------------

data ReflectionParity : Set where
  reflectionPlus reflectionMinus mixedReflection : ReflectionParity

record DeckS3Observation : Set where
  constructor deckS3Observation
  field
    c3Type : DeckC3Type
    reflectionParity : ReflectionParity

constantDeckObservation : DeckS3Observation
constantDeckObservation = deckS3Observation trivialC3 reflectionPlus

brandtDeckObservation : DeckS3Observation
brandtDeckObservation = deckS3Observation trivialC3 reflectionPlus

signDeckObservation : DeckS3Observation
signDeckObservation = deckS3Observation trivialC3 reflectionMinus

standardDeckObservation : DeckS3Observation
standardDeckObservation = deckS3Observation conjugateNontrivialPair mixedReflection

signAndTrivialSeparatedByReflection : signDeckObservation ≡ brandtDeckObservation → ⊥
signAndTrivialSeparatedByReflection ()

standardAndBrandtSeparatedByC3 : standardDeckObservation ≡ brandtDeckObservation → ⊥
standardAndBrandtSeparatedByC3 ()

------------------------------------------------------------------------
-- Boundary: exact finite character observation, not a complex-Hilbert upgrade.
------------------------------------------------------------------------

record P11MarkedDeckCharacterBoundary : Set where
  field
    phase3CharacterCarrierReused : Bool
    phase3CharacterCarrierReusedIsTrue : phase3CharacterCarrierReused ≡ true

    actualDeckC3RestrictionConstructed : Bool
    actualDeckC3RestrictionConstructedIsTrue : actualDeckC3RestrictionConstructed ≡ true

    heckeFrobeniusCollisionSeparatedByDeckCharacter : Bool
    heckeFrobeniusCollisionSeparatedByDeckCharacterIsTrue :
      heckeFrobeniusCollisionSeparatedByDeckCharacter ≡ true

    reflectionSeparatesSignFromTrivial : Bool
    reflectionSeparatesSignFromTrivialIsTrue : reflectionSeparatesSignFromTrivial ≡ true

    fullS3TypeDeclaredRedundant : Bool
    fullS3TypeDeclaredRedundantIsFalse : fullS3TypeDeclaredRedundant ≡ false

    complexCharacterSpaceConstructedHere : Bool
    complexCharacterSpaceConstructedHereIsFalse : complexCharacterSpaceConstructedHere ≡ false

    c9OrF9IdentifiedWithMarkedX2Carrier : Bool
    c9OrF9IdentifiedWithMarkedX2CarrierIsFalse : c9OrF9IdentifiedWithMarkedX2Carrier ≡ false

canonicalP11MarkedDeckCharacterBoundary : P11MarkedDeckCharacterBoundary
canonicalP11MarkedDeckCharacterBoundary = record
  { phase3CharacterCarrierReused = true
  ; phase3CharacterCarrierReusedIsTrue = refl
  ; actualDeckC3RestrictionConstructed = true
  ; actualDeckC3RestrictionConstructedIsTrue = refl
  ; heckeFrobeniusCollisionSeparatedByDeckCharacter = true
  ; heckeFrobeniusCollisionSeparatedByDeckCharacterIsTrue = refl
  ; reflectionSeparatesSignFromTrivial = true
  ; reflectionSeparatesSignFromTrivialIsTrue = refl
  ; fullS3TypeDeclaredRedundant = false
  ; fullS3TypeDeclaredRedundantIsFalse = refl
  ; complexCharacterSpaceConstructedHere = false
  ; complexCharacterSpaceConstructedHereIsFalse = refl
  ; c9OrF9IdentifiedWithMarkedX2Carrier = false
  ; c9OrF9IdentifiedWithMarkedX2CarrierIsFalse = refl
  }
