module DASHI.Moonshine.CM163Hecke41CorrectionWordsExact where

-- Source-written, kernel pending. Finite Euclidean decomposition of the
-- ORIGINAL correction matrices into the actual modular generators S,T.
-- No new Hecke chart, no PSL sign quotient: every matrix is exact SL2Z.
open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List using (List; []; _∷_)
open import Data.Fin as Fin using (Fin)
import DASHI.Moonshine.CM163ClassicalHecke41GeneratorTransportExact as H
import DASHI.Moonshine.CM163ClassicalHecke41LatticeSpecializationExact as B

data Step : Set where
  s t : Step

Word : Set
Word = List Step

stepRows : Step → B.Rows
stepRows s = H.left H.S H.identityRows
stepRows t = H.left H.T H.identityRows

matrix : Word → B.Rows
matrix [] = H.identityRows
matrix (g ∷ gs) = H.mul (stepRows g) (matrix gs)

