module DASHI.Moonshine.Y443FLMGriessFullAutSelectedVOAExact where

------------------------------------------------------------------------
-- FLM / GRIESS / TITS / HUANG: SHORTEST SAME-OBJECT AUT GROUP ROUTE
--
-- PRIMARY THEOREM AUTHORITIES
--   R. L. Griess, The Friendly Giant (1982), 10.1007/BF01389186.
--   J. Tits, automorphisms of the Griess algebra (1983/84).
--   I. Frenkel, J. Lepowsky, A. Meurman, Vertex Operator Algebras
--     and the Monster (1988).
--   Y.-Z. Huang, nonmeromorphic extension of the moonshine VOA (1994),
--     hep-th/9406190: automorphisms of the Griess algebra extend.
--   C. Dong, R. Griess, C. H. Lam, uniqueness (2005/07),
--     math/0506321: Vnatural is generated by weight two.
--
-- DASHI PROOF: for the actual selected VOA, weight-two generation
-- establishes pointwise injectivity of the restriction map by structural
-- induction over VACUUM / WEIGHT-TWO / SUM / SCALING / MODES / TRANSLATION.
-- The concrete Griess first product is defined by the ORIGINAL VOA mode 1.
-- Extending every Griess automorphism, and identifying Aut_Griess with the
-- EXACT selected Monster carrier, produce pointwise inverse maps between
-- Monster and the complete VOA automorphism carrier.
--
-- NO circle: the published FLM/GRIESS/TITS/HUANG facts are explicit inputs
-- only for their selected *concrete* structures; no 369/C3 character can
-- instantiate an algebra/product/extension theorem on its own.
------------------------------------------------------------------------

open import Agda.Primitive using (Setω)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Sigma using (Σ; _,_; fst; snd)
open import Agda.Builtin.Nat using (Nat)
open import Data.Integer.Base using (ℤ; +_)

import DASHI.Moonshine.VertexOperatorAlgebraCore as VOA
import DASHI.Moonshine.VNaturalOrbifoldConstruction as VN

sym : ∀ {A : Set} {x y : A} → x ≡ y → y ≡ x
sym refl = refl

trans : ∀ {A : Set} {x y z : A} → x ≡ y → y ≡ z → x ≡ z
trans refl p = p

cong : ∀ {A B : Set} (f : A → B) {x y : A} → x ≡ y → f x ≡ f y
cong f refl = refl

cong₂ : ∀ {A B C : Set} (f : A → B → C)
  {a b : A} {c d : B} → a ≡ b → c ≡ d → f a c ≡ f b d
cong₂ f refl refl = refl

module Selected (V : VOA.VertexOperatorAlgebra) where
  GM : VOA.GradedModule
  GM = VOA.VertexOperatorAlgebra.gradedModule V

  Y : VOA.VertexOperatorData GM
  Y = VOA.VertexOperatorAlgebra.vertexData V

  State : Set
  State = VOA.GradedModule.Carrier GM

  Scalar : Set
  Scalar = VOA.GradedModule.Scalar GM

  WeightTwo : Set
  WeightTwo = VOA.GradedModule.gradePiece GM 2

  include : WeightTwo → State
  include = VOA.GradedModule.includeGrade GM 2

  data GeneratedTerm : Set where
    vacuum : GeneratedTerm
    sourceWeightTwo : WeightTwo → GeneratedTerm
    addTerm : GeneratedTerm → GeneratedTerm → GeneratedTerm
    scaleTerm : Scalar → GeneratedTerm → GeneratedTerm
    modeTerm : GeneratedTerm → ℤ → GeneratedTerm → GeneratedTerm
    translateTerm : GeneratedTerm → GeneratedTerm

  evaluate : GeneratedTerm → State
  evaluate vacuum = VOA.VertexOperatorData.vacuum Y
  evaluate (sourceWeightTwo x) = include x
  evaluate (addTerm x y) =
    VOA.GradedModule._+_ GM (evaluate x) (evaluate y)
  evaluate (scaleTerm s x) =
    VOA.GradedModule._·_ GM s (evaluate x)
  evaluate (modeTerm x k y) =
    VOA.VertexOperatorData.mode Y (evaluate x) k (evaluate y)
  evaluate (translateTerm x) =
    VOA.VertexOperatorData.translation Y (evaluate x)

  record SelectedVOAAutomorphism : Setω where
    field
      action reverseAction : State → State
      reverseAfterAction : (x : State) → reverseAction (action x) ≡ x
      actionAfterReverse : (x : State) → action (reverseAction x) ≡ x

      actionVacuum :
        action (VOA.VertexOperatorData.vacuum Y)
        ≡ VOA.VertexOperatorData.vacuum Y
      actionConformal :
        action (VOA.VertexOperatorData.conformalVector Y)
        ≡ VOA.VertexOperatorData.conformalVector Y
      actionPreservesEveryGrade :
        (n : Nat) (x : VOA.GradedModule.gradePiece GM n) →
        Σ (VOA.GradedModule.gradePiece GM n)
          (λ y →
            action (VOA.GradedModule.includeGrade GM n x)
            ≡ VOA.GradedModule.includeGrade GM n y)

      actionAdd : (x y : State) →
        action (VOA.GradedModule._+_ GM x y)
        ≡ VOA.GradedModule._+_ GM (action x) (action y)

      actionScale : (s : Scalar) (x : State) →
        action (VOA.GradedModule._·_ GM s x)
        ≡ VOA.GradedModule._·_ GM s (action x)

      actionMode : (x : State) (k : ℤ) (y : State) →
        action (VOA.VertexOperatorData.mode Y x k y)
        ≡ VOA.VertexOperatorData.mode Y (action x) k (action y)

      actionTranslation : (x : State) →
        action (VOA.VertexOperatorData.translation Y x)
        ≡ VOA.VertexOperatorData.translation Y (action x)

      weightTwoAction weightTwoReverse : WeightTwo → WeightTwo
      weightTwoLeftInverse : (x : WeightTwo) →
        weightTwoReverse (weightTwoAction x) ≡ x
      weightTwoRightInverse : (x : WeightTwo) →
        weightTwoAction (weightTwoReverse x) ≡ x
      restrictionAgrees : (x : WeightTwo) →
        action (include x) ≡ include (weightTwoAction x)

  open SelectedVOAAutomorphism public

  -- Everything about a generated state is determined by its weight-two
  -- generator action. Structural recursion below is entirely source-native.

  mapTerm : SelectedVOAAutomorphism → GeneratedTerm → GeneratedTerm
  mapTerm a vacuum = vacuum
  mapTerm a (sourceWeightTwo x) = sourceWeightTwo (weightTwoAction a x)
  mapTerm a (addTerm l r) = addTerm (mapTerm a l) (mapTerm a r)
  mapTerm a (scaleTerm s l) = scaleTerm s (mapTerm a l)
  mapTerm a (modeTerm l k r) = modeTerm (mapTerm a l) k (mapTerm a r)
  mapTerm a (translateTerm l) = translateTerm (mapTerm a l)

  actionOnTermDirect :
    (a : SelectedVOAAutomorphism) (t : GeneratedTerm) →
    action a (evaluate t) ≡ evaluate (mapTerm a t)
  actionOnTermDirect a vacuum = actionVacuum a
  actionOnTermDirect a (sourceWeightTwo x) = restrictionAgrees a x
  actionOnTermDirect a (addTerm l r) =
    trans (actionAdd a (evaluate l) (evaluate r))
      (cong₂ (VOA.GradedModule._+_ GM)
        (actionOnTermDirect a l) (actionOnTermDirect a r))
  actionOnTermDirect a (scaleTerm s l) =
    trans (actionScale a s (evaluate l))
      (cong (VOA.GradedModule._·_ GM s) (actionOnTermDirect a l))
  actionOnTermDirect a (modeTerm l k r) =
    trans (actionMode a (evaluate l) k (evaluate r))
      (cong₂ (λ x y → VOA.VertexOperatorData.mode Y x k y)
        (actionOnTermDirect a l) (actionOnTermDirect a r))
  actionOnTermDirect a (translateTerm l) =
    trans (actionTranslation a (evaluate l))
      (cong (VOA.VertexOperatorData.translation Y)
        (actionOnTermDirect a l))

  termAgreement :
    (a b : SelectedVOAAutomorphism) →
    ((x : WeightTwo) → weightTwoAction a x ≡ weightTwoAction b x) →
    (t : GeneratedTerm) → mapTerm a t ≡ mapTerm b t
  termAgreement a b agreement vacuum = refl
  termAgreement a b agreement (sourceWeightTwo x) =
    cong sourceWeightTwo (agreement x)
  termAgreement a b agreement (addTerm l r) =
    cong₂ addTerm (termAgreement a b agreement l)
                  (termAgreement a b agreement r)
  termAgreement a b agreement (scaleTerm s l) =
    cong (scaleTerm s) (termAgreement a b agreement l)
  termAgreement a b agreement (modeTerm l k r) =
    cong₂ (λ x y → modeTerm x k y)
      (termAgreement a b agreement l)
      (termAgreement a b agreement r)
  termAgreement a b agreement (translateTerm l) =
    cong translateTerm (termAgreement a b agreement l)

  actionsAgreeOnTerm :
    (a b : SelectedVOAAutomorphism) →
    ((x : WeightTwo) → weightTwoAction a x ≡ weightTwoAction b x) →
    (t : GeneratedTerm) →
    action a (evaluate t) ≡ action b (evaluate t)
  actionsAgreeOnTerm a b eq t =
    trans (actionOnTermDirect a t)
      (trans (cong evaluate (termAgreement a b eq t))
             (sym (actionOnTermDirect b t)))

  record WeightTwoGeneration : Setω where
    field
      sourceWord : (state : State) → GeneratedTerm
      sourceWordEvaluates : (state : State) →
        evaluate (sourceWord state) ≡ state
  open WeightTwoGeneration public

  restrictionInjective :
    WeightTwoGeneration →
    (a b : SelectedVOAAutomorphism) →
    ((x : WeightTwo) → weightTwoAction a x ≡ weightTwoAction b x) →
    (x : State) → action a x ≡ action b x
  restrictionInjective generated a b agreed x =
    trans (sym (cong (action a) (sourceWordEvaluates generated x)))
      (trans
        (actionsAgreeOnTerm a b agreed (sourceWord generated x))
        (cong (action b) (sourceWordEvaluates generated x)))

  record ConcreteGriessProduct : Setω where
    field
      firstProduct : WeightTwo → WeightTwo → WeightTwo
      conformalWeightTwo : WeightTwo
      conformalIsActual :
        include conformalWeightTwo
        ≡ VOA.VertexOperatorData.conformalVector Y
      -- Actual linear algebra operations on the original grade-two space.
      -- A multiplicative set bijection alone is NOT an algebra automorphism.
      weightTwoAdd : WeightTwo → WeightTwo → WeightTwo
      weightTwoScale : Scalar → WeightTwo → WeightTwo
      includeWeightTwoAdd : (x y : WeightTwo) →
        include (weightTwoAdd x y)
        ≡ VOA.GradedModule._+_ GM (include x) (include y)
      includeWeightTwoScale : (s : Scalar) (x : WeightTwo) →
        include (weightTwoScale s x)
        ≡ VOA.GradedModule._·_ GM s (include x)
      firstProductIsModeOne : (x y : WeightTwo) →
        include (firstProduct x y) ≡
        VOA.VertexOperatorData.mode Y (include x) (+ 1) (include y)
      gradeEmbeddingInjective :
        (x y : WeightTwo) → include x ≡ include y → x ≡ y
  open ConcreteGriessProduct public

  record GriessAutomorphism (griess : ConcreteGriessProduct) : Set where
    field
      onWeightTwo inverseOnWeightTwo : WeightTwo → WeightTwo
      leftInverse : (x : WeightTwo) →
        inverseOnWeightTwo (onWeightTwo x) ≡ x
      rightInverse : (x : WeightTwo) →
        onWeightTwo (inverseOnWeightTwo x) ≡ x
      additiveLaw : (x y : WeightTwo) →
        onWeightTwo (weightTwoAdd griess x y)
        ≡ weightTwoAdd griess (onWeightTwo x) (onWeightTwo y)
      scalarLaw : (s : Scalar) (x : WeightTwo) →
        onWeightTwo (weightTwoScale griess s x)
        ≡ weightTwoScale griess s (onWeightTwo x)
      conformalFixed :
        onWeightTwo (conformalWeightTwo griess) ≡ conformalWeightTwo griess
      productLaw : (x y : WeightTwo) →
        onWeightTwo (firstProduct griess x y)
        ≡ firstProduct griess (onWeightTwo x) (onWeightTwo y)
  open GriessAutomorphism public

  restrictedProductLaw :
    (griess : ConcreteGriessProduct) →
    (a : SelectedVOAAutomorphism) (x y : WeightTwo) →
    weightTwoAction a (firstProduct griess x y)
    ≡ firstProduct griess (weightTwoAction a x) (weightTwoAction a y)
  restrictedProductLaw griess a x y =
    gradeEmbeddingInjective griess
      (weightTwoAction a (firstProduct griess x y))
      (firstProduct griess (weightTwoAction a x) (weightTwoAction a y))
      (trans (sym (restrictionAgrees a (firstProduct griess x y)))
        (trans (cong (action a) (firstProductIsModeOne griess x y))
          (trans (actionMode a (include x) (+ 1) (include y))
            (trans
              (cong₂ (λ u v → VOA.VertexOperatorData.mode Y u (+ 1) v)
                (restrictionAgrees a x) (restrictionAgrees a y))
              (sym (firstProductIsModeOne griess
                (weightTwoAction a x) (weightTwoAction a y)))))))

  restrictedAdditiveLaw :
    (griess : ConcreteGriessProduct) →
    (a : SelectedVOAAutomorphism) (x y : WeightTwo) →
    weightTwoAction a (weightTwoAdd griess x y)
    ≡ weightTwoAdd griess (weightTwoAction a x) (weightTwoAction a y)
  restrictedAdditiveLaw griess a x y =
    gradeEmbeddingInjective griess
      (weightTwoAction a (weightTwoAdd griess x y))
      (weightTwoAdd griess (weightTwoAction a x) (weightTwoAction a y))
      (trans (sym (restrictionAgrees a (weightTwoAdd griess x y)))
        (trans (cong (action a) (includeWeightTwoAdd griess x y))
          (trans (actionAdd a (include x) (include y))
            (trans
              (cong₂ (VOA.GradedModule._+_ GM)
                (restrictionAgrees a x) (restrictionAgrees a y))
              (sym (includeWeightTwoAdd griess
                (weightTwoAction a x) (weightTwoAction a y)))))))

  restrictedScalarLaw :
    (griess : ConcreteGriessProduct) →
    (a : SelectedVOAAutomorphism) (s : Scalar) (x : WeightTwo) →
    weightTwoAction a (weightTwoScale griess s x)
    ≡ weightTwoScale griess s (weightTwoAction a x)
  restrictedScalarLaw griess a s x =
    gradeEmbeddingInjective griess
      (weightTwoAction a (weightTwoScale griess s x))
      (weightTwoScale griess s (weightTwoAction a x))
      (trans (sym (restrictionAgrees a (weightTwoScale griess s x)))
        (trans (cong (action a) (includeWeightTwoScale griess s x))
          (trans (actionScale a s (include x))
            (trans
              (cong (VOA.GradedModule._·_ GM s)
                (restrictionAgrees a x))
              (sym (includeWeightTwoScale griess s
                (weightTwoAction a x)))))))

  restrictedConformalLaw :
    (griess : ConcreteGriessProduct) →
    (a : SelectedVOAAutomorphism) →
    weightTwoAction a (conformalWeightTwo griess)
    ≡ conformalWeightTwo griess
  restrictedConformalLaw griess a =
    gradeEmbeddingInjective griess
      (weightTwoAction a (conformalWeightTwo griess))
      (conformalWeightTwo griess)
      (trans (sym (restrictionAgrees a (conformalWeightTwo griess)))
        (trans (cong (action a) (conformalIsActual griess))
          (trans (actionConformal a) (sym (conformalIsActual griess)))))

  restrict :
    (griess : ConcreteGriessProduct) →
    SelectedVOAAutomorphism → GriessAutomorphism griess
  restrict griess a = record
    { onWeightTwo = weightTwoAction a
    ; inverseOnWeightTwo = weightTwoReverse a
    ; leftInverse = weightTwoLeftInverse a
    ; rightInverse = weightTwoRightInverse a
    ; additiveLaw = restrictedAdditiveLaw griess a
    ; scalarLaw = restrictedScalarLaw griess a
    ; conformalFixed = restrictedConformalLaw griess a
    ; productLaw = restrictedProductLaw griess a
    }

  -- The exact FLM/Huang extension input is NOT inferred from a character.
  record SelectedFLMExtension (griess : ConcreteGriessProduct) : Setω where
    field
      extend : GriessAutomorphism griess → SelectedVOAAutomorphism
      extensionRestricts : (g : GriessAutomorphism griess) →
        (x : WeightTwo) →
        weightTwoAction (extend g) x ≡ onWeightTwo g x
  open SelectedFLMExtension public

  extensionIsRightInverseOnStates :
    (griess : ConcreteGriessProduct) →
    WeightTwoGeneration →
    (ext : SelectedFLMExtension griess) →
    (a : SelectedVOAAutomorphism) →
    (x : State) →
    action (extend ext (restrict griess a)) x ≡ action a x
  extensionIsRightInverseOnStates griess generated ext a x =
    restrictionInjective generated (extend ext (restrict griess a)) a
      (λ w → extensionRestricts ext (restrict griess a) w) x

  -- The source Griess/Tits identification must use the SAME WeightTwo,
  -- firstProduct and selected Monster group as the VOA action/Y443 bridge.
  record SelectedMonsterGriessIdentification (Monster : Set)
    (griess : ConcreteGriessProduct) : Setω where
    field
      monsterToGriess : Monster → GriessAutomorphism griess
      griessToMonster : GriessAutomorphism griess → Monster
      monsterRoundTrip : (m : Monster) →
        griessToMonster (monsterToGriess m) ≡ m
      griessRoundTrip : (g : GriessAutomorphism griess) →
        (x : WeightTwo) →
        onWeightTwo (monsterToGriess (griessToMonster g)) x
        ≡ onWeightTwo g x
      -- Extensionality of the CONCRETE Griess automorphism-to-Monster
      -- map, not global function extensionality as an axiom.
      griessInverseExtensional :
        (g h : GriessAutomorphism griess) →
        ((x : WeightTwo) → onWeightTwo g x ≡ onWeightTwo h x) →
        griessToMonster g ≡ griessToMonster h
  open SelectedMonsterGriessIdentification public

  fullMonsterAction :
    ∀ {Monster : Set} (griess : ConcreteGriessProduct)
    (ext : SelectedFLMExtension griess)
    (ident : SelectedMonsterGriessIdentification Monster griess) →
    Monster → SelectedVOAAutomorphism
  fullMonsterAction griess ext ident m =
    extend ext (monsterToGriess ident m)

  recoverMonsterFromVOA :
    ∀ {Monster : Set} (griess : ConcreteGriessProduct)
    (ident : SelectedMonsterGriessIdentification Monster griess) →
    SelectedVOAAutomorphism → Monster
  recoverMonsterFromVOA griess ident a =
    griessToMonster ident (restrict griess a)

  monsterAfterVOA :
    ∀ {Monster : Set} (griess : ConcreteGriessProduct)
    (ext : SelectedFLMExtension griess)
    (ident : SelectedMonsterGriessIdentification Monster griess) →
    (m : Monster) →
    recoverMonsterFromVOA griess ident
      (fullMonsterAction griess ext ident m) ≡ m
  monsterAfterVOA griess ext ident m =
    trans
      (griessInverseExtensional ident
        (restrict griess (extend ext (monsterToGriess ident m)))
        (monsterToGriess ident m)
        (extensionRestricts ext (monsterToGriess ident m)))
      (monsterRoundTrip ident m)

  fullVOAAfterMonsterOnStates :
    ∀ {Monster : Set} (griess : ConcreteGriessProduct)
    (generation : WeightTwoGeneration)
    (ext : SelectedFLMExtension griess)
    (ident : SelectedMonsterGriessIdentification Monster griess) →
    (a : SelectedVOAAutomorphism) (x : State) →
    action
      (fullMonsterAction griess ext ident
        (recoverMonsterFromVOA griess ident a)) x
    ≡ action a x
  fullVOAAfterMonsterOnStates griess generation ext ident a x =
    restrictionInjective generation
      (fullMonsterAction griess ext ident
        (recoverMonsterFromVOA griess ident a))
      a
      (λ w →
        trans
          (extensionRestricts ext
            (monsterToGriess ident
              (griessToMonster ident (restrict griess a))) w)
          (griessRoundTrip ident (restrict griess a) w))
      x
