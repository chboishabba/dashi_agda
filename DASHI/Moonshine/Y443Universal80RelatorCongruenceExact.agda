module DASHI.Moonshine.Y443Universal80RelatorCongruenceExact where

------------------------------------------------------------------------
-- SOURCE-NATIVE UNIVERSAL 80-RELATOR *SETOID* PRESENTATION.
--
-- The least congruence is inductively generated by the GROUP axioms
-- and the ACTUAL Y443.monsterRelators. No arbitrary quotient carrier
-- or arbitrary selected-group kernel is substituted for the source.
--
-- This gives the quotient as a setoid of signed-node terms, not a
-- quotient Set with definitional equality. That remaining carrier
-- choice must be respected by downstream group-isomorphism owners.
--
-- Sources: Ivanov, Bray; TauCeti presentation; JMD word theorem.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List using (List; []; _∷_)
open import Data.Product using (_×_; _,_)
import DASHI.Moonshine.Y443CoxeterPresentationExact as Y
import DASHI.Moonshine.Y443PresentedGroupNodeGenerationExact as Presented
import DASHI.Moonshine.Y443VNaturalPairGenerationExact as Pair
import DASHI.Moonshine.Y443JMDNonadjacentRelatorConsequencesExact as Consequences
import DASHI.Moonshine.Y443JMDPowerFiveSixAlgebraExact as Algebra
import DASHI.Moonshine.TwistedModuleModularity as TM

Expr : Set
Expr = Presented.SignedNodeExpression

infix 4 _≈₈₀_

wordExpr : Y.Word → Expr
wordExpr [] = Presented.empty
wordExpr (x ∷ xs) =
  Presented.multiply (Presented.generator x) (wordExpr xs)

data _≈₈₀_ : Expr → Expr → Set where
  eqRefl : ∀ {x} → x ≈₈₀ x
  eqSym : ∀ {x y} → x ≈₈₀ y → y ≈₈₀ x
  eqTrans : ∀ {x y z} → x ≈₈₀ y → y ≈₈₀ z → x ≈₈₀ z
  mulCong : ∀ {x x' y y'} →
    x ≈₈₀ x' → y ≈₈₀ y' →
    Presented.multiply x y ≈₈₀ Presented.multiply x' y'
  invCong : ∀ {x y} → x ≈₈₀ y →
    Presented.inverse x ≈₈₀ Presented.inverse y
  groupAssoc : ∀ x y z →
    Presented.multiply (Presented.multiply x y) z
      ≈₈₀ Presented.multiply x (Presented.multiply y z)
  groupLeftId : ∀ x →
    Presented.multiply Presented.empty x ≈₈₀ x
  groupRightId : ∀ x →
    Presented.multiply x Presented.empty ≈₈₀ x
  groupLeftInverse : ∀ x →
    Presented.multiply (Presented.inverse x) x ≈₈₀ Presented.empty
  groupRightInverse : ∀ x →
    Presented.multiply x (Presented.inverse x) ≈₈₀ Presented.empty
  sourceRelator : (w : Y.Word) →
    Consequences._∈_ w Y.monsterRelators →
    wordExpr w ≈₈₀ Presented.empty

-- A canonical finite source: the 80-word list, not an arbitrary
-- asserted equation family.
infix 4 _∼_
_∼_ : Expr → Expr → Set
_∼_ = _≈₈₀_

-- Universal property: any congruence respecting group axioms and the
-- ORIGINAL 80 relator equations contains the generated presentation
-- congruence. This is the least-congruence theorem, not a cardinality
-- or finite-regression inference.
record AdmissibleCongruence : Set₁ where
  field
    R : Expr → Expr → Set
    rRefl : ∀ x → R x x
    rSym : ∀ {x y} → R x y → R y x
    rTrans : ∀ {x y z} → R x y → R y z → R x z
    rMul : ∀ {x x' y y'} →
      R x x' → R y y' →
      R (Presented.multiply x y) (Presented.multiply x' y')
    rInv : ∀ {x y} → R x y →
      R (Presented.inverse x) (Presented.inverse y)
    rAssoc : ∀ x y z →
      R (Presented.multiply (Presented.multiply x y) z)
        (Presented.multiply x (Presented.multiply y z))
    rLeftId : ∀ x → R (Presented.multiply Presented.empty x) x
    rRightId : ∀ x → R (Presented.multiply x Presented.empty) x
    rLeftInverse : ∀ x →
      R (Presented.multiply (Presented.inverse x) x) Presented.empty
    rRightInverse : ∀ x →
      R (Presented.multiply x (Presented.inverse x)) Presented.empty
    rSourceRelator : ∀ w →
      Consequences._∈_ w Y.monsterRelators →
      R (wordExpr w) Presented.empty

open AdmissibleCongruence public

least80Congruence :
  (C : AdmissibleCongruence) →
  ∀ {x y} → x ≈₈₀ y → R C x y
least80Congruence C eqRefl = rRefl C _
least80Congruence C (eqSym p) =
  rSym C (least80Congruence C p)
least80Congruence C (eqTrans p q) =
  rTrans C (least80Congruence C p) (least80Congruence C q)
least80Congruence C (mulCong p q) =
  rMul C (least80Congruence C p) (least80Congruence C q)
least80Congruence C (invCong p) =
  rInv C (least80Congruence C p)
least80Congruence C (groupAssoc x y z) = rAssoc C x y z
least80Congruence C (groupLeftId x) = rLeftId C x
least80Congruence C (groupRightId x) = rRightId C x
least80Congruence C (groupLeftInverse x) = rLeftInverse C x
least80Congruence C (groupRightInverse x) = rRightInverse C x
least80Congruence C (sourceRelator w member) =
  rSourceRelator C w member

module Interpretation {G : Set}
    (gi : TM.GroupWithInverse G)
    (nodes : Y.Node → G)
    (all : Pair.RelatorsSatisfied gi nodes Y.monsterRelators) where

  module A = Algebra.PowerAlgebra gi
  eval : Expr → G
  eval = Presented.interpret gi nodes

  wordSound : (w : Y.Word) →
    eval (wordExpr w) ≡ Pair.evaluateCoxeterWord gi nodes w
  wordSound [] = refl
  wordSound (x ∷ xs) =
    Pair.cong (Pair.multiply gi (nodes x)) (wordSound xs)

  sound : ∀ {x y} → x ≈₈₀ y → eval x ≡ eval y
  sound eqRefl = refl
  sound (eqSym p) = Algebra.sym (sound p)
  sound (eqTrans p q) = Algebra.trans (sound p) (sound q)
  sound (mulCong p q) =
    Algebra.cong₂ (Pair.multiply gi) (sound p) (sound q)
  sound (invCong p) = Algebra.cong (Pair.inverse gi) (sound p)
  sound (groupAssoc x y z) =
    A.assoc (eval x) (eval y) (eval z)
  sound (groupLeftId x) = A.leftId (eval x)
  sound (groupRightId x) = A.rightId (eval x)
  sound (groupLeftInverse x) =
    TM.GroupWithInverse.leftInverse gi (eval x)
  sound (groupRightInverse x) =
    TM.GroupWithInverse.rightInverse gi (eval x)
  sound (sourceRelator w member) =
    Algebra.trans (wordSound w)
      (Consequences.relatorMembershipElim gi nodes w member all)

  -- The map from the universal presented SETOID into any selected
  -- group respecting the 80 relators is always well defined.
  -- Its injectivity is the genuine additional Monster V2 gate.
  semanticKernelContainsUniversal :
    ∀ {x y} → x ≈₈₀ y → eval x ≡ eval y
  semanticKernelContainsUniversal = sound

  record NoExtraSelectedRelations : Set where
    field
      reflectsEquality : ∀ x y → eval x ≡ eval y → x ≈₈₀ y

  open NoExtraSelectedRelations public

  exactKernelIffNoExtra :
    NoExtraSelectedRelations →
    ∀ x y → (x ≈₈₀ y → eval x ≡ eval y)
           × (eval x ≡ eval y → x ≈₈₀ y)
  exactKernelIffNoExtra noExtra x y =
    sound , reflectsEquality noExtra x y
