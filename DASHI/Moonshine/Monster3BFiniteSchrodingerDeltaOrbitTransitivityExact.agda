module DASHI.Moonshine.Monster3BFiniteSchrodingerDeltaOrbitTransitivityExact where

open import DASHI.Core.Prelude
open import DASHI.Algebra.Trit using (Trit; neg; zer; pos)

import DASHI.Moonshine.Monster3BFiniteHeisenbergGeneratorsExact as H
import DASHI.Moonshine.Monster3BFiniteSchrodingerFunctionModuleExact as V
import DASHI.Moonshine.Monster3BFiniteSchrodingerBooleanDeltaExact as Delta
import DASHI.Moonshine.Monster3BFiniteSchrodingerDeltaExtractionExact as Extract

------------------------------------------------------------------------
-- TRANSLATED DELTA ORBIT TRANSITIVITY
--
-- The finite Stone-von Neumann frontier had one compound open sentence:
-- "translated delta orbit spans the full function carrier".  Split it into:
--
--   (A) translations reach every X6 point / delta line;
--   (B) the 729 delta lines linearly span every function X6 -> Q(zeta_3).
--
-- This owner closes (A) constructively using only the six literal translation
-- generators.  It does not silently claim (B).
------------------------------------------------------------------------

------------------------------------------------------------------------
-- 1. Reachability generated by the actual unit translations.
------------------------------------------------------------------------

data TranslationReachable : H.X6 → H.X6 → Set where
  reachableRefl : ∀ {x} → TranslationReachable x x
  reachableStep :
    ∀ {x y} →
    (axis : H.Axis6) →
    TranslationReachable (H.translate axis x) y →
    TranslationReachable x y

reachableTrans :
  ∀ {x y z} →
  TranslationReachable x y →
  TranslationReachable y z →
  TranslationReachable x z
reachableTrans reachableRefl yz = yz
reachableTrans (reachableStep axis rest) yz =
  reachableStep axis (reachableTrans rest yz)

------------------------------------------------------------------------
-- 2. Reset one coordinate to zero using at most two positive translations.
------------------------------------------------------------------------

reset0 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a b c d e f)
    (H.x6 zer b c d e f)
reset0 neg b c d e f = reachableStep H.axis0 reachableRefl
reset0 zer b c d e f = reachableRefl
reset0 pos b c d e f = reachableStep H.axis0 (reachableStep H.axis0 reachableRefl)

reset1 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a b c d e f)
    (H.x6 a zer c d e f)
reset1 a neg c d e f = reachableStep H.axis1 reachableRefl
reset1 a zer c d e f = reachableRefl
reset1 a pos c d e f = reachableStep H.axis1 (reachableStep H.axis1 reachableRefl)

reset2 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a b c d e f)
    (H.x6 a b zer d e f)
reset2 a b neg d e f = reachableStep H.axis2 reachableRefl
reset2 a b zer d e f = reachableRefl
reset2 a b pos d e f = reachableStep H.axis2 (reachableStep H.axis2 reachableRefl)

reset3 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a b c d e f)
    (H.x6 a b c zer e f)
reset3 a b c neg e f = reachableStep H.axis3 reachableRefl
reset3 a b c zer e f = reachableRefl
reset3 a b c pos e f = reachableStep H.axis3 (reachableStep H.axis3 reachableRefl)

reset4 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a b c d e f)
    (H.x6 a b c d zer f)
reset4 a b c d neg f = reachableStep H.axis4 reachableRefl
reset4 a b c d zer f = reachableRefl
reset4 a b c d pos f = reachableStep H.axis4 (reachableStep H.axis4 reachableRefl)

reset5 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a b c d e f)
    (H.x6 a b c d e zer)
reset5 a b c d e neg = reachableStep H.axis5 reachableRefl
reset5 a b c d e zer = reachableRefl
reset5 a b c d e pos = reachableStep H.axis5 (reachableStep H.axis5 reachableRefl)

zeroX6 : H.X6
zeroX6 = H.x6 zer zer zer zer zer zer

toZero : (x : H.X6) → TranslationReachable x zeroX6
toZero (H.x6 a b c d e f) =
  reachableTrans (reset0 a b c d e f)
    (reachableTrans (reset1 zer b c d e f)
      (reachableTrans (reset2 zer zer c d e f)
        (reachableTrans (reset3 zer zer zer d e f)
          (reachableTrans (reset4 zer zer zer zer e f)
            (reset5 zer zer zer zer zer f)))))

------------------------------------------------------------------------
-- 3. Build any target coordinate from zero using at most two translations.
------------------------------------------------------------------------

build0 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 zer b c d e f)
    (H.x6 a b c d e f)
build0 neg b c d e f = reachableStep H.axis0 (reachableStep H.axis0 reachableRefl)
build0 zer b c d e f = reachableRefl
build0 pos b c d e f = reachableStep H.axis0 reachableRefl

build1 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a zer c d e f)
    (H.x6 a b c d e f)
build1 a neg c d e f = reachableStep H.axis1 (reachableStep H.axis1 reachableRefl)
build1 a zer c d e f = reachableRefl
build1 a pos c d e f = reachableStep H.axis1 reachableRefl

build2 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a b zer d e f)
    (H.x6 a b c d e f)
build2 a b neg d e f = reachableStep H.axis2 (reachableStep H.axis2 reachableRefl)
build2 a b zer d e f = reachableRefl
build2 a b pos d e f = reachableStep H.axis2 reachableRefl

build3 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a b c zer e f)
    (H.x6 a b c d e f)
build3 a b c neg e f = reachableStep H.axis3 (reachableStep H.axis3 reachableRefl)
build3 a b c zer e f = reachableRefl
build3 a b c pos e f = reachableStep H.axis3 reachableRefl

build4 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a b c d zer f)
    (H.x6 a b c d e f)
build4 a b c d neg f = reachableStep H.axis4 (reachableStep H.axis4 reachableRefl)
build4 a b c d zer f = reachableRefl
build4 a b c d pos f = reachableStep H.axis4 reachableRefl

build5 :
  ∀ a b c d e f →
  TranslationReachable
    (H.x6 a b c d e zer)
    (H.x6 a b c d e f)
build5 a b c d e neg = reachableStep H.axis5 (reachableStep H.axis5 reachableRefl)
build5 a b c d e zer = reachableRefl
build5 a b c d e pos = reachableStep H.axis5 reachableRefl

fromZero : (x : H.X6) → TranslationReachable zeroX6 x
fromZero (H.x6 a b c d e f) =
  reachableTrans (build0 a zer zer zer zer zer)
    (reachableTrans (build1 a b zer zer zer zer)
      (reachableTrans (build2 a b c zer zer zer)
        (reachableTrans (build3 a b c d zer zer)
          (reachableTrans (build4 a b c d e zer)
            (build5 a b c d e f)))))

translationActionIsTransitive :
  (source target : H.X6) → TranslationReachable source target
translationActionIsTransitive source target =
  reachableTrans (toZero source) (fromZero target)

------------------------------------------------------------------------
-- 4. One translation step transports a Boolean delta line inside every
-- Heisenberg-invariant subspace.
------------------------------------------------------------------------

translationStepCarriesDeltaMembership :
  ∀ {Member}
    (inv : V.HeisenbergInvariantSubspace Member) →
    (axis : H.Axis6) →
    (selected : H.X6) →
    Member (Delta.booleanDelta selected) →
    Member (Delta.booleanDelta (H.translate axis selected))
translationStepCarriesDeltaMembership inv axis selected member =
  V.closedUnderPointwiseEquality inv
    (V.translationAction axis (Delta.booleanDelta selected))
    (Delta.booleanDelta (H.translate axis selected))
    (V.closedUnderTranslation inv axis (Delta.booleanDelta selected) member)
    (Delta.unitTranslationCarriesBooleanDeltaPointwise axis selected)

transportDeltaMembershipAlongReachability :
  ∀ {Member source target}
    (inv : V.HeisenbergInvariantSubspace Member) →
    TranslationReachable source target →
    Member (Delta.booleanDelta source) →
    Member (Delta.booleanDelta target)
transportDeltaMembershipAlongReachability inv reachableRefl member = member
transportDeltaMembershipAlongReachability inv
    (reachableStep {x = source} axis rest) member =
  transportDeltaMembershipAlongReachability inv rest
    (translationStepCarriesDeltaMembership inv axis source member)

------------------------------------------------------------------------
-- 5. Main theorem: one extracted nonzero invariant vector yields every one of
-- the 729 delta lines in the same invariant subspace.
------------------------------------------------------------------------

allBooleanDeltaLinesBelong :
  ∀ {Member}
    (inv : V.HeisenbergInvariantSubspace Member) →
    (witness : Extract.NonzeroInvariantVector inv) →
    (target : H.X6) →
    Member (Delta.booleanDelta target)
allBooleanDeltaLinesBelong inv witness target =
  transportDeltaMembershipAlongReachability inv
    (translationActionIsTransitive (Extract.selected witness) target)
    (Delta.booleanDeltaMemberFromExtraction inv witness)

------------------------------------------------------------------------
-- 6. The remaining linear-algebra payment is deliberately separate.
------------------------------------------------------------------------

record DeltaBasisSpanningPayment : Set₁ where
  field
    everyFunctionIsFiniteDeltaCombination : Set

open DeltaBasisSpanningPayment public

record DeltaOrbitTransitivityBoundary : Set where
  constructor delta-orbit-transitivity-boundary
  field
    unitTranslationCovarianceReused : Bool
    arbitraryX6TranslationReachabilityProved : Bool
    extractedDeltaOrbitReachesEveryDeltaLine : Bool
    all729DeltaLinesForcedIntoInvariantSubspace : Bool
    linearSpanOfAllFunctionsProvedHere : Bool
    fullIrreducibilityProvedHere : Bool

canonicalDeltaOrbitTransitivityBoundary : DeltaOrbitTransitivityBoundary
canonicalDeltaOrbitTransitivityBoundary =
  delta-orbit-transitivity-boundary
    true true true true false false
