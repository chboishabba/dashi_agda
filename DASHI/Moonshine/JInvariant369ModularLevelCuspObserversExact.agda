------------------------------------------------------------------------
-- 1. Literal translation matrices.
------------------------------------------------------------------------

translationMatrix : ℤ → Eisenstein.SL2Z
translationMatrix n =
  Eisenstein.sl2z 1ℤ n 0ℤ 1ℤ refl

T : Eisenstein.SL2Z
T = translationMatrix 1ℤ

translationPower : Nat → Eisenstein.SL2Z
translationPower n = translationMatrix (+ n)

record TranslationPowerPrincipalLevelWitness
    (level : Nat) : Set where
  constructor translation-power-principal-level-witness
  field
    aIsOne :
      Eisenstein.a (translationPower level) ≡ 1ℤ
    bIsLevel :
      Eisenstein.b (translationPower level) ≡ + level
    cIsZero :
      Eisenstein.c (translationPower level) ≡ 0ℤ
    dIsOne :
      Eisenstein.d (translationPower level) ≡ 1ℤ

open TranslationPowerPrincipalLevelWitness public

translationPowerPrincipalWitness :
  (level : Nat) →
  TranslationPowerPrincipalLevelWitness level
translationPowerPrincipalWitness level =
  translation-power-principal-level-witness refl refl refl refl

level3PrincipalWitness : TranslationPowerPrincipalLevelWitness 3
level3PrincipalWitness = translationPowerPrincipalWitness 3

level6PrincipalWitness : TranslationPowerPrincipalLevelWitness 6
level6PrincipalWitness = translationPowerPrincipalWitness 6

level9PrincipalWitness : TranslationPowerPrincipalLevelWitness 9
level9PrincipalWitness = translationPowerPrincipalWitness 9

level27PrincipalWitness : TranslationPowerPrincipalLevelWitness 27
level27PrincipalWitness = translationPowerPrincipalWitness 27

------------------------------------------------------------------------
-- 2. Canonical triadic cusp fibres Z/3^d Z.
--
-- The repository already represents Z/3^d Z by balanced-ternary residues.
-- Translation by T is therefore addition of the residue 1.
------------------------------------------------------------------------

oneResidue : (depth : Nat) → Q.Residue3Pow depth
oneResidue zero = []
oneResidue (suc depth) = pos ∷ Arithmetic.zeroResidue depth

translateTriadic :
  (depth : Nat) →
  Q.Residue3Pow depth →
  Q.Residue3Pow depth
translateTriadic depth x =
  Arithmetic.addResidue (oneResidue depth) x

reduceOne :
  (depth : Nat) →
  Q.reduce (oneResidue (suc depth)) ≡ oneResidue depth
reduceOne zero = refl
reduceOne (suc depth) = refl

reduceTranslate :
  (depth : Nat) →
  (x : Q.Residue3Pow (suc depth)) →
  Q.reduce (translateTriadic (suc depth) x)
  ≡
  translateTriadic depth (Q.reduce x)
reduceTranslate depth x =
  trans
    (Arithmetic.reduce-addResidue
      (oneResidue (suc depth)) x)
    (cong
      (λ one → Arithmetic.addResidue one (Q.reduce x))
      (reduceOne depth))

level3CuspFibre : Set
level3CuspFibre = Q.Residue3Pow Q.one

level9CuspFibre : Set
level9CuspFibre = Q.Residue3Pow Q.two

level27CuspFibre : Set
level27CuspFibre = Q.Residue3Pow Q.three

level9To3CoveringProjection :
  level9CuspFibre → level3CuspFibre
level9To3CoveringProjection = Q.reduce

level27To9CoveringProjection :
  level27CuspFibre → level9CuspFibre
level27To9CoveringProjection = Q.reduce

level9To3TranslationEquivariant :
  (x : level9CuspFibre) →
  level9To3CoveringProjection (translateTriadic Q.two x)
  ≡
  translateTriadic Q.one (level9To3CoveringProjection x)
level9To3TranslationEquivariant =
  reduceTranslate Q.one

level27To9TranslationEquivariant :
  (x : level27CuspFibre) →
  level27To9CoveringProjection (translateTriadic Q.three x)
  ≡
  translateTriadic Q.two (level27To9CoveringProjection x)
level27To9TranslationEquivariant =
  reduceTranslate Q.two

------------------------------------------------------------------------
-- 3. Existing C3 observer == level-3 cusp fibre as a finite carrier.
------------------------------------------------------------------------

kernelTritToTrit : Kernel.KernelTrit → Trit
kernelTritToTrit Kernel.negativeTrit = neg
kernelTritToTrit Kernel.zeroTrit = zer
kernelTritToTrit Kernel.positiveTrit = pos

tritToKernelTrit : Trit → Kernel.KernelTrit
tritToKernelTrit neg = Kernel.negativeTrit
tritToKernelTrit zer = Kernel.zeroTrit
tritToKernelTrit pos = Kernel.positiveTrit

kernelRoundTrip :
  (x : Kernel.KernelTrit) →
  tritToKernelTrit (kernelTritToTrit x) ≡ x
kernelRoundTrip Kernel.negativeTrit = refl
kernelRoundTrip Kernel.zeroTrit = refl
kernelRoundTrip Kernel.positiveTrit = refl

tritRoundTrip :
  (x : Trit) →
  kernelTritToTrit (tritToKernelTrit x) ≡ x
tritRoundTrip neg = refl
tritRoundTrip zer = refl
tritRoundTrip pos = refl

observer3ToLevel3 :
  Kernel.KernelTrit → level3CuspFibre
observer3ToLevel3 x = kernelTritToTrit x ∷ []

level3ToObserver3 :
  level3CuspFibre → Kernel.KernelTrit
level3ToObserver3 (x ∷ []) = tritToKernelTrit x

observer3LevelRoundTrip :
  (x : Kernel.KernelTrit) →
  level3ToObserver3 (observer3ToLevel3 x) ≡ x
observer3LevelRoundTrip = kernelRoundTrip

level3ObserverRoundTrip :
  (x : level3CuspFibre) →
  observer3ToLevel3 (level3ToObserver3 x) ≡ x
level3ObserverRoundTrip (neg ∷ []) = refl
level3ObserverRoundTrip (zer ∷ []) = refl
level3ObserverRoundTrip (pos ∷ []) = refl

------------------------------------------------------------------------
-- 4. Existing NineSheet == level-9 cusp fibre as a finite carrier.
--
-- Important: NineSheet was originally a product carrier.  The bijection below
-- does not assert that its old coordinatewise semantics was already cyclic.
-- Instead it transports the canonical Z/9Z cusp action onto that same set.
------------------------------------------------------------------------

observer9ToLevel9 :
  Kernel.NineSheet → level9CuspFibre
observer9ToLevel9 (a , b) =
  kernelTritToTrit a ∷ kernelTritToTrit b ∷ []

level9ToObserver9 :
  level9CuspFibre → Kernel.NineSheet
level9ToObserver9 (a ∷ b ∷ []) =
  tritToKernelTrit a , tritToKernelTrit b

observer9LevelRoundTrip :
  (x : Kernel.NineSheet) →
  level9ToObserver9 (observer9ToLevel9 x) ≡ x
observer9LevelRoundTrip (Kernel.negativeTrit , Kernel.negativeTrit) = refl
observer9LevelRoundTrip (Kernel.negativeTrit , Kernel.zeroTrit) = refl
observer9LevelRoundTrip (Kernel.negativeTrit , Kernel.positiveTrit) = refl
observer9LevelRoundTrip (Kernel.zeroTrit , Kernel.negativeTrit) = refl
observer9LevelRoundTrip (Kernel.zeroTrit , Kernel.zeroTrit) = refl
observer9LevelRoundTrip (Kernel.zeroTrit , Kernel.positiveTrit) = refl
observer9LevelRoundTrip (Kernel.positiveTrit , Kernel.negativeTrit) = refl
observer9LevelRoundTrip (Kernel.positiveTrit , Kernel.zeroTrit) = refl
observer9LevelRoundTrip (Kernel.positiveTrit , Kernel.positiveTrit) = refl

level9ObserverRoundTrip :
  (x : level9CuspFibre) →
  observer9ToLevel9 (level9ToObserver9 x) ≡ x
level9ObserverRoundTrip (neg ∷ neg ∷ []) = refl
level9ObserverRoundTrip (neg ∷ zer ∷ []) = refl
level9ObserverRoundTrip (neg ∷ pos ∷ []) = refl
level9ObserverRoundTrip (zer ∷ neg ∷ []) = refl
level9ObserverRoundTrip (zer ∷ zer ∷ []) = refl
level9ObserverRoundTrip (zer ∷ pos ∷ []) = refl
level9ObserverRoundTrip (pos ∷ neg ∷ []) = refl
level9ObserverRoundTrip (pos ∷ zer ∷ []) = refl
level9ObserverRoundTrip (pos ∷ pos ∷ []) = refl

translateObserver9 :
  Kernel.NineSheet → Kernel.NineSheet
translateObserver9 x =
  level9ToObserver9
    (translateTriadic Q.two (observer9ToLevel9 x))

------------------------------------------------------------------------
-- 5. Existing ternary hypervoxel == level-27 cusp fibre as a finite carrier.
--
-- Again this is a carrier bijection plus an INDUCED cyclic cusp action.
-- It does not identify the hypervoxel's coordinatewise C3^3 group with C27.
------------------------------------------------------------------------

sspToTrit : SSP.SSPTrit → Trit
sspToTrit SSP.sspNegOne = neg
sspToTrit SSP.sspZero = zer
sspToTrit SSP.sspPosOne = pos

tritToSSP : Trit → SSP.SSPTrit
tritToSSP neg = SSP.sspNegOne
tritToSSP zer = SSP.sspZero
tritToSSP pos = SSP.sspPosOne

sspRoundTrip :
  (x : SSP.SSPTrit) →
  tritToSSP (sspToTrit x) ≡ x
sspRoundTrip SSP.sspNegOne = refl
sspRoundTrip SSP.sspZero = refl
sspRoundTrip SSP.sspPosOne = refl

observer27ToLevel27 :
  Fabric.Ternary27Point → level27CuspFibre
observer27ToLevel27 p =
  sspToTrit (Fabric.x p)
    ∷ sspToTrit (Fabric.y p)
    ∷ sspToTrit (Fabric.z p)
    ∷ []

level27ToObserver27 :
  level27CuspFibre → Fabric.Ternary27Point
level27ToObserver27 (x ∷ y ∷ z ∷ []) =
  Fabric.ternary27Point
    (tritToSSP x)
    (tritToSSP y)
    (tritToSSP z)

