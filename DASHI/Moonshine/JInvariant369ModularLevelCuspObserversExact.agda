reflect6Involutive Base.hex-4 = refl
reflect6Involutive Base.hex-5 = refl

------------------------------------------------------------------------
-- 7. What it means for the actual j-phase quantisers to be modular-level
--    observers rather than merely equal-sector partitions.
------------------------------------------------------------------------

record J369ModularCuspObserverStructure
    (R : Render.JPhaseRenderingAlgebra) : Set₁ where
  constructor j369-modular-cusp-observer-structure
  field
    translatePhase3 : Render.Phase R → Render.Phase R
    translatePhase6 : Render.Phase R → Render.Phase R
    translatePhase9 : Render.Phase R → Render.Phase R
    translatePhase27 : Render.Phase R → Render.Phase R

    phase3IntertwinesCuspTranslation :
      (phase : Render.Phase R) →
      observer3ToLevel3
        (Render.phase3 R (translatePhase3 phase))
      ≡
      translateTriadic Q.one
        (observer3ToLevel3 (Render.phase3 R phase))

    phase6IntertwinesCuspTranslation :
      (phase : Render.Phase R) →
      Render.phase6 R (translatePhase6 phase)
      ≡
      translate6 (Render.phase6 R phase)

    phase9IntertwinesCuspTranslation :
      (phase : Render.Phase R) →
      observer9ToLevel9
        (Render.phase9 R (translatePhase9 phase))
      ≡
      translateTriadic Q.two
        (observer9ToLevel9 (Render.phase9 R phase))

    phase27IntertwinesCuspTranslation :
      (phase : Render.Phase R) →
      observer27ToLevel27
        (Render.phase27 R (translatePhase27 phase))
      ≡
      translateTriadic Q.three
        (observer27ToLevel27 (Render.phase27 R phase))

open J369ModularCuspObserverStructure public

------------------------------------------------------------------------
-- 8. Covering compatibility of the observer tower.
--
-- These equations are the finite shadow of the level-covering maps
--
--   X(27) -> X(9) -> X(3)
--
-- restricted to the canonical cusp-translation fibres.
------------------------------------------------------------------------

observer27ToObserver9ViaLevel :
  Fabric.Ternary27Point → Kernel.NineSheet
observer27ToObserver9ViaLevel p =
  level9ToObserver9
    (level27To9CoveringProjection (observer27ToLevel27 p))

observer9ToObserver3ViaLevel :
  Kernel.NineSheet → Kernel.KernelTrit
observer9ToObserver3ViaLevel p =
  level3ToObserver3
    (level9To3CoveringProjection (observer9ToLevel9 p))

observer27To9TranslationCommutes :
  (p : Fabric.Ternary27Point) →
  observer27ToObserver9ViaLevel (translateObserver27 p)
  ≡
  translateObserver9 (observer27ToObserver9ViaLevel p)
observer27To9TranslationCommutes p =
  trans
    (cong level9ToObserver9
      (cong level27To9CoveringProjection
        (level27ObserverRoundTrip
          (translateTriadic Q.three (observer27ToLevel27 p)))))
    (trans
      (cong level9ToObserver9
        (level27To9TranslationEquivariant (observer27ToLevel27 p)))
      (cong level9ToObserver9
        (cong (translateTriadic Q.two)
          (sym
            (level9ObserverRoundTrip
              (level27To9CoveringProjection
                (observer27ToLevel27 p)))))))

