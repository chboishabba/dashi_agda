------------------------------------------------------------------------

translate6 : Base.HexTruth → Base.HexTruth
translate6 Base.hex-0 = Base.hex-1
translate6 Base.hex-1 = Base.hex-2
translate6 Base.hex-2 = Base.hex-3
translate6 Base.hex-3 = Base.hex-4
translate6 Base.hex-4 = Base.hex-5
translate6 Base.hex-5 = Base.hex-0

reflect6 : Base.HexTruth → Base.HexTruth
reflect6 Base.hex-0 = Base.hex-0
reflect6 Base.hex-1 = Base.hex-5
reflect6 Base.hex-2 = Base.hex-4
reflect6 Base.hex-3 = Base.hex-3
reflect6 Base.hex-4 = Base.hex-2
reflect6 Base.hex-5 = Base.hex-1

translate6SixTimes :
  (x : Base.HexTruth) →
  translate6
    (translate6
      (translate6
        (translate6
          (translate6
            (translate6 x)))))
  ≡ x
translate6SixTimes Base.hex-0 = refl
translate6SixTimes Base.hex-1 = refl
translate6SixTimes Base.hex-2 = refl
translate6SixTimes Base.hex-3 = refl
translate6SixTimes Base.hex-4 = refl
translate6SixTimes Base.hex-5 = refl

reflect6Involutive :
  (x : Base.HexTruth) →
  reflect6 (reflect6 x) ≡ x
