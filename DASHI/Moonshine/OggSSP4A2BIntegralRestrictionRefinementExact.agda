------------------------------------------------------------------------
-- 2. Concrete cyclic group of order four.
------------------------------------------------------------------------

data C4 : Set where
  c4e :
    C4
  c4g :
    C4
  c4g2 :
    C4
  c4g3 :
    C4

combineC4 : C4 -> C4 -> C4
combineC4 c4e x = x
combineC4 c4g c4e = c4g
combineC4 c4g c4g = c4g2
combineC4 c4g c4g2 = c4g3
combineC4 c4g c4g3 = c4e
combineC4 c4g2 c4e = c4g2
combineC4 c4g2 c4g = c4g3
combineC4 c4g2 c4g2 = c4e
combineC4 c4g2 c4g3 = c4g
combineC4 c4g3 c4e = c4g3
combineC4 c4g3 c4g = c4e
combineC4 c4g3 c4g2 = c4g
combineC4 c4g3 c4g3 = c4g2

inverseC4 : C4 -> C4
inverseC4 c4e = c4e
inverseC4 c4g = c4g3
inverseC4 c4g2 = c4g2
inverseC4 c4g3 = c4g

------------------------------------------------------------------------
-- 3. Exact square-subgroup inclusion C2 -> C4.
------------------------------------------------------------------------

squareSubgroupEmbedding :
  C2.C2 ->
  C4
squareSubgroupEmbedding C2.identity = c4e
squareSubgroupEmbedding C2.flip = c4g2

squareSubgroupIdentity :
  squareSubgroupEmbedding C2.identity ≡ c4e
squareSubgroupIdentity = refl

squareSubgroupCombine :
  (a b : C2.C2) ->
  squareSubgroupEmbedding (C2.combineC2 a b)
  ≡
  combineC4
    (squareSubgroupEmbedding a)
    (squareSubgroupEmbedding b)
squareSubgroupCombine C2.identity C2.identity = refl
squareSubgroupCombine C2.identity C2.flip = refl
squareSubgroupCombine C2.flip C2.identity = refl
squareSubgroupCombine C2.flip C2.flip = refl

squareSubgroupInverse :
  (a : C2.C2) ->
  squareSubgroupEmbedding (C2.inverseC2 a)
  ≡
  inverseC4 (squareSubgroupEmbedding a)
squareSubgroupInverse C2.identity = refl
squareSubgroupInverse C2.flip = refl

squareGeneratorHasOrderTwo :
  combineC4 c4g2 c4g2 ≡ c4e
squareGeneratorHasOrderTwo = refl

fourAGeneratorSquaresToSquareSubgroupGenerator :
  combineC4 c4g c4g ≡ squareSubgroupEmbedding C2.flip
fourAGeneratorSquaresToSquareSubgroupGenerator = refl

------------------------------------------------------------------------
-- 4. Restriction of any invertible C4 action to the square C2 subgroup.
------------------------------------------------------------------------

restrictC4ActionToSquareC2 :
  {State : Set} ->
  Action.InvertibleSymmetryAction State C4 ->
  Action.InvertibleSymmetryAction State C2.C2
restrictC4ActionToSquareC2 action =
  Action.invertibleSymmetryAction
    C2.identity
    C2.combineC2
    C2.inverseC2
    restrictedAct
    restrictedIdentity
    restrictedCombine
    restrictedInverseLeft
    restrictedInverseRight
  where
    restrictedAct :
      C2.C2 ->
      State ->
      State
    restrictedAct symmetry state =
      Action.act action
        (squareSubgroupEmbedding symmetry)
        state

    restrictedIdentity :
      (state : State) ->
      restrictedAct C2.identity state ≡ state
    restrictedIdentity state =
      Action.identityActs action state

    restrictedCombine :
      (a b : C2.C2) ->
      (state : State) ->
      restrictedAct (C2.combineC2 a b) state
      ≡
      restrictedAct a (restrictedAct b state)
    restrictedCombine a b state =
      trans
        (cong
          (λ symmetry -> Action.act action symmetry state)
          (squareSubgroupCombine a b))
        (Action.combineActs action
          (squareSubgroupEmbedding a)
          (squareSubgroupEmbedding b)
          state)

    restrictedInverseLeft :
      (a : C2.C2) ->
      (state : State) ->
      restrictedAct (C2.inverseC2 a)
        (restrictedAct a state)
      ≡ state
    restrictedInverseLeft a state =
      trans
        (cong
          (λ symmetry ->
            Action.act action symmetry
              (Action.act action
                (squareSubgroupEmbedding a)
                state))
          (squareSubgroupInverse a))
        (Action.inverseLeftActs action
          (squareSubgroupEmbedding a)
          state)

    restrictedInverseRight :
      (a : C2.C2) ->
      (state : State) ->
      restrictedAct a
        (restrictedAct (C2.inverseC2 a) state)
      ≡ state
    restrictedInverseRight a state =
      trans
        (cong
          (λ symmetry ->
            Action.act action
              (squareSubgroupEmbedding a)
              (Action.act action symmetry state))
          (squareSubgroupInverse a))
        (Action.inverseRightActs action
          (squareSubgroupEmbedding a)
          state)

