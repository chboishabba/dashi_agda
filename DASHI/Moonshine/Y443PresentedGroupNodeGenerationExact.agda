module DASHI.Moonshine.Y443PresentedGroupNodeGenerationExact where

------------------------------------------------------------------------
-- CONSTRUCTIVE NODE-GENERATION FROM A LITERAL PRESENTED GROUP CARRIER.
--
-- A presented group is generated by the source nodes by construction.
-- Rather than assume the impredicative NodeGeneration eliminator as a
-- field, this owner builds it from the conventional quotient word
-- surjectivity certificate and an explicit signed-word grammar.
--
-- A concrete Monster/VOA action must still provide this EXACT selected
-- group's word-surjectivity, not a same-cardinality or label receipt.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_; refl)
import DASHI.Moonshine.Y443CoxeterPresentationExact as Y
import DASHI.Moonshine.Y443VNaturalPairGenerationExact as Pair
import DASHI.Moonshine.TwistedModuleModularity as TM

data SignedNodeExpression : Set where
  empty : SignedNodeExpression
  generator : Y.Node → SignedNodeExpression
  multiply : SignedNodeExpression → SignedNodeExpression → SignedNodeExpression
  inverse : SignedNodeExpression → SignedNodeExpression

interpret :
  ∀ {G} (gi : TM.GroupWithInverse G) →
  (nodes : Y.Node → G) →
  SignedNodeExpression → G
interpret gi nodes empty = Pair.identity gi
interpret gi nodes (generator n) = nodes n
interpret gi nodes (multiply l r) =
  Pair.multiply gi (interpret gi nodes l) (interpret gi nodes r)
interpret gi nodes (inverse w) =
  Pair.inverse gi (interpret gi nodes w)

record SyntaxWitness
  {G : Set} (gi : TM.GroupWithInverse G)
  (nodes : Y.Node → G) (g : G) : Set where
  constructor witnessed
  field
    sourceWord : SignedNodeExpression
    interpretation : interpret gi nodes sourceWord ≡ g

open SyntaxWitness public

record PresentedByY443Nodes
  {G : Set} (gi : TM.GroupWithInverse G)
  (nodes : Y.Node → G) : Set₁ where
  field
    -- This is the source presentation's ordinary quotient-surjectivity
    -- theorem. No external "all nodes generate" elimination assumed.
    allElementsHaveSourceWords :
      (g : G) → SyntaxWitness gi nodes g

open PresentedByY443Nodes public

cong : ∀ {A B : Set} (f : A → B) {x y : A} → x ≡ y → f x ≡ f y
cong f refl = refl

inductionOnSourceWord :
  ∀ {G} (gi : TM.GroupWithInverse G) (nodes : Y.Node → G) →
  (P : G → Set) →
  P (Pair.identity gi) →
  (∀ {x y} → P x → P y → P (Pair.multiply gi x y)) →
  (∀ {x} → P x → P (Pair.inverse gi x)) →
  ((n : Y.Node) → P (nodes n)) →
  (w : SignedNodeExpression) → P (interpret gi nodes w)
inductionOnSourceWord gi nodes P eid mulClosed invClosed genClosed empty =
  eid
inductionOnSourceWord gi nodes P eid mulClosed invClosed genClosed
  (generator n) =
  genClosed n
inductionOnSourceWord gi nodes P eid mulClosed invClosed genClosed
  (multiply l r) =
  mulClosed
    (inductionOnSourceWord gi nodes P eid mulClosed invClosed genClosed l)
    (inductionOnSourceWord gi nodes P eid mulClosed invClosed genClosed r)
inductionOnSourceWord gi nodes P eid mulClosed invClosed genClosed
  (inverse w) =
  invClosed
    (inductionOnSourceWord gi nodes P eid mulClosed invClosed genClosed w)

nodeGenerationFromPresentedSyntax :
  ∀ {G : Set} (gi : TM.GroupWithInverse G) (nodes : Y.Node → G) →
  PresentedByY443Nodes gi nodes →
  Pair.NodeGeneration gi nodes
nodeGenerationFromPresentedSyntax {G} gi nodes source = record
  { Pair.allFromNodes = proof
  }
  where
  proof :
    (P : G → Set) →
    P (Pair.identity gi) →
    (∀ {x y} → P x → P y → P (Pair.multiply gi x y)) →
    (∀ {x} → P x → P (Pair.inverse gi x)) →
    ((n : Y.Node) → P (nodes n)) →
    (x : G) → P x
  proof P eid mulClosed invClosed genClosed x
    with allElementsHaveSourceWords source x
  ... | witnessed word refl =
    inductionOnSourceWord gi nodes
      P eid mulClosed invClosed genClosed word
