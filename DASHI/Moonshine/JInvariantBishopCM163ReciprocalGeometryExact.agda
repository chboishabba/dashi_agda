    (P.≃-trans (P.+-cong P.≃-refl (P.*-congˡ squareDefect))
      (solve 3 (λ r x y → (((Κ (- (+ 81) / 82) ⊗ (((Κ (- (+ 41) / 1) ⊖ ((Κ (- (+ 1) / 2) ⊗ (x ⊕ Κ (+ 1 / 1))) ⊖ ((Κ (- (+ 1) / 2) ⊗ r) ⊗ (y ⊕ Κ (+ 0 / 1))))) ⊗ (x ⊖ Κ (- (+ 1) / 2))) ⊖ ((Κ (+ 0 / 1) ⊖ ((Κ (- (+ 1) / 2) ⊗ (y ⊕ Κ (+ 0 / 1))) ⊕ ((Κ (- (+ 1) / 2) ⊗ r) ⊗ (x ⊕ Κ (+ 1 / 1))))) ⊗ (y ⊖ (Κ (+ 1 / 2) ⊗ r))))) ⊖ ((Κ (- (+ 1) / 82) ⊗ r) ⊗ (((Κ (- (+ 41) / 1) ⊖ ((Κ (- (+ 1) / 2) ⊗ (x ⊕ Κ (+ 1 / 1))) ⊖ ((Κ (- (+ 1) / 2) ⊗ r) ⊗ (y ⊕ Κ (+ 0 / 1))))) ⊗ (y ⊖ (Κ (+ 1 / 2) ⊗ r))) ⊕ ((Κ (+ 0 / 1) ⊖ ((Κ (- (+ 1) / 2) ⊗ (y ⊕ Κ (+ 0 / 1))) ⊕ ((Κ (- (+ 1) / 2) ⊗ r) ⊗ (x ⊕ Κ (+ 1 / 1))))) ⊗ (x ⊖ Κ (- (+ 1) / 2)))))) ⊕ ((((((Κ (+ 0 / 1) ⊕ (Κ (+ 161 / 328) ⊗ x)) ⊕ Κ (+ 81 / 328)) ⊕ ((Κ (+ 1 / 164) ⊗ y) ⊗ y)) ⊕ ((Κ (- (+ 1) / 328) ⊗ r) ⊗ y)) ⊕ ((Κ (- (+ 1) / 164) ⊗ x) ⊗ x)) ⊗ Κ Q.0ℚᵘ)) ⊜ ((Κ (- (+ 81) / 82) ⊗ (((Κ (- (+ 41) / 1) ⊖ ((Κ (- (+ 1) / 2) ⊗ (x ⊕ Κ (+ 1 / 1))) ⊖ ((Κ (- (+ 1) / 2) ⊗ r) ⊗ (y ⊕ Κ (+ 0 / 1))))) ⊗ (x ⊖ Κ (- (+ 1) / 2))) ⊖ ((Κ (+ 0 / 1) ⊖ ((Κ (- (+ 1) / 2) ⊗ (y ⊕ Κ (+ 0 / 1))) ⊕ ((Κ (- (+ 1) / 2) ⊗ r) ⊗ (x ⊕ Κ (+ 1 / 1))))) ⊗ (y ⊖ (Κ (+ 1 / 2) ⊗ r))))) ⊖ ((Κ (- (+ 1) / 82) ⊗ r) ⊗ (((Κ (- (+ 41) / 1) ⊖ ((Κ (- (+ 1) / 2) ⊗ (x ⊕ Κ (+ 1 / 1))) ⊖ ((Κ (- (+ 1) / 2) ⊗ r) ⊗ (y ⊕ Κ (+ 0 / 1))))) ⊗ (y ⊖ (Κ (+ 1 / 2) ⊗ r))) ⊕ ((Κ (+ 0 / 1) ⊖ ((Κ (- (+ 1) / 2) ⊗ (y ⊕ Κ (+ 0 / 1))) ⊕ ((Κ (- (+ 1) / 2) ⊗ r) ⊗ (x ⊕ Κ (+ 1 / 1))))) ⊗ (x ⊖ Κ (- (+ 1) / 2))))))) P.≃-refl N.r x y))) ,
