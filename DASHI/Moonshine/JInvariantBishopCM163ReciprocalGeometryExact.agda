module DASHI.Moonshine.JInvariantBishopCM163ReciprocalGeometryExact where

-- SOURCE-WRITTEN. The original selected CM point and its reciprocal
-- degree-41 Möbius maps, with denominators cleared. Both conjugate
-- multipliers and all four finite product jet coefficients are explicit.
-- This module does not assert the analytic modular-polynomial identity.
open import Data.Integer.Base using (+_; -_)
open import Data.Rational.Unnormalised using (_/_)
import Data.Rational.Unnormalised as Q
open import Data.Product.Base using (_,_)
import Real as R
open R using (ℝ; _≃_; _+_; _-_; _*_; _⋆)
import RealProperties as P
import DASHI.Analysis.BishopComplexSeriesConvergenceExact as C
import DASHI.Analysis.BishopComplexAlgebraExact as A
open A using (_+C_; _-C_; _*C_)
open C using (_≈C_)
import DASHI.Foundations.BishopChudnovskySignedPeriodNormalizationExact as N
import DASHI.Foundations.BishopNatSquareRootSemanticSquareExact as SQ
import DASHI.Moonshine.JInvariantBishopCM163SelectedDiskExact as CM

realC : ℝ → C.BishopComplex
realC x = C.complex x R.0ℝ

squareDefect : (N.r * N.r - ((+ 163 / 1) ⋆)) ≃ R.0ℝ
squareDefect = P.≃-trans (P.+-cong (SQ.canonicalFloorSquareRootSquaresToNat 163) P.≃-refl)
  (P.+-inverseʳ ((+ 163 / 1) ⋆))

tau tauBar alpha beta : C.BishopComplex
tau = CM.tau
tauBar = C.complex (((- (+ 1)) / 2) ⋆) (((- (+ 1)) / 2) ⋆ * N.r)
alpha = C.complex (((- (+ 81)) / 82) ⋆) (((- (+ 1)) / 82) ⋆ * N.r)
beta = C.complex (((- (+ 81)) / 82) ⋆) (((+ 1 / 82) ⋆) * N.r)

-- Homogeneous numerator/denominator from S*A1 and T^-1*S*A0.
fNum fDen gNum gDen : C.BishopComplex → C.BishopComplex
fNum z = realC (((- (+ 41)) / 1) ⋆)
fDen z = z +C A.oneC
gNum z = realC (((- (+ 41)) / 1) ⋆) -C z
gDen z = z

cmQuadratic : ((tau *C tau) +C tau +C realC ((+ 41 / 1) ⋆)) ≈C A.zeroC
cmQuadratic = let open P.ℝ-Solver in
  (P.≃-trans (solve 1 (λ r → ((((Κ (- (+ 1) / 2) ⊗ Κ (- (+ 1) / 2)) ⊖ ((Κ (+ 1 / 2) ⊗ r) ⊗ (Κ (+ 1 / 2) ⊗ r))) ⊕ Κ (- (+ 1) / 2)) ⊕ Κ (+ 41 / 1)) ⊜ (Κ (+ 0 / 1) ⊕ ((Κ (+ 0 / 1) ⊕ Κ (- (+ 1) / 4)) ⊗ ((r ⊗ r) ⊖ Κ (+ 163 / 1))))) P.≃-refl N.r)
    (P.≃-trans (P.+-cong P.≃-refl (P.*-congˡ squareDefect))
      (solve 1 (λ r → (Κ (+ 0 / 1) ⊕ ((Κ (+ 0 / 1) ⊕ Κ (- (+ 1) / 4)) ⊗ Κ Q.0ℚᵘ)) ⊜ Κ (+ 0 / 1)) P.≃-refl N.r))) ,
  ((solve 1 (λ r → ((((Κ (- (+ 1) / 2) ⊗ (Κ (+ 1 / 2) ⊗ r)) ⊕ ((Κ (+ 1 / 2) ⊗ r) ⊗ Κ (- (+ 1) / 2))) ⊕ (Κ (+ 1 / 2) ⊗ r)) ⊕ Κ (+ 0 / 1)) ⊜ Κ (+ 0 / 1)) P.≃-refl N.r))

reciprocalMultipliers : (alpha *C beta) ≈C A.oneC
reciprocalMultipliers = let open P.ℝ-Solver in
  (P.≃-trans (solve 1 (λ r → ((Κ (- (+ 81) / 82) ⊗ Κ (- (+ 81) / 82)) ⊖ ((Κ (- (+ 1) / 82) ⊗ r) ⊗ (Κ (+ 1 / 82) ⊗ r))) ⊜ (Κ (+ 1 / 1) ⊕ ((Κ (+ 0 / 1) ⊕ Κ (+ 1 / 6724)) ⊗ ((r ⊗ r) ⊖ Κ (+ 163 / 1))))) P.≃-refl N.r)
    (P.≃-trans (P.+-cong P.≃-refl (P.*-congˡ squareDefect))
      (solve 1 (λ r → (Κ (+ 1 / 1) ⊕ ((Κ (+ 0 / 1) ⊕ Κ (+ 1 / 6724)) ⊗ Κ Q.0ℚᵘ)) ⊜ Κ (+ 1 / 1)) P.≃-refl N.r))) ,
  ((solve 1 (λ r → ((Κ (- (+ 81) / 82) ⊗ (Κ (+ 1 / 82) ⊗ r)) ⊕ ((Κ (- (+ 1) / 82) ⊗ r) ⊗ Κ (- (+ 81) / 82))) ⊜ Κ (+ 0 / 1)) P.≃-refl N.r))

multiplierTrace : (alpha +C beta) ≈C realC (((- (+ 81)) / 41) ⋆)
multiplierTrace = let open P.ℝ-Solver in
  ((solve 1 (λ r → (Κ (- (+ 81) / 82) ⊕ Κ (- (+ 81) / 82)) ⊜ Κ (- (+ 81) / 41)) P.≃-refl N.r)) ,
  ((solve 1 (λ r → ((Κ (- (+ 1) / 82) ⊗ r) ⊕ (Κ (+ 1 / 82) ⊗ r)) ⊜ Κ (+ 0 / 1)) P.≃-refl N.r))

forwardFixed : fNum tau ≈C (tau *C fDen tau)
forwardFixed = let open P.ℝ-Solver in
  (P.≃-trans (solve 1 (λ r → Κ (- (+ 41) / 1) ⊜ (((Κ (- (+ 1) / 2) ⊗ (Κ (- (+ 1) / 2) ⊕ Κ (+ 1 / 1))) ⊖ ((Κ (+ 1 / 2) ⊗ r) ⊗ ((Κ (+ 1 / 2) ⊗ r) ⊕ Κ (+ 0 / 1)))) ⊕ ((Κ (+ 0 / 1) ⊕ Κ (+ 1 / 4)) ⊗ ((r ⊗ r) ⊖ Κ (+ 163 / 1))))) P.≃-refl N.r)
    (P.≃-trans (P.+-cong P.≃-refl (P.*-congˡ squareDefect))
      (solve 1 (λ r → (((Κ (- (+ 1) / 2) ⊗ (Κ (- (+ 1) / 2) ⊕ Κ (+ 1 / 1))) ⊖ ((Κ (+ 1 / 2) ⊗ r) ⊗ ((Κ (+ 1 / 2) ⊗ r) ⊕ Κ (+ 0 / 1)))) ⊕ ((Κ (+ 0 / 1) ⊕ Κ (+ 1 / 4)) ⊗ Κ Q.0ℚᵘ)) ⊜ ((Κ (- (+ 1) / 2) ⊗ (Κ (- (+ 1) / 2) ⊕ Κ (+ 1 / 1))) ⊖ ((Κ (+ 1 / 2) ⊗ r) ⊗ ((Κ (+ 1 / 2) ⊗ r) ⊕ Κ (+ 0 / 1))))) P.≃-refl N.r))) ,
  ((solve 1 (λ r → Κ (+ 0 / 1) ⊜ ((Κ (- (+ 1) / 2) ⊗ ((Κ (+ 1 / 2) ⊗ r) ⊕ Κ (+ 0 / 1))) ⊕ ((Κ (+ 1 / 2) ⊗ r) ⊗ (Κ (- (+ 1) / 2) ⊕ Κ (+ 1 / 1))))) P.≃-refl N.r))

reverseFixed : gNum tau ≈C (tau *C gDen tau)
reverseFixed = let open P.ℝ-Solver in
  (P.≃-trans (solve 1 (λ r → (Κ (- (+ 41) / 1) ⊖ Κ (- (+ 1) / 2)) ⊜ (((Κ (- (+ 1) / 2) ⊗ Κ (- (+ 1) / 2)) ⊖ ((Κ (+ 1 / 2) ⊗ r) ⊗ (Κ (+ 1 / 2) ⊗ r))) ⊕ ((Κ (+ 0 / 1) ⊕ Κ (+ 1 / 4)) ⊗ ((r ⊗ r) ⊖ Κ (+ 163 / 1))))) P.≃-refl N.r)
    (P.≃-trans (P.+-cong P.≃-refl (P.*-congˡ squareDefect))
      (solve 1 (λ r → (((Κ (- (+ 1) / 2) ⊗ Κ (- (+ 1) / 2)) ⊖ ((Κ (+ 1 / 2) ⊗ r) ⊗ (Κ (+ 1 / 2) ⊗ r))) ⊕ ((Κ (+ 0 / 1) ⊕ Κ (+ 1 / 4)) ⊗ Κ Q.0ℚᵘ)) ⊜ ((Κ (- (+ 1) / 2) ⊗ Κ (- (+ 1) / 2)) ⊖ ((Κ (+ 1 / 2) ⊗ r) ⊗ (Κ (+ 1 / 2) ⊗ r)))) P.≃-refl N.r))) ,
  ((solve 1 (λ r → (Κ (+ 0 / 1) ⊖ (Κ (+ 1 / 2) ⊗ r)) ⊜ ((Κ (- (+ 1) / 2) ⊗ (Κ (+ 1 / 2) ⊗ r)) ⊕ ((Κ (+ 1 / 2) ⊗ r) ⊗ Κ (- (+ 1) / 2)))) P.≃-refl N.r))

