-- The two actual reciprocal branches are the projective degree-41
-- charts S*A1 and T^-1*S*A0; retain the minus scalar in their product.
forwardCM reverseCM : H.Rows
forwardCM = left S (chart (Fin.suc Fin.zero))
reverseCM = left (L.sl2z (Z.- (+ 1)) (Z.- (+ 1)) (+ 1) (+ 0) refl) (chart Fin.zero)
-- T^-1*S = [-1,-1;1,0].
forwardLiteral : forwardCM ≡ H.rows (L.lattice-point (+ 0) (Z.- (+ 41))) (L.lattice-point (+ 1) (+ 1))
forwardLiteral = refl

reverseLiteral : reverseCM ≡ H.rows (L.lattice-point (Z.- (+ 1)) (Z.- (+ 41))) (L.lattice-point (+ 1) (+ 0))
reverseLiteral = refl

mul : H.Rows → H.Rows → H.Rows
mul (H.rows (L.lattice-point a b) (L.lattice-point c d)) (H.rows u v) =
  H.rows (H.add (H.scale a u) (H.scale b v))
         (H.add (H.scale c u) (H.scale d v))

forwardReverse : mul forwardCM reverseCM ≡ H.rows (L.lattice-point (Z.- (+ 41)) (+ 0)) (L.lattice-point (+ 0) (Z.- (+ 41)))
forwardReverse = refl

reverseForward : mul reverseCM forwardCM ≡ H.rows (L.lattice-point (Z.- (+ 41)) (+ 0)) (L.lattice-point (+ 0) (Z.- (+ 41)))
reverseForward = refl
