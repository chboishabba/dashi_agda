chart : Fin 42 → H.Rows
chart i = H.chartImage i identityRows

S T : L.SL2Z
S = L.sl2z (+ 0) (Z.- (+ 1)) (+ 1) (+ 0) refl
T = L.sl2z (+ 1) (+ 1) (+ 0) (+ 1) refl

right : H.Rows → L.SL2Z → H.Rows
right (H.rows u v) g = H.rows (L.forwardIndex g u) (L.forwardIndex g v)

left : L.SL2Z → H.Rows → H.Rows
left g (H.rows u v) =
