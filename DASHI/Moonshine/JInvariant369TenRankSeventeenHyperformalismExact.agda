------------------------------------------------------------------------
-- 8. Generic ternary rank fibre and finite pants path are the same finite
--    vector shape.  This is combinatorial path/gluing syntax, not a smooth
--    pair-of-pants surface theorem.
------------------------------------------------------------------------

TernaryRankFibre : Nat → Set
TernaryRankFibre n = Vec SSP.SSPTrit n

adjoinTernaryCoordinate :
  ∀ {n} →
  SSP.SSPTrit →
  TernaryRankFibre n →
  TernaryRankFibre (suc n)
adjoinTernaryCoordinate trit fibre =
  trit vcons fibre

forgetAdjoinedCoordinate :
  ∀ {n} →
  TernaryRankFibre (suc n) →
  TernaryRankFibre n
forgetAdjoinedCoordinate (trit vcons fibre) =
  fibre

forgetAfterAdjoin :
  ∀ {n}
    (trit : SSP.SSPTrit)
    (fibre : TernaryRankFibre n) →
  forgetAdjoinedCoordinate (adjoinTernaryCoordinate trit fibre)
  ≡ fibre
forgetAfterAdjoin trit fibre = refl

rankFibreToPantsPath :
  ∀ {n} →
  TernaryRankFibre n →
  PantsFrontier.PantsPath n
rankFibreToPantsPath =
  map (λ trit → Pants369.kernelToSlot (Pants369.sspToKernel trit))

pantsPathToRankFibre :
  ∀ {n} →
  PantsFrontier.PantsPath n →
  TernaryRankFibre n
pantsPathToRankFibre =
  map (λ slot → Pants369.kernelToSSP (Pants369.slotToKernel slot))

rankPantsRoundTrip :
  ∀ {n}
    (fibre : TernaryRankFibre n) →
  pantsPathToRankFibre (rankFibreToPantsPath fibre)
  ≡ fibre
rankPantsRoundTrip vnil = refl
rankPantsRoundTrip (trit vcons rest)
  rewrite Pants369.kernelSlotRoundTrip (Pants369.sspToKernel trit)
        | Pants369.sspKernelRoundTrip trit
        | rankPantsRoundTrip rest
  = refl

pantsRankRoundTrip :
  ∀ {n}
    (path : PantsFrontier.PantsPath n) →
  rankFibreToPantsPath (pantsPathToRankFibre path)
  ≡ path
pantsRankRoundTrip vnil = refl
pantsRankRoundTrip (slot vcons rest)
  rewrite Pants369.kernelSSPRoundTrip (Pants369.slotToKernel slot)
        | Pants369.slotKernelRoundTrip slot
        | pantsRankRoundTrip rest
  = refl

