------------------------------------------------------------------------
-- 3. D4-oriented ten <-> completion ten <-> macro Fine10.
--
-- The first bridge is already C2-equivariant in-repo.  We compose it with the
-- explicit Fine10 codec, obtaining a real finite equivariant bridge among
-- independently motivated ten-state presentations.
------------------------------------------------------------------------

d4ToMacro10 :
  D4Ten.D4OrientedSector →
  Pointed.Fine10
d4ToMacro10 sector =
  completionToFine10 (D4Ten.sectorToCompletedFine sector)

macro10ToD4 :
  Pointed.Fine10 →
  D4Ten.D4OrientedSector
macro10ToD4 state =
  D4Ten.completedFineToSector (fine10ToCompletion state)

d4MacroRoundTrip :
  (sector : D4Ten.D4OrientedSector) →
  macro10ToD4 (d4ToMacro10 sector) ≡ sector
d4MacroRoundTrip sector
  rewrite completionFine10RoundTrip (D4Ten.sectorToCompletedFine sector)
  = D4Ten.sectorRoundTrip sector

macroD4RoundTrip :
  (state : Pointed.Fine10) →
  d4ToMacro10 (macro10ToD4 state) ≡ state
macroD4RoundTrip state
  rewrite D4Ten.completedFineRoundTrip (fine10ToCompletion state)
        | fine10CompletionRoundTrip state
  = refl

d4FlipIntertwinesMacroComplement :
  (sector : D4Ten.D4OrientedSector) →
  d4ToMacro10 (D4Ten.flipSector sector)
  ≡
  macroComplement (d4ToMacro10 sector)
d4FlipIntertwinesMacroComplement sector
  rewrite D4Ten.sectorComplementEquivariant sector
        | completionFine10RoundTrip (D4Ten.sectorToCompletedFine sector)
  = refl

