cancelLeft : ∀ d i x y → (i *C d) ≈C A.oneC →
  (d *C x) ≈C (d *C y) → x ≈C y
cancelLeft d i x y hi h =
  complexTrans (complexSym (L.complexMultiplyLeftIdentity x))
    (complexTrans (A.mulCCongruent (complexSym hi) (C.≈C-refl x))
      (complexTrans (L.complexMultiplyAssociative i d x)
        (complexTrans (A.mulCCongruent (C.≈C-refl i) h)
          (complexTrans (complexSym (L.complexMultiplyAssociative i d y))
            (complexTrans (A.mulCCongruent hi (C.≈C-refl y))
              (L.complexMultiplyLeftIdentity y))))))

module AtDisk {q : BishopComplex} {r : R.ℝ} (input : Disk.BishopUnitDiskQ q r) where
  module Rw = Lim.AtDisk input
  nz = Rw.gapGuard
  g = gapMinus q
  i = Rec.reciprocalC g nz
  d = square g
  u = D.X q nz

  squareCancels : (d *C square i) ≈C A.oneC
  squareCancels = complexTrans (G.shuffle g g i i)
    (complexTrans (A.mulCCongruent (Rec.multiplyReciprocal g nz) (Rec.multiplyReciprocal g nz))
      (L.complexMultiplyLeftIdentity A.oneC))

  du : (d *C u) ≈C q
  du = complexTrans (complexSym (L.complexMultiplyAssociative d q (square i)))
    (complexTrans (A.mulCCongruent (L.complexMultiplyCommutative d q) (C.≈C-refl _))
      (complexTrans (L.complexMultiplyAssociative q d (square i))
        (complexTrans (A.mulCCongruent (C.≈C-refl q) squareCancels)
          (L.complexMultiplyRightIdentity q))))

  tail4Read : Rw.Row4.Fin.tail 0 ≈C (q *C head4 q)
  tail4Read = A.mulCCongruent (L.complexMultiplyRightIdentity q) (head4Read q)

  tail6Read : Rw.Row6.Fin.tail 0 ≈C (q *C head6 q)
  tail6Read = A.mulCCongruent (L.complexMultiplyRightIdentity q) (head6Read q)

  clear4Read : (Rw.Row4.den *C P4 u) ≈C Rw.Row4.Fin.tail 0
  clear4Read = complexTrans (A.mulCCongruent (power4Read g) (C.≈C-refl _))
    (complexTrans (clear4 d u)
      (complexTrans (A.mulCCongruent du
        (A.addCCongruent (C.≈C-refl d) (D.scaleCong 6 du)))
        (complexSym tail4Read)))

  clear6Read : (Rw.Row6.den *C P6 u) ≈C Rw.Row6.Fin.tail 0
  clear6Read = complexTrans (A.mulCCongruent (power6Read g) (C.≈C-refl _))
    (complexTrans (clear6 d u)
      (complexTrans (A.mulCCongruent du
        (A.addCCongruent
          (A.addCCongruent (C.≈C-refl (square d))
            (D.scaleCong 30 (A.mulCCongruent du (C.≈C-refl d))))
          (D.scaleCong 120 (A.mulCCongruent du du))))
        (complexSym tail6Read)))

  fourierRow4 : Rw.row 3 ≈C P4 u
  fourierRow4 = cancelLeft Rw.Row4.den Rw.Row4.inv (Rw.row 3) (P4 u)
    (complexTrans (L.complexMultiplyCommutative Rw.Row4.inv Rw.Row4.den)
      (Lim.cancelPower g nz 4))
    (complexTrans Rw.Row4.clearedLimit (complexSym clear4Read))

  fourierRow6 : Rw.row 5 ≈C P6 u
  fourierRow6 = cancelLeft Rw.Row6.den Rw.Row6.inv (Rw.row 5) (P6 u)
    (complexTrans (L.complexMultiplyCommutative Rw.Row6.inv Rw.Row6.den)
      (Lim.cancelPower g nz 6))
    (complexTrans Rw.Row6.clearedLimit (complexSym clear6Read))
