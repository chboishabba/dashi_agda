square : BishopComplex → BishopComplex
square q = q *C q

cube : BishopComplex → BishopComplex
cube q = q *C square q

head4 : BishopComplex → BishopComplex
head4 q = square (gapMinus q) +C scale 6 q

head6 : BishopComplex → BishopComplex
head6 q = (square (square (gapMinus q)) +C scale 30 (q *C square (gapMinus q)))
  +C scale 120 (square q)

