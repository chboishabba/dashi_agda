module DASHI.Moonshine.Y443PublishedQuotientIsoCompositionExact where

------------------------------------------------------------------------
-- TWO INDEPENDENT GROUP IDENTIFICATIONS -> SELECTED GROUP = MONSTER.
--
-- Q is the TRUE original 80-relator group, not a free group nor one of
-- its arbitrary quotients. The actual Ivanov/Bray theorem identifies Q
-- with canonical M. Independently the selected DASHI G must be proved
-- isomorphic to Q (NOT merely satisfy 80 relators and generated by nodes).
-- This module CONSTRUCTS the G-to-M equivalence and every group law
-- from those two same-Q facts. It never accepts a trivial Q quotient.
------------------------------------------------------------------------

open import Agda.Builtin.Equality using (_≡_; refl)

import DASHI.Moonshine.TwistedModuleModularity as TM
import DASHI.Moonshine.Y443VNaturalPairGenerationExact as Pair
import DASHI.Moonshine.Y443FLMConcreteVOAGroupTransportExact as Transport
import DASHI.Moonshine.VertexOperatorAlgebraCore as VOA

sym : ∀ {A : Set} {a b : A} → a ≡ b → b ≡ a
sym refl = refl

trans : ∀ {A : Set} {a b c : A} → a ≡ b → b ≡ c → a ≡ c
trans refl p = p

cong : ∀ {A B : Set} (f : A → B) {a b : A} → a ≡ b → f a ≡ f b
cong f refl = refl

cong₂ : ∀ {A B C : Set} (f : A → B → C)
  {a b : A} {c d : B} → a ≡ b → c ≡ d → f a c ≡ f b d
cong₂ f refl refl = refl

module Selected
  (V : VOA.VertexOperatorAlgebra)
  {Q G H : Set}
  (qgi : TM.GroupWithInverse Q)
  (ggi : TM.GroupWithInverse G)
  (hgi : TM.GroupWithInverse H) where

  module T = Transport.Transport V V

  record SamePublishedQuotient : Set where
    field
      -- Source owner: Q -> G, with NO extra relations in selected G.
      selectedQuotientIsomorphism :
        T.ExactY443MonsterGroupIso qgi ggi
      -- Ivanov/Bray source: exactly the SAME quotient Q -> published M.
      ivanovQuotientMonsterIsomorphism :
        T.ExactY443MonsterGroupIso qgi hgi
  open SamePublishedQuotient public

  fromPreservesProduct :
    ∀ {X Y : Set}
    (xi : TM.GroupWithInverse X)
    (yi : TM.GroupWithInverse Y)
    (iso : T.ExactY443MonsterGroupIso xi yi)
    (a b : Y) →
    T.fromMonster iso (Pair.multiply yi a b)
    ≡ Pair.multiply xi (T.fromMonster iso a) (T.fromMonster iso b)
  fromPreservesProduct xi yi iso a b =
    trans
      (cong (T.fromMonster iso)
        (cong₂ (Pair.multiply yi)
          (sym (T.toMonsterAfterFrom iso a))
          (sym (T.toMonsterAfterFrom iso b))))
      (trans
        (cong (T.fromMonster iso)
          (sym (T.preservesProduct iso
            (T.fromMonster iso a) (T.fromMonster iso b))))
        (T.fromMonsterAfterTo iso
          (Pair.multiply xi
            (T.fromMonster iso a)
            (T.fromMonster iso b))))

  fromPreservesIdentity :
    ∀ {X Y : Set}
    (xi : TM.GroupWithInverse X)
    (yi : TM.GroupWithInverse Y)
    (iso : T.ExactY443MonsterGroupIso xi yi) →
    T.fromMonster iso (Pair.identity yi) ≡ Pair.identity xi
  fromPreservesIdentity xi yi iso =
    trans
      (cong (T.fromMonster iso)
        (sym (T.preservesIdentity iso)))
      (T.fromMonsterAfterTo iso (Pair.identity xi))

  fromPreservesInverse :
    ∀ {X Y : Set}
    (xi : TM.GroupWithInverse X)
    (yi : TM.GroupWithInverse Y)
    (iso : T.ExactY443MonsterGroupIso xi yi)
    (a : Y) →
    T.fromMonster iso (Pair.inverse yi a)
    ≡ Pair.inverse xi (T.fromMonster iso a)
  fromPreservesInverse xi yi iso a =
    trans
      (cong (T.fromMonster iso)
        (cong (Pair.inverse yi)
          (sym (T.toMonsterAfterFrom iso a))))
      (trans
        (cong (T.fromMonster iso)
          (sym (T.preservesInverse iso (T.fromMonster iso a))))
        (T.fromMonsterAfterTo iso
          (Pair.inverse xi (T.fromMonster iso a))))

  selectedToMonster :
    (source : SamePublishedQuotient) → G → H
  selectedToMonster src g =
    T.toMonster (ivanovQuotientMonsterIsomorphism src)
      (T.fromMonster (selectedQuotientIsomorphism src) g)

  monsterToSelected :
    (source : SamePublishedQuotient) → H → G
  monsterToSelected src h =
    T.toMonster (selectedQuotientIsomorphism src)
      (T.fromMonster (ivanovQuotientMonsterIsomorphism src) h)

  composedInverseLeft :
    (source : SamePublishedQuotient) (g : G) →
    monsterToSelected source (selectedToMonster source g) ≡ g
  composedInverseLeft source g =
    trans
      (cong (T.toMonster (selectedQuotientIsomorphism source))
        (T.fromMonsterAfterTo
          (ivanovQuotientMonsterIsomorphism source)
          (T.fromMonster (selectedQuotientIsomorphism source) g)))
      (T.toMonsterAfterFrom (selectedQuotientIsomorphism source) g)

  composedInverseRight :
    (source : SamePublishedQuotient) (h : H) →
    selectedToMonster source (monsterToSelected source h) ≡ h
  composedInverseRight source h =
    trans
      (cong (T.toMonster (ivanovQuotientMonsterIsomorphism source))
        (T.fromMonsterAfterTo
          (selectedQuotientIsomorphism source)
          (T.fromMonster (ivanovQuotientMonsterIsomorphism source) h)))
      (T.toMonsterAfterFrom (ivanovQuotientMonsterIsomorphism source) h)

  composedPreservesProduct :
    (source : SamePublishedQuotient) (a b : G) →
    selectedToMonster source (Pair.multiply ggi a b)
    ≡ Pair.multiply hgi
        (selectedToMonster source a)
        (selectedToMonster source b)
  composedPreservesProduct source a b =
    trans
      (cong (T.toMonster (ivanovQuotientMonsterIsomorphism source))
        (fromPreservesProduct qgi ggi
          (selectedQuotientIsomorphism source) a b))
      (T.preservesProduct
        (ivanovQuotientMonsterIsomorphism source)
        (T.fromMonster (selectedQuotientIsomorphism source) a)
        (T.fromMonster (selectedQuotientIsomorphism source) b))

  composedPreservesIdentity :
    (source : SamePublishedQuotient) →
    selectedToMonster source (Pair.identity ggi) ≡ Pair.identity hgi
  composedPreservesIdentity source =
    trans
      (cong (T.toMonster (ivanovQuotientMonsterIsomorphism source))
        (fromPreservesIdentity qgi ggi
          (selectedQuotientIsomorphism source)))
      (T.preservesIdentity (ivanovQuotientMonsterIsomorphism source))

  composedPreservesInverse :
    (source : SamePublishedQuotient) (g : G) →
    selectedToMonster source (Pair.inverse ggi g)
    ≡ Pair.inverse hgi (selectedToMonster source g)
  composedPreservesInverse source g =
    trans
      (cong (T.toMonster (ivanovQuotientMonsterIsomorphism source))
        (fromPreservesInverse qgi ggi
          (selectedQuotientIsomorphism source) g))
      (T.preservesInverse
        (ivanovQuotientMonsterIsomorphism source)
        (T.fromMonster (selectedQuotientIsomorphism source) g))

  composedMonsterIsomorphism :
    (source : SamePublishedQuotient) →
    T.ExactY443MonsterGroupIso ggi hgi
  composedMonsterIsomorphism source = record
    { T.toMonster = selectedToMonster source
    ; T.fromMonster = monsterToSelected source
    ; T.fromMonsterAfterTo = composedInverseLeft source
    ; T.toMonsterAfterFrom = composedInverseRight source
    ; T.preservesIdentity = composedPreservesIdentity source
    ; T.preservesProduct = composedPreservesProduct source
    ; T.preservesInverse = composedPreservesInverse source
    }
