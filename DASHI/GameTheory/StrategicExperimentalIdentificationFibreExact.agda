module DASHI.GameTheory.StrategicExperimentalIdentificationFibreExact where

open import DASHI.Core.Prelude
open import Agda.Builtin.Bool using (Bool; false; true)
open import Agda.Builtin.String using (String)
open import Data.Empty using (⊥)

import DASHI.Core.ConsumerIndexedTrajectoryFibreAdequacyExact as Fibre
import DASHI.Biology.CausalIdentificationFamiliesExact as Causal

------------------------------------------------------------------------
-- STRATEGIC MODEL IDENTIFICATION AS A CONSUMER-INDEXED FIBRE PROBLEM
--
-- Observed play can be generated by distinct latent strategic models.  Whether
-- an observation is adequate therefore depends on the downstream question:
-- prediction of current action, player preference, information state,
-- counterfactual response, mechanism type, etc.  Same observed play does not
-- identify all of these targets.
------------------------------------------------------------------------

record StrategicIdentificationSurface : Set₁ where
  constructor strategic-identification-surface
  field
    LatentModel Observation Query Answer : Set

    observe : LatentModel → Observation
    answer : Query → LatentModel → Answer

    modelReference : String
    observationReference : String
    queryReference : String

open StrategicIdentificationSurface public

asConsumerIndexedFibreSystem :
  StrategicIdentificationSurface →
  Fibre.ConsumerIndexedFibreSystem
asConsumerIndexedFibreSystem S =
  Fibre.consumerIndexedFibreSystem
    (LatentModel S)
    (Observation S)
    (Query S)
    (Answer S)
    (observe S)
    (answer S)
    "Strategic observation adequacy is query-relative; identical observed play may leave preference, information, mechanism, or counterfactual response unresolved."

IdentifiedForQuery :
  (S : StrategicIdentificationSurface) →
  Query S → Set₁
IdentifiedForQuery S query =
  Fibre.AdequateForConsumer (asConsumerIndexedFibreSystem S) query

StrategicIdentificationDefect :
  (S : StrategicIdentificationSurface) →
  Query S → Set
StrategicIdentificationDefect S query =
  Fibre.ConsumerAdequacyDefect (asConsumerIndexedFibreSystem S) query

record SameObservedPlayDifferentStrategicAnswer
    (S : StrategicIdentificationSurface)
    (query : Query S) : Set where
  constructor same-observed-play-different-strategic-answer
  field
    leftModel rightModel : LatentModel S
    sameObservation : observe S leftModel ≡ observe S rightModel
    differentAnswer :
      answer S query leftModel ≡ answer S query rightModel → ⊥

open SameObservedPlayDifferentStrategicAnswer public

observationCollisionCreatesIdentificationDefect :
  ∀ {S query} →
  SameObservedPlayDifferentStrategicAnswer S query →
  StrategicIdentificationDefect S query
observationCollisionCreatesIdentificationDefect {S} {query} witness =
  Fibre.sameObservationDifferentAnswerGivesDefect
    (Fibre.same-observation-different-consumer-answer
      (leftModel witness)
      (rightModel witness)
      (sameObservation witness)
      (differentAnswer witness))

identificationDefectBlocksIdentification :
  ∀ {S query} →
  StrategicIdentificationDefect S query →
  IdentifiedForQuery S query →
  ⊥
identificationDefectBlocksIdentification = Fibre.consumerAdequacyDefectBlocksAdequacy

------------------------------------------------------------------------
-- Experiment/refinement receipt.
------------------------------------------------------------------------

record StrategicExperimentRefinement
    (S : StrategicIdentificationSurface)
    (query : Query S) : Set₁ where
  constructor strategic-experiment-refinement
  field
    refinement :
      Fibre.ConsumerRefinementReceipt
        (asConsumerIndexedFibreSystem S)
        query

    causalFamily : Causal.CausalIdentificationFamily
    causalFamilyReceipt : Causal.IdentificationFamilyReceipt causalFamily

    interventionReference : String
    measurementReference : String
    refinementReference : String

open StrategicExperimentRefinement public

refinedExperimentIdentifiesSelectedQuery :
  ∀ {S query} →
  StrategicExperimentRefinement S query →
  Fibre.AdequateForConsumer
    (record
      { State = LatentModel S
      ; Observation = Fibre.RefinedObservation (refinement _)
      ; Consumer = Query S
      ; Answer = Answer S
      ; observe = Fibre.refine (refinement _)
      ; answer = answer S
      ; systemReading = "experiment-refined strategic observation"
      })
    query
refinedExperimentIdentifiesSelectedQuery {S} {query} experiment =
  Fibre.fibreConstancyGivesConsumerAdequacy
    (Fibre.fibre-constant-for-consumer
      (Fibre.refinedAnswer (refinement experiment))
      (Fibre.targetDescendsAfterRefinement (refinement experiment)))

------------------------------------------------------------------------
-- Firewalls.
------------------------------------------------------------------------

data ObservedActionMeansPreferenceIdentifiedPermission : Set where

data ObservedEquilibriumMeansGameIdentifiedPermission : Set where

data SamePayoffMeansSameInformationPermission : Set where

data RandomisationMeansPreferenceTruthPermission : Set where

data OneExperimentIdentifiesAllQueriesPermission : Set where

data StrategicIdentificationMeansHistoricalIntentPermission : Set where

data ModelFitMeansCausalIdentificationPermission : Set where

observedActionDoesNotIdentifyPreference :
  ObservedActionMeansPreferenceIdentifiedPermission → ⊥
observedActionDoesNotIdentifyPreference ()

observedEquilibriumDoesNotIdentifyUniqueGame :
  ObservedEquilibriumMeansGameIdentifiedPermission → ⊥
observedEquilibriumDoesNotIdentifyUniqueGame ()

samePayoffDoesNotIdentifyInformationState :
  SamePayoffMeansSameInformationPermission → ⊥
samePayoffDoesNotIdentifyInformationState ()

randomisationDoesNotCreatePreferenceTruth :
  RandomisationMeansPreferenceTruthPermission → ⊥
randomisationDoesNotCreatePreferenceTruth ()

oneExperimentDoesNotIdentifyEveryStrategicQuery :
  OneExperimentIdentifiesAllQueriesPermission → ⊥
oneExperimentDoesNotIdentifyEveryStrategicQuery ()

identifiedStrategicModelDoesNotRecoverHistoricalIntent :
  StrategicIdentificationMeansHistoricalIntentPermission → ⊥
identifiedStrategicModelDoesNotRecoverHistoricalIntent ()

modelFitDoesNotCreateCausalIdentification :
  ModelFitMeansCausalIdentificationPermission → ⊥
modelFitDoesNotCreateCausalIdentification ()

record StrategicExperimentalIdentificationBoundary : Set where
  constructor strategic-experimental-identification-boundary
  field
    strategicIdentificationConsumerIndexed : Bool
    observationCollisionCanRefuteIdentification : Bool
    experimentalRefinementCanRestoreSelectedQuery : Bool
    causalDesignReceiptSeparate : Bool
    oneExperimentAutomaticallyIdentifiesAllQueries : Bool
    observedPlayAutomaticallyRevealsPreference : Bool

canonicalStrategicExperimentalIdentificationBoundary :
  StrategicExperimentalIdentificationBoundary
canonicalStrategicExperimentalIdentificationBoundary =
  strategic-experimental-identification-boundary
    true true true true false false
