    ℓ : ℤ

next : Scale → Scale
next s = s

record Tower : Set₁ where
  field
    S   : Scale → Set           -- states at level ℓ
    R   : ∀ {ℓ} → S ℓ → S (next ℓ)  -- renormalize / refine
    P   : ∀ {ℓ} → S ℓ → S ℓ        -- projection to invariants
    C   : ∀ {ℓ} → S ℓ → S ℓ        -- canonical representative

