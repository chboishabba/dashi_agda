-- 1. Causal substrate: poset / causal set

record Poset (E : Set) : Set₁ where
  field
    _≺_     : E → E → Set
    -- minimal poset axioms
    irrefl  : ∀ {a} → ¬ (a ≺ a)
    trans   : ∀ {a b c} → a ≺ b → b ≺ c → a ≺ c
    -- you may want antisymmetry if you use ≤, or keep it a strict order

