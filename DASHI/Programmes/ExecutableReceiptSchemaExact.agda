module DASHI.Programmes.ExecutableReceiptSchemaExact where

open import DASHI.Core.Prelude

------------------------------------------------------------------------
-- Executable receipt schemas generated by BIDI.
--
-- These records do not prove a satellite result.  They state the smallest
-- runtime evidence surface that the current Agda consumers can accept without
-- conflating finite empirical observations with global theorems.
------------------------------------------------------------------------

record BrainKernelRunReceipt : Set where
  constructor brainKernelRunReceipt
  field
    fixedPointObserved : Bool
    defectNonincreasingObserved : Bool
    idempotentAtFinalObserved : Bool
    finiteRunOnly : Bool
    finiteRunOnlyIsTrue : finiteRunOnly ≡ true

    globalIdempotenceClaimed : Bool
    globalIdempotenceClaimedIsFalse : globalIdempotenceClaimed ≡ false

    globalDefectMonotonicityClaimed : Bool
    globalDefectMonotonicityClaimedIsFalse :
      globalDefectMonotonicityClaimed ≡ false

    globalContractionClaimed : Bool
    globalContractionClaimedIsFalse : globalContractionClaimed ≡ false

open BrainKernelRunReceipt public

------------------------------------------------------------------------
-- dashiCFD residual-atom probe.
--
-- The executable already reports a selected finite Gram spectrum.  BIDI says
-- the missing theorem-facing receipt is not another selected-dictionary scalar;
-- it is a uniform frame statement over the declared admissible family.
------------------------------------------------------------------------

record CFDSelectedAtomProbeReceipt : Set where
  constructor cfdSelectedAtomProbeReceipt
  field
    selectedLowerGramPositive : Bool
    selectedFrameOnly : Bool
    selectedFrameOnlyIsTrue : selectedFrameOnly ≡ true

    uniformLowerFrameBoundProved : Bool
    gate3NormComparisonProved : Bool
    smoothNSRegularityClaimed : Bool
    smoothNSRegularityClaimedIsFalse : smoothNSRegularityClaimed ≡ false

open CFDSelectedAtomProbeReceipt public

record CFDUniformFramePromotionReceipt : Set where
  constructor cfdUniformFramePromotionReceipt
  field
    uniformLowerFrameBound : Set
    uniformUpperFrameBound : Set
    normComparison : Set

------------------------------------------------------------------------
-- FRACDASH compiler bridge.
--
-- Runtime parity is useful regression evidence, but the theorem consumer wants
-- the one-step semantic commuting square plus decoder/readout commutation.
------------------------------------------------------------------------

record FRACDASHExecutableReceipt : Set where
  constructor fracdashExecutableReceipt
  field
    oneStepCompilerCommutation : Set
    decoderReadoutCommutation : Set
    signedIRRealisation : Set

------------------------------------------------------------------------
-- Grokking / dashifine validation.
--
-- A numerical fit remains indexed by the concrete member and task.  A family
-- promotion needs a held-out receipt for every admitted member of the declared
-- extension family.
------------------------------------------------------------------------

record HeldOutLearningReceipt : Set₁ where
  constructor heldOutLearningReceipt
  field
    Member : Set
    Baseline : Member → Set
    HeldOut : Member → Set
    baselineReceipt : (member : Member) → Baseline member → Set
    heldOutReceipt : (member : Member) → HeldOut member → Set

open HeldOutLearningReceipt public

------------------------------------------------------------------------
-- dashitest / generic heterogeneous experiment output.
------------------------------------------------------------------------

record TypedExperimentArtifactReceipt : Set₁ where
  constructor typedExperimentArtifactReceipt
  field
    Evidence State Prediction : Set
    compatibleStateWitness : Evidence → State → Set
    predictionReadout : State → Prediction
    provenanceReceipt : Set

------------------------------------------------------------------------
-- Receipt hierarchy / anti-promotion boundary.
------------------------------------------------------------------------

record ExecutableReceiptBoundary : Set where
  constructor executableReceiptBoundary
  field
    finiteRunObservationIsGlobalTheorem : Bool
    finiteRunObservationIsGlobalTheoremIsFalse :
      finiteRunObservationIsGlobalTheorem ≡ false

    selectedGramIsUniformFrameTheorem : Bool
    selectedGramIsUniformFrameTheoremIsFalse :
      selectedGramIsUniformFrameTheorem ≡ false

    benchmarkParityIsCompilerCommutation : Bool
    benchmarkParityIsCompilerCommutationIsFalse :
      benchmarkParityIsCompilerCommutation ≡ false

    heldOutReceiptCanCloseDeclaredFamilyGap : Bool
    heldOutReceiptCanCloseDeclaredFamilyGapIsTrue :
      heldOutReceiptCanCloseDeclaredFamilyGap ≡ true

canonicalExecutableReceiptBoundary : ExecutableReceiptBoundary
canonicalExecutableReceiptBoundary =
  executableReceiptBoundary
    false refl
    false refl
    false refl
    true refl
