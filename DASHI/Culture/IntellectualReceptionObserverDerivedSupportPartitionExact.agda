module DASHI.Culture.IntellectualReceptionObserverDerivedSupportPartitionExact where

------------------------------------------------------------------------
-- INTELLECTUAL RECEPTION / OBSERVER-DERIVED SUPPORT PARTITION
--
-- Shared/divergent coordinates are derived from one explicit finite observer
-- evaluated on the early/late histories at t1.  The resulting receipts are then
-- transported into the existing support-partition retain/reopen calculus.
------------------------------------------------------------------------

open import DASHI.Core.Prelude

import DASHI.Culture.IntellectualReceptionHistoryTimeIndexedFibreExact as Fibre
import DASHI.Culture.IntellectualReceptionTemporalMultiResidueAdmissibilityExact as Temporal
import DASHI.Culture.IntellectualReceptionSharedObservedPrefixCertificateReuseExact as Reuse
import DASHI.Culture.IntellectualReceptionSupportPartitionRetainReopenExact as Partition

------------------------------------------------------------------------
-- 1. One uniform observer language for the coordinates compared at t1.
------------------------------------------------------------------------

data ObserverValue : Set where
  presentValue
  movementFutureValue
  authorityEnabledValue
  authorityDisabledValue
  : ObserverValue

observeAtT1 :
  Temporal.TemporalReceptionHistory →
  Reuse.PrefixCoordinate →
  ObserverValue
observeAtT1 history Reuse.presentCoordinate = presentValue
observeAtT1 history Reuse.futureCoordinate = movementFutureValue
observeAtT1 Temporal.movementEarlyAuthorityHistory Reuse.authorityCoordinate =
  authorityEnabledValue
observeAtT1 Temporal.movementLateAuthorityHistory Reuse.authorityCoordinate =
  authorityDisabledValue
observeAtT1 Temporal.closureTemporalHistory Reuse.authorityCoordinate =
  authorityDisabledValue
observeAtT1 Temporal.archiveTemporalHistory Reuse.authorityCoordinate =
  authorityDisabledValue

------------------------------------------------------------------------
-- 2. Shared/divergent regions are predicates generated by observer comparison.
------------------------------------------------------------------------

SharedByObserver : Reuse.PrefixCoordinate → Set
SharedByObserver coordinate =
  observeAtT1 Temporal.movementEarlyAuthorityHistory coordinate
  ≡ observeAtT1 Temporal.movementLateAuthorityHistory coordinate

DivergentByObserver : Reuse.PrefixCoordinate → Set
DivergentByObserver coordinate =
  SharedByObserver coordinate → ⊥

presentSharedByObserver : SharedByObserver Reuse.presentCoordinate
presentSharedByObserver = refl

futureSharedByObserver : SharedByObserver Reuse.futureCoordinate
futureSharedByObserver = refl

authorityDivergentByObserver : DivergentByObserver Reuse.authorityCoordinate
authorityDivergentByObserver ()

------------------------------------------------------------------------
-- 3. Observer receipts generate the existing shared/divergent predicates.
------------------------------------------------------------------------

observerSharedImpliesExistingShared :
  ∀ {coordinate} →
  SharedByObserver coordinate →
  Reuse.SharedAtT1Precision coordinate
observerSharedImpliesExistingShared {Reuse.presentCoordinate} shared =
  Reuse.presentShared
observerSharedImpliesExistingShared {Reuse.futureCoordinate} shared =
  Reuse.futureShared
observerSharedImpliesExistingShared {Reuse.authorityCoordinate} ()

observerDivergentImpliesExistingDivergent :
  ∀ {coordinate} →
  DivergentByObserver coordinate →
  Partition.DivergentAtT1Precision coordinate
observerDivergentImpliesExistingDivergent {Reuse.presentCoordinate} divergent =
  ⊥-elim (divergent presentSharedByObserver)
observerDivergentImpliesExistingDivergent {Reuse.futureCoordinate} divergent =
  ⊥-elim (divergent futureSharedByObserver)
observerDivergentImpliesExistingDivergent {Reuse.authorityCoordinate} divergent =
  Partition.authorityDiverges

------------------------------------------------------------------------
-- 4. Support containment and divergence intersection are synthesized from O.
------------------------------------------------------------------------

ObserverSupportContainedInShared : Reuse.CertificateSupport → Set
ObserverSupportContainedInShared support =
  ∀ {coordinate} →
  Reuse.SupportedCoordinate support coordinate →
  SharedByObserver coordinate

presentFutureObserverSupportContained :
  ObserverSupportContainedInShared Reuse.presentFutureSupport
presentFutureObserverSupportContained Reuse.supportPresent = presentSharedByObserver
presentFutureObserverSupportContained Reuse.supportFuture = futureSharedByObserver

observerContainmentToExistingContainment :
  ∀ {support} →
  ObserverSupportContainedInShared support →
  Reuse.SupportContainedInSharedPrefix support
observerContainmentToExistingContainment contained supported =
  observerSharedImpliesExistingShared (contained supported)

record ObserverSupportIntersectsDivergence
    (support : Reuse.CertificateSupport) : Set where
  constructor observer-support-intersects-divergence
  field
    coordinate : Reuse.PrefixCoordinate
    supported : Reuse.SupportedCoordinate support coordinate
    divergent : DivergentByObserver coordinate

open ObserverSupportIntersectsDivergence public

authoritySensitiveObserverIntersection :
  ObserverSupportIntersectsDivergence Reuse.authoritySensitiveSupport
authoritySensitiveObserverIntersection =
  observer-support-intersects-divergence
    Reuse.authorityCoordinate
    Reuse.supportAuthority
    authorityDivergentByObserver

observerIntersectionToExistingIntersection :
  ∀ {support} →
  ObserverSupportIntersectsDivergence support →
  Partition.SupportIntersectsDivergentRegion support
observerIntersectionToExistingIntersection witness =
  Partition.support-intersects-divergent-region
    (coordinate witness)
    (supported witness)
    (observerDivergentImpliesExistingDivergent (divergent witness))

------------------------------------------------------------------------
-- 5. Retain/reopen dispositions are now consequences of observer comparison.
------------------------------------------------------------------------

presentFutureDispositionDerivedFromObserver :
  Partition.CertificateDisposition Reuse.presentFutureSupport
presentFutureDispositionDerivedFromObserver =
  Partition.retainIfSupportContained
    (observerContainmentToExistingContainment
      presentFutureObserverSupportContained)

authoritySensitiveDispositionDerivedFromObserver :
  Partition.CertificateDisposition Reuse.authoritySensitiveSupport
authoritySensitiveDispositionDerivedFromObserver =
  Partition.reopenIfSupportIntersectsDivergence
    (observerIntersectionToExistingIntersection
      authoritySensitiveObserverIntersection)

------------------------------------------------------------------------
-- 6. The observer computation agrees with the actual fibre-level facts.
------------------------------------------------------------------------

presentFibreAgreementReceipt :
  Fibre.present
    (Fibre.fibreAt Temporal.movementEarlyAuthorityHistory Temporal.t1)
  ≡ Fibre.present
    (Fibre.fibreAt Temporal.movementLateAuthorityHistory Temporal.t1)
presentFibreAgreementReceipt = Fibre.samePresent

futureFibreAgreementReceipt :
  Fibre.futureCone
    (Fibre.fibreAt Temporal.movementEarlyAuthorityHistory Temporal.t1)
  ≡ Fibre.futureCone
    (Fibre.fibreAt Temporal.movementLateAuthorityHistory Temporal.t1)
futureFibreAgreementReceipt = Fibre.sameFutureCone

authorityFibreDivergenceReceipt :
  Fibre.authorityEnabled
    (Fibre.fibreAt Temporal.movementEarlyAuthorityHistory Temporal.t1)
  ≡ Fibre.authorityEnabled
    (Fibre.fibreAt Temporal.movementLateAuthorityHistory Temporal.t1) → ⊥
authorityFibreDivergenceReceipt =
  Fibre.authorityAdmissibilityDiffersInsideSameCoarseFibre

------------------------------------------------------------------------
-- 7. No-promotion boundaries.
------------------------------------------------------------------------

data ObserverEqualityPromotesFineHistoryEquality : Set where
data ObserverDivergencePromotesCausalDifference : Set where
data ObserverPartitionPromotesPAdicValuation : Set where

observerEqualityDoesNotPromoteFineHistoryEquality :
  ObserverEqualityPromotesFineHistoryEquality → ⊥
observerEqualityDoesNotPromoteFineHistoryEquality ()

observerDivergenceDoesNotPromoteCausalDifference :
  ObserverDivergencePromotesCausalDifference → ⊥
observerDivergenceDoesNotPromoteCausalDifference ()

observerPartitionDoesNotPromotePAdicValuation :
  ObserverPartitionPromotesPAdicValuation → ⊥
observerPartitionDoesNotPromotePAdicValuation ()

------------------------------------------------------------------------
-- 8. Canonical boundary.
------------------------------------------------------------------------

record IntellectualReceptionObserverDerivedSupportPartitionBoundary : Set where
  constructor intellectual-reception-observer-derived-support-partition-boundary
  field
    sharedCoordinatesAreDerivedFromObserverEquality : Bool
    divergentCoordinatesAreDerivedFromObserverInequality : Bool
    supportContainmentIsDerivedFromObserverComparison : Bool
    divergenceIntersectionIsDerivedFromObserverComparison : Bool
    retainDispositionIsDerivedFromObserverComparison : Bool
    reopenDispositionIsDerivedFromObserverComparison : Bool
    observerEqualityDeterminesFineHistory : Bool
    observerDivergenceDeterminesCausality : Bool
    sourceAttributionBoundarySurvivesObserverPartition : Bool

canonicalIntellectualReceptionObserverDerivedSupportPartitionBoundary :
  IntellectualReceptionObserverDerivedSupportPartitionBoundary
canonicalIntellectualReceptionObserverDerivedSupportPartitionBoundary =
  intellectual-reception-observer-derived-support-partition-boundary
    true true true true true true false false true
