module DASHI.Culture.IntellectualReceptionMotifParetoChoiceExact where

open import DASHI.Core.Prelude

import Base369 as Base
import DASHI.Culture.IntellectualReceptionSituatedInformationParetoPreorderExact as Pareto
import DASHI.Culture.IntellectualReceptionTernaryParetoSituatedChoiceExact as Choice

------------------------------------------------------------------------
-- MOTIF-SENSITIVE PARETO CHOICE
--
-- Structural cross-pollination only: intellectual reception histories can have
-- relay/return/split-style action motifs without identifying them with asset,
-- textile, or cryptographic traces.  Motif shape does not determine quality;
-- each motif is evaluated through the six-axis situated-information profile.
------------------------------------------------------------------------

data ReceptionMotif : Set where
  relayReception
  sourceReturnRecovery
  pluralSplitReception
  institutionalMergeReception
  : ReceptionMotif

motifProfile : ReceptionMotif → Pareto.SituatedInformationProfile
motifProfile relayReception =
  Pareto.situated-information-profile
    Pareto.strong Pareto.strong Pareto.strong
    Pareto.weak Pareto.weak Pareto.weak
motifProfile sourceReturnRecovery =
  Pareto.situated-information-profile
    Pareto.weak Pareto.weak Pareto.weak
    Pareto.strong Pareto.strong Pareto.strong
motifProfile pluralSplitReception =
  Pareto.situated-information-profile
    Pareto.strong Pareto.strong Pareto.weak
    Pareto.strong Pareto.weak Pareto.weak
motifProfile institutionalMergeReception =
  Pareto.situated-information-profile
    Pareto.weak Pareto.weak Pareto.strong
    Pareto.weak Pareto.strong Pareto.strong

------------------------------------------------------------------------
-- Relay and source-return recovery are genuinely crossed profiles.
------------------------------------------------------------------------

relayNotBelowRecovery :
  Pareto.ParetoNoWorse
    (motifProfile relayReception)
    (motifProfile sourceReturnRecovery) → ⊥
relayNotBelowRecovery witness =
  Pareto.strongNotAtMostWeak (Pareto.supportOrder witness)

recoveryNotBelowRelay :
  Pareto.ParetoNoWorse
    (motifProfile sourceReturnRecovery)
    (motifProfile relayReception) → ⊥
recoveryNotBelowRelay witness =
  Pareto.strongNotAtMostWeak (Pareto.provenanceOrder witness)

relayRecoveryIncomparable :
  Pareto.ParetoIncomparable
    (motifProfile relayReception)
    (motifProfile sourceReturnRecovery)
relayRecoveryIncomparable =
  Pareto.pareto-incomparable relayNotBelowRecovery recoveryNotBelowRelay

relayRecoverySituatedChoice :
  Choice.SituatedParetoRelation
    (motifProfile relayReception)
    (motifProfile sourceReturnRecovery)
relayRecoverySituatedChoice =
  Choice.paretoIncomparable relayRecoveryIncomparable

relayRecoveryCodeIsTernaryMiddle :
  Choice.relationCode relayRecoverySituatedChoice ≡ Base.tri-mid
relayRecoveryCodeIsTernaryMiddle = refl

------------------------------------------------------------------------
-- The ternary middle is generated by the proof of crossed objectives; it is
-- not a scalar tie and not a claim that the histories have equal value.
------------------------------------------------------------------------

data MotifCountDeterminesSituatedQuality : Set where
data RelayIsUniversallyBetterThanReturn : Set where
data ReturnIsUniversallyBetterThanRelay : Set where
data TernaryMiddleMeansEqualProfiles : Set where
data TernaryMiddleGuaranteesSynthesis : Set where
data ReceptionMotifIsCryptoMotifIdentity : Set where
data ReceptionMotifIsTextileMotifIdentity : Set where

motifCountDoesNotDetermineSituatedQuality : MotifCountDeterminesSituatedQuality → ⊥
motifCountDoesNotDetermineSituatedQuality ()

relayIsNotUniversallyBetterThanReturn : RelayIsUniversallyBetterThanReturn → ⊥
relayIsNotUniversallyBetterThanReturn ()

returnIsNotUniversallyBetterThanRelay : ReturnIsUniversallyBetterThanRelay → ⊥
returnIsNotUniversallyBetterThanRelay ()

ternaryMiddleDoesNotMeanEqualProfiles : TernaryMiddleMeansEqualProfiles → ⊥
ternaryMiddleDoesNotMeanEqualProfiles ()

ternaryMiddleDoesNotGuaranteeSynthesis : TernaryMiddleGuaranteesSynthesis → ⊥
ternaryMiddleDoesNotGuaranteeSynthesis ()

receptionMotifIsNotCryptoIdentity : ReceptionMotifIsCryptoMotifIdentity → ⊥
receptionMotifIsNotCryptoIdentity ()

receptionMotifIsNotTextileIdentity : ReceptionMotifIsTextileMotifIdentity → ⊥
receptionMotifIsNotTextileIdentity ()

record IntellectualReceptionMotifParetoChoiceBoundary : Set where
  constructor intellectual-reception-motif-pareto-choice-boundary
  field
    receptionMotifsExplicit : Bool
    motifProfilesUseSixAxes : Bool
    relayReturnIncomparabilityConstructed : Bool
    incomparableResultMapsToTriMid : Bool
    triMidMeansScalarTie : Bool
    motifShapeDeterminesQuality : Bool
    crossDomainMotifsIdentified : Bool

canonicalIntellectualReceptionMotifParetoChoiceBoundary :
  IntellectualReceptionMotifParetoChoiceBoundary
canonicalIntellectualReceptionMotifParetoChoiceBoundary =
  intellectual-reception-motif-pareto-choice-boundary
    true true true true false false false
