------------------------------------------------------------------------
-- ESKRIDGE x REPOSITORY-NATIVE EXPERIMENT / PROOF-SEARCH LOOP
--
-- Historical advocacy may nominate a mechanism family and motivate an
-- experiment.  It does not own the experiment's success criterion, theorem
-- authority, nuisance closure, intervention authority, or consumer promotion.
------------------------------------------------------------------------

record EskridgeExperimentProofSearchBoundary : Set where
  constructor eskridge-experiment-proof-search-boundary
  field
    advocacyMayNominateCandidateExperiment : Bool
    advocacyMayNominateCandidateExperimentIsTrue :
      advocacyMayNominateCandidateExperiment ≡ true

    advocacyMayRewriteFrozenPhysicsConsumer : Bool
    advocacyMayRewriteFrozenPhysicsConsumerIsFalse :
      advocacyMayRewriteFrozenPhysicsConsumer ≡ false

    historicalMechanismInterestCountsAsRouteAdmission : Bool
    historicalMechanismInterestCountsAsRouteAdmissionIsFalse :
      historicalMechanismInterestCountsAsRouteAdmission ≡ false

    successfulDiscriminatorStillRequiresMeasurementProvenance : Bool
    successfulDiscriminatorStillRequiresMeasurementProvenanceIsTrue :
      successfulDiscriminatorStillRequiresMeasurementProvenance ≡ true

    localPositiveSignalAutomaticallyPromotesEtaC : Bool
    localPositiveSignalAutomaticallyPromotesEtaCIsFalse :
      localPositiveSignalAutomaticallyPromotesEtaC ≡ false

canonicalEskridgeExperimentProofSearchBoundary : EskridgeExperimentProofSearchBoundary
canonicalEskridgeExperimentProofSearchBoundary =
  eskridge-experiment-proof-search-boundary
    true refl
    false refl
    false refl
    true refl
    false refl

------------------------------------------------------------------------
-- Exact reuse of the physics-side frontiers and generic active cycle.
------------------------------------------------------------------------

currentSourceSplitFrontier : Split.EnhancementLeaf
currentSourceSplitFrontier = Split.currentFirstOpenEnhancementLeaf

currentPublicEvidenceFrontier : Evidence.EvidenceLeaf
currentPublicEvidenceFrontier = Evidence.currentFirstOpenEvidenceLeaf

canonicalPhysicsExperimentCycle : Loop.BidiPath Loop.liveHypotheses Loop.liveHypotheses
canonicalPhysicsExperimentCycle = X.experimentBidiCycle

canonicalPhysicsRouteAdmission : Admission.RouteAdmission
canonicalPhysicsRouteAdmission = X.experimentRouteAdmission

