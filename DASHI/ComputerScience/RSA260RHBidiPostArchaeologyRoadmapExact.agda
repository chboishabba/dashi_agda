  continueExistingPhaseAndCellUpperAscent : RHPostArchaeologyTarget

firstRHPostArchaeologyTarget : RHPostArchaeologyTarget
firstRHPostArchaeologyTarget = acquireOriginalAristotleArchiveBytes

