module DASHI.Reasoning.SurplusChannelCore where

open import DASHI.Core.Prelude
open import Agda.Builtin.String using (String)

import DASHI.Interop.SensibLawResidualLattice as Residual

------------------------------------------------------------------------
-- Typed surplus channels.
--
-- Value, enjoyment, knowledge and power are kept as distinct outputs of a
-- reproductive update.  No channel is assumed to be numeric, cardinality
-- increasing, empirically calibrated or mutually reducible.
------------------------------------------------------------------------

data SurplusKind : Set where
  valueSurplus enjoymentSurplus knowledgeSurplus powerSurplus : SurplusKind

record SurplusChannel (State Output : Set) : Set₁ where
  field
    kind : SurplusKind
    produce : State → Output
    reinject : Output → State → State
    reproductionLaw :
      Output → State → Set
    reproductionWitness :
      ∀ output state → reproductionLaw output state
    outputInterpretation : String
    strictCardinalityIncreaseClaimed : Bool
    empiricalMagnitudeClaimed : Bool

record FourChannelSurplus
  (State Value Enjoyment Knowledge Power : Set) : Set₁ where
  field
    valueChannel : SurplusChannel State Value
    enjoymentChannel : SurplusChannel State Enjoyment
    knowledgeChannel : SurplusChannel State Knowledge
    powerChannel : SurplusChannel State Power

record PNFResidualSurplusVector : Set where
  field
    valueResidual : Residual.ResidualLevel
    enjoymentResidual : Residual.ResidualLevel
    knowledgeResidual : Residual.ResidualLevel
    powerResidual : Residual.ResidualLevel
    valueReading : String
    enjoymentReading : String
    knowledgeReading : String
    powerReading : String
    channelsProvedEquivalent : Bool
    cardinalIncreaseProved : Bool
    empiricalCalibrationPresent : Bool

canonicalUnpromotedPNFSurplusVector : PNFResidualSurplusVector
canonicalUnpromotedPNFSurplusVector = record
  { valueResidual = Residual.partial
  ; enjoymentResidual = Residual.partial
  ; knowledgeResidual = Residual.partial
  ; powerResidual = Residual.partial
  ; valueReading =
      "candidate residual generated by economic predicate transformation"
  ; enjoymentReading =
      "candidate residual generated by prohibition, failure or repeated satisfaction circuit"
  ; knowledgeReading =
      "new classification, provenance and proof obligations generated by normalisation"
  ; powerReading =
      "new gates, exclusions and classifier authority generated by classification"
  ; channelsProvedEquivalent = false
  ; cardinalIncreaseProved = false
  ; empiricalCalibrationPresent = false
  }

record SurplusAuthorityBoundary : Set where
  field
    fourChannelsDistinguished : Bool
    feedbackReinjectionRepresented : Bool
    allSurplusIsCantorianClaimed : Bool
    allChannelsShareOneScalarClaimed : Bool
    residualAutomaticallyMeansEnjoyment : Bool
    interpretationRequiresCalibration : Bool
    boundaryNote : String

canonicalSurplusAuthorityBoundary : SurplusAuthorityBoundary
canonicalSurplusAuthorityBoundary = record
  { fourChannelsDistinguished = true
  ; feedbackReinjectionRepresented = true
  ; allSurplusIsCantorianClaimed = false
  ; allChannelsShareOneScalarClaimed = false
  ; residualAutomaticallyMeansEnjoyment = false
  ; interpretationRequiresCalibration = true
  ; boundaryNote =
      "Surplus is a typed reproductive remainder family; Cantor applies only to an explicit predicate-space lift."
  }
