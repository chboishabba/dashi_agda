module DASHI.Reasoning.DerivationEdgeInstanceSelectiveReopeningExact where

open import DASHI.Core.Prelude
open import Agda.Builtin.String using (String)

import DASHI.Core.AffectedDependencyClosureExact as Dependency
import DASHI.Reasoning.LogicalConsequenceDerivationPathExact as Path

------------------------------------------------------------------------
-- PATH-INSTANCE SELECTIVE REOPENING
--
-- Artifact-level reopening says which class of certificate depends on which
-- class of upstream artifact.  This owner adds the finer statement:
--
--      a particular derivation-edge instance occurs in a particular
--      consequence path => that consequence certificate is affected.
--
-- Edge identity is explicit and path membership is proof-relevant.
------------------------------------------------------------------------

record IndexedDerivationEdge
    (from to : Path.DerivationNode) : Set where
  constructor indexedDerivationEdge
  field
    edgeKey : String
    step : Path.DerivationStep from to
    sourceReference : String
    replayReference : String

open IndexedDerivationEdge public

data IndexedDerivationPath : Path.DerivationNode → Path.DerivationNode → Set where
  indexedRefl :
    ∀ {node} → IndexedDerivationPath node node
  indexedStep :
    ∀ {from middle to} →
    IndexedDerivationEdge from middle →
    IndexedDerivationPath middle to →
    IndexedDerivationPath from to

------------------------------------------------------------------------
-- Exact occurrence of one edge object in one indexed path.
------------------------------------------------------------------------

data EdgeOccurs
    {edgeFrom edgeTo : Path.DerivationNode}
    (edge : IndexedDerivationEdge edgeFrom edgeTo) :
    ∀ {pathFrom pathTo} →
    IndexedDerivationPath pathFrom pathTo → Set where
  occursHere :
    ∀ {tail} →
    EdgeOccurs edge (indexedStep edge tail)
  occursLater :
    ∀ {prefixFrom prefixTo pathTo}
      {prefix : IndexedDerivationEdge prefixFrom prefixTo}
      {tail : IndexedDerivationPath prefixTo pathTo} →
    EdgeOccurs edge tail →
    EdgeOccurs edge (indexedStep prefix tail)

DoesNotOccur :
  ∀ {a b x y}
    (edge : IndexedDerivationEdge a b) →
    IndexedDerivationPath x y → Set
DoesNotOccur edge path = EdgeOccurs edge path → ⊥

------------------------------------------------------------------------
-- A consequence certificate owns the exact path it used.
------------------------------------------------------------------------

record IndexedConsequenceCertificate : Set₁ where
  constructor indexedConsequenceCertificate
  field
    source : Path.DerivationNode
    target : Path.DerivationNode
    derivation : IndexedDerivationPath source target
    certificateKey : String
    consequenceReference : String
    authorityReference : String

open IndexedConsequenceCertificate public

------------------------------------------------------------------------
-- Local two-artifact dependency relation generated by one actual occurrence.
-- This is deliberately per-edge/per-certificate: no class-level dependency is
-- assumed merely because the edge and certificate have compatible kinds.
------------------------------------------------------------------------

data PathOccurrenceArtifact : Set where
  changedEdgeInstanceArtifact
  consequenceCertificateArtifact
  : PathOccurrenceArtifact

data OccurrenceDepends
    {a b : Path.DerivationNode}
    (edge : IndexedDerivationEdge a b)
    (certificate : IndexedConsequenceCertificate) :
    PathOccurrenceArtifact → PathOccurrenceArtifact → Set where
  occurrenceFeedsCertificate :
    EdgeOccurs edge (derivation certificate) →
    OccurrenceDepends edge certificate
      changedEdgeInstanceArtifact
      consequenceCertificateArtifact

edgeOccurrenceCreatesAffectedClosure :
  ∀ {a b}
    {edge : IndexedDerivationEdge a b}
    {certificate : IndexedConsequenceCertificate} →
  EdgeOccurs edge (derivation certificate) →
  Dependency.AffectedClosure
    (OccurrenceDepends edge certificate)
    changedEdgeInstanceArtifact
    consequenceCertificateArtifact
edgeOccurrenceCreatesAffectedClosure occurrence =
  Dependency.affectedStep
    (occurrenceFeedsCertificate occurrence)
    Dependency.affectedRefl

edgeOccurrenceCreatesReopeningObligation :
  ∀ {a b}
    {edge : IndexedDerivationEdge a b}
    {certificate : IndexedConsequenceCertificate} →
  EdgeOccurs edge (derivation certificate) →
  Dependency.ReopeningObligation
    (OccurrenceDepends edge certificate)
    changedEdgeInstanceArtifact
    consequenceCertificateArtifact
edgeOccurrenceCreatesReopeningObligation occurrence =
  Dependency.reopeningObligation
    (edgeOccurrenceCreatesAffectedClosure occurrence)

------------------------------------------------------------------------
-- If an edge does not occur, this occurrence-generated dependency has no
-- direct constructor.  Thus an unrelated path is not reopened by this local
-- dependency witness.
------------------------------------------------------------------------

nonOccurrenceBlocksDirectDependency :
  ∀ {a b}
    {edge : IndexedDerivationEdge a b}
    {certificate : IndexedConsequenceCertificate} →
  DoesNotOccur edge (derivation certificate) →
  OccurrenceDepends edge certificate
    changedEdgeInstanceArtifact
    consequenceCertificateArtifact →
  ⊥
nonOccurrenceBlocksDirectDependency absent (occurrenceFeedsCertificate occurrence) =
  absent occurrence

------------------------------------------------------------------------
-- Path suffixes preserve occurrence: if an edge occurred in the prefix used to
-- derive a middle consequence, appending later reasoning does not erase that
-- dependency from the longer certificate path.
------------------------------------------------------------------------

appendIndexedPath :
  ∀ {a b c} →
  IndexedDerivationPath a b →
  IndexedDerivationPath b c →
  IndexedDerivationPath a c
appendIndexedPath indexedRefl right = right
appendIndexedPath (indexedStep edge rest) right =
  indexedStep edge (appendIndexedPath rest right)

occurrenceSurvivesPathAppend :
  ∀ {edgeFrom edgeTo a b c}
    {edge : IndexedDerivationEdge edgeFrom edgeTo}
    {left : IndexedDerivationPath a b}
    {right : IndexedDerivationPath b c} →
  EdgeOccurs edge left →
  EdgeOccurs edge (appendIndexedPath left right)
occurrenceSurvivesPathAppend occursHere = occursHere
occurrenceSurvivesPathAppend (occursLater occurrence) =
  occursLater (occurrenceSurvivesPathAppend occurrence)

record EdgeInstanceSelectiveReopeningBoundary : Set where
  constructor edgeInstanceSelectiveReopeningBoundary
  field
    actualPathOccurrenceCanCreateReopening : Bool
    actualPathOccurrenceCanCreateReopeningIsTrue :
      actualPathOccurrenceCanCreateReopening ≡ true
    sameEdgeKindWithoutOccurrenceForcesReopening : Bool
    sameEdgeKindWithoutOccurrenceForcesReopeningIsFalse :
      sameEdgeKindWithoutOccurrenceForcesReopening ≡ false
    pathAppendErasesEarlierDependency : Bool
    pathAppendErasesEarlierDependencyIsFalse :
      pathAppendErasesEarlierDependency ≡ false
    edgeIdentityIsExplicit : Bool
    edgeIdentityIsExplicitIsTrue : edgeIdentityIsExplicit ≡ true

canonicalEdgeInstanceSelectiveReopeningBoundary :
  EdgeInstanceSelectiveReopeningBoundary
canonicalEdgeInstanceSelectiveReopeningBoundary =
  edgeInstanceSelectiveReopeningBoundary
    true refl
    false refl
    false refl
    true refl
