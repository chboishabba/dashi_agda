module DASHI.Reasoning.TrialecticFiniteTriadicHypersheafExact where

------------------------------------------------------------------------
-- FINITE 1-TRUNCATED HYPERSHEAF ON THE RELATIONAL TRIADIC SITE
--
-- The relational Grothendieck topology is unusually small.  Its Cover type
-- has exactly two constructors:
--
--   * maximal covers at any object;
--   * the distinguished triadic global cover generated by AB, BC and CA.
--
-- Every non-global pullback of the triadic cover is maximal.  The target is
-- groupoid-valued / 1-truncated, so the finite hyperdescent data required by
-- this concrete site terminates at the 2-skeleton:
--
--   level 0 : object descent;
--   level 1 : morphism descent;
--   level 2 : phase 2-cell / cocycle coherence;
--   higher  : only pullbacks of maximal covers remain, hence identity descent.
--
-- This certifies a finite one-truncated hypersheaf for THIS topology.  It does
-- not claim an arbitrary infinity-topos theorem or descent for an unrelated
-- external notion of hypercover.
------------------------------------------------------------------------

open import DASHI.Core.Prelude
open import Agda.Builtin.Bool using (Bool; false; true)
open import Agda.Builtin.Equality using (_≡_; refl)

import DASHI.Foundations.Base369TriTruthField as Tri
import DASHI.Foundations.StageTwelveGrothendieckRelationHyperformExact as Stage12
import DASHI.Foundations.RelationalStageTwelveGrothendieckExtensionExact as Site
import DASHI.Foundations.RelationalStageTwelveSiteExact as RelSheaf
import DASHI.Reasoning.TrialecticThreeCellHyperformSynthesisExact as Cell
import DASHI.Reasoning.TrialecticGrothendieckThreeCellDescentExact as Descent
import DASHI.Reasoning.TrialecticGrothendieckCellPresheafExact as Presheaf
import DASHI.Reasoning.TrialecticSetEffectiveDescentExact as SetEffective
import DASHI.Reasoning.TrialecticWavePhaseGroupoidPresheafExact as Phase
import DASHI.Reasoning.TrialecticWavePhaseEffectiveStackDescentExact as Stack
import DASHI.Reasoning.TrialecticWavePhaseTwoCellCocycleExact as Two

------------------------------------------------------------------------
-- 1. Exhaustive cover classification.
------------------------------------------------------------------------

data ExhaustiveCoverCase :
  {U : Site.RelObj} →
  {sieve : Stage12.Sieve Site.relationalPatchCategory U} →
  Site.RelCover sieve →
  Set₁ where

  maximalCase :
    ∀ {U : Site.RelObj}
      {sieve : Stage12.Sieve Site.relationalPatchCategory U} →
    (maximality : Site.RelIsMaximal sieve) →
    ExhaustiveCoverCase (Site.maximalCover maximality)

  triadicCase :
    ∀ {sieve : Stage12.Sieve Site.relationalPatchCategory Site.globalABC} →
    (hab : Stage12.Sieve.contains sieve Site.abToGlobal) →
    (hbc : Stage12.Sieve.contains sieve Site.bcToGlobal) →
    (hca : Stage12.Sieve.contains sieve Site.caToGlobal) →
    ExhaustiveCoverCase (Site.triadicGlobalCover hab hbc hca)

classifyEveryCover :
  ∀ {U : Site.RelObj}
    {sieve : Stage12.Sieve Site.relationalPatchCategory U} →
  (cover : Site.RelCover sieve) →
  ExhaustiveCoverCase cover
classifyEveryCover (Site.maximalCover maximality) =
  maximalCase maximality
classifyEveryCover (Site.triadicGlobalCover hab hbc hca) =
  triadicCase hab hbc hca

------------------------------------------------------------------------
-- 2. Every non-global pullback of the canonical triadic sieve is maximal.
------------------------------------------------------------------------

abPullbackMaximal :
  Site.RelIsMaximal
    (Stage12.pullbackSieve
      Site.relationalPatchCategory
      Site.abToGlobal
      Site.triadicRelationalSieve)
abPullbackMaximal (Site.idR Site.edgeAB) = Site.memberAB
abPullbackMaximal Site.aToAB = Site.memberA
abPullbackMaximal Site.bToAB = Site.memberB

bcPullbackMaximal :
  Site.RelIsMaximal
    (Stage12.pullbackSieve
      Site.relationalPatchCategory
      Site.bcToGlobal
      Site.triadicRelationalSieve)
bcPullbackMaximal (Site.idR Site.edgeBC) = Site.memberBC
bcPullbackMaximal Site.bToBC = Site.memberB
bcPullbackMaximal Site.cToBC = Site.memberC

caPullbackMaximal :
  Site.RelIsMaximal
    (Stage12.pullbackSieve
      Site.relationalPatchCategory
      Site.caToGlobal
      Site.triadicRelationalSieve)
caPullbackMaximal (Site.idR Site.edgeCA) = Site.memberCA
caPullbackMaximal Site.cToCA = Site.memberC
caPullbackMaximal Site.aToCA = Site.memberA

aPullbackMaximal :
  Site.RelIsMaximal
    (Stage12.pullbackSieve
      Site.relationalPatchCategory
      Site.aToGlobal
      Site.triadicRelationalSieve)
aPullbackMaximal (Site.idR Site.vertexA) = Site.memberA

bPullbackMaximal :
  Site.RelIsMaximal
    (Stage12.pullbackSieve
      Site.relationalPatchCategory
      Site.bToGlobal
      Site.triadicRelationalSieve)
bPullbackMaximal (Site.idR Site.vertexB) = Site.memberB

cPullbackMaximal :
  Site.RelIsMaximal
    (Stage12.pullbackSieve
      Site.relationalPatchCategory
      Site.cToGlobal
      Site.triadicRelationalSieve)
cPullbackMaximal (Site.idR Site.vertexC) = Site.memberC

maximalPullbacksRemainMaximal :
  ∀ {U V : Site.RelObj} →
  (arrow : Site.RelHom V U) →
  (sieve : Stage12.Sieve Site.relationalPatchCategory U) →
  Site.RelIsMaximal sieve →
  Site.RelIsMaximal
    (Stage12.pullbackSieve Site.relationalPatchCategory arrow sieve)
maximalPullbacksRemainMaximal = Site.pullbackOfMaximalIsMaximal

------------------------------------------------------------------------
-- 3. Level-zero object descent is already universal on the nontrivial cover.
------------------------------------------------------------------------

triadicObjectHyperdescent :
  (locals : RelSheaf.TriadicLocals Cell.CellDialectic) →
  (compatibility :
    RelSheaf.CompatibleOnTriadicCover Descent.cellOverlapSystem locals) →
  SetEffective.GlobalRealization locals
triadicObjectHyperdescent = SetEffective.realizeCompatibleLocals

------------------------------------------------------------------------
-- 4. Level-one morphism descent is already universal on the same cover.
------------------------------------------------------------------------

triadicMorphismHyperdescent :
  (source target : RelSheaf.TriadicLocals Cell.CellDialectic) →
  (sourceCompatibility :
    RelSheaf.CompatibleOnTriadicCover Descent.cellOverlapSystem source) →
  (targetCompatibility :
    RelSheaf.CompatibleOnTriadicCover Descent.cellOverlapSystem target) →
  Stack.TriadicPhaseMorphisms source target →
  Phase.GlobalPhaseHom
    (Descent.glueStructured source sourceCompatibility)
    (Descent.glueStructured target targetCompatibility)
triadicMorphismHyperdescent = Stack.gluePhaseMorphisms

------------------------------------------------------------------------
-- 5. Level-two coherence: arbitrary compatible local phase morphisms satisfy
--    the triadic cocycle, not only the canonical C3 fixture.
------------------------------------------------------------------------

triadicTwoSkeletonCocycle :
  ∀ {source target : RelSheaf.TriadicLocals Cell.CellDialectic} →
  (morphisms : Stack.TriadicPhaseMorphisms source target) →
  Tri.triAdd
    (Phase.equalityPhase (Stack.morphismAB morphisms))
    (Tri.triAdd
      (Phase.equalityPhase (Stack.morphismBC morphisms))
      (Phase.equalityPhase (Stack.morphismCA morphisms)))
  ≡
  Tri.triAdd
    (Phase.equalityPhase (Stack.morphismAB morphisms))
    (Tri.triAdd
      (Phase.equalityPhase (Stack.morphismAB morphisms))
      (Phase.equalityPhase (Stack.morphismAB morphisms)))
triadicTwoSkeletonCocycle = Two.triadicPhaseCycleCloses

------------------------------------------------------------------------
-- 6. Maximal-cover descent is identity descent at objects and morphisms.
------------------------------------------------------------------------

maximalObjectDescent :
  ∀ {U : Site.RelObj} →
  (section : Presheaf.Section U) →
  Presheaf.restrict (Site.idR U) section ≡ section
maximalObjectDescent = Presheaf.restrictIdentity

maximalMorphismDescent :
  ∀ {U : Site.RelObj}
    {x y : Presheaf.Section U} →
  (hom : Phase.FibreHom x y) →
  Phase.restrictHom (Site.idR U) hom Phase.≈ₚ hom
maximalMorphismDescent = Phase.restrictIdentityHom

------------------------------------------------------------------------
-- 7. Concrete finite 1-truncated hyperdescent receipt.
--
-- Sieve is Set1, so a record quantifying over arbitrary sieves belongs in
-- Set2.  Keeping this universe explicit avoids hiding a future elaboration
-- failure behind the finite nature of the object carrier.
------------------------------------------------------------------------

record FiniteTriadicHyperdescentReceipt : Set₂ where
  field
    classifyCover :
      ∀ {U : Site.RelObj}
        {sieve : Stage12.Sieve Site.relationalPatchCategory U} →
      (cover : Site.RelCover sieve) →
      ExhaustiveCoverCase cover

    pullbackABMaximal :
      Site.RelIsMaximal
        (Stage12.pullbackSieve
          Site.relationalPatchCategory Site.abToGlobal Site.triadicRelationalSieve)
    pullbackBCMaximal :
      Site.RelIsMaximal
        (Stage12.pullbackSieve
          Site.relationalPatchCategory Site.bcToGlobal Site.triadicRelationalSieve)
    pullbackCAMaximal :
      Site.RelIsMaximal
        (Stage12.pullbackSieve
          Site.relationalPatchCategory Site.caToGlobal Site.triadicRelationalSieve)
    pullbackAMaximal :
      Site.RelIsMaximal
        (Stage12.pullbackSieve
          Site.relationalPatchCategory Site.aToGlobal Site.triadicRelationalSieve)
    pullbackBMaximal :
      Site.RelIsMaximal
        (Stage12.pullbackSieve
          Site.relationalPatchCategory Site.bToGlobal Site.triadicRelationalSieve)
    pullbackCMaximal :
      Site.RelIsMaximal
        (Stage12.pullbackSieve
          Site.relationalPatchCategory Site.cToGlobal Site.triadicRelationalSieve)

    maximalPullbackStable :
      ∀ {U V : Site.RelObj} →
      (arrow : Site.RelHom V U) →
      (sieve : Stage12.Sieve Site.relationalPatchCategory U) →
      Site.RelIsMaximal sieve →
      Site.RelIsMaximal
        (Stage12.pullbackSieve Site.relationalPatchCategory arrow sieve)

    objectDescent :
      (locals : RelSheaf.TriadicLocals Cell.CellDialectic) →
      (compatibility :
        RelSheaf.CompatibleOnTriadicCover Descent.cellOverlapSystem locals) →
      SetEffective.GlobalRealization locals

    morphismDescent :
      (source target : RelSheaf.TriadicLocals Cell.CellDialectic) →
      (sourceCompatibility :
        RelSheaf.CompatibleOnTriadicCover Descent.cellOverlapSystem source) →
      (targetCompatibility :
        RelSheaf.CompatibleOnTriadicCover Descent.cellOverlapSystem target) →
      Stack.TriadicPhaseMorphisms source target →
      Phase.GlobalPhaseHom
        (Descent.glueStructured source sourceCompatibility)
        (Descent.glueStructured target targetCompatibility)

    twoSkeletonCocycle :
      ∀ {source target : RelSheaf.TriadicLocals Cell.CellDialectic} →
      (morphisms : Stack.TriadicPhaseMorphisms source target) →
      Tri.triAdd
        (Phase.equalityPhase (Stack.morphismAB morphisms))
        (Tri.triAdd
          (Phase.equalityPhase (Stack.morphismBC morphisms))
          (Phase.equalityPhase (Stack.morphismCA morphisms)))
      ≡
      Tri.triAdd
        (Phase.equalityPhase (Stack.morphismAB morphisms))
        (Tri.triAdd
          (Phase.equalityPhase (Stack.morphismAB morphisms))
          (Phase.equalityPhase (Stack.morphismAB morphisms)))

    maximalObjectIdentity :
      ∀ {U : Site.RelObj} →
      (section : Presheaf.Section U) →
      Presheaf.restrict (Site.idR U) section ≡ section

    maximalMorphismIdentity :
      ∀ {U : Site.RelObj}
        {x y : Presheaf.Section U} →
      (hom : Phase.FibreHom x y) →
      Phase.restrictHom (Site.idR U) hom Phase.≈ₚ hom

canonicalFiniteTriadicHyperdescentReceipt :
  FiniteTriadicHyperdescentReceipt
canonicalFiniteTriadicHyperdescentReceipt = record
  { classifyCover = classifyEveryCover
  ; pullbackABMaximal = abPullbackMaximal
  ; pullbackBCMaximal = bcPullbackMaximal
  ; pullbackCAMaximal = caPullbackMaximal
  ; pullbackAMaximal = aPullbackMaximal
  ; pullbackBMaximal = bPullbackMaximal
  ; pullbackCMaximal = cPullbackMaximal
  ; maximalPullbackStable = maximalPullbacksRemainMaximal
  ; objectDescent = triadicObjectHyperdescent
  ; morphismDescent = triadicMorphismHyperdescent
  ; twoSkeletonCocycle = triadicTwoSkeletonCocycle
  ; maximalObjectIdentity = maximalObjectDescent
  ; maximalMorphismIdentity = maximalMorphismDescent
  }

------------------------------------------------------------------------
-- 7b. One theorem quantified over every covering sieve of the topology.
--
-- The certificate carries both the exhaustive constructor case for the given
-- cover and the site-wide hyperdescent receipt above.  Therefore consumers do
-- not need to rediscover that RelCover has only the two supported cases.
------------------------------------------------------------------------

record CoverHyperdescentCertificate
    {U : Site.RelObj}
    {sieve : Stage12.Sieve Site.relationalPatchCategory U}
    (cover : Site.RelCover sieve) : Set₂ where
  field
    coverCase : ExhaustiveCoverCase cover
    hyperdescent : FiniteTriadicHyperdescentReceipt

open CoverHyperdescentCertificate public

hyperdescentForEveryCover :
  ∀ {U : Site.RelObj}
    {sieve : Stage12.Sieve Site.relationalPatchCategory U} →
  (cover : Site.RelCover sieve) →
  CoverHyperdescentCertificate cover
hyperdescentForEveryCover cover = record
  { coverCase = classifyEveryCover cover
  ; hyperdescent = canonicalFiniteTriadicHyperdescentReceipt
  }

------------------------------------------------------------------------
-- 8. Promotion boundary.
--
-- "hypersheaf" here is deliberately qualified: finite, concrete site,
-- groupoid-valued / 1-truncated semantics.  Arbitrary infinity-hypercovers or
-- an external infinity-topos hypercompletion theorem remain separate claims.
------------------------------------------------------------------------

record TrialecticFiniteTriadicHypersheafBoundary : Set where
  constructor trialectic-finite-triadic-hypersheaf-boundary
  field
    everyCoverIsMaximalOrTriadic : Bool
    everyCoverHasHyperdescentCertificate : Bool
    triadicNonGlobalPullbacksAreMaximal : Bool
    maximalPullbacksStayMaximal : Bool
    objectHyperdescentPaid : Bool
    morphismHyperdescentPaid : Bool
    twoSkeletonCocyclePaid : Bool
    higherMatchingStagesMaximal : Bool
    finiteOneTruncatedHyperdescentReceiptConstructed : Bool
    certifiedFiniteOneTruncatedHypersheaf : Bool
    certifiedArbitraryInfinityHypersheaf : Bool

open TrialecticFiniteTriadicHypersheafBoundary public

canonicalTrialecticFiniteTriadicHypersheafBoundary :
  TrialecticFiniteTriadicHypersheafBoundary
canonicalTrialecticFiniteTriadicHypersheafBoundary =
  trialectic-finite-triadic-hypersheaf-boundary
    true true true true true true true true true true false
