module DASHI.Reasoning.AristotleResidualInformationSearchExact where

open import DASHI.Core.Prelude
open import Agda.Builtin.String using (String)

import DASHI.Core.BidiResidualApproximationExact as Bidi
import DASHI.Core.CostedResidualInformationChoiceExact as Costed
import DASHI.Reasoning.AristotleMCGSHypergraphExact as Aristotle

------------------------------------------------------------------------
-- ARISTOTLE x BIDI RESIDUAL SEARCH
--
-- An Aristotle action may be worthwhile before it proves its source state if
-- it is accompanied by an independently certified narrowing of the admissible
-- continuation/search fibre. This is a DASHI search-policy extension, not a
-- claim that the Aristotle paper itself defines this objective.
------------------------------------------------------------------------

record AristotleResidualAction
    (G : Aristotle.SearchHypergraph) : Set₁ where
  constructor aristotleResidualAction
  field
    action : Aristotle.Action G

    prior : Bidi.ResidualFibre (Aristotle.State G)
    posterior : Bidi.ResidualFibre (Aristotle.State G)
    refinement : Bidi.FibreRefines posterior prior

    -- Every explicit successor generated by the Aristotle hyperedge is admitted
    -- by the refined continuation fibre. This does not prove those successors.
    targetsRemainAdmissible :
      Aristotle.All posterior (Aristotle.targets G action)

    cost : Nat
    certifiedGain : Nat

    refinementReference : String
    targetAdmissionReference : String
    gainCertificateReference : String
    searchPolicyReference : String

open AristotleResidualAction public

asCostedResidualMove :
  ∀ {G} → AristotleResidualAction G →
  Costed.ResidualInformationMove (Aristotle.State G)
asCostedResidualMove candidate = Costed.residualInformationMove
  (prior candidate)
  (posterior candidate)
  (refinement candidate)
  Costed.proofSearchResidualMove
  (cost candidate)
  (certifiedGain candidate)
  "Aristotle proof-search residual information action"
  (gainCertificateReference candidate)
  (refinementReference candidate)
  (searchPolicyReference candidate)
  "proof state remains open until Aristotle StateProved evidence is constructed"

------------------------------------------------------------------------
-- Search-progress status is deliberately distinct from the AND/OR proof object.
------------------------------------------------------------------------

data AristotleSearchProgressGrade : Set where
  residualSearchProgress
  actionProvedGrade
  stateProvedGrade
  : AristotleSearchProgressGrade

residualProgressNotActionProof :
  residualSearchProgress ≡ actionProvedGrade → ⊥
residualProgressNotActionProof ()

residualProgressNotStateProof :
  residualSearchProgress ≡ stateProvedGrade → ⊥
residualProgressNotStateProof ()

------------------------------------------------------------------------
-- Lemma feedback can be combined with residual narrowing while retaining both
-- receipts independently: proved lemmas remain monotone, while the admissible
-- search fibre may also shrink.
------------------------------------------------------------------------

record FeedbackResidualRefinement
    {old new : Aristotle.LemmaLedger}
    {G : Aristotle.SearchHypergraph}
    (feedback : Aristotle.FeedbackRefinement old new)
    (prior posterior : Bidi.ResidualFibre (Aristotle.State G)) : Set₁ where
  constructor feedbackResidualRefinement
  field
    residualRefinement : Bidi.FibreRefines posterior prior
    feedbackReference : String
    residualReference : String
    couplingReference : String

open FeedbackResidualRefinement public

feedbackStillPreservesProvedLemma :
  ∀ {old new G prior posterior}
    {feedback : Aristotle.FeedbackRefinement old new} →
  FeedbackResidualRefinement feedback prior posterior →
  (lemma : Aristotle.LemmaId old) →
  Aristotle.ProvedIn old lemma →
  Aristotle.ProvedIn new (Aristotle.castId feedback lemma)
feedbackStillPreservesProvedLemma {feedback = feedback} receipt lemma =
  Aristotle.provedKnowledgeMonotone feedback lemma

residualPartStillRefines :
  ∀ {old new G prior posterior}
    {feedback : Aristotle.FeedbackRefinement old new} →
  FeedbackResidualRefinement feedback prior posterior →
  Bidi.FibreRefines posterior prior
residualPartStillRefines = residualRefinement

------------------------------------------------------------------------
-- Experiment/proof-search bridge semantics.
------------------------------------------------------------------------

record AristotleResidualSearchBoundary : Set where
  constructor aristotleResidualSearchBoundary
  field
    everyUsefulSearchActionMustImmediatelyProveSource : Bool
    everyUsefulSearchActionMustImmediatelyProveSourceIsFalse :
      everyUsefulSearchActionMustImmediatelyProveSource ≡ false
    residualSearchProgressAutomaticallyConstructsActionProved : Bool
    residualSearchProgressAutomaticallyConstructsActionProvedIsFalse :
      residualSearchProgressAutomaticallyConstructsActionProved ≡ false
    targetAdmissionMeansTargetsAreAlreadyProved : Bool
    targetAdmissionMeansTargetsAreAlreadyProvedIsFalse :
      targetAdmissionMeansTargetsAreAlreadyProved ≡ false
    lemmaFeedbackAndResidualNarrowingCanCompose : Bool
    lemmaFeedbackAndResidualNarrowingCanComposeIsTrue :
      lemmaFeedbackAndResidualNarrowingCanCompose ≡ true
    AristotlePaperItselfClaimsResidualGainObjective : Bool
    AristotlePaperItselfClaimsResidualGainObjectiveIsFalse :
      AristotlePaperItselfClaimsResidualGainObjective ≡ false
    proofSearchActionIsLaboratoryMeasurement : Bool
    proofSearchActionIsLaboratoryMeasurementIsFalse :
      proofSearchActionIsLaboratoryMeasurement ≡ false

canonicalAristotleResidualSearchBoundary : AristotleResidualSearchBoundary
canonicalAristotleResidualSearchBoundary =
  aristotleResidualSearchBoundary
    false refl false refl false refl true refl false refl false refl
