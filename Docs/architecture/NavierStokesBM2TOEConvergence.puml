@startuml
title Navier-Stokes B R571 M2 -> DASHI TOE normalization

package "Canonical theorem owners" {
  [R571 Physical M2 Dissipation Fold] as R571
  [NS Paper Theorem Interface / R650] as R650
}

package "Normalization" {
  [NavierStokesBM2TOEConvergenceExact] as N
  [NavierStokesBM2TOEConvergenceValidation] as V
}

package "TOE facades" {
  [EverythingTOESymmetryResolved369] as TOE
  [Unifier] as U
  [Unified.Physics] as P
