@startuml
' C4-style component view without a remote include.
' Parent document: README.md

title DASHI periodic Navier–Stokes Clay contract after Round 28

skinparam componentStyle rectangle
skinparam wrapWidth 220
skinparam maxMessageSize 160
skinparam shadowing false

actor "Mathematical reviewer" as Reviewer

package "Official requirement boundary" {
  component "Fefferman periodic alternative B\nExact preconditions and postconditions" as ClayTarget <<Requirement>>
}

package "Claim corpus and falsification" {
  component "Broad claimed-paper corpus\npeer-reviewed, arXiv, repositories, web" as Corpus <<Source registry>>
  component "Exact countermodels and finite regressions" as NoGo <<Checked exact>>
  component "Claim-family to first physical lemma crosswalk" as Crosswalk <<Checked reducer>>
}

package "Finite physical system" {
  component "Literal cutoff Z3 carrier\ncomplete duplicate-free output fibres" as Carrier <<Checked exact>>
  component "Sharp finite shell projectors\nidempotence, disjointness, resolution" as Projectors <<Checked exact>>
  component "Physical HH/LH/HL/CC support\nCom separated, no residual" as Support <<Checked exact>>
  component "Reality involution Ju(k)=conj u(-k)\ndiagonal multiplier equivariance" as Reality <<Checked exact algebra>>
  component "Commuting physical selector\nLeray, reality and centering" as PhysSelector <<Checked generic theorem>>
  component "Conjugate triad/output fibres\nPlucker invariant under conjugation" as ConjugateFibres <<Checked exact>>
  component "Reality-orbit phase space\nand quadratic coordinate RHS" as Coordinates <<Checked exact algebra>>
  component "Concrete selector and nonlinear equivariance" as PhysicalEquivariance <<Open producer>>
  component "Finite Picard-Lindelof\nand global Galerkin solution" as FiniteODE <<Open producer>>
  component "Triadwise energy cancellation" as Energy <<Checked exact algebra>>
  component "Signed critical shell ledger\nexplicit lower and upper boundaries" as SignedLedger <<Checked exact algebra>>
  component "Physical filtered-vorticity instantiation" as PhysicalLedger <<Open producer>>
}

package "Critical operator and geometry system" {
  component "State carrier versus multiplier dual" as StateDual <<Checked exact algebra>>
  component "Signed translation-multiplier commutator" as TranslationCommutator <<Checked exact algebra>>
  component "Structured signed interaction fibres" as InteractionFibres <<Checked exact algebra>>
  component "TT* / almost-orthogonality estimate" as TStarT <<Open producer>>
  component "Low transport cancellation\nand finite kernel commutator" as Commutator <<Checked exact algebra>>
  component "Physical triad Plucker/Gram invariant" as Plucker <<Checked exact algebra>>
  component "Orbit parity and conjugation signature" as OrbitParity <<Checked exact algebra>>
  component "Division-free Plucker homogeneity\nand parallel zero branch" as HHDefect <<Checked exact algebra>>
  component "Hysteretic entry charge\npaid by positive variation" as Hysteresis <<Checked exact algebra>>
}

package "Critical tax system" {
  component "Centred five-source probe" as Probe <<Checked exact algebra>>
  component "Signed constituent tree\ndelayed positive grouping" as Constituents <<Checked exact algebra>>
  component "Dependent unique-owner partition" as Ownership <<Checked exact algebra>>
  component "No-hidden-norm owner language" as TaxLanguage <<Checked exact algebra>>
  component "Nine-owner absorption algebra" as NineAbsorption <<Checked exact algebra>>
  component "Maximal uniform viscosity core" as MaxCore <<Checked exact algebra>>
  component "Physical nine-owner estimates" as Allocations <<Open producer>>
  component "Cutoff-uniform physical class taxes" as Tax <<Open producer>>
  component "Strict unique-owner viscosity certificate" as Margin <<Open producer>>
}

package "Limit and continuation system" {
  component "Critical Gronwall reducer" as Gronwall <<Checked reducer>>
  component "Nested shell/Galerkin limits" as Limits <<Reducer plus open analysis>>
  component "Critical-to-Serrin interpolation" as SerrinBridge <<Open analytic instance>>
  component "Periodic Serrin continuation" as Restart <<Reducer plus open analysis>>
  component "Smooth velocity and pressure recovery" as Recovery <<Open producer>>
}

package "Submission adaptation system" {
  component "Legacy global physical witness" as Legacy <<Existing interface>>
  component "Legacy-to-Fefferman adapter" as Adapter <<Checked reducer>>
  component "Mean-zero centering and Galilean restoration" as Galilean <<Reducer plus open analysis>>
  component "Literal Fefferman witness" as Literal <<Target witness>>
}

package "Assurance system" {
  component "Round 28 cumulative Agda root" as AgdaRoot <<Verification>>
  component "Static no-hole, source, link and authority checker" as Checker <<Verification>>
  component "Generated finite projector/operator certificate" as Certificate <<Verification>>
  component "Change, risk and traceability record" as Governance <<Governance>>
}

Corpus --> NoGo : isolate first load-bearing implication
Corpus --> Crosswalk : retain surviving local lemmas
NoGo --> Crosswalk : reject or narrow false routes
Crosswalk --> Tax : assign physical producer lane
Crosswalk --> Margin : assign strict-budget lane

Carrier --> Projectors : literal finite modes
Carrier --> Support : actual resonant output fibres
Carrier --> Coordinates : finite coefficient carrier
Carrier --> ConjugateFibres : cutoff closure under negation
Projectors --> PhysicalLedger : shell localization
Projectors --> TranslationCommutator : multiplier symbol
Reality --> PhysSelector : fixed-point selector
PhysSelector --> PhysicalEquivariance : instantiate concrete operations
ConjugateFibres --> PhysicalEquivariance : triad involution and opposite output
Coordinates --> PhysicalEquivariance : literal nonlinear RHS
PhysicalEquivariance --> FiniteODE : invariant finite phase space
Coordinates --> FiniteODE : local Lipschitz input
Coordinates --> Energy : resonant atoms
FiniteODE --> PhysicalLedger : time-dependent finite solution
Energy --> PhysicalLedger : exact finite energy cancellation
Support --> SignedLedger : exact five-source labels
PhysicalLedger --> SignedLedger : physical shell values

StateDual --> TranslationCommutator : typed state/test action
TranslationCommutator --> InteractionFibres : signed multiplier difference
InteractionFibres --> TStarT : direct-sum operator structure
TStarT --> Commutator : cutoff-uniform quantitative bound
SignedLedger --> Constituents : signed physical source values
Support --> Constituents : source-to-owner compatibility
Constituents --> Ownership : owner-homogeneous groups
Ownership --> TaxLanguage : each atom paid exactly once
TaxLanguage --> NineAbsorption : admissible finite aggregation
SignedLedger --> Probe : common plus centred sources
Support --> Plucker : physical resonant triads
ConjugateFibres --> OrbitParity : conjugation action
Plucker --> OrbitParity : orientation signature
OrbitParity --> HHDefect : invariant numerator
SignedLedger --> HHDefect : signed high-high coordinate
Commutator --> Tax : quantitative Com/low tax
HHDefect --> Tax : quantitative HH tax
Hysteresis --> Tax : repeated bad-entry charge
Ownership --> Tax : disjoint owner partition
Ownership --> MaxCore : unique owner set
MaxCore --> Allocations : canonical common core
Allocations --> TaxLanguage : physical estimates
TaxLanguage --> NineAbsorption : nine owner bounds
NineAbsorption --> Margin : explicit coefficient sum
Tax --> Margin : physical estimates for every owner
Margin --> Gronwall : total coefficient < 1
Gronwall --> Limits : uniform critical estimate
Limits --> SerrinBridge : physical critical bounds
SerrinBridge --> Restart : L4_t L6_x criterion
Restart --> Recovery : infinite maximal time
Recovery --> Legacy : global smooth solution data
Legacy --> Adapter : stronger witness
Adapter --> Galilean : centered literal witness
Galilean --> Literal : arbitrary periodic datum
Literal --> ClayTarget : inhabits exact theorem type

AgdaRoot ..> Carrier : imports through Round 25
AgdaRoot ..> SignedLedger : imports through Round 26
AgdaRoot ..> Projectors : imports through Round 27
AgdaRoot ..> PhysSelector : imports Round 28
AgdaRoot ..> ConjugateFibres : imports Round 28
AgdaRoot ..> Constituents : imports Round 28
AgdaRoot ..> Ownership : imports Round 28
AgdaRoot ..> InteractionFibres : imports Round 28
AgdaRoot ..> OrbitParity : imports Round 28
AgdaRoot ..> TaxLanguage : imports Round 28
AgdaRoot ..> NineAbsorption : imports Round 28
Checker ..> AgdaRoot : executes pinned Agda check
Certificate ..> Projectors : finite lattice box
Certificate ..> TranslationCommutator : finite lattice box
Certificate ..> Probe : exact rational cases
Certificate ..> Plucker : finite mode pairs
Certificate ..> MaxCore : candidate cores
Governance ..> Checker : quality and change gates
Reviewer --> Governance : reviews evidence
Reviewer --> Corpus : verifies source fidelity
Reviewer --> ClayTarget : checks exact target

note right of PhysSelector
The commuting-selector theorem is generic.
Concrete Leray idempotence and full nonlinear
commutation remain open physical instances.
end note

note right of Constituents
Positive taxation occurs only after a
source-compatible owner-homogeneous signed
group has been assembled.
end note

note right of InteractionFibres
The signed symbol m(k)-m(k-l) is retained.
The cutoff-uniform TT* estimate is open.
end note

note right of TaxLanguage
No uncontrolled BKM, Serrin or target
critical supremum can be inserted into an
admissible owner estimate by construction.
end note

note right of Margin
Open: physical bounds uniform in q, Q and N
and a strict sum of all nine coefficients.
end note

note right of Galilean
Mean zero is a reduction device,
not a Clay precondition.
end note

note bottom of ClayTarget
No unconditional theorem is promoted
until every open producer is inhabited
and the cumulative kernel check passes.
end note

@enduml
